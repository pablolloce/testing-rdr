<item id="340" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="341">querySQL</name>
<stringValue id="342">select FIIDFUND.FINS_ID AS FINS_ID FROM FT_T_FrID FRIDACRO, FT_T_FRId FRIDACC, FT_T_FIID FIIDFUND where 
FRIDACC.FINSRL_ID_CTXT_TYP = 'ACCDE' AND FRIDACRO.FINSRL_ID_CTXT_TYP = 'ALERTID' AND FRIDACRO.INST_MNEM = FRIDACC.INST_MNEM
AND FRIDACC.FINR_ID = ? AND FRIDACRO.FINR_ID= ? AND FIIDFUND.INST_MNEM = FRIDACC.INST_MNEM AND FIIDFUND.FINS_ID_CTXT_TYP = 'FINSID'</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
