<item id="2395" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="2396">querySQL</name>
<objectValue id="2397" type="java.lang.String">select * from (select COUNT(distinct ISSUE.instr_id) over() CNT,count (distinct SECLABEL.ISS_ID) over (partition by ISSUE.instr_id, seclabel.mkt_oid) SECLABEL_MKT_CNT,
DENSE_RANK() over (partition by ISSUE.instr_id, seclabel.mkt_oid order by seclabel.last_chg_tms desc,seclabel.start_tms desc, seclabel.isid_oid) SECLABEL_MKT_RANK,
count (distinct MKIS.mkt_iss_oid) over (partition by ISSUE.instr_id,  MKIS.mkt_oid,MKIS.PRC_CURR_CDE) MKT_CURR_CNT,
ISSUE.INSTR_ID,
ISSUE.SEDOL,ISSUE.SEDOL_MKT_OID,MKT_SEDOL.MKT_ID SEDOL_MKT_ID,GRP_SEDOL.GRP_NME SEDOL_GRP_NME,
ISSUE.RIC,ISSUE.RIC_MKT_OID,MKT_RIC.MKT_ID RIC_MKT_ID,GRP_RIC.GRP_NME RIC_GRP_NME,
ISSUE.ISIN,ISSUE.ISIN_MKT_OID,MKT_ISIN.MKT_ID ISIN_MKT_ID,GRP_ISIN.GRP_NME ISIN_GRP_NME,
SECLABEL.ISS_ID SECLABEL,SECLABEL.MKT_OID SECLABEL_MKT_OID,MKT_SECLABEL.MKT_ID SECLABEL_MKT_ID,GRP_SECLABEL.GRP_NME SECLABEL_GRP_NME, 
MKIS.MKT_OID MKIS_MKT_OID,MKIS.PRC_CURR_CDE CURRENCY, SECLABEL.ISID_OID ISIDOID, MKIS.MKT_ISS_OID MKTISSOID
from (select sedol.instr_id INSTR_ID, sedol.ISS_ID SEDOL, isin.iss_id ISIN,ric.iss_id RIC,
sedol.mkt_oid SEDOL_MKT_OID, null ISIN_MKT_OID, ric.mkt_oid RIC_MKT_OID
from ft_t_isid sedol, ft_t_isid isin,ft_t_isid ric
where sedol.iss_id = :sedol
and sedol.instr_id = isin.instr_id (+)
and sedol.instr_id = ric.instr_id (+)
and sedol.id_ctxt_typ = 'SEDOL'
and isin.id_ctxt_typ (+) = 'ISIN'
and ric.id_ctxt_typ (+) = 'RIC'
and sedol.data_stat_typ = 'ACTIVE'
and isin.data_stat_typ (+) = 'ACTIVE'
and ric.data_stat_typ (+) = 'ACTIVE'
union
select isin.instr_id INSTR_ID, sedol.ISS_ID SEDOL, isin.iss_id ISIN,ric.iss_id RIC,
sedol.mkt_oid SEDOL_MKT_OID, :isinMkt ISIN_MKT_OID, ric.mkt_oid RIC_MKT_OID
from ft_t_isid sedol,ft_t_isid isin,ft_t_isid ric
where isin.iss_id = :isin
and isin.instr_id = sedol.instr_id (+)
and isin.instr_id = ric.instr_id (+)
and isin.id_ctxt_typ = 'ISIN'
and sedol.id_ctxt_typ (+) = 'SEDOL'
and ric.id_ctxt_typ (+) = 'RIC'
and isin.data_stat_typ = 'ACTIVE'
and sedol.data_stat_typ (+) = 'ACTIVE'
and ric.data_stat_typ (+) = 'ACTIVE'
union
select ric.instr_id INSTR_ID, sedol.ISS_ID SEDOL, isin.iss_id ISIN,ric.iss_id RIC,
sedol.mkt_oid SEDOL_MKT_OID, null ISIN_MKT_OID, ric.mkt_oid RIC_MKT_OID
from ft_t_isid sedol,ft_t_isid isin,ft_t_isid ric
where ric.iss_id = :ric
and ric.instr_id = isin.instr_id (+)
and ric.instr_id = sedol.instr_id (+)
and ric.id_ctxt_typ = 'RIC'
and isin.id_ctxt_typ (+) = 'ISIN'
and sedol.id_ctxt_typ (+) = 'SEDOL'
and ric.data_stat_typ = 'ACTIVE'
and isin.data_stat_typ (+) = 'ACTIVE'
and sedol.data_stat_typ (+) = 'ACTIVE') ISSUE, ft_t_isid SECLABEL,ft_t_mkis MKIS, ft_t_mkid MKT_ISIN, ft_t_mkid MKT_RIC, ft_t_mkid MKT_SECLABEL,ft_t_mkid MKT_SEDOL,
ft_t_mtgp MTGP_ISIN, ft_t_mtgr GRP_ISIN,ft_t_mtgp MTGP_RIC, ft_t_mtgr GRP_RIC,ft_t_mtgp MTGP_SECLABEL, ft_t_mtgr GRP_SECLABEL,ft_t_mtgp MTGP_SEDOL, ft_t_mtgr GRP_SEDOL
where issue.instr_id=seclabel.instr_id (+)
and seclabel.id_ctxt_typ (+) = 'MUREXID'
and seclabel.data_stat_typ (+) = 'ACTIVE'
and issue.instr_id = mkis.instr_id (+)
--AND SECLABEL.MKT_OID= MKIS.MKT_OID (+)
and mkis.data_stat_typ (+) = 'ACTIVE'
and mkis.end_tms (+) is null
and trim(ISSUE.ISIN_MKT_OID)=trim(MKT_ISIN.mkt_oid (+))
and trim(ISSUE.ISIN_MKT_OID)=trim(MTGP_ISIN.mkt_oid (+))
and MTGP_ISIN.PRNT_MKT_GRP_OID=GRP_ISIN.MKT_GRP_OID (+)
and ISSUE.SEDOL_MKT_OID=MKT_SEDOL.mkt_oid (+)
and ISSUE.SEDOL_MKT_OID=MTGP_SEDOL.mkt_oid (+)
and MTGP_SEDOL.PRNT_MKT_GRP_OID=GRP_SEDOL.MKT_GRP_OID (+)
and ISSUE.RIC_MKT_OID=MKT_RIC.mkt_oid (+)
and ISSUE.RIC_MKT_OID=MTGP_RIC.mkt_oid (+)
and MTGP_RIC.PRNT_MKT_GRP_OID=GRP_RIC.MKT_GRP_OID (+)
and SECLABEL.MKT_OID=MKT_SECLABEL.mkt_oid (+)
and SECLABEL.MKT_OID=MTGP_SECLABEL.mkt_oid (+)
and MTGP_SECLABEL.PRNT_MKT_GRP_OID=GRP_SECLABEL.MKT_GRP_OID (+)
and MKT_ISIN.data_stat_typ (+) ='ACTIVE'
and MKT_SEDOL.data_stat_typ (+) ='ACTIVE'
and MKT_RIC.data_stat_typ (+) ='ACTIVE'
and MKT_SECLABEL.data_stat_typ (+) ='ACTIVE'
and MKT_ISIN.end_tms (+) is null
and MKT_SEDOL.end_tms (+) is null
and MKT_RIC.end_tms (+) is null
and MKT_SECLABEL.end_tms (+) is null
and MKT_ISIN.MKT_ID_CTXT_TYP (+) ='MIC'
and MKT_SEDOL.MKT_ID_CTXT_TYP (+) ='MIC'
and MKT_RIC.MKT_ID_CTXT_TYP (+) ='MIC'
and MKT_SECLABEL.MKT_ID_CTXT_TYP (+) ='MIC'
and MTGP_ISIN.data_stat_typ (+) ='ACTIVE'
and MTGP_SEDOL.data_stat_typ (+) ='ACTIVE'
and MTGP_RIC.data_stat_typ (+) ='ACTIVE'
and MTGP_SECLABEL.data_stat_typ (+) ='ACTIVE'
and MTGP_ISIN.end_tms (+) is null
and MTGP_SEDOL.end_tms (+) is null
and MTGP_RIC.end_tms (+) is null
and MTGP_SECLABEL.end_tms (+) is null
and GRP_ISIN.data_stat_typ (+) ='ACTIVE'
and GRP_SEDOL.data_stat_typ (+) ='ACTIVE'
and GRP_RIC.data_stat_typ (+) ='ACTIVE'
and GRP_SECLABEL.data_stat_typ (+) ='ACTIVE'
and GRP_ISIN.end_tms (+) is null
and GRP_SEDOL.end_tms (+) is null
and GRP_RIC.end_tms (+) is null
and GRP_SECLABEL.end_tms (+) is null)
where SECLABEL_MKT_RANK=1
order by seclabel_mkt_cnt asc, MKT_CURR_CNT desc, sedol asc,isin asc, ric asc,  seclabel asc, mkis_mkt_oid asc, currency asc</objectValue>
<type>CONSTANT</type>
</item>
</parameters>
