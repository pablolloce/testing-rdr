<item id="38" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="39">PLSQLQuery</name>
<objectValue id="40" type="java.lang.String"><![CDATA[DECLARE
-- CONSTANTES
CONS_ACTIVE CONSTANT VARCHAR2(20) := 'ACTIVE';
-- EXCEPCIONES CONTROLADAS
OFICINAD_NOT_FOUND EXCEPTION;
OFICINAP_NOT_FOUND EXCEPTION;
OFICINAP_DUPLICATE EXCEPTION;

-- VARIABLES
-- Oficina que se cierra, desaparece.
OFICINAD VARCHAR2(9):= ?;
-- Oficina que persiste
OFICINAP VARCHAR2(9):=?;
--JOB_ID
JOB varchar2(40) := ? ;
INST_MNEM_OFD VARCHAR2(10);
INST_MNEM_OFP VARCHAR2(10);
SUFR_OID_CONTRAPARTIDA VARCHAR(10);
INST_NME_OFD VARCHAR(100);
INST_NME_OFP VARCHAR(100);
SUBDIV_IDD FT_T_SUBD.SUBDIV_ID%TYPE;
SUBD_ORG_IDD FT_T_SUBD.ORG_ID%TYPE;
SUBD_OID_IDD FT_T_SUBD.SUBD_OID%TYPE;
SUBDIV_IDP FT_T_SUBD.SUBDIV_ID%TYPE;
SUBD_ORG_IDP FT_T_SUBD.ORG_ID%TYPE;
SUBD_OID_IDP FT_T_SUBD.SUBD_OID%TYPE;
FIID_FINSID VARCHAR2(10);
INST_MNEM_LOCALD VARCHAR(10);
INST_MNEM_LOCALP VARCHAR(10);
INST_MNEM_GLOBALD VARCHAR(10);
SUFR_OID_OFICINAP VARCHAR(10);
SUFR_OID_OFICINAD VARCHAR(10);
DATA_STAT_TYPD VARCHAR2(20);
COUNT_OFICINAD NUMERIC;
COUNT_OFICINAP NUMERIC;
ERR_RLT_STATUS NUMERIC;

CONTADOR NUMERIC;
HIJOS_LOCAL NUMERIC;
HIJOS_GLOBAL NUMERIC;

TYPE CONTRAPARTIDAS IS REF CURSOR;
CUR_CONTRAPARTIDAS CONTRAPARTIDAS;
VCH_SQL_CONTRAPARTIDAS VARCHAR2(2000);
BEGIN
  -- Get INST_MNEM de las dos oficinas. Si no devuelven una se lanza excepcion
  SELECT NVL((SELECT FINR_INST_MNEM FROM FT_T_SUFR WHERE DATA_STAT_TYP = 'ACTIVE' AND SUBDIV_ID = OFICINAD AND SUBDIV_RL_TYP='IS_OFFI' AND SUBD_ORG_ID = 'A1' AND ROWNUM < 2),(SELECT FINR_INST_MNEM FROM FT_T_SUFR WHERE SUBDIV_ID = OFICINAD AND SUBDIV_RL_TYP='IS_OFFI' AND SUBD_ORG_ID = 'A1' AND ROWNUM < 2)) INTO INST_MNEM_OFD FROM DUAL;
  IF INST_MNEM_OFD IS NULL THEN
    RAISE OFICINAD_NOT_FOUND;
  END IF;
  SELECT COUNT (FINR_INST_MNEM) INTO COUNT_OFICINAP FROM FT_T_SUFR WHERE DATA_STAT_TYP = 'ACTIVE' AND SUBDIV_ID = OFICINAP AND SUBDIV_RL_TYP='IS_OFFI' AND SUBD_ORG_ID = 'A1';
	IF COUNT_OFICINAP = 0 THEN   
    RAISE OFICINAP_NOT_FOUND;
  END IF;
  IF COUNT_OFICINAP > 1 THEN    
    RAISE OFICINAP_DUPLICATE;
  END IF;
  SELECT FINR_INST_MNEM INTO INST_MNEM_OFP FROM FT_T_SUFR WHERE DATA_STAT_TYP = 'ACTIVE' AND SUBDIV_ID = OFICINAP AND SUBDIV_RL_TYP='IS_OFFI'AND SUBDIV_RL_TYP='IS_OFFI' AND SUBD_ORG_ID = 'A1';
  -- Control de que las contrapartidas existan 
  -- Get INST_NME. Nombre de la oficina para reportes
  SELECT INST_NME INTO INST_NME_OFD FROM FT_T_FINS WHERE INST_MNEM = INST_MNEM_OFD;
  SELECT INST_NME INTO INST_NME_OFP FROM FT_T_FINS WHERE INST_MNEM = INST_MNEM_OFP;
  -- Datos de la oficina sobre la que se va a reubicar.
  SELECT SUFR_OID INTO SUFR_OID_OFICINAP FROM FT_T_SUFR WHERE FINR_INST_MNEM = INST_MNEM_OFP AND SUBDIV_RL_TYP='IS_OFFI';
  SELECT SUBDIV_ID INTO SUBDIV_IDP FROM FT_T_SUFR WHERE SUFR_OID = SUFR_OID_OFICINAP;
  SELECT SUBD_ORG_ID INTO SUBD_ORG_IDP FROM FT_T_SUFR WHERE SUFR_OID = SUFR_OID_OFICINAP;
  SELECT SUBD_OID INTO SUBD_OID_IDP FROM FT_T_SUBD WHERE SUBDIV_ID = SUBDIV_IDP AND ORG_ID=SUBD_ORG_IDP;
  -- Datos de la oficina que desaparece.
  SELECT SUFR_OID INTO SUFR_OID_OFICINAD FROM FT_T_SUFR WHERE FINR_INST_MNEM = INST_MNEM_OFD AND SUBDIV_RL_TYP='IS_OFFI';
  SELECT SUBDIV_ID INTO SUBDIV_IDD FROM FT_T_SUFR WHERE SUFR_OID = SUFR_OID_OFICINAD;
  SELECT SUBD_ORG_ID INTO SUBD_ORG_IDD FROM FT_T_SUFR WHERE SUFR_OID = SUFR_OID_OFICINAD;
  SELECT SUBD_OID INTO SUBD_OID_IDD FROM FT_T_SUBD WHERE SUBDIV_ID = SUBDIV_IDD AND ORG_ID=SUBD_ORG_IDD;
  SELECT FINS_ID INTO FIID_FINSID FROM FT_T_FIID WHERE INST_MNEM = INST_MNEM_OFD AND FINS_ID_CTXT_TYP = 'FINSID' AND DATA_STAT_TYP = 'ACTIVE';
  -- Get DATA_STAT_TYP de la contrapartida que se cierra. Si es activo y pasa a Inactive Pending se marca a DIFUSION
  SELECT DATA_STAT_TYP INTO DATA_STAT_TYPD FROM FT_T_FINS WHERE INST_MNEM = INST_MNEM_OFD;
  -- Reubicacion de las relaciones de la oficina que se cierra a la oficina destino
  VCH_SQL_CONTRAPARTIDAS := 'SELECT SUFR_OID FROM FT_T_SUFR WHERE SUBDIV_ID = '''|| SUBDIV_IDD ||''' AND SUBD_ORG_ID = '''|| SUBD_ORG_IDD ||''' AND ( SUBDIV_RL_TYP = '''||'TRADES_WITH'||''' OR SUBDIV_RL_TYP = '''||'RISKPYME'||''')';
  CONTADOR:=1;            
  OPEN CUR_CONTRAPARTIDAS FOR VCH_SQL_CONTRAPARTIDAS;
  LOOP
    FETCH CUR_CONTRAPARTIDAS INTO SUFR_OID_CONTRAPARTIDA;
    EXIT WHEN CUR_CONTRAPARTIDAS%NOTFOUND;
    -- Asocio los valores de la oficina que permanece a las contrapartidas asociadadas a la oficina que desaparece.
    UPDATE FT_T_SUFR SET SUBDIV_ID=SUBDIV_IDP,SUBD_ORG_ID=SUBD_ORG_IDP, SUBD_OID=SUBD_OID_IDP, LAST_CHG_TMS = SYSDATE, LAST_CHG_USR_ID = 'REUBICACION' WHERE SUFR_OID = SUFR_OID_CONTRAPARTIDA;
    -- Inserto registro en la tabla de log
    CONTADOR:= CONTADOR+1;              
  END LOOP;
  -- RLT1 para reporte
  
  IF DATA_STAT_TYPD = 'ACTIVE'
  THEN  
	-- Modificación evolutivos contrapartidas 23/07/2018 -> No tener en cuenta contrapartidas inactivas
	INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,null,contador,1,'Reubicacion realizada con exito',INST_MNEM_OFD,'REPORTES','REUBICACION','OFICINA CERRADA: ',OFICINAD,'OFICINA A LA QUE SE REUBICA: ',OFICINAP,'DESC OFICINA CERRADA:',FIID_FINSID,sysdate,null,sysdate,'BBVA:CUSTOMER','NO',null);           
	-- RLT1 para marcar a baja la FINS de la contrapartida si procede
  
    INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,null,contador,1,'Oficina actualizada a Inactive Pending',INST_MNEM_OFD,'REPORTES','REUBICACION','OFICINA CERRADA: ',OFICINAD,'OFICINA A LA QUE SE REUBICA: ',OFICINAP,'DESC OFICINA CERRADA:',FIID_FINSID,sysdate,null,sysdate,'BBVA:CUSTOMER','PENDING','B');
  END IF;            
  -- Baja del registro IS_OFFI de la SUFR
  UPDATE FT_T_SUFR SET DATA_STAT_TYP='INACTIVE',LAST_CHG_TMS = SYSDATE, LAST_CHG_USR_ID = 'REUBICACION' WHERE SUFR_OID=SUFR_OID_OFICINAD AND DATA_STAT_TYP = 'ACTIVE';
  -- Baja de la SUBD
  UPDATE FT_T_SUBD SET DATA_STAT_TYP='INACTIVE',LAST_CHG_TMS = SYSDATE, LAST_CHG_USR_ID = 'REUBICACION' WHERE SUBDIV_ID=SUBDIV_IDD AND ORG_ID=SUBD_ORG_IDD AND DATA_STAT_TYP = 'ACTIVE';
  -- Baja de la FINS si esta ACTIVA
  UPDATE FT_T_FINS SET DATA_STAT_TYP='INACTIVEPEND',LAST_CHG_TMS = SYSDATE, LAST_CHG_USR_ID = 'REUBICACION' WHERE INST_MNEM=INST_MNEM_OFD AND DATA_STAT_TYP = 'ACTIVE';			      
  DBMS_OUTPUT.PUT_LINE('PROCESADO DE REUBICACION OK');  
  -- CONTROL DE EXCEPCIONES
	EXCEPTION
    -- OFICINA CIERRE NO ENCONTRADA
    WHEN OFICINAD_NOT_FOUND THEN          
      INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,null,null,1,'Oficina de cierre no encontrada','NOT_FOUND','REPORTES','REUBICACION','OFICINA CERRADA: ',OFICINAD,'OFICINA A LA QUE SE REUBICA: ',OFICINAP,'DESC OFICINA CERRADA:','NOT_FOUND',sysdate,null,sysdate,'BBVA:CUSTOMER','NO',null);
    -- OFICINA DESTINO NO ENCONTRADA
    WHEN OFICINAP_NOT_FOUND THEN      
      INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,null,null,1,'Oficina destino no encontrada','NOT_FOUND','REPORTES','REUBICACION','OFICINA CERRADA: ',OFICINAD,'OFICINA A LA QUE SE REUBICA: ',OFICINAP,'DESC OFICINA CERRADA:','NOT_FOUND',sysdate,null,sysdate,'BBVA:CUSTOMER','NO',null); 
    -- OFICINA DESTINO DUPLICADA
    WHEN OFICINAP_DUPLICATE THEN  
      INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,null,null,1,'Oficina destino duplicado','NOT_FOUND','REPORTES','REUBICACION','OFICINA CERRADA: ',OFICINAD,'OFICINA A LA QUE SE REUBICA: ',OFICINAP,'DESC OFICINA CERRADA:','NOT_FOUND',sysdate,null,sysdate,'BBVA:CUSTOMER','NO',null);
    -- ERRORES INESPERADOS
    WHEN OTHERS THEN      
      INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,null,null,1,'Error en el proceso de Reubicacion','NOT_FOUND','REPORTES','REUBICACION','OFICINA CERRADA: ',OFICINAD,'OFICINA A LA QUE SE REUBICA: ',OFICINAP,'DESC OFICINA CERRADA:','NOT_FOUND',sysdate,null,sysdate,'BBVA:CUSTOMER','NO',null);
END REUBICACION]]></objectValue>
<type>CONSTANT</type>
</item>
