<item id="41" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="42">querySQL</name>
<stringValue id="43">select INCL.CL_VALUE CL_VALUE
from ft_t_firt FIRT, FT_T_FRRL FRRL, ft_t_incl INCL 
where 
FRRL.rel_typ = INCL.CLSF_OID and
FIRT.DATA_STAT_TYP='ACTIVE' and
FRRL.DATA_STAT_TYP='ACTIVE' and
INCL.DATA_STAT_TYP='ACTIVE' and
FRRL.PARTICIPANT_ID = FIRT.fins_RTNG_OID and 
FIRT.FINS_RTNG_OID = ? and 
FIRT.INST_MNEM = ? and 
FIRT.RTNG_SET_OID = ?</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
