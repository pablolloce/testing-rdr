<item id="244" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="245">querySQL</name>
<stringValue id="246">SELECT firl_glob.inst_mnem VALOR
FROM FT_T_FIRL firl_glob
JOIN FT_T_FIRL firl_loc
ON firl_glob.REL_TYP        = 'GLOBAL'
AND firl_glob.DATA_STAT_TYP = 'ACTIVE'
AND firl_loc.PRNT_INST_MNEM = firl_glob.inst_mnem
AND firl_loc.DATA_STAT_TYP  = 'ACTIVE'
JOIN FT_T_FIRL firl_ope
ON firl_ope.PRNT_INST_MNEM = firl_loc.inst_mnem
AND firl_ope.DATA_STAT_TYP = 'ACTIVE'
AND firl_ope.inst_mnem     = :mnemOperativo</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
