<item id="56" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="57">querySQL</name>
<stringValue id="58">SELECT
 
  UTD_ID_PURP_TYP,
 
  UTD_ID 

FROM
 
  FT_T_UTD1 

WHERE
 
  UTD_ID_PURP_TYP IN ('MA_ROL', 'MA_BR', 'MA_AFC')
 
  AND UTD_USAGE_TYP = 'FIELD'
   AND DATA_STAT_TYP = 'ACTIVE'
   AND END_TMS IS NULL
   AND UTD_EXT_ID = ?</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
