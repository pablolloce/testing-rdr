			UPDATE FT_T_SSIA SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_SSIR SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_SSIS SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_SUFR SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';

			--MIRAR SI EL GLOBAL ESTA INACTIVO
			SELECT COUNT(*) INTO CUENTA_GLOBAL FROM FT_T_FINS WHERE DATA_STAT_TYP = 'INACTIVE' AND INST_MNEM IN (SELECT FIRLL.PRNT_INST_MNEM FROM FT_T_FIRL FIRLL WHERE FIRLL.INST_MNEM = INST_MNEM_CLP AND FIRLL.REL_TYP = 'LOCAL' AND FIRLL.FINSRL_TYP = 'CUSTOMER');
				
				IF(CUENTA_GLOBAL = 1) THEN
					SELECT PRNT_INST_MNEM INTO MNEMONICO_GLOBAL FROM FT_T_FIRL WHERE INST_MNEM = INST_MNEM_CLP AND REL_TYP = 'LOCAL' AND FINSRL_TYP = 'CUSTOMER';
					--Actualizo tablas
					UPDATE FT_T_ADTP SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
