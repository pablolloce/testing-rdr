<name id="195">Get ACKNACK</name>
<nodeHandler>com.j2fe.general.activities.database.DBQuery</nodeHandler>
<nodeHandlerClass id="196">com.j2fe.general.activities.database.DBQuery</nodeHandlerClass>
<parameters id="197" type="java.util.HashSet">
<item id="198" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="199">database</name>
<stringValue id="200">jdbc/GSDM-1</stringValue>
<type>REFERENCE</type>
</item>
<item id="201" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="202">["1,2"]@java/util/Date@</UITypeHint>
<input>true</input>
<name id="203">mappedParameters["1,2"]</name>
<stringValue id="204">date</stringValue>
<type>VARIABLE</type>
</item>
<item id="205" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="206">["3"]@java/lang/String@</UITypeHint>
<input>true</input>
<name id="207">mappedParameters["3"]</name>
<stringValue id="208">basketId</stringValue>
<type>VARIABLE</type>
</item>
<item id="209" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="210">[0]["ACKNACK"]@java/lang/String@</UITypeHint>
<input>false</input>
<name id="211">mappedResult[0]["ACKNACK"]</name>
<stringValue id="212">ackNack</stringValue>
<type>VARIABLE</type>
</item>
<item id="213" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="214">querySQL</name>
<objectValue id="215" type="java.lang.String">SELECT CASE when (ACK>NACK or (NACK is null and ACK is not null))
                 then 'Recibido ACK' 
            when (NACK>ACK or (NACK is not null and ACK is null))
                 then MSG_NACK else 'No encontrado ACK ni NACK' 
            end ACKNACK
FROM (SELECT MUREXID.LAST_CHG_TMS ACK,
EMM1.BROADCAST_DATE NACK,
EMM1.MSG_DESCRIPTION MSG_NACK,
dense_rank() over(order by EMM1.BROADCAST_DATE desc) as NACK_RANK
FROM FT_T_ISID CANONICO
    LEFT JOIN FT_T_ISID MUREXID ON MUREXID.INSTR_ID=CANONICO.INSTR_ID
        AND MUREXID.ID_CTXT_TYP='MUREXID'
        AND MUREXID.LAST_CHG_USR_ID='ACK'
        AND MUREXID.LAST_CHG_TMS >= :fecha
    LEFT JOIN FT_T_EMM1 EMM1 ON EMM1.DATA_CDE=CANONICO.ISS_ID
        AND EMM1.BROADCAST_DATE >= :fecha
        AND EMM1.BROADCAST_STATUS='NACK'
        AND EMM1.BROADCAST_SYSTEM IN ('MUREX','ESB')
        AND EMM1.DATA_TYP='Basket'
WHERE CANONICO.ID_CTXT_TYP='RDR_ID'
AND CANONICO.DATA_STAT_TYP='ACTIVE'
AND CANONICO.INSTR_ID=:basketId) listado
where NACK_RANK=1</objectValue>
<type>CONSTANT</type>
</item>
</parameters>
<sources id="216" type="java.util.HashSet">
<item idref="192"/>
</sources>
<targets id="217" type="java.util.HashSet">
<item id="218" type="com.j2fe.workflow.definition.Transition">
<name id="219">goto-next</name>
<source idref="194"/>
<target id="220">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="221">Published</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="222">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="223" type="java.util.HashSet">
<item id="224" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="225">statements</name>
<stringValue id="226">String body ="";
String subject = "";
String listAlerts = "";
String ackInfo = "fallida";

for (Map map: alerts){
	if (!map.get("TIPO").equals("ACKINFO")){
		listAlerts = listAlerts +  map.get("MENSAJE") + "\r\n\r\n";
	}
}

if (ackNack.equals("Recibido ACK")){
	ackInfo="correcta";
}

if (ackInfo.equals("correcta")){
	body = ackNack + " de MX3.\r\n\r\n";
} else {
	body = "Se ha encontrado el siguiente error en la publicación a MX3: "+ackNack+"\r\n\r\n";
}

if (listAlerts.equals("")){
	body = body +"El índice: "+ indexId+ " se ha cargado correctamente en RDR.";
} else {
	body =  body +"El índice: "+ indexId+ " se ha cargado correctamente en RDR generando las siguientes alertas:\r\n\r\n" + listAlerts;
}

subject = "Recarga del indice en RDR: " + indexId+ " correcta, publicación " +ackInfo + " a MX3";</stringValue>
<type>CONSTANT</type>
</item>
<item id="227" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="228">["ackNack"]@java/lang/String@</UITypeHint>
<input>true</input>
<name id="229">variables["ackNack"]</name>
<stringValue id="230">ackNack</stringValue>
<type>VARIABLE</type>
</item>
<item id="231" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="232">variables["alerts"]</name>
<stringValue id="233">alerts</stringValue>
<type>VARIABLE</type>
</item>
