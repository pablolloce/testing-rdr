<item id="48" type="com.j2fe.workflow.definition.Transition">
<name id="49">goto-next</name>
<source idref="33"/>
<target id="50">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="51">Generar Mail Reporte LEI</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="52">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="53" type="java.util.HashSet">
