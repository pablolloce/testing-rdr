<item id="22" type="com.j2fe.workflow.definition.Transition">
<name id="23">goto-next</name>
<source id="24">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="25">SFTR Calculation</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="26">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="27" type="java.util.HashSet">
<item id="28" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="29">statements</name>
<objectValue id="30" type="java.lang.String"><![CDATA[//Declaracion de variables
Map calculoSFTR = new HashMap();
String bdi = "";
String ent = "";
String pers = "";
String rolcr = "";
String etiqueta = "";
String european = "";
String codinstiText = "";

if (bdiCode != null && bdiCode.length > 0){
	bdi = bdiCode[0].get("BDI");
}else{
	bdi = "NE";
}

if (codinsti != null && codinsti.length > 0){
	codinstiText = codinsti[0].get("CODINSTI");
}else{
	codinstiText = "NE";
}

if (entOwn != null && entOwn.length > 0){
	ent = entOwn[0].get("ENTOWN");
}else{
	ent = "NE";
}

if (personality != null && personality.length > 0){
	pers = personality[0].get("ROLE");
}else{
	pers = "NE";
}

if (rolcrsem != null && rolcrsem.length > 0){
	rolcr = rolcrsem[0].get("ROLCRSEM");
}else{
	rolcr = "NE";
}

if (etiquetaSFTR != null && etiquetaSFTR.length > 0){
	etiqueta = etiquetaSFTR[0].get("ETIQUETA");
}else{
	etiqueta = "NE";
}

if (europeanPersonData != null && europeanPersonData.length > 0){
	european = europeanPersonData[0].get("USINDEM");
}else{
	european = "NE";
}

//Una vez inicializados los valores por si alguno de ellos no existiera en la contrapartida, se realiza el calculo del dato

switch (etiqueta) {
	case "PENDING":  
		calculoSFTR.put("ETIQUETA","05");
		break;
	case "NFC / EXENT":

		//Se valida el campo CCP (se valida si la contrapartida es cÃƒÆ’Ã‚Â¡mara o no)
		if(rolcr.equals("Y"))	{
			calculoSFTR.put("ETIQUETA","02");
		}else	{
			calculoSFTR.put("ETIQUETA","04");
		}  
		break;
	case "EXENT / FINAN.":

		//Se valida el European Person Indicator
		if(european.equals("Y"))		{
			calculoSFTR.put("ETIQUETA","02");
		}else		{
			calculoSFTR.put("ETIQUETA","03");
		}  
		break;
	case "PEND. / NFC":
		//Se valida si la contrapartida tiene cÃƒÆ’Ã‚Â³digo de BDI
		if(!bdi.equals("NE")){
			calculoSFTR.put("ETIQUETA","05");
		}else	{
			calculoSFTR.put("ETIQUETA","04");
		}
		break;
	case "EXENT EXC. REP.":  
		calculoSFTR.put("ETIQUETA","01");
		break;
	case "EX. EXC. / NFC":
		//Se valida el European Person Indicator
		if(european.equals("Y"))	{
			calculoSFTR.put("ETIQUETA","01");
		}else	{
			calculoSFTR.put("ETIQUETA","04");
		}  
		break;
	case "FINANCIAL":
		calculoSFTR.put("ETIQUETA","03");
		break;
	case "EXENT":
		calculoSFTR.put("ETIQUETA","02");
		break;
	case "EXENT / NFC":  
		//Se valida el European Person Indicator
		if(european.equals("Y"))	{
			calculoSFTR.put("ETIQUETA","02");
		}else	{
			calculoSFTR.put("ETIQUETA","04");
		}  
		break;
	case "NON FINAN.":
		calculoSFTR.put("ETIQUETA","04");
		break;
    default:
		if(!pers.equals("NE"))	{
			calculoSFTR.put("ETIQUETA","04");
		}else	{
			if(!codinstiText.equals("NE"))		{
				calculoSFTR.put("ETIQUETA","05");
			}else	{
				calculoSFTR.put("ETIQUETA","02");
			}
		}
		break;
}]]></objectValue>
<type>CONSTANT</type>
</item>
