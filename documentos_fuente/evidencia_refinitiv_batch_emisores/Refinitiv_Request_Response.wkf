<name id="981">statements</name>
<objectValue id="982" type="java.lang.String">import org.apache.log4j.Logger;
import java.io.BufferedReader;
import java.io.File;
import java.io.FileReader;
import java.io.IOException;
import java.util.regex.*;
import javax.xml.parsers.ParserConfigurationException;
import javax.xml.xpath.XPathExpressionException;
import org.xml.sax.SAXException;
import java.text.SimpleDateFormat;
import java.util.Arrays;
import java.util.Date;
 
Logger logger = Logger.getLogger("Refinitiv_Request - OptionsFutures");
String cmdFiltrado="";
String cmdOpenFigi="";
String cmdLoadDerivative="";
String cmdHistorificaFichCarga="mv "+pathOut+"*.txt "+pathOut+"old";
String cmdCopiaFichRefinitiv="cp "+pathOut+"*.txt "+pathOut+"old";
	
String JAR="/"+env+"/kytl/online/multipais/multicanal/jar/";
String LIB="/"+env+"/kytl/online/multipais/multicanal/lib/";
String LogPropertiesFilter ="/"+env+"/kytl/online/multipais/multicanal/dat/properties/log4jrefinitivDataFilter.properties";
String LogPropertiesOpenFigi ="/"+env+"/kytl/online/multipais/multicanal/dat/properties/log4jrefinitivEnricherOnline.properties";
String LogPropertiesLoadDerivatives ="/"+env+"/kytl/online/multipais/multicanal/dat/properties/log4jrefinitivderivativesloaderOnline.properties";

String LIBRERIAS_PROCESOS_JAVA=LIB+"spring-context-5.2.5.RELEASE.jar:"+
LIB+"spring-aop-5.2.5.RELEASE.jar:"+
LIB+"spring-beans-5.2.5.RELEASE.jar:"+
LIB+"spring-expression-5.2.5.RELEASE.jar:"+
LIB+"spring-boot-starter-2.2.6.RELEASE.jar:"+
LIB+"spring-boot-2.2.6.RELEASE.jar:"+
LIB+"spring-boot-autoconfigure-2.2.6.RELEASE.jar:"+
LIB+"spring-boot-starter-logging-2.2.6.RELEASE.jar:"+
LIB+"logback-classic-1.2.3.jar:"+
LIB+"logback-core-1.2.3.jar:"+
LIB+"log4j-to-slf4j-2.12.1.jar:"+
LIB+"log4j-api-2.12.1.jar:"+
LIB+"jul-to-slf4j-1.7.30.jar:"+
LIB+"jakarta.annotation-api-1.3.5.jar:"+
LIB+"snakeyaml-1.25.jar:"+
LIB+"spring-boot-starter-data-jpa-1.5.14.RELEASE.jar:"+
LIB+"spring-boot-starter-aop-1.5.14.RELEASE.jar:"+
LIB+"aspectjweaver-1.8.13.jar:"+
LIB+"spring-boot-starter-jdbc-1.5.14.RELEASE.jar:"+
LIB+"tomcat-jdbc-8.5.31.jar:"+
LIB+"tomcat-juli-8.5.31.jar:"+
LIB+"spring-jdbc-4.3.18.RELEASE.jar:"+
LIB+"hibernate-core-5.0.12.Final.jar:"+
LIB+"jboss-logging-3.3.0.Final.jar:"+
LIB+"hibernate-jpa-2.1-api-1.0.0.Final.jar:"+
LIB+"antlr-2.7.7.jar:"+
LIB+"jandex-2.0.0.Final.jar:"+
LIB+"dom4j-1.6.1.jar:"+
LIB+"xml-apis-1.0.b2.jar:"+
LIB+"hibernate-commons-annotations-5.0.1.Final.jar:"+
LIB+"hibernate-entitymanager-5.0.12.Final.jar:"+
LIB+"javax.transaction-api-1.2.jar:"+
LIB+"spring-data-jpa-1.11.13.RELEASE.jar:"+
LIB+"spring-data-commons-1.13.13.RELEASE.jar:"+
LIB+"spring-orm-4.3.18.RELEASE.jar:"+
LIB+"spring-tx-4.3.18.RELEASE.jar:"+
LIB+"slf4j-api-1.7.25.jar:"+
LIB+"jcl-over-slf4j-1.7.25.jar:"+
LIB+"spring-aspects-4.3.18.RELEASE.jar:"+
LIB+"spring-boot-starter-actuator-1.5.14.RELEASE.jar:"+
LIB+"spring-boot-actuator-1.5.14.RELEASE.jar:"+
LIB+"jackson-databind-2.8.11.2.jar:"+
LIB+"jackson-annotations-2.8.0.jar:"+
LIB+"jackson-core-2.8.10.jar:"+
LIB+"spring-core-5.2.5.RELEASE.jar:"+
LIB+"spring-jcl-5.2.5.RELEASE.jar:"+
LIB+"log4j.jar:"+
LIB+"javassist-3.28.0-GA.jar:"+
LIB+"ojdbc6.jar:"+
LIB+"httpclient-4.5.12.jar:"+
LIB+"httpcore-4.4.13.jar:"+
LIB+"commons-logging-1.2.jar:"+
LIB+"commons-codec-1.11.jar:"+
LIB+"gson-2.6.2.jar:"+
JAR+"ConexionBD.jar:"+
LIB+"spring-context-support-4.3.18.RELEASE.jar:";

cmdOpenFigi = JAVA+" -Dfile.encoding=UTF8 -Dorg.jboss.logging.provider=log4j -cp "+
LIBRERIAS_PROCESOS_JAVA+
JAR +"XMASToken-0.0.1.jar:"+
JAR+"openFigiEnricher.jar com.bbva.kytl.EnricherProcess "
+env+" "+LogPropertiesOpenFigi+" "+pathOut+" Derivados_Filtrado_ " +pathOut+ " DELETE " +pathOut+"old DERIVADO" ;

logger.error("[Refinitiv_Request OpenFigi]: "+ cmdOpenFigi);

if (vreqOid.equals("OPTIONS_FUTURES_ENRICHMENT")){
		cmdFiltrado = JAVA+" -Dfile.encoding=UTF8 -Dorg.jboss.logging.provider=log4j -cp "+
		LIBRERIAS_PROCESOS_JAVA+
		JAR+"refinitivFilter.jar com.bbva.kytl.MainProcess "
		+LogPropertiesFilter+" ONLINE "+pathOut+" .txt " +pathOut+ " " +pathOut+"old DELETE" ;
		
		cmdLoadDerivative = JAVA+" -Dfile.encoding=UTF8 -Dorg.jboss.logging.provider=log4j -cp "+
		LIBRERIAS_PROCESOS_JAVA+
		JAR+"refinitivDerivativesLoader.jar com.bbva.kytl.refinitivderivativesloader.LoaderProcess "
		+LogPropertiesLoadDerivatives+" ONLINE "+pathOut+" .txt";
		logger.error("[Refinitiv_Request Load Derivative]: "+ cmdLoadDerivative);
} else{

		cmdFiltrado = JAVA+" -Dfile.encoding=UTF8 -Dorg.jboss.logging.provider=log4j -cp "+
		LIBRERIAS_PROCESOS_JAVA+
		JAR+"refinitivFilter.jar com.bbva.kytl.MainProcess "
		+LogPropertiesFilter+" ONLINE "+pathOut+" "+ fileOut +" " +pathOut+ " " +pathOut+"old DELETE " + vreqOid;
		
		
		cmdLoadDerivative = JAVA+" -Dfile.encoding=UTF8 -Dorg.jboss.logging.provider=log4j -cp "+
		LIBRERIAS_PROCESOS_JAVA+
		JAR+"refinitivDerivativesLoader.jar com.bbva.kytl.refinitivderivativesloader.LoaderProcess "
		+LogPropertiesLoadDerivatives+" BATCH "+pathOut+" .txt " + vreqOid;
		
		logger.error("[Refinitiv_Request Load Derivative]: "+ cmdLoadDerivative);
}



</objectValue>
<type>CONSTANT</type>
