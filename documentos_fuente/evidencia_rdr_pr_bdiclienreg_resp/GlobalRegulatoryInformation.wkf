<item id="144" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="145">querySQL</name>
<stringValue id="146">select case when SRC_VALUE = 'manualSFTRINACTIVE' then 'Inactivar'
when SRC_VALUE = 'manualSFTRACTIVE' then 'Activar' end as STATUS
from ft_t_rlt1 
where DATA_SRC_APP='CALCULODR' 
and RLT_PURP_TYP='CONTROLDR' 
and LAST_CHG_TMS > sysdate- (7/86400) 
and MAIN_ENTITY_ID =  ? 
and SRC_VALUE like 'manualSFTR%' 
order by LAST_CHG_TMS desc 
fetch first 1 row only</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
