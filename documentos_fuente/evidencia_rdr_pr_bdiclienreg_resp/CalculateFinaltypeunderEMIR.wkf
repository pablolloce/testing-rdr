<name id="29">statements</name>
<stringValue id="30"><![CDATA[import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("Calculate Final type under EMIR");

if (hacerCalculoDR != null && hacerCalculoDR.length() > 0 && hacerCalculoDR.equalsIgnoreCase("false")) {
	logger.error("[CheckDatosRegulatorios] Calculate Final type under EMIR NO SE HACE CALCULO AQUI");
	return false;
}else{
	logger.error("[CheckDatosRegulatorios] Calculate Final type under EMIR SE HACE CALCULO AQUI");
	return true;
}]]></stringValue>
<type>CONSTANT</type>
</item>
