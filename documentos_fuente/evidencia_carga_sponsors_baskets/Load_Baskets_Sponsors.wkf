<item id="2301" type="com.j2fe.workflow.definition.Transition">
<name id="2302">ERROR</name>
<source id="2303">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="2304">Issue Verification</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="2305">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="2306" type="java.util.HashSet">
<item id="2307" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="2308">statements</name>
<objectValue id="2309" type="java.lang.String"><![CDATA[String[][] mensaje = new String[12][2];
String[] arrayMensaje = new String[2]; 
int issueLine = -1;
int maxMensaje = 0;
int contOK = 0;
estado="ERROR";

String instrName = mapAlta.get(instrumentName);

if (resultCount == 0) {
	//si la query no devuelve resultados la emision no existe en BBDD
	if (!mapAlta.get(mainIdType).isEmpty()) {
		
			mensaje[contOK][1] = "El " + mainIdType + ": " + mapAlta.get(mainIdType) + " no existe en RDR";
			if (sponsor != null && !sponsor.equals("SP_DJ") && !sponsor.equals("MANUAL")) {
				mensaje[contOK][1] += ". Instrumento: " + instrName;
			}
		
			mensaje[contOK][0] = "ERROR DE DATOS";

			if (mapAlta.get(secondaryIdType) != null) {
				mensaje[contOK][1] = mensaje[contOK][1] + ", correspondiente al " + secondaryIdType + ": " + mapAlta.get(secondaryIdType);
			}

	} else {
		mensaje[contOK][1] = "Componente sin " + mainIdType + ", verificar fichero de entrada";
		mensaje[contOK][0] = "ERROR TÉCNICO RDR";
	}
} else if (issueData[0].get("CNT") == 1) {
	//Cuando la emision existe, puede devolver +1 resultado por tener varios identificadores en distintos mercados, por eso recorremos todos los resultado
	for (Map data : issueData) {
		issueLine++;
		contOK = 1;
		if (data.get(mainIdType) != null && data.get(mainIdType).equals(mapAlta.get(mainIdType))) {
			contOK++;
			if (data.get(mainIdType+"_MKT_OID") != null) {
				contOK++;
				if (mapAlta.get(secondaryIdType) != null) {
					if (data.get(secondaryIdType) != null && data.get(secondaryIdType).equals(mapAlta.get(secondaryIdType))) {
						contOK++;
					} else {
						maxMensaje = (maxMensaje < contOK) ? contOK : maxMensaje;

						mensaje[contOK][1] = "El " + secondaryIdType + ": " + mapAlta.get(secondaryIdType) +" no existe en RDR, correspondiente al " + mainIdType + ": " + mapAlta.get(mainIdType);
						if (sponsor != null && !sponsor.equals("SP_DJ") && !sponsor.equals("MANUAL")) {
							mensaje[contOK][1] += " Instrumento: " + instrName;
						}

						mensaje[contOK][0] = "ERROR DE DATOS";
						continue;
					}
				} else {
					contOK++;
				}
			} else {
				maxMensaje = (maxMensaje < contOK) ? contOK : maxMensaje;
				if (mainIdType.equals("ISIN")){
					mensaje[contOK][1] = "El " + mainIdType + ": " + mapAlta.get(mainIdType) + " no tiene el mercado: "+mapAlta.get("MARKET")+" asociado en RDR";
					mensaje[contOK][0] = "ERROR DE DATOS";
					continue;					
				} else {
					mensaje[contOK][1] = "El " + mainIdType + ": " + mapAlta.get(mainIdType) + " no tiene mercado asociado en RDR";
					mensaje[contOK][0] = "ERROR DE DATOS";
					continue;
				}
			}
		} else if (mapAlta.get(mainIdType).isEmpty()){
			maxMensaje = (maxMensaje < contOK) ? contOK : maxMensaje;
			mensaje[contOK][1] = "Componente sin " + mainIdType + ", verificar fichero de entrada";
			mensaje[contOK][0] = "ERROR TÉCNICO RDR";
			if (mapAlta.get(secondaryIdType) != null) {
				mensaje[contOK][1] = mensaje[contOK][1] + ", correspondiente al " + secondaryIdType + ": " + mapAlta.get(secondaryIdType);
			}
			continue;
		} else {
			maxMensaje = (maxMensaje < contOK) ? contOK : maxMensaje;

			mensaje[contOK][1] = "El " + mainIdType + ": " + mapAlta.get(mainIdType) + " no existe en RDR";
			if (sponsor != null && !sponsor.equals("SP_DJ") && !sponsor.equals("MANUAL")) {
				mensaje[contOK][1] += ". Instrumento: " + instrName;
			}
			mensaje[contOK][0] = "ERROR DE DATOS";

			if (mapAlta.get(secondaryIdType) != null) {
				mensaje[contOK][1] = mensaje[contOK][1] + ", correspondiente al " + secondaryIdType + ": " + mapAlta.get(secondaryIdType);
			}
			continue;
		}
		if (data.get("SECLABEL") != null) {
			contOK++;
			if (data.get("SECLABEL_MKT_OID") != null) {
				contOK++;
				if (data.get("SECLABEL_MKT_OID").equals(data.get(mainIdType+"_MKT_OID")) || 
					(data.get("SECLABEL_GRP_NME") != null && data.get(mainIdType+"_GRP_NME") != null && data.get("SECLABEL_GRP_NME").equals(data.get(mainIdType+"_GRP_NME")))) {
					contOK++;
					// cambio temporal para permitir seclabels distintos con mismo mercado
					// if (data.get("SECLABEL_MKT_CNT") > 1) {
						// maxMensaje = (maxMensaje < contOK) ? contOK : maxMensaje;
						// mensaje[contOK][1] = "La emisión con " + mainIdType+ ": " + mapAlta.get(mainIdType) + " tiene más de un Security Label asociado al mismo mercado: "+data.get("SECLABEL_MKT_ID");
						// mensaje[contOK][0] = "ERROR DE DATOS";
						// continue;
					// } else {
						// contOK++;
					// }
				} else {
					maxMensaje = (maxMensaje < contOK) ? contOK : maxMensaje;
						if (mainIdType.equals("ISIN")){
							if (data.get(mainIdType+"_GRP_NME")!=null){
								mensaje[contOK][1] = "No se encuentra un Security Label con el mercado "+data.get(mainIdType+"_MKT_ID")+" o grupo "+data.get(mainIdType+"_GRP_NME")+" para la emisión con " + mainIdType + ": " + mapAlta.get(mainIdType);	
							}else{
								mensaje[contOK][1] = "No se encuentra un Security Label con el mercado "+data.get(mainIdType+"_MKT_ID")+" para la emisión con " + mainIdType + ": " + mapAlta.get(mainIdType);
							}
							
							mensaje[contOK][0] = "ERROR DE DATOS";
							continue;					
						} else {
							if (data.get(mainIdType+"_GRP_NME")!=null){
								mensaje[contOK][1] = "No se encuentra un Security Label con el mercado "+data.get(mainIdType+"_MKT_ID")+" o grupo "+data.get(mainIdType+"_GRP_NME")+" que es el asociado al " + mainIdType + ": " + mapAlta.get(mainIdType);
							}else{
								mensaje[contOK][1] = "No se encuentra un Security Label con el mercado "+data.get(mainIdType+"_MKT_ID")+" que es el asociado al " + mainIdType + ": " + mapAlta.get(mainIdType);
							}
							
							mensaje[contOK][0] = "ERROR DE DATOS";
							continue;
						}				
				}
			} else {
				maxMensaje = (maxMensaje < contOK) ? contOK : maxMensaje;
				mensaje[contOK][1] = "El Security Label de la emisión con " + mainIdType+ ": " + mapAlta.get(mainIdType) + " no tiene mercado asociado";
				mensaje[contOK][0] = "ERROR DE DATOS";
				continue;
			}
		} else {
			maxMensaje = (maxMensaje < contOK) ? contOK : maxMensaje;
			mensaje[contOK][1] = "La emisión con " + mainIdType+ ": " + mapAlta.get(mainIdType) + " no tiene Security Label";
			mensaje[contOK][0] = "ERROR DE DATOS";
			continue;			
		}
		if (data.get("MKIS_MKT_OID") != null && data.get("SECLABEL_MKT_OID").equals(data.get("MKIS_MKT_OID"))) {
			contOK++;
			if (data.get("CURRENCY") != null && data.get("CURRENCY").equalsIgnoreCase(mapAlta.get("CURRENCY"))) {
				contOK++;
				if (data.get("MKT_CURR_CNT") < 2) {
				} else {
					maxMensaje = (maxMensaje < contOK) ? contOK : maxMensaje;
					mensaje[contOK][1] = "La emisión con " + mainIdType+ ": " + mapAlta.get(mainIdType) + " tiene el mercado: "+data.get("SECLABEL_MKT_ID")+" asociado más de una vez con la divisa: "+ data.get("CURRENCY");
					mensaje[contOK][0] = "ERROR DE DATOS";
					continue;
				}
			} else {
				maxMensaje = (maxMensaje < contOK) ? contOK : maxMensaje;
				mensaje[contOK][1] = "La emisión con " + mainIdType+ ": " + mapAlta.get(mainIdType) + " no tiene un mercado asociado con la divisa: "+ mapAlta.get("CURRENCY");
				mensaje[contOK][0] = "ERROR DE DATOS";
				continue;
			}
		} else {
				maxMensaje = (maxMensaje < contOK) ? contOK : maxMensaje;
				mensaje[contOK][1] = "El mercado "+data.get("SECLABEL_MKT_ID")+" del Security Label no existe o no está activo en la emisión con " + mainIdType+ ": " + mapAlta.get(mainIdType);
				mensaje[contOK][0] = "ERROR DE DATOS";
				continue;
		}
		estado="OK";
		break;
	}
} else {
	if (secondaryIdType.equals("")){
		mensaje[contOK][1] = "El " + mainIdType+ ": " + mapAlta.get(mainIdType) + " está duplicado en RDR";
		mensaje[contOK][0] = "ERROR DE DATOS";
	} else  {
		mensaje[contOK][1] = "El " + mainIdType+ ": " + mapAlta.get(mainIdType) + " y el " + secondaryIdType + ": " + mapAlta.get(secondaryIdType) + " no pertenecen a la misma emisión en RDR";
		mensaje[contOK][0] = "ERROR DE DATOS";
	}
}

if (estado.equals("ERROR")) {
	arrayMensaje[0] = mensaje[maxMensaje][0];
	arrayMensaje[1] = mensaje[maxMensaje][1];
	listaErrores.add(arrayMensaje);
}else {
	isidOid = issueData[issueLine].get("ISIDOID");
	instrId = issueData[issueLine].get("INSTR_ID");
	mktIssOid = issueData[issueLine].get("MKTISSOID");
	// cambio temporal para permitir seclabels distintos con mismo mercado
	if (issueData[issueLine].get("SECLABEL_MKT_CNT") > 1) {
		arrayMensaje[0] = "INFO";
		arrayMensaje[1] = "La emisión con " + mainIdType+ ": " + mapAlta.get(mainIdType) + " tiene más de un Security Label asociado al mismo mercado: "+issueData[issueLine].get("SECLABEL_MKT_ID")+" se usa el Security Label: "+issueData[issueLine].get("SECLABEL");
		listaErrores.add(arrayMensaje);
	}
}
Transition=estado;]]></objectValue>
<type>CONSTANT</type>
</item>
