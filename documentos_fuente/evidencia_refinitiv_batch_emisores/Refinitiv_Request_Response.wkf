<parameters id="243" type="java.util.HashSet">
<item id="244" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="245">statements</name>
<objectValue id="246" type="java.lang.String"><![CDATA[import org.apache.log4j.Logger;
import java.io.BufferedReader;
import java.io.File;
import java.io.FileReader;
import java.io.IOException;
import java.util.regex.*;
import javax.xml.parsers.ParserConfigurationException;
import javax.xml.xpath.XPathExpressionException;
import org.xml.sax.SAXException;
import java.text.SimpleDateFormat;
import java.util.Arrays;
import java.util.Date;

SimpleDateFormat formatter = new SimpleDateFormat("yyyyMMdd-HHmmss");  
Date date = new Date();

Logger logger = Logger.getLogger("Refinitiv_Request");
String cmd="";
String env="";
String nivelLog="";
String pathOut="";
String fileOut="";	
String pathpro = "/pr/kytl/online/multipais/multicanal/cfg/entorno/";
String pathpre = "/pp/kytl/online/multipais/multicanal/cfg/entorno/";
String pathint = "/ei/kytl/online/multipais/multicanal/cfg/entorno/";
String pathdev = "/de/kytl/online/multipais/multicanal/cfg/entorno/";
String path = "";
String javahome17 = "";
String linea;
String fich = "";
File folderpro = new File(pathpro);
File folderpre = new File(pathpre);
File folderint = new File(pathint);
File folderdev = new File(pathdev);

if (folderpro.exists()){
	path = pathpro + "credentials.xml";
	env="pr";
	nivelLog ="error";
}else if (folderpre.exists()){
	path = pathpre + "credentials.xml";
	env="pp";
	nivelLog = "info";
}else if (folderint.exists()){
	path = pathint + "credentials.xml";
	env="ei";
	nivelLog = "info";
}else if (folderdev.exists()){
	path = pathdev + "credentials.xml";
	env="de";
	nivelLog = "debug";
}
		
File archivo = new File(path);
FileReader fr = new FileReader(archivo);
BufferedReader br = new BufferedReader(fr);


while ((linea = br.readLine()) != null){
	fich = fich + linea;
}
fr.close();

Pattern patronAux = Pattern.compile("<environment>(.*?)</environment>");
Matcher matchAux = patronAux.matcher(fich);	
if (matchAux.find()) {
	fich = matchAux.group(1);
}

patronAux = Pattern.compile("<javahome17>(.*?)</javahome17>");
matchAux = patronAux.matcher(fich);
if (matchAux.find()) {
	javahome17 = matchAux.group(1);
}
		
String JAR="/"+env+"/kytl/online/multipais/multicanal/jar/";
String JAVA= javahome17 +"bin/java";
String LIB="/"+env+"/kytl/online/multipais/multicanal/lib/";

switch (requestType){
	case "issueRequest":
		if (vreqOid.equals("MULTI_ISSUE")){
			pathOut= "/fichtemcomp/"+env+"/descargas/kytl/issues/Refinitiv/Multi_Request/";
		} 		
		else if (vreqOid.equals("UNDLY_ISSUES_ENRICHMENT")){
			pathOut= "/fichtemcomp/"+env+"/descargas/kytl/issues/Refinitiv/OpcionesFutures/Enrichment/issues/";
		}		
		else if (vreqOid.equals("OPTIONS_FUTURES_ENRICHMENT")){
			pathOut= "/fichtemcomp/"+env+"/descargas/kytl/issues/Refinitiv/OpcionesFutures/Enrichment/optionsfutures/";
		}		
		else {
			pathOut= "/fichtemcomp/"+env+"/descargas/kytl/issues/Refinitiv/";
		}
		fileOut= "RFNT_BBVA_"+id+"_"+formatter.format(date)+".txt";
		fileOut= fileOut.replaceAll("['^']","");
		break;

	case "optionsfuturesRequest":
		if (vreqOid.equals("OPTIONS_FUTURES_ENRICHMENT")){
			pathOut= "/fichtemcomp/"+env+"/descargas/kytl/issues/Refinitiv/OpcionesFutures/Enrichment/optionsfutures/";
		}
	    else{
		   pathOut= "/fichtemcomp/"+env+"/descargas/kytl/issues/Refinitiv/";			
		}
		fileOut= "RFNT_BBVA_"+id+"_"+formatter.format(date)+".txt";
		fileOut= fileOut.replaceAll("['^']","");
		break;
	case "issueSearch":
		pathOut= "/fichtemcomp/"+env+"/descargas/kytl/issues/Refinitiv/";
		fileOut= "RFNT_BBVA_Search_"+id+"_"+formatter.format(date)+".txt";
		fileOut= fileOut.replaceAll("['^']","");
		break;
	case "issuerRequest": case "issuerRequestBE":
		if (vreqOid.equals("BATCH_ISSUER")){
			pathOut= "/fichtemcomp/"+env+"/descargas/kytl/riesgoemisorBatch/Refinitiv/";
		} else {
			pathOut= "/fichtemcomp/"+env+"/descargas/kytl/riesgoemisor/Refinitiv/";
		}
		fileOut= "RFNT_BBVA_"+id+"_"+formatter.format(date)+".txt";
		break;
	case "ratingsRequest": case "ratingsRequestBE":
		pathOut= "/fichtemcomp/"+env+"/descargas/kytl/riesgoemisor/Refinitiv/";
		fileOut= "RFNT_BBVA_"+id+"_"+formatter.format(date)+".txt";
		break;
	default :
		break;
	}

cmd = JAVA+" -Dfile.encoding=UTF8 -Denv="+env+" -cp "+
JAR+"RDR_Refinitiv_Request.jar:"+
LIB+"ojdbc8.jar:"+
LIB+"commons-dbcp-1.4.jar:"+
LIB+"commons-pool-1.5.4.jar:"+
JAR+"ConexionBD.jar:"+
LIB+"log4j.jar:"+
LIB+"gson-2.6.2.jar:"+
LIB+"commons-logging-1.2.jar:"+
LIB+"httpclient-4.5.12.jar:"+
LIB+"httpcore-4.4.13.jar:"+
LIB+"httpcore-nio-4.4.13.jar:"+
JAR+"XMASToken-0.0.1.jar:"+
" com.bbva.kytl.main.Request REFINITIV "
+vreqOid+" "+requestType+" "+env+" "+pathOut+fileOut+" "+nivelLog;

if (requestType.substring(requestType.length()-2, requestType.length()).equals("BE")){
	requestTypeAux=requestType;
	requestType=requestType.substring(0, requestType.length()-2);
}

logger.error("[Refinitiv_Request]: "+ cmd);]]></objectValue>
<type>CONSTANT</type>
</item>
