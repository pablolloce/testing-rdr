<source id="1601">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="1602">Loop alta/baja</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="1603">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="1604" type="java.util.HashSet">
