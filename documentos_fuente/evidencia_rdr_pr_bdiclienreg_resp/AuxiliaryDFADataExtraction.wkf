<item id="143" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="144">querySQL</name>
<stringValue id="145">SELECT GU_ID COUNGUAR
FROM FT_T_FIGU
WHERE FINS_GU_PURP_TYP = 'COUNGUAR'
AND DATA_STAT_TYP = 'ACTIVE'
AND END_TMS IS NULL
AND INST_MNEM IN (SELECT PRNT_INST_MNEM 
                    FROM FT_T_FIRL FIRL, FT_T_FIST FIST
                    WHERE FIRL.REL_TYP = 'OPERATIVE'
                    AND FIRL.INST_MNEM = FIST.INST_MNEM
                    AND FIST.STAT_CHAR_VAL_TXT = TRIM(FIRL.FINSRL_TYP)
                    AND FIST.STAT_DEF_ID = 'MAINROL'
                    AND FIRL.INST_MNEM = :cntrprtyOperativeOid)</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
