<name id="58">Componer mapa de Datos Regulatorios</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="59">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="60" type="java.util.HashSet">
<item id="61" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="62">statements</name>
<stringValue id="63"><![CDATA[import org.apache.commons.lang.StringUtils;

//Declaracion de variables
String manEmir = "";
String emir = "";
String finalEmir = "";

// Manual Counterparty type under EMIR
if (manualEmir != null && manualEmir.length > 0) 
{
	if (manualEmir[0].get("VALOR").equals("09")){
		manEmir = "03";
	} else {
		manEmir = manualEmir[0].get("VALOR");
	}

}else
{
	manEmir = "NE";
}

//Counterparty type under EMIR

if (cntrprtyTypeUnderEMIR != null && cntrprtyTypeUnderEMIR.length > 0) 
{
	emir = cntrprtyTypeUnderEMIR[0].get("ETIQUETA");
}else
{
	emir = "NE";
}

if(!manEmir.equals("NE"))
{
	finalEmir = manEmir;

}else if (!emir.equals("NE"))
{
	finalEmir = emir;
}else
{
	finalEmir = "NE";
}]]></stringValue>
<type>CONSTANT</type>
</item>
