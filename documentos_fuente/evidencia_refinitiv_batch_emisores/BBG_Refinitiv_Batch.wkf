<item id="185" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="186">querySQL</name>
<objectValue id="187" type="java.lang.String"><![CDATA[select firt_bb.inst_mnem, firt_bb.fins_rtng_oid fins_rtng_oid_bb, rtng_bb.rtng_set_mnem rtng_set_mnem_bb, firt_bb.rtng_set_oid rtng_set_oid_bb, firt_bb.rtng_value_oid rtng_value_oid_bb, firt_bb.rtng_cde rtng_cde_bb, 
firt_ofi.fins_rtng_oid fins_rtng_oid_ofi, rtng_ofi.rtng_set_mnem rtng_set_mnem_ofi, firt_ofi.rtng_set_oid rtng_set_oid_ofi, firt_ofi.rtng_value_oid rtng_value_oid_ofi, firt_ofi.rtng_cde rtng_cde_ofi, 
rtvl_map.rtng_value_oid  rtng_value_oid_map, rtvl_map.rtng_cde rtng_cde_map, 'ACTIVE' data_stat_typ_map 
from ft_t_firt firt_bb, FT_T_RTNG rtng_bb, ft_t_firt firt_ofi, FT_T_RTNG rtng_ofi, ft_t_rvxr rvxr, FT_T_RTVL rtvl_map 
where firt_bb.rtng_set_oid = rtng_bb.rtng_set_oid 
and rtng_bb.RTNG_SET_MNEM = 'BBGSPLT' 
and firt_ofi.rtng_set_oid = rtng_ofi.rtng_set_oid 
and rtng_ofi.RTNG_SET_MNEM = 'SPRLOTRT' 
and ( firt_ofi.data_stat_typ = 'ACTIVE' or firt_ofi.data_stat_typ is null or (firt_ofi.data_stat_typ = 'INACTIVE' and firt_ofi.rtng_cde = 'PENDING' ) ) 
and firt_bb.inst_mnem = firt_ofi.inst_mnem 
and rvxr.rld_rtng_value_oid = firt_bb.rtng_value_oid 
and ( rvxr.data_stat_typ = 'ACTIVE' or rvxr.data_stat_typ is null ) 
and ( rvxr.end_tms is null or rvxr.end_tms > sysdate ) 
and rtvl_map.rtng_value_oid = rvxr.rtng_value_oid 
and rtvl_map.rtng_set_oid = firt_ofi.rtng_set_oid 
and ( rtvl_map.data_stat_typ = 'ACTIVE' or rtvl_map.data_stat_typ is null ) 
and rtvl_map.rtng_value_oid <> firt_ofi.rtng_value_oid 
union all 
select firt_bb.inst_mnem, firt_bb.fins_rtng_oid fins_rtng_oid_bb, rtng_bb.rtng_set_mnem rtng_set_mnem_bb, firt_bb.rtng_set_oid rtng_set_oid_bb, firt_bb.rtng_value_oid rtng_value_oid_bb, firt_bb.rtng_cde rtng_cde_bb, 
firt_ofi.fins_rtng_oid fins_rtng_oid_ofi, rtng_ofi.rtng_set_mnem rtng_set_mnem_ofi, firt_ofi.rtng_set_oid rtng_set_oid_ofi, firt_ofi.rtng_value_oid rtng_value_oid_ofi, firt_ofi.rtng_cde rtng_cde_ofi, 
rtvl_map.rtng_value_oid  rtng_value_oid_map, rtvl_map.rtng_cde rtng_cde_map, 'ACTIVE' data_stat_typ_map 
from ft_t_firt firt_bb, FT_T_RTNG rtng_bb, ft_t_firt firt_ofi, FT_T_RTNG rtng_ofi, ft_t_rvxr rvxr, FT_T_RTVL rtvl_map 
where firt_bb.rtng_set_oid = rtng_bb.rtng_set_oid 
and rtng_bb.RTNG_SET_MNEM = 'RFSPLTLO' 
and firt_ofi.rtng_set_oid = rtng_ofi.rtng_set_oid 
and rtng_ofi.RTNG_SET_MNEM = 'SPRLTRTL' 
and ( firt_ofi.data_stat_typ = 'ACTIVE' or firt_ofi.data_stat_typ is null or (firt_ofi.data_stat_typ = 'INACTIVE' and firt_ofi.rtng_cde = 'PENDING' ) ) 
and firt_bb.inst_mnem = firt_ofi.inst_mnem 
and rvxr.rld_rtng_value_oid = firt_bb.rtng_value_oid 
and ( rvxr.data_stat_typ = 'ACTIVE' or rvxr.data_stat_typ is null ) 
and ( rvxr.end_tms is null or rvxr.end_tms > sysdate ) 
and rtvl_map.rtng_value_oid = rvxr.rtng_value_oid 
and rtvl_map.rtng_set_oid = firt_ofi.rtng_set_oid 
and ( rtvl_map.data_stat_typ = 'ACTIVE' or rtvl_map.data_stat_typ is null ) 
and rtvl_map.rtng_value_oid <> firt_ofi.rtng_value_oid 
union all 
select firt_bb.inst_mnem, firt_bb.fins_rtng_oid fins_rtng_oid_bb, rtng_bb.rtng_set_mnem rtng_set_mnem_bb, firt_bb.rtng_set_oid rtng_set_oid_bb, firt_bb.rtng_value_oid rtng_value_oid_bb, firt_bb.rtng_cde rtng_cde_bb, 
firt_ofi.fins_rtng_oid fins_rtng_oid_ofi, rtng_ofi.rtng_set_mnem rtng_set_mnem_ofi, firt_ofi.rtng_set_oid rtng_set_oid_ofi, firt_ofi.rtng_value_oid rtng_value_oid_ofi, firt_ofi.rtng_cde rtng_cde_ofi, 
rtvl_map.rtng_value_oid  rtng_value_oid_map, rtvl_map.rtng_cde rtng_cde_map, 'ACTIVE' data_stat_typ_map 
from ft_t_firt firt_bb, FT_T_RTNG rtng_bb, ft_t_firt firt_ofi, FT_T_RTNG rtng_ofi, ft_t_rvxr rvxr, FT_T_RTVL rtvl_map 
where firt_bb.rtng_set_oid = rtng_bb.rtng_set_oid 
and rtng_bb.RTNG_SET_MNEM = 'BBGMODLT' 
and firt_ofi.rtng_set_oid = rtng_ofi.rtng_set_oid 
and rtng_ofi.RTNG_SET_MNEM = 'MODLOTRT' 
and ( firt_ofi.data_stat_typ = 'ACTIVE' or firt_ofi.data_stat_typ is null or ( firt_ofi.data_stat_typ = 'INACTIVE' and firt_ofi.rtng_cde = 'PENDING' ) ) 
and firt_bb.inst_mnem = firt_ofi.inst_mnem and rvxr.rld_rtng_value_oid = firt_bb.rtng_value_oid and ( rvxr.data_stat_typ = 'ACTIVE' or rvxr.data_stat_typ is null ) 
