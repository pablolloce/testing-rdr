<name id="222">querySQL</name>
<stringValue id="223">UPDATE FT_T_FRA1
SET CLSF_OID = (SELECT CLSF_OID FROM FT_T_INCL WHERE INDUS_CL_SET_ID = 'DFACAT' AND CL_VALUE = :value), CL_VALUE = :value, LAST_CHG_TMS = sysdate, DATA_STAT_TYP = 'ACTIVE',
REG1_OID = (SELECT REG1_OID FROM FT_T_REG1 WHERE REG_NME = 'DFA')
WHERE INST_MNEM = :contrprtyGlobalOid
AND CLSF_OID IN (SELECT CLSF_OID FROM FT_T_INCL WHERE INDUS_CL_SET_ID = 'DFACAT')</stringValue>
<type>CONSTANT</type>
</item>
