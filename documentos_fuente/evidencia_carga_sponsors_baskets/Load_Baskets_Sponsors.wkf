<name id="2209">querySQL</name>
<stringValue id="2210">INSERT INTO "KYTL_GC"."FT_T_ISGP" (PRNT_ISS_GRP_OID, START_TMS, INSTR_ID, LAST_CHG_TMS, LAST_CHG_USR_ID, PRT_PURP_TYP, PRT_DESC, DATA_STAT_TYP, DATA_SRC_ID,  ISID_OID, MKT_ISS_OID, ISGP_OID)
VALUES (:1, sysdate, :2, sysdate, :3, 'COMPNENT', '0', 'ACTIVE', 'RDR', :4, :5, new_oid)</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
