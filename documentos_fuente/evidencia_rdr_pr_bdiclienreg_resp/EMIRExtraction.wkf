<item id="124" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="125">querySQL</name>
<stringValue id="126">SELECT NVL(CL_VALUE,' ') CODINSTI
FROM FT_T_FRCL
WHERE INST_MNEM IN (SELECT FIRLO.INST_MNEM 
                      FROM FT_T_FIRL FIRLO, FT_T_FIST FISTO, FT_T_FINS FINS
                      WHERE FIRLO.PRNT_INST_MNEM IN (SELECT FIRLG.INST_MNEM
                                                FROM FT_T_FIRL FIRLG
                                                WHERE FIRLG.PRNT_INST_MNEM = :mnem
                                                AND FIRLG.REL_TYP = 'LOCAL')
                      AND TRIM(FIRLO.FINSRL_TYP) = TRIM(FISTO.STAT_CHAR_VAL_TXT)
                      AND FIRLO.INST_MNEM = FISTO.INST_MNEM
                      AND FIRLO.INST_MNEM = FINS.INST_MNEM
                      AND FINS.subsidiary_ind = 'N')
AND CLSF_OID IN (SELECT CLSF_OID FROM FT_T_INCL WHERE INDUS_CL_SET_ID = 'CODINSTI')</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
