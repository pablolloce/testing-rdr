<item id="103" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="104">statements</name>
<stringValue id="105"><![CDATA[//import org.apache.log4j.Logger;
//Logger logger = Logger.getLogger("Enriquecimiento");

String query = "Insert into FT_T_FRCL (FINR_CLSF_OID,INST_MNEM,FINSRL_TYP,INDUS_CL_SET_ID,CLSF_OID,CL_VALUE,CLSF_PURP_TYP,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,DATA_STAT_TYP,DATA_SRC_ID,EINC_OID, FINR_OID) \r\n" + 
		"values (new_oid,'"+mnemLocal+"','CUSTOMER','VIPCLNT',(select CLSF_OID from ft_t_incl where cl_value = '"+VIP_CL_IND+"' and indus_cl_set_id = 'VIPCLNT' and data_stat_typ = 'ACTIVE'),'"+VIP_CL_IND+"',null,sysdate,null,sysdate,'RDR','ACTIVE','BDI',null, (SELECT FINR_OID FROM FT_T_FINR WHERE DATA_STAT_TYP = 'ACTIVE' AND FINSRL_TYP = 'CUSTOMER' AND INST_MNEM = '"+mnemLocal+"' AND ROWNUM < 2))";
		
//logger.error("VIP_CL_IND query: "+ query);
]]></stringValue>
<type>CONSTANT</type>
</item>
