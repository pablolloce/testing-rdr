<item id="80" type="com.j2fe.workflow.definition.Transition">
<name id="81">goto-next</name>
<source id="82">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="83">XML_ALTA_ROL</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="84">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="85" type="java.util.HashSet">
<item id="86" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="87">statements</name>
<objectValue id="88" type="java.lang.String"><![CDATA[String org = ORG_ID;
if (org == null) org = "";
org = org.trim();
if (org.equalsIgnoreCase("n.a") || org.equalsIgnoreCase("na") || org.equalsIgnoreCase("n/a")
 || org.equalsIgnoreCase("null") || org.equalsIgnoreCase("void") || org.equals("-")) org = "";

String lei = LEI;
if (lei == null) lei = "";
lei = lei.trim();

String fins = FINS_ID;
if (fins == null) fins = "";
fins = fins.trim();

String req = String.valueOf(System.currentTimeMillis());

String XML_ALTA_ROL =
    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" +
    "<PtyDetlListUpd ReqID=\"" + req + "\" SvcID=\"ISSUER\">" +
        "<PtyDetlUpd ListUpdActn=\"A\">" +
            "<PtyDetl ID=\"" + fins + "\" R=\"CHILD\" src=\"ASSET\">" +
                "<RolDetl R=\"CPARTY\"><AltPty><ID>" + org + "</ID><Typ>ORG_ID</Typ></AltPty></RolDetl>" +
                "<RolDetl R=\"CPARTY\"><AltPty><ID></ID><Typ>BBGCID</Typ></AltPty></RolDetl>" +
                "<RolDetl R=\"CPARTY\"><AltPty><ID>" + lei + "</ID><Typ>LEIID</Typ></AltPty></RolDetl>" +
            "</PtyDetl>" +
        "</PtyDetlUpd>" +
    "</PtyDetlListUpd>";]]></objectValue>
<type>CONSTANT</type>
</item>
