(SELECT REG1_OID FROM REGULATORY_INFO WHERE DATA_STAT_TYP = 'ACTIVE' AND END_TMS IS NULL AND REG_NME = 'EMIR'), 
(SELECT CLSF_OID FROM FT_T_INCL WHERE DATA_STAT_TYP = 'ACTIVE' AND END_TMS IS NULL AND CL_VALUE = ? AND INDUS_CL_SET_ID = 'EMIRREPDEL'), 
?,sysdate,'BBVA:CUSTOMER','RDR','ACTIVE',sysdate,'0182')</stringValue>
