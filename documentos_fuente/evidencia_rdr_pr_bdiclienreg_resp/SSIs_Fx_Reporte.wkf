<item id="754" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="755">statements</name>
<objectValue id="756" type="java.lang.String">import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("SSIs_Fx_Reporte");

String Data = "";
String Data2="";
if(Modo.equals("Conciliacion")){
	Data="ALERT_CON_SSI";
	Data2="CONCILIACION";
}else{
	Data="ALERT_IP_SSI";
	Data2="ONLINE";
}

if(Message.contains("NoCodOid::")){
String FinsIDF = "0";
String FinsIDG = "0";
if (FinsIDFond.length>0) { 
FinsIDF = FinsIDFond[0].get("FINS_ID");
}
if (FinsIDGest.length>0) {
FinsIDG =FinsIDGest[0].get("FINS_ID");
}
	Message = Message.replace("NoCodOid::", "");
	Query = "Insert into FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,RLT_DIF_STAT,RLT_DIF_ACC,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID) values (new_oid,null,null,'1',null,null,'FAILED','"+Message+"','"+Data2+"','"+FinsIDF+"','"+Data+"',null,'ALTA','"+FinsIDG+"','"+CodOid+"','"+Acronym+"','"+Access+"',sysdate,null,sysdate,'CARGA_FX_ALERTMIRR')";
QueryVREQ="Insert into FT_T_VREQ (VND_RQST_OID,VND_RQSTR_ID,VND_RQST_ACTION_TYP,VND_RQST_TMS,VND_RQST_TYP,DATA_SRC_ID,VND_RQST_XREF_TBL_TYP,VND_RQST_XREF_ID_CTXT_TYP,VND_RQST_XREF_ID,VND_RQST_STAT_TYP,VND_RQST_STAT_TXT,VND_RQST_CORR_ID,LAST_CHG_TMS,LAST_CHG_USR_ID,TRN_ID,USR_RQST_ID,PHYSICAL_RQST_IND,VENDOR_ID,VND_RQST_DATA_TYP,BASIC_VND_RQST_OID,VND_RESP_FILE_NME,MSG_CNT,VND_SRVC_NME,VND_CHAIN_RQST_IND,VND_RQST_FILE_NME,PRNT_VND_RQST_OID,VND_RESP_FILE_CORR_TXT,MSTP_OID,VRSC_OID,VENDOR_DATA_OID) values (new_oid,'"+Acronym+"','"+FinsIDG+"',sysdate,'"+FinsIDF+"','"+Data+"',null,'"+Access+"','"+CodOid+"','FAILED','"+Message+"',null,sysdate,'CARGA_FX_ALERTMIRR',null,null,'1',null,'"+Data2+"',null,null,null,null,null,null,null,null,null,null,null)";
}else{
	CodOid = "ERR-001";
	Query = "Insert into FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,RLT_DIF_STAT,RLT_DIF_ACC,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID) values (new_oid,null,null,'1',null,null,'FAILED','"+Message+"','"+Data2+"','"+CodOid+"','"+Data+"',null,'ALTA','"+CodOid+"','"+CodOid+"','"+CodOid+"','"+CodOid+"',sysdate,null,sysdate,'CARGA_FX_ALERTMIRR')";
QueryVREQ="Insert into FT_T_VREQ (VND_RQST_OID,VND_RQSTR_ID,VND_RQST_ACTION_TYP,VND_RQST_TMS,VND_RQST_TYP,DATA_SRC_ID,VND_RQST_XREF_TBL_TYP,VND_RQST_XREF_ID_CTXT_TYP,VND_RQST_XREF_ID,VND_RQST_STAT_TYP,VND_RQST_STAT_TXT,VND_RQST_CORR_ID,LAST_CHG_TMS,LAST_CHG_USR_ID,TRN_ID,USR_RQST_ID,PHYSICAL_RQST_IND,VENDOR_ID,VND_RQST_DATA_TYP,BASIC_VND_RQST_OID,VND_RESP_FILE_NME,MSG_CNT,VND_SRVC_NME,VND_CHAIN_RQST_IND,VND_RQST_FILE_NME,PRNT_VND_RQST_OID,VND_RESP_FILE_CORR_TXT,MSTP_OID,VRSC_OID,VENDOR_DATA_OID) values (new_oid,'"+CodOid+"','"+CodOid+"',sysdate,'"+CodOid+"','"+Data+"',null,'"+CodOid+"','"+CodOid+"','FAILED','"+Message+"',null,sysdate,'CARGA_FX_ALERTMIRR',null,null,'1',null,'"+Data2+"',null,null,null,null,null,null,null,null,null,null,null)";
}


logger.error(Message);
</objectValue>
<type>CONSTANT</type>
</item>
