<name id="59">statements</name>
<stringValue id="60">String body ="";
String subject = "";
String listAlerts = "";

for (Map map: alerts){
		listAlerts = listAlerts +  map.get("MENSAJE") + "\r\n\r\n";
}

subject = "Recarga del índice en RDR: " + indexId + " fallida";

body = "El índice: "+indexId+" no se ha cargado correctamente en RDR.\r\n\r\nSe han encontrado los siguientes errores:\r\n\r\n" + listAlerts;</stringValue>
<type>CONSTANT</type>
</item>
