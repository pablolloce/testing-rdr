<directJoin>false</directJoin>
<name id="260">Crea Msg CONS CLI</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="261">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="262" type="java.util.HashSet">
<item id="263" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="264">statements</name>
<objectValue id="265" type="java.lang.String"><![CDATA[// Mensaje de CONSULTA
import org.apache.commons.lang.StringUtils;
import java.text.SimpleDateFormat;
import java.util.Date;

//Formateador del CCLIEN
if (CCLIEN!=null)
{
	CCLIEN = ("000000000" + CCLIEN).substring(CCLIEN.length());
}

Date ahora = new Date();
SimpleDateFormat formateador = new SimpleDateFormat("yyMMddHHmmssSSS");
String fecha = formateador.format(ahora);
String msgeId = "";
if (newOid!=null && newOid.length>0){
	msgeId = "C" + newOid[0].get("NEWOID") + fecha.substring(4,8) + "XCLICONS";
} else {
	msgeId = "C" + fecha.substring(0,14) + "XCLICONS";
}
String MSG_ID= msgeId.substring(5,15);
StringBuilder messageCLI = new StringBuilder(msgeId);
String [] values = {CCLIEN,ENT,PAISO,NAME,IDFISCAL,MIDNAME,LASTNAME};
int [] longs = {9,4,2,80,25,20,20};
int i = 0;

for ( i = 0 ; i < values.length ; i++)
{
	if (values[i] != null)
	{
		messageCLI.append(StringUtils.rightPad(values[i],longs[i]));
	}
	else
	{
		messageCLI.append(StringUtils.rightPad(" ",longs[i]));
	}
}

String message = messageCLI.toString();]]></objectValue>
<type>CONSTANT</type>
</item>
