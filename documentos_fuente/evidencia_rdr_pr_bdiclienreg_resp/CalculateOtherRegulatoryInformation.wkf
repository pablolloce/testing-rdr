<item id="68" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="69">statements</name>
<objectValue id="70" type="java.lang.String">//Declaracion de variables
Map valores = new HashMap();
//Declaracion de variables
Map dataMap = new HashMap();
String rolin = cftcMap.get("WE-COD-ROLIN");
String rolcrsec = secMap.get("WE-COD-ROLCRSEC");
ArrayList tags = new ArrayList();

if(!cftcMap.containsKey("WE-COD-ROLCR"))
{
	tags.add("RR_CRD");
	dataMap.put("RR_CRD",cftcMap.get("WE-COD-ROLIN"));
	cftcMap.put("WE-COD-ROLCR",cftcMap.get("WE-COD-ROLIN"));	
}
if(!cftcMap.containsKey("WE-COD-ROLCO"))
{
	tags.add("RR_COM");	
	dataMap.put("RR_COM",cftcMap.get("WE-COD-ROLIN"));
	cftcMap.put("WE-COD-ROLCO",cftcMap.get("WE-COD-ROLIN"));
}
if(!cftcMap.containsKey("WE-COD-ROLEQ"))
{
	tags.add("RR_EQD");	
	dataMap.put("RR_EQD",cftcMap.get("WE-COD-ROLIN"));
	cftcMap.put("WE-COD-ROLEQ",cftcMap.get("WE-COD-ROLIN"));
}
if(!cftcMap.containsKey("WE-COD-ROLFX"))
{
	tags.add("RR_FX");
	dataMap.put("RR_FX",cftcMap.get("WE-COD-ROLIN"));
	cftcMap.put("WE-COD-ROLFX",cftcMap.get("WE-COD-ROLIN"));
}
if(!secMap.containsKey("WE-COD-ROLEQSEC"))
{
	secMap.put("WE-COD-ROLEQSEC",secMap.get("WE-COD-ROLCRSEC"));
}</objectValue>
<type>CONSTANT</type>
</item>
