<item id="1388" type="com.j2fe.workflow.definition.Transition">
<name id="1389">OK</name>
<source id="1390">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="1391">MIC</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="1392">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="1393" type="java.util.HashSet">
<item id="1394" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="1395">statements</name>
<stringValue id="1396"><![CDATA[//import org.apache.log4j.Logger;
//Logger logger = Logger.getLogger("Load_Baskets_Sponsors");
//logger.error("text");

String accion ="OK";
String mensaje = "";
String market = "";
String tipoMensaje = "";
String mainId = "";
String[] arrayMensaje = new String[2]; 
//cada inputComponentNode es un elemento del XML de entrada sobre el cual se hace el loop
//Verificamos que el main id type venga con valor

mainId = inputComponentNode.getElementsByTagName(mainIdType).item(0).getTextContent();
market=inputComponentNode.getElementsByTagName("EXCHANGE").item(0).getTextContent();

if (mic != null && !mic.equals("")) {

}else{
	accion="ERROR";
	mensaje="No se encuentra traducción en RDR para el mercado de "+sponsor+": "+market+" para el ISIN: "+mainId;
	tipoMensaje = "ERROR TÉCNICO RDR";
	arrayMensaje[0] = tipoMensaje;
	arrayMensaje[1] = mensaje;
	listaErrores.add(arrayMensaje);
}
Transition=accion;]]></stringValue>
<type>CONSTANT</type>
</item>
<item id="1397" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="1398">["accion"]@java/lang/String@</UITypeHint>
<input>false</input>
<name id="1399">variables["accion"]</name>
<stringValue id="1400">accion</stringValue>
<type>VARIABLE</type>
</item>
<item id="1401" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="1402">variables["inputComponentNode"]</name>
<stringValue id="1403">IncrementedObjects</stringValue>
<type>VARIABLE</type>
<variablePart id="1404">[0]</variablePart>
</item>
<item id="1405" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
