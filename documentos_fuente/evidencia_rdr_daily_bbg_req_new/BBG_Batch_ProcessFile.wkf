<name id="119">Parse lineResponse</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="120">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="121" type="java.util.HashSet">
<item id="122" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="123">statements</name>
<objectValue id="124" type="java.lang.String"><![CDATA[import java.io.BufferedReader;
import java.io.File;
import java.io.FileReader;
import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.Calendar;

import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("BBG_Batch_Response: SplitLine");
int contIssuers = 0;
String lineAux2="";
String[] datos = lineResponse.split("\\|");
String bbgId=datos[0].trim();
String ErrorCode = datos[1].trim();
String sector=datos[6].trim();
String group=datos[7].trim();
String subgroup=datos[62].trim();

String Debt = new String();

if ( datos[8].equals("N.A.") ||  datos[8].equals("N.S.")) 
{
	Debt="";
}
else if (datos[8].split(" ").length>1)
{
	Debt =  datos[8].split(" ")[0].replace('.',',');
}
else if (datos[8].equals(" "))
{
	Debt = "0";
}
else
{
	Debt = datos[8].trim();
}

if ( sector.equals("N.A.") ||  sector.equals("N.S.")) 
{
	sector="";
}

if ( group.equals("N.A.") ||  group.equals("N.S.")) 
{
	group="";
}

if ( subgroup.equals("N.A.") ||  subgroup.equals("N.S.")) 
{
	subgroup="";
}







if(datos[14].equals(" ") || datos[14].equals(null) ||  datos[14].equals("N.A.") ){
	for(int i=16; i<=32; i=i+2 ){
		datos[14]=datos[i];
		datos[15]=datos[i+1];
		if(!datos[14].equals(" ") && !datos[14].equals(null) &&  !datos[14].equals("N.A.") ){
			break;
		}
		if(i==32 && (datos[i].equals(" ") || datos[i].equals(null) ||  datos[i].equals("N.A.")) ){
			datos[14]="N.A.";
			break;
		}
	}
}

if(datos[34].equals(" ") || datos[34].equals(null) || datos[34].equals("N.A.")){

	for(int i=36; i<=54; i=i+2){
		datos[34]=datos[i];
		datos[35]=datos[i+1];
		if(!datos[34].equals(" ") && !datos[34].equals(null) && !datos[34].equals("N.A.") ){
			break;
		}
		if(i==54 && (datos[i].equals(" ") || datos[i].equals(null) || datos[i].equals("N.A.")) ){
			datos[34]="N.A.";
			break;
		}
	}
}

if(datos[10].equals(" ") || datos[10].equals(null) ||  datos[10].equals("N.A.")){
		int i=12;
		datos[10]=datos[i];
		datos[11]=datos[i+1];
		
		if(i==12 && (datos[i].equals(" ")  || datos[i].equals(null) ||  datos[i].equals("N.A.")) ){
			datos[10]="N.A.";
		}
}

if(datos[56].equals(" ") || datos[56].equals(null) ||  datos[56].equals("N.A.")){
		int i=58;
		datos[56]=datos[i];
		datos[57]=datos[i+1];
		
		if(i==58 && (datos[i].equals(" ")  || datos[i].equals(null) ||  datos[i].equals("N.A.")) ){
			datos[56]="N.A.";
		}
}

if(datos[60].equals(" ")  || datos[60].equals(null) ||  datos[60].equals("N.A.") ){
			datos[60]="N.A.";			
}

if (datos[15].equals(" ") ||  datos[15].equals(null)   ||  datos[15].equals("N.A.")  ||  datos[15].equals("N.S.") ){
	datos[15]="";
}

if (datos[35].equals(" ") ||  datos[35].equals(null)   ||  datos[35].equals("N.A.")  ||  datos[35].equals("N.S.") ){
	datos[35]=" ";
}

if (datos[11].equals(" ") ||  datos[11].equals(null)   ||  datos[11].equals("N.A.")  ||  datos[11].equals("N.S.") ){
	datos[11]="";
}


if (datos[57].equals(" ") ||  datos[57].equals(null)   ||  datos[57].equals("N.A.")  ||  datos[57].equals("N.S.") ){
	datos[57]=" ";
}

if (datos[61].equals(" ") ||  datos[61].equals(null)   ||  datos[61].equals("N.A.")  ||  datos[61].equals("N.S.") ){
	datos[61]="";
}



String lineAux=bbgId+"|"+ErrorCode+"|"+sector +"|"+ group +"|"+subgroup+"|"+Debt+"|"+datos[10].trim()+"|"+datos[11].trim()+"|"+datos[14].trim()+"|"+datos[15].trim()+"|"+datos[34].trim()+"|"+datos[35].trim()+"|"+datos[56].trim()+"|"+datos[57].trim()+"|"+datos[60].trim()+"|"+datos[61].trim()+"|";]]></objectValue>
<type>CONSTANT</type>
</item>
