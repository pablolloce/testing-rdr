<stringValue id="1576">String[] componentsArray = componentsMap.keySet().toArray(new String[componentsMap.size()]);

for (String issue : componentsArray){
	if (componentsMap.get(issue).containsKey("accion")) {
		componentsIsgpMap.put(issue,componentsMap.get(issue).get("ISGPOID"));
	}
}</stringValue>
<type>CONSTANT</type>
