<item id="501" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="502">querySQL</name>
<stringValue id="503">select FIIDGEST.FINS_ID AS FINS_ID FROM FT_T_FIGP FIGPFUND, FT_T_FiGP FIGPGEST, FT_T_FIID FIIDGEST, FT_T_FrID FRIDACRO, FT_T_FRId FRIDACC 
where FIGPFUND.INST_MNEM = FRIDACC.INST_MNEM AND FIGPFUND.PRNT_FINS_GRP_OID = FIGPGEST.PRNT_FINS_GRP_OID 
AND FIGPGEST.PRT_PURP_TYP = 'FUNDMNGR' AND FIIDGEST.INST_MNEM = FIGPGEST.INST_MNEM AND FIIDGEST.FINS_ID_CTXT_TYP = 'FINSID'
AND FRIDACC.FINSRL_ID_CTXT_TYP = 'ACCDE' AND FRIDACRO.FINSRL_ID_CTXT_TYP = 'ALERTID' AND FRIDACRO.INST_MNEM = FRIDACC.INST_MNEM AND FRIDACC.FINR_ID = ? AND FRIDACRO.FINR_ID=?
</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
