<name id="298">Set Variables</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="299">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="300" type="java.util.HashSet">
<item id="301" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="302">statements</name>
<objectValue id="303" type="java.lang.String"><![CDATA[import java.util.Date;
import java.util.Calendar;
import java.text.SimpleDateFormat;
import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("BBG_Refinitiv_Batch");

Date date = Calendar.getInstance().getTime();
SimpleDateFormat sdf = new SimpleDateFormat("MM_dd_yyyy");

String env = "no";
File f1 = new File("/fichtemcomp/de/descargas/kytl/riesgoemisorBatch");	
	if ( f1.canWrite() ) {
		if (f1.exists() && f1.isDirectory()) {
			env = "de";
		}		
	}
File f2 = new File("/fichtemcomp/ei/descargas/kytl/riesgoemisorBatch");	
	if ( f2.canWrite() ) {
		if (f2.exists() && f2.isDirectory()) {
			env = "ei";
		}		
	}
File f3 = new File("/fichtemcomp/pp/descargas/kytl/riesgoemisorBatch");	
	if ( f3.canWrite() ) {
		if (f3.exists() && f3.isDirectory()) {
			env = "pp";
		}		
	}
File f4 = new File("/fichtemcomp/pr/descargas/kytl/riesgoemisorBatch");	
	if ( f4.canWrite() ) {
		if (f4.exists() && f4.isDirectory()) {
			env = "pr";
		}		
	}

String pathBatch = "/fichtemcomp/" + env + "/descargas/kytl/riesgoemisorBatch/Backup/";

String fileNameUser =  "BBG_Refinitiv_loadRating_failures_toUser_".concat(sdf.format(date)).concat(".csv");
String fileNameANS =  "BBG_Refinitiv_loadRating_failures_toANS_".concat(sdf.format(date)).concat(".csv");
String bodyMsg="Please, find attached a report with the errors found in BBG and Refinitiv Batch proccess.";
String subject="Bloomberg and Refinitiv load ratings failures ".concat(sdf.format(date));
String errorTypeANS="ANS_ERROR_LOAD_BBG_ISSUERS_RATING";
String errorTypeUser="USER_ERROR_LOAD_BBG_ISSUERS_RATING";

int counterIsin=0;]]></objectValue>
<type>CONSTANT</type>
</item>
