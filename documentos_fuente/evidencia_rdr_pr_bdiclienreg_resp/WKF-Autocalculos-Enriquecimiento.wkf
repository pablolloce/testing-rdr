//Logger logger = Logger.getLogger("Enriquecimiento");

String query = "Insert into FT_T_FIST (STAT_ID,STAT_DEF_ID,INST_MNEM,DENOM_CURR_CDE,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,STAT_VAL_DTE,STAT_VAL_TMS,STAT_INT_VAL_NUM,STAT_CHAR_VAL_TXT,DATA_STAT_TYP,DATA_SRC_ID,STAT_VAL_CAMT) \r\n" + 
				"values (new_oid,'FXRELF','"+mnemOperativo+"',null,sysdate,null,sysdate,'FXFUNDS',null,null,null,'"+FXRELFUND+"','ACTIVE','RDR',null)";
		
//logger.error("VIP_CL_IND query: "+ query);
</stringValue>
<type>CONSTANT</type>
