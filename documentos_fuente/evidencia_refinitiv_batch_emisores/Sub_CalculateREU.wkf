<directJoin>false</directJoin>
<name id="2293">Calculo REU Local</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="2294">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="2295" type="java.util.HashSet">
<item id="2296" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="2297">statements</name>
<objectValue id="2298" type="java.lang.String"><![CDATA[java.util.Arrays;

import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("Sub_CalculateREU");
logger.error(" ------------------------------------------------------------------- Dentro de Sub_CalculateREU_LOCAL");

String hayTresRtngIgualesL = "N";
String losTresSonDistintosL= "N";
String hayDosMejoresRtngIgualesL = "N";
String hayDosPeoresRtngIgualesL = "N";

String mejorRtngL = "";
String peorRtngL = "";

int intNumRtngInformadosL = 0;
String numRtngInformadosL = ""; //Si hay 1, 2 o 3 rating informados por Refinitiv distintos a N.A.
String mejorREUL = "";
String segundoMejorREUL = "";
String segundoMejorREUGradoL = "";
String segundoMejorREUratingL = "";

String valueL = "";
int conteoMejorRtngL = 0;
int conteoPeorRtngL = 0;
int sumaTresRatingL = 0;
double mediaL = 0;

int[] gradosL;

//Revisamos cuantos ratings han sido informados por Refinitiv
if ( SPRtngCodeL != null && !"".equals(SPRtngCodeL) && !"No disp.".equals(SPRtngCodeL) ){ 
	intNumRtngInformadosL = intNumRtngInformadosL + 1;

	if (MoodysRtngCodeL != null && !"".equals(MoodysRtngCodeL) && !"No disp.".equals(MoodysRtngCodeL) ){
		intNumRtngInformadosL = intNumRtngInformadosL + 1;
	
		if (FitchRtngCodeL != null && !"".equals(FitchRtngCodeL) && !"No disp.".equals(FitchRtngCodeL)){
			intNumRtngInformadosL = intNumRtngInformadosL + 1;
		}
	} else if (FitchRtngCodeL != null && !"".equals(FitchRtngCodeL) && !"No disp.".equals(FitchRtngCodeL)){ 
		intNumRtngInformadosL = intNumRtngInformadosL + 1;
	}
	
} else if (MoodysRtngCodeL != null && !"".equals(MoodysRtngCodeL) && !"No disp.".equals(MoodysRtngCodeL) ){
		intNumRtngInformadosL = intNumRtngInformadosL + 1;
	
		if (FitchRtngCodeL != null && !"".equals(FitchRtngCodeL) && !"No disp.".equals(FitchRtngCodeL)){
			intNumRtngInformadosL = intNumRtngInformadosL + 1;
		}

} else if (FitchRtngCodeL != null && !"".equals(FitchRtngCodeL) && !"No disp.".equals(FitchRtngCodeL)){
	intNumRtngInformadosL = intNumRtngInformadosL + 1;
}

//Revisamos si los 3 Grados son iguales, salvo si son 99 Se tendran en cuenta?

logger.error(" ------------------------------------------------------------------- Dentro de Sub_CalculateREU_LOCAL SPGradoRtngCodeL "+SPGradoRtngCodeL);
logger.error(" ------------------------------------------------------------------- Dentro de Sub_CalculateREU_LOCAL MoodysGradoRtngCodeL "+MoodysGradoRtngCodeL);
logger.error(" ------------------------------------------------------------------- Dentro de Sub_CalculateREU_LOCAL FitchGradoRtngCodeL: "+FitchGradoRtngCodeL);

if ( SPGradoRtngCodeL.equals(MoodysGradoRtngCodeL) && MoodysGradoRtngCodeL.equals(FitchGradoRtngCodeL) ){
logger.error(" ------------------------------------------------------------------- Dentro de Sub_CalculateREU_LOCAL 1: ");
	if (!"".equals(SPGradoRtngCodeL) && !"".equals(MoodysGradoRtngCodeL) && !"".equals(FitchGradoRtngCodeL) ){
logger.error(" ------------------------------------------------------------------- Dentro de Sub_CalculateREU_LOCAL 2: ");
		hayTresRtngIgualesL = "S";

	} else {
logger.error(" ------------------------------------------------------------------- Dentro de Sub_CalculateREU_LOCAL 3: ");
		hayTresRtngIgualesL = "N";
	}
} else  if (!SPGradoRtngCodeL.equals(MoodysGradoRtngCodeL) && !MoodysGradoRtngCodeL.equals(FitchGradoRtngCodeL) && !SPGradoRtngCodeL.equals(FitchGradoRtngCodeL)) {
logger.error(" ------------------------------------------------------------------- Dentro de Sub_CalculateREU_LOCAL 4: ");	
//losTresSonDistintos = "S";
losTresSonDistintosL= "S";
}

//Sacamos el mejor grado de rating, que es el mas bajo, siendo 1 el mas bajo y 25 el mas alto
/*if (!"".equals(SPGradoRtngCodeL) && !"".equals(MoodysGradoRtngCodeL) && !"".equals(FitchGradoRtngCodeL) ){
	gradosL = new int[intNumRtngInformadosL];
	gradosL[0] = Integer.parseInt(SPGradoRtngCodeL);
	gradosL[1] = Integer.parseInt(MoodysGradoRtngCodeL);
	gradosL[2] = Integer.parseInt(FitchGradoRtngCodeL);
} else {
	gradosL = new int[intNumRtngInformadosL];
	if (!"".equals(SPGradoRtngCodeL)){
		gradosL[0] = Integer.parseInt(SPGradoRtngCodeL);
	}
	if (!"".equals(MoodysGradoRtngCodeL)){
		gradosL[1] = Integer.parseInt(SPGradoRtngCodeL);
	}
	if (!"".equals(FitchGradoRtngCodeL)){
		gradosL[2] = Integer.parseInt(SPGradoRtngCodeL);
	}
}*/
int[] gradosL = {Integer.parseInt(SPGradoRtngCodeL), Integer.parseInt(MoodysGradoRtngCodeL), Integer.parseInt(FitchGradoRtngCodeL)};
Arrays.sort(gradosL);
if (intNumRtngInformadosL > 0){
mejorRtngL = String.valueOf(gradosL[0]);

//Sacamos el peor grado de rating, que es el mas alto, siendo 1 el mas bajo y 25 el mas alto
peorRtngL = String.valueOf(gradosL[intNumRtngInformadosL-1]);
}

//revisamos si hay 2 mejores grados de rating iguales
for(int i=0;i<intNumRtngInformadosL;i++){
	valueL = String.valueOf(gradosL[i]);
	if (mejorRtngL.equals(valueL) ){
		conteoMejorRtngL = conteoMejorRtngL + 1;
	}
}

if ( conteoMejorRtngL > 1){
	hayDosMejoresRtngIgualesL = "S";
} else {
	hayDosMejoresRtngIgualesL = "N";
}

//revisamos si hay 2 peores grados de rating iguales
value = "";
for(int i=0;i<intNumRtngInformadosL;i++){
	valueL = String.valueOf(gradosL[i]);
	if (peorRtngL.equals(valueL) ){
		conteoPeorRtngL = conteoPeorRtngL + 1;
	}
}

if ( conteoPeorRtngL > 1){
	hayDosPeoresRtngIgualesL = "S";
} else {
	hayDosPeoresRtngIgualesL = "N";
}



numRtngInformadosL = String.valueOf(intNumRtngInformadosL);
logger.error(" numRtngInformadosL : "+ numRtngInformadosL );
//Calculamos el Rating Externo Unificado
if ( intNumRtngInformadosL == 0 ) {
	//no se realiza ningun calculo dado que ninguno de los valores devueltos por Refinitiv
	mejorGradoREUL = rankNumREUNRL; //Grado NR para la clasificacion del REU
	segundoMejorGradoREUL = "N.A.";
} else if ( intNumRtngInformadosL == 1 ) {
	mejorGradoREUL = mejorRtngL;
	segundoMejorGradoREUL = "N.A.";
} else  if ( intNumRtngInformadosL == 2 ) {
	mejorGradoREUL = mejorRtngL;

	if ( "S".equals(hayDosMejoresRtngIgualesL) ){
		segundoMejorGradoREUL = mejorRtngL;
	} else if ( "S".equals(hayDosPeoresRtngIgualesL) ){
		segundoMejorGradoREUL = peorRtngL;
	} else {
		segundoMejorGradoREUL = String.valueOf(gradosL[intNumRtngInformadosL-1]);
	}
	
} else if ( intNumRtngInformadosL == 3 ) {
logger.error("losTresSonDistintosL: "+ losTresSonDistintosL);
	if ("S".equals(losTresSonDistintosL)){

		// Antes cambios SDATOOL-48154 Cambio logica REU
		for(int i=0;i<3;i++){
			sumaTresRatingL = sumaTresRatingL + gradosL[i];
		}
		mediaL = (double)sumaTresRatingL/gradosL.length;
		/*mejorGradoREUL = (int)Math.round(mediaL);
		segundoMejorGradoREUL = mejorGradoREUL;*/

		// Despues cambios SDATOOL-48154 Cambio logica REU
		for(int i=0; i < gradosL.length-1; i++){
                   for(int j=0; j < (gradosL.length-1-i); j++){  
                        if(gradosL[j] > gradosL[j+1]){  
                                int aux=gradosL[j];                 
                                gradosL[j]=gradosL[j+1];           
                                gradosL[j+1]=aux;
                         }    
                   }
              }
		mejorGradoREUL = (int)Math.round(gradosL[1]);
		segundoMejorGradoREUL = mejorGradoREUL;
		logger.error(" mejorGradoREUL: "+ mejorGradoREUL );
		logger.error(" segundoMejorGradoREUL:"+ segundoMejorGradoREUL );
	} else {
	
		mejorGradoREUL = mejorRtngL;
		if ( "S".equals(hayDosMejoresRtngIgualesL) ){
			segundoMejorGradoREUL = mejorRtngL;
		} else if ( "S".equals(hayDosPeoresRtngIgualesL) ){
			segundoMejorGradoREUL = peorRtngL;
		} else {
			segundoMejorGradoREUL = String.valueOf(gradosL[intNumRtngInformadosL-1]);
		}
	}
}
]]></objectValue>
<type>CONSTANT</type>
</item>
