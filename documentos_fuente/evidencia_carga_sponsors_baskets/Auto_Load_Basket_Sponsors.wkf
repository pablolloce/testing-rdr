<directJoin>false</directJoin>
<name id="523">PreProcess</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="524">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="525" type="java.util.HashSet">
<item id="526" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="527">statements</name>
<objectValue id="528" type="java.lang.String">String files=inputMap.get("INFORMATION").split("\\?")[0];
String[] filesArray = files.split(";");
String script="./RDR_Sponsor_PreProcess.sh "+inputMap.get("INFORMATION").split("\\?")[1].replaceAll("\\$env", env);
String sponsor=inputMap.get("SPONSOR_INDEX").split(";")[0];
String index=inputMap.get("SPONSOR_INDEX").split(";")[1];
String filePath="/fichtemcomp/"+env+"/descargas/kytl/issues/Baskets/Sponsors/"+sponsor+"/";
String oid=inputMap.get("PAR1_OID");
String transition = "OK";

for (String fileName : filesArray){
	File file = new File(filePath+fileName);
	if (!file.exists()){
		transition = "ERROR";
		for (String affectedIndex : inputMap.get("AFFECTED_INDEX").split(";")) {
			String[] arrayMensaje = new String[4]; 
			arrayMensaje[0] = "ERROR PLATAFORMA";
			arrayMensaje[1] = "No ha sido recibido el fichero "+fileName+" para cargar el índice "+affectedIndex;
			arrayMensaje[2] = affectedIndex;
			arrayMensaje[3] = sponsor;
			listaErrores.add(arrayMensaje);
		}

	}
}

Transition=transition;</objectValue>
<type>CONSTANT</type>
</item>
