<input>true</input>
<name id="136">statements</name>
<stringValue id="137"><![CDATA[String trn_id ="";
String trn_id =ResultList[counterLocal - 1][7];
String resultTmp = "";
String lineTmp = "";

for (int i=0;i<ResultList[0].length; i++) 
{
	lineTmp = "" + ResultList[counterLocal - 1][i] +"" ;
	lineTmp = lineTmp.replace("null","");
	resultTmp = resultTmp + lineTmp + ";";
}

]]></stringValue>
<type>CONSTANT</type>
</item>
