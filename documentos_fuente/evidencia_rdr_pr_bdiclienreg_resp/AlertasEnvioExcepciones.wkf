<item id="43" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="44">querySQL</name>
<objectValue id="45" type="java.lang.String"><![CDATA[WITH EMISORES_ACTIVOS AS (
    SELECT DISTINCT FINS.INST_MNEM
    FROM FT_T_FINS FINS
    JOIN FT_T_FINR FINR
         ON FINR.INST_MNEM = FINS.INST_MNEM
    WHERE FINS.DATA_STAT_TYP = 'ACTIVE'
      AND FINS.END_TMS IS NULL
      AND FINR.FINSRL_TYP = 'ISSUER'
      AND FINR.DATA_STAT_TYP = 'ACTIVE'
      AND FINR.END_TMS IS NULL
),

EMISORES_ADA AS (
    SELECT FIID.FINS_ID
    FROM FT_T_FRCL FRCL
    JOIN FT_T_FIID FIID ON FIID.INST_MNEM = FRCL.INST_MNEM
        AND FIID.FINS_ID_CTXT_TYP = 'FINSID'
        AND FIID.DATA_STAT_TYP = 'ACTIVE'
        AND FIID.END_TMS IS NULL
    WHERE FRCL.INDUS_CL_SET_ID = 'SAACCT'
      AND FRCL.DATA_STAT_TYP = 'ACTIVE'
      AND FRCL.END_TMS IS NULL
      AND FRCL.DATA_SRC_ID = 'ADA'
),

BRANCH_MEXICO AS (
    SELECT
        ENFR.INST_MNEM,
        CASE
            WHEN COUNT(*) > 0
             AND COUNT(CASE WHEN ENFR.ORG_ID <> 'MEX' OR ENFR.ORG_ID IS NULL THEN 1 END) = 0
            THEN 'Y'
            ELSE 'N'
        END AS MX_ONLY_BRANCH
    FROM FT_T_ENFR ENFR
    WHERE ENFR.DATA_STAT_TYP = 'ACTIVE'
      AND ENFR.END_TMS IS NULL
      AND ENFR.FINSRL_TYP = 'ISSUER'
    GROUP BY ENFR.INST_MNEM
)

SELECT COUNT(*) AS TOTAL
FROM (
    SELECT MENSAJE_1, MENSAJE_2, MENSAJE_4, MENSAJE_5
    FROM (
        SELECT 1 B_GROUP,
               DENSE_RANK() OVER (ORDER BY MENSAJE_1 ASC, MENSAJE_2 ASC, MENSAJE_3 ASC) FILA,
               MENSAJE_1,
               MENSAJE_2,
               MENSAJE_3,
               MENSAJE_4,
               MENSAJE_5,
               ALG1_OID ALG1_OID
        FROM (
            SELECT
                SUBSTR(mensaje,INSTR(mensaje,'|',1,1)+1,INSTR(mensaje,'|',1,2)-INSTR(mensaje,'|',1,1)-1) MENSAJE_1,
                SUBSTR(mensaje,INSTR(mensaje,'|',1,2)+1,INSTR(mensaje,'|',1,3)-INSTR(mensaje,'|',1,2)-1) MENSAJE_2,
                SUBSTR(mensaje,INSTR(mensaje,'|',1,3)+1) MENSAJE_3,
                (
                    SELECT IRCL.CL_VALUE
                    FROM FT_T_FIID FIID, FT_T_ISSR ISSR, FT_T_IRCL IRCL
                    WHERE FIID.FINS_ID = SUBSTR(mensaje,INSTR(mensaje,'|',1,1)+1,INSTR(mensaje,'|',1,2)-INSTR(mensaje,'|',1,1)-1)
                      AND FIID.FINS_ID_CTXT_TYP = 'FINSID'
                      AND FIID.DATA_STAT_TYP = 'ACTIVE'
                      AND FIID.END_TMS IS NULL
                      AND ISSR.FINS_INST_MNEM = FIID.INST_MNEM
                      AND ISSR.DATA_STAT_TYP = 'ACTIVE'
                      AND ISSR.END_TMS IS NULL
                      AND IRCL.INSTR_ISSR_ID (+) = ISSR.INSTR_ISSR_ID
                      AND IRCL.DATA_STAT_TYP (+) = 'ACTIVE'
                      AND IRCL.END_TMS (+) IS NULL
                      AND IRCL.INDUS_CL_SET_ID (+) = 'TPISSU'
                ) MENSAJE_4,
                (
                    SELECT NVL(BM.MX_ONLY_BRANCH, 'N')
                    FROM FT_T_FIID FIID
                    LEFT JOIN BRANCH_MEXICO BM ON BM.INST_MNEM = FIID.INST_MNEM
                    WHERE FIID.FINS_ID = SUBSTR(mensaje,INSTR(mensaje,'|',1,1)+1,INSTR(mensaje,'|',1,2)-INSTR(mensaje,'|',1,1)-1)
                      AND FIID.FINS_ID_CTXT_TYP = 'FINSID'
                      AND FIID.DATA_STAT_TYP = 'ACTIVE'
                      AND FIID.END_TMS IS NULL
                      AND ROWNUM = 1
                ) MENSAJE_5,
                alg1_oid
            FROM (
                SELECT MIN(alg1_oid) alg1_oid, mensaje
                FROM FT_T_ALG1
                WHERE PROCESO = 'BATCH_REFINITIV_EMISORES'
                  AND (PROCESADO = 'N' OR (PROCESADO = 'S' AND LAST_CHG_TMS > SYSDATE - 0.1))
                  AND MENSAJE NOT LIKE '%TRBC Activ%'
                GROUP BY mensaje
            )

            UNION

            SELECT
                SUBSTR(mensaje,INSTR(mensaje,'|',1,1)+1,INSTR(mensaje,'|',1,2)-INSTR(mensaje,'|',1,1)-1) MENSAJE_1,
                SUBSTR(mensaje,INSTR(mensaje,'|',1,2)+1,INSTR(mensaje,'|',1,3)-INSTR(mensaje,'|',1,2)-1) MENSAJE_2,
                SUBSTR(mensaje,INSTR(mensaje,'|',1,3)+1) MENSAJE_3,
                (
                    SELECT IRCL.CL_VALUE
                    FROM FT_T_FIID FIID, FT_T_ISSR ISSR, FT_T_IRCL IRCL
                    WHERE FIID.FINS_ID = SUBSTR(mensaje,INSTR(mensaje,'|',1,1)+1,INSTR(mensaje,'|',1,2)-INSTR(mensaje,'|',1,1)-1)
                      AND FIID.FINS_ID_CTXT_TYP = 'FINSID'
                      AND FIID.DATA_STAT_TYP = 'ACTIVE'
                      AND FIID.END_TMS IS NULL
                      AND ISSR.FINS_INST_MNEM = FIID.INST_MNEM
                      AND ISSR.DATA_STAT_TYP = 'ACTIVE'
                      AND ISSR.END_TMS IS NULL
                      AND IRCL.INSTR_ISSR_ID (+) = ISSR.INSTR_ISSR_ID
                      AND IRCL.DATA_STAT_TYP (+) = 'ACTIVE'
                      AND IRCL.END_TMS (+) IS NULL
                      AND IRCL.INDUS_CL_SET_ID (+) = 'TPISSU'
                ) MENSAJE_4,
                (
                    SELECT NVL(BM.MX_ONLY_BRANCH, 'N')
                    FROM FT_T_FIID FIID
                    LEFT JOIN BRANCH_MEXICO BM ON BM.INST_MNEM = FIID.INST_MNEM
                    WHERE FIID.FINS_ID = SUBSTR(mensaje,INSTR(mensaje,'|',1,1)+1,INSTR(mensaje,'|',1,2)-INSTR(mensaje,'|',1,1)-1)
                      AND FIID.FINS_ID_CTXT_TYP = 'FINSID'
                      AND FIID.DATA_STAT_TYP = 'ACTIVE'
                      AND FIID.END_TMS IS NULL
                      AND ROWNUM = 1
                ) MENSAJE_5,
                alg1_oid
            FROM (
                SELECT MIN(alg1_oid) alg1_oid, mensaje
                FROM FT_T_ALG1
                WHERE PROCESO = 'BATCH_REFINITIV_EMISORES'
                  AND (PROCESADO = 'N' OR (PROCESADO = 'S' AND LAST_CHG_TMS > SYSDATE - 0.1))
                  AND MENSAJE LIKE '%TRBC Activ%'
                  AND SUBSTR(mensaje,INSTR(mensaje,'|',1,1)+1,INSTR(mensaje,'|',1,2)-INSTR(mensaje,'|',1,1)-1)
                        NOT IN (SELECT FINS_ID FROM EMISORES_ADA)
                GROUP BY mensaje
            )
        )

        UNION ALL

        SELECT
            2 B_GROUP,
            ROWNUM FILA,
            FIID.FINS_ID AS MENSAJE_1,
            FRID.FINR_ID AS MENSAJE_2,
            'Emisor sin pais de riesgo' MENSAJE_3,
            IRCL.CL_VALUE AS MENSAJE_4,
            NVL(BM.MX_ONLY_BRANCH, 'N') AS MENSAJE_5,
            '' AS ALG1_OID
        FROM EMISORES_ACTIVOS E_A
        JOIN FT_T_FINS FINS ON FINS.INST_MNEM = E_A.INST_MNEM
        JOIN FT_T_ISSR ISSR ON ISSR.FINS_INST_MNEM = FINS.INST_MNEM
            AND ISSR.DATA_STAT_TYP = 'ACTIVE'
            AND ISSR.END_TMS IS NULL
        JOIN FT_T_FIID FIID ON ISSR.FINS_INST_MNEM = FIID.INST_MNEM
            AND FIID.FINS_ID_CTXT_TYP = 'FINSID'
            AND FIID.DATA_STAT_TYP = 'ACTIVE'
            AND FIID.END_TMS IS NULL
        LEFT JOIN BRANCH_MEXICO BM ON BM.INST_MNEM = FINS.INST_MNEM
        LEFT JOIN FT_T_IRGU IRGU ON IRGU.INSTR_ISSR_ID = ISSR.INSTR_ISSR_ID
            AND IRGU.ISSR_GU_PURP_TYP = 'RISK'
            AND IRGU.DATA_STAT_TYP = 'ACTIVE'
            AND IRGU.END_TMS IS NULL
        LEFT JOIN FT_T_IRCL IRCL ON IRCL.INSTR_ISSR_ID = ISSR.INSTR_ISSR_ID
            AND IRCL.INDUS_CL_SET_ID = 'TPISSU'
            AND IRCL.DATA_STAT_TYP = 'ACTIVE'
            AND IRCL.END_TMS IS NULL
        LEFT JOIN FT_T_FRID FRID ON FRID.INST_MNEM = FIID.INST_MNEM
            AND FRID.FINSRL_ID_CTXT_TYP = 'ORG_ID'
            AND FRID.FINSRL_TYP = 'ISSUER'
            AND FRID.END_TMS IS NULL
            AND FRID.DATA_STAT_TYP = 'ACTIVE'
        LEFT JOIN FT_T_IRST IRST ON IRST.INSTR_ISSR_ID = ISSR.INSTR_ISSR_ID
            AND IRST.STAT_DEF_ID = 'SOURCE'
            AND IRST.DATA_STAT_TYP = 'ACTIVE'
            AND IRST.END_TMS IS NULL
        WHERE IRGU.ISSR_GU_PURP_TYP IS NULL

        UNION ALL

        SELECT
            3 B_GROUP,
            ROWNUM FILA,
            FIID.FINS_ID AS MENSAJE_1,
            FRID.FINR_ID AS MENSAJE_2,
            'Emisor sin subsector' MENSAJE_3,
            IRCL.CL_VALUE AS MENSAJE_4,
            NVL(BM.MX_ONLY_BRANCH, 'N') AS MENSAJE_5,
            '' ALG1_OID
        FROM EMISORES_ACTIVOS E_A
        JOIN FT_T_FINS FINS ON FINS.INST_MNEM = E_A.INST_MNEM
        JOIN FT_T_ISSR ISSR ON ISSR.FINS_INST_MNEM = FINS.INST_MNEM
            AND ISSR.DATA_STAT_TYP = 'ACTIVE'
            AND ISSR.END_TMS IS NULL
        JOIN FT_T_FIID FIID ON ISSR.FINS_INST_MNEM = FIID.INST_MNEM
            AND FIID.FINS_ID_CTXT_TYP = 'FINSID'
            AND FIID.DATA_STAT_TYP = 'ACTIVE'
            AND FIID.END_TMS IS NULL
        LEFT JOIN BRANCH_MEXICO BM ON BM.INST_MNEM = FINS.INST_MNEM
        LEFT JOIN FT_T_FRCL FRCL
            ON FRCL.INST_MNEM = FIID.INST_MNEM
            AND FRCL.INDUS_CL_SET_ID = 'SAASUBS'
            AND FRCL.DATA_STAT_TYP = 'ACTIVE'
            AND FRCL.END_TMS IS NULL
        LEFT JOIN FT_T_FRID FRID
            ON FRID.INST_MNEM = FIID.INST_MNEM
            AND FRID.FINSRL_ID_CTXT_TYP = 'ORG_ID'
            AND FRID.FINSRL_TYP = 'ISSUER'
            AND FRID.DATA_STAT_TYP = 'ACTIVE'
            AND FRID.END_TMS IS NULL
        LEFT JOIN FT_T_IRST IRST ON IRST.INSTR_ISSR_ID = ISSR.INSTR_ISSR_ID
            AND IRST.STAT_DEF_ID = 'SOURCE'
            AND IRST.DATA_STAT_TYP = 'ACTIVE'
            AND IRST.END_TMS IS NULL
        LEFT JOIN FT_T_IRCL IRCL ON IRCL.INSTR_ISSR_ID = ISSR.INSTR_ISSR_ID
            AND IRCL.INDUS_CL_SET_ID = 'TPISSU'
            AND IRCL.DATA_STAT_TYP = 'ACTIVE'
            AND IRCL.END_TMS IS NULL
        WHERE FRCL.CL_VALUE IS NULL

        UNION ALL

        SELECT
            4 AS B_GROUP,
            ROWNUM AS FILA,
            FIID.FINS_ID AS MENSAJE_1,
            FRID.FINR_ID AS MENSAJE_2,
            'Emisor sin REU' AS MENSAJE_3,
            IRCL.CL_VALUE AS MENSAJE_4,
            NVL(BM.MX_ONLY_BRANCH, 'N') AS MENSAJE_5,
            '' AS ALG1_OID
        FROM EMISORES_ACTIVOS E_A
        JOIN FT_T_FINS FINS ON FINS.INST_MNEM = E_A.INST_MNEM
        JOIN FT_T_FIID FIID ON FINS.INST_MNEM = FIID.INST_MNEM
        JOIN FT_T_ISSR ISSR ON FINS.INST_MNEM = ISSR.FINS_INST_MNEM
        LEFT JOIN BRANCH_MEXICO BM ON BM.INST_MNEM = FINS.INST_MNEM
        LEFT JOIN FT_T_IRCL IRCL ON ISSR.INSTR_ISSR_ID = IRCL.INSTR_ISSR_ID
          AND IRCL.INDUS_CL_SET_ID='TPISSU'
          AND IRCL.DATA_STAT_TYP='ACTIVE'
          AND IRCL.END_TMS IS NULL
        LEFT JOIN FT_T_FRID FRID ON FINS.INST_MNEM = FRID.INST_MNEM
          AND FRID.FINSRL_ID_CTXT_TYP='ORG_ID'
          AND FRID.FINSRL_TYP='ISSUER'
          AND FRID.DATA_STAT_TYP='ACTIVE'
          AND FRID.END_TMS IS NULL
        WHERE FIID.FINS_ID_CTXT_TYP='FINSID'
          AND FIID.DATA_STAT_TYP='ACTIVE'
          AND FIID.END_TMS IS NULL
          AND ISSR.DATA_STAT_TYP='ACTIVE'
          AND ISSR.END_TMS IS NULL
          AND FINS.INST_MNEM NOT IN (
            SELECT FIRT.INST_MNEM
            FROM FT_T_FIRT FIRT
            JOIN FT_T_RTNG RTNG ON FIRT.RTNG_SET_OID = RTNG.RTNG_SET_OID
            WHERE RTNG.RTNG_SET_MNEM IN ('EXT_RTNL', 'EXT_RTN')
              AND FIRT.DATA_STAT_TYP='ACTIVE'
              AND FIRT.END_TMS IS NULL
              AND RTNG.END_TMS IS NULL
          )
          AND EXISTS (
            SELECT 1 FROM FT_T_FINR FINR
            WHERE FINS.INST_MNEM = FINR.INST_MNEM
              AND FINR.FINSRL_TYP = 'ISSUER'
              AND FINR.DATA_STAT_TYP='ACTIVE'
              AND FINR.END_TMS IS NULL
          )
          AND NOT EXISTS (
            SELECT 1
            FROM FT_T_FIRT FIRT
            JOIN FT_T_RTNG RTNG ON FIRT.RTNG_SET_OID = RTNG.RTNG_SET_OID
            WHERE FIRT.INST_MNEM = FINS.INST_MNEM
              AND RTNG.RTNG_SET_MNEM IN ('EXT_RTNL', 'EXT_RTN')
              AND NVL(FIRT.RTNG_CDE, 'N.A') NOT IN ('N.A','N.A.','NR','N.S.','PENDING','RD','SD','WD','WR')
              AND FIRT.DATA_STAT_TYP='ACTIVE'
              AND FIRT.END_TMS IS NULL
              AND RTNG.END_TMS IS NULL
          )

        UNION ALL

        SELECT
            5 AS B_GROUP,
            ROWNUM AS FILA,
            FIID.FINS_ID AS MENSAJE_1,
            FRID.FINR_ID AS MENSAJE_2,
            'Emisor sin ratings externos' AS MENSAJE_3,
            IRCL.CL_VALUE AS MENSAJE_4,
            NVL(BM.MX_ONLY_BRANCH, 'N') AS MENSAJE_5,
            '' AS ALG1_OID
        FROM EMISORES_ACTIVOS E_A
        JOIN FT_T_FINS FINS ON FINS.INST_MNEM = E_A.INST_MNEM
        JOIN FT_T_FIID FIID ON FINS.INST_MNEM = FIID.INST_MNEM
        JOIN FT_T_ISSR ISSR ON FINS.INST_MNEM = ISSR.FINS_INST_MNEM
        LEFT JOIN BRANCH_MEXICO BM ON BM.INST_MNEM = FINS.INST_MNEM
        LEFT JOIN FT_T_IRCL IRCL ON ISSR.INSTR_ISSR_ID = IRCL.INSTR_ISSR_ID
          AND IRCL.INDUS_CL_SET_ID='TPISSU'
          AND IRCL.DATA_STAT_TYP='ACTIVE'
          AND IRCL.END_TMS IS NULL
        LEFT JOIN FT_T_FRID FRID ON FINS.INST_MNEM = FRID.INST_MNEM
          AND FRID.FINSRL_ID_CTXT_TYP='ORG_ID'
          AND FRID.FINSRL_TYP='ISSUER'
          AND FRID.DATA_STAT_TYP='ACTIVE'
          AND FRID.END_TMS IS NULL
        WHERE FIID.FINS_ID_CTXT_TYP='FINSID'
          AND FIID.DATA_STAT_TYP='ACTIVE'
          AND FIID.END_TMS IS NULL
          AND ISSR.DATA_STAT_TYP='ACTIVE'
          AND ISSR.END_TMS IS NULL
          AND NOT EXISTS (
            SELECT 1
            FROM FT_T_FIRT FIRT
            JOIN FT_T_RTNG RTNG ON FIRT.RTNG_SET_OID = RTNG.RTNG_SET_OID
            WHERE FIRT.INST_MNEM = FINS.INST_MNEM
              AND RTNG.RTNG_SET_MNEM IN ('MODLOTRT', 'SPRLOTRT', 'FTCHLTRT')
              AND FIRT.RTNG_CDE NOT IN ('N.A','N.A.','NR','N.S.','PENDING','RD','SD','WD','WR')
              AND FIRT.DATA_STAT_TYP='ACTIVE'
              AND FIRT.END_TMS IS NULL
              AND RTNG.END_TMS IS NULL
          )

        UNION ALL

        SELECT
            6 AS B_GROUP,
            ROWNUM AS FILA,
            MENSAJE_1,
            MENSAJE_2,
            MENSAJE_3,
            MENSAJE_4,
            MENSAJE_5,
            ALG1_OID
        FROM (
            SELECT
                FIID.FINS_ID                 AS MENSAJE_1,
                FRID.FINR_ID                 AS MENSAJE_2,
                'Emisor con ratings externos inactivos en RDR' AS MENSAJE_3,
                IRCL.CL_VALUE                AS MENSAJE_4,
                NVL(BM.MX_ONLY_BRANCH, 'N')  AS MENSAJE_5,
                ''                           AS ALG1_OID
            FROM EMISORES_ACTIVOS E_A
            JOIN FT_T_FINS FINS ON FINS.INST_MNEM = E_A.INST_MNEM
            JOIN FT_T_FIID FIID ON FIID.INST_MNEM = FINS.INST_MNEM
            JOIN FT_T_ISSR ISSR ON ISSR.FINS_INST_MNEM = FINS.INST_MNEM
            LEFT JOIN BRANCH_MEXICO BM ON BM.INST_MNEM = FINS.INST_MNEM
            LEFT JOIN FT_T_IRCL IRCL ON IRCL.INSTR_ISSR_ID = ISSR.INSTR_ISSR_ID
              AND IRCL.INDUS_CL_SET_ID='TPISSU'
              AND IRCL.DATA_STAT_TYP='ACTIVE'
              AND IRCL.END_TMS IS NULL
            LEFT JOIN FT_T_FRID FRID ON FRID.INST_MNEM = FINS.INST_MNEM
              AND FRID.FINSRL_ID_CTXT_TYP='ORG_ID'
              AND FRID.FINSRL_TYP='ISSUER'
              AND FRID.DATA_STAT_TYP='ACTIVE'
              AND FRID.END_TMS IS NULL
            WHERE ISSR.DATA_STAT_TYP='ACTIVE'
              AND ISSR.END_TMS IS NULL
              AND FIID.FINS_ID_CTXT_TYP = 'FINSID'
              AND FIID.DATA_STAT_TYP='ACTIVE'
              AND FIID.END_TMS IS NULL
              AND EXISTS (
                  SELECT 1
                  FROM FT_T_FINR FINR
                  WHERE FINR.INST_MNEM = FINS.INST_MNEM
                    AND FINR.FINSRL_TYP = 'ISSUER'
                    AND FINR.DATA_STAT_TYP='ACTIVE'
                    AND FINR.END_TMS IS NULL
              )
              AND EXISTS (
                  SELECT 1
                  FROM FT_T_FIRT FIRT
                  JOIN FT_T_RTNG RTNG ON RTNG.RTNG_SET_OID = FIRT.RTNG_SET_OID
                  WHERE FIRT.INST_MNEM = FINS.INST_MNEM
                    AND RTNG.RTNG_SET_MNEM IN ('MODLOTRT','SPRLOTRT','FTCHLTRT')
                    AND FIRT.DATA_STAT_TYP = 'INACTIVE'
                    AND FIRT.END_TMS IS NULL
                    AND RTNG.END_TMS IS NULL
                    AND RTNG.DATA_STAT_TYP = 'ACTIVE'
              )
              AND NOT EXISTS (
                  SELECT 1
                  FROM FT_T_FIRT FIRT
                  JOIN FT_T_RTNG RTNG ON RTNG.RTNG_SET_OID = FIRT.RTNG_SET_OID
                  WHERE FIRT.INST_MNEM = FINS.INST_MNEM
                    AND RTNG.RTNG_SET_MNEM IN ('MODLOTRT','SPRLOTRT','FTCHLTRT')
                    AND FIRT.DATA_STAT_TYP = 'ACTIVE'
                    AND FIRT.END_TMS IS NULL
                    AND RTNG.END_TMS IS NULL
                    AND RTNG.DATA_STAT_TYP = 'ACTIVE'
              )
        )
    )
)

]]></objectValue>
<type>CONSTANT</type>
</item>
</parameters>
