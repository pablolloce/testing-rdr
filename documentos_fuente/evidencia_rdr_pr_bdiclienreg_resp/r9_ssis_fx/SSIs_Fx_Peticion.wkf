<source id="322">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="323">Peticion API REST</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="324">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="325" type="java.util.HashSet">
<item id="326" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="327">statements</name>
<objectValue id="328" type="java.lang.String"><![CDATA[import org.apache.log4j.Logger;
import java.io.BufferedReader;
import java.io.File;
import java.io.FileReader;
import java.io.IOException;
import java.util.regex.*;
import javax.xml.parsers.ParserConfigurationException;
import javax.xml.xpath.XPathExpressionException;
import org.xml.sax.SAXException;

	Logger logger = Logger.getLogger("SSIs_Fx_Peticion");
	String cmd="";
	String ENV="";
       String NivelLog ="3";
	String parametros = "";
		
	String pathpro = "/pr/kytl/online/multipais/multicanal/cfg/entorno/";
	String pathpre = "/pp/kytl/online/multipais/multicanal/cfg/entorno/";
	String pathint = "/ei/kytl/online/multipais/multicanal/cfg/entorno/";
	String pathdev = "/de/kytl/online/multipais/multicanal/cfg/entorno/";
	String path = "";
	File folderpro = new File(pathpro);
	File folderpre = new File(pathpre);
	File folderint = new File(pathint);
	File folderdev = new File(pathdev);

	if (folderpro.exists()){		path = pathpro + "credentials.xml";		ENV="pr";	NivelLog ="3";}
	else if (folderpre.exists()){	path = pathpre + "credentials.xml";		ENV="pp";	NivelLog = "1";}
	else if (folderint.exists()){	path = pathint + "credentials.xml";		ENV="ei";	NivelLog = "1";}
	else if (folderdev.exists()){	path = pathdev + "credentials.xml";		ENV="de";	NivelLog = "1";}
		
	File archivo = new File(path);
	FileReader fr = new FileReader(archivo);
	BufferedReader br = new BufferedReader(fr);

	String linea;
	String fich = "";
	while ((linea = br.readLine()) != null){	fich = fich + linea;	}
	fr.close();

	String javahome = "";

	Pattern patronAux = Pattern.compile("<environment>(.*?)</environment>");
	Matcher matchAux = patronAux.matcher(fich);
	if (matchAux.find()) {		fich = matchAux.group(1);		}

	patronAux = Pattern.compile("<javahome>(.*?)</javahome>");
	matchAux = patronAux.matcher(fich);
	if (matchAux.find()) {		javahome = matchAux.group(1);		}
		
	String encoding="iso-8859-1";
	String CONF="/"+ENV+"/kytl/online/multipais/multicanal/dat/properties";
	String JAR="/"+ENV+"/kytl/online/multipais/multicanal/jar/";
	String JAVA= javahome +"bin/java";
	String LOG="/"+ENV+"/kytl/online/multipais/multicanal/dat/properties";

if(null!=acronimo && !"".equals(acronimo)){
parametros = acronimo;
}
else {
parametros = parametros.concat("|null");
}

if(null!=accessCode && !"".equals(accessCode)){
parametros = parametros.concat("|".concat(accessCode));
}
else {
parametros = parametros.concat("|null");
}

cmd = JAVA+" -Dfile.encoding=UTF8 -DENV="+ENV+" -cp "+JAR+"API_REST.jar:/"+ENV+"/kytl/online/multipais/multicanal/lib/ojdbc8.jar:/"+ENV+"/kytl/online/multipais/multicanal/lib/commons-dbcp-1.4.jar:/"+ENV+"/kytl/online/multipais/multicanal/lib/log4j.jar:/"+ENV+"/kytl/online/multipais/multicanal/lib/commons-pool-1.5.4.jar:/"+ENV+"/kytl/online/multipais/multicanal/jar/XMASToken-0.0.1.jar:/"+ENV+"/kytl/online/multipais/multicanal/jar/ConexionBD.jar:/"+ENV+"/kytl/online/multipais/multicanal/lib/httpclient-4.5.12.jar:/"+ENV+"/kytl/online/multipais/multicanal/lib/httpcore-4.4.13.jar:/"+ENV+"/kytl/online/multipais/multicanal/lib/json-20160212.jar:/"+ENV+"/kytl/online/multipais/multicanal/lib/commons-logging-1.2.jar:/"+ENV+"/kytl/online/multipais/multicanal/lib/unirest-java-1.4.9.jar:/"+ENV+"/kytl/online/multipais/multicanal/lib/gson-2.6.2.jar main.Peticion ALERT_MIRROR " +new_oid +" AlertRequestSSIsByFond \""+ parametros + "\" "+  NivelLog + " " + ENV + " ssiInformations"; 

/*cmd = JAVA+" -Dfile.encoding=UTF8 -DENV="+ENV+" -cp "+JAR+"API_REST.jar:/"+ENV+"/kytl/online/multipais/multicanal/lib/ojdbc8.jar:/"+ENV+"/kytl/online/multipais/multicanal/lib/commons-dbcp-1.4.jar:/"+ENV+"/kytl/online/multipais/multicanal/lib/log4j.jar:/"+ENV+"/kytl/online/multipais/multicanal/lib/commons-pool-1.5.4.jar:/"+ENV+"/kytl/online/multipais/multicanal/jar/XMASToken-0.0.1.jar:/"+ENV+"/kytl/online/multipais/multicanal/jar/ConexionBD.jar:/"+ENV+"/kytl/online/multipais/multicanal/lib/httpclient-4.5.12.jar:/"+ENV+"/kytl/online/multipais/multicanal/lib/httpcore-4.4.13.jar:/"+ENV+"/kytl/online/multipais/multicanal/lib/json-20160212.jar:/"+ENV+"/kytl/online/multipais/multicanal/lib/commons-logging-1.2.jar:/"+ENV+"/kytl/online/multipais/multicanal/lib/unirest-java-1.4.9.jar:/"+ENV+"/kytl/online/multipais/multicanal/lib/gson-2.6.2.jar main.Peticion ALERT_MIRROR " +new_oid +" AlertRequestSSIsByFond \""+ parametros + "\" "+  NivelLog + " " + ENV + " ssiInformations";  */

	logger.error("[SSIs_Fx_Peticion]: "+ cmd);
]]></objectValue>
<type>CONSTANT</type>
</item>
