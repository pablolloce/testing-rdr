<name id="285">Select a RLT1</name>
<nodeHandler>com.j2fe.general.activities.database.DBQuery</nodeHandler>
<nodeHandlerClass id="286">com.j2fe.general.activities.database.DBQuery</nodeHandlerClass>
<parameters id="287" type="java.util.HashSet">
<item id="288" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="289">database</name>
<stringValue id="290">jdbc/GSDM-1</stringValue>
<type>REFERENCE</type>
</item>
<item id="291" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="292">indexedParameters[0]</name>
<stringValue id="293">JOB_ID</stringValue>
<type>VARIABLE</type>
</item>
<item id="294" type="com.j2fe.workflow.definition.Parameter">
<input>false</input>
<name id="295">indexedResult</name>
<stringValue id="296">QueryVar</stringValue>
<type>VARIABLE</type>
</item>
<item id="297" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="298">querySQL</name>
<stringValue id="299">select 
t.RECORD_SEQ_NUM,
'Funcional' ERROR_TYPE,
r.MAIN_ENTITY_ID,
r.MESSAGE_RLT,
t.crrnt_severity_cde,
r.RLT_FIELD,
r.RLT_OID,
r.TRN_ID,
r.JOB_ID,
'' NOTFCN_ID,
'' NOTFCN_SHORT_TXT

from ft_t_rlt1 r, ft_t_trid t
where
    r.trn_id=t.trn_id
and
    r.JOB_ID=?
and
    r.RLT_PURP_TYP='ERRORES'
order by t.record_seq_num</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
