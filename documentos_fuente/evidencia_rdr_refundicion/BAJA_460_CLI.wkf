<item id="162" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="163">querySQL</name>
<stringValue id="164">select
(SELECT PRNT_INST_MNEM FROM FT_T_FIRL WHERE INST_MNEM =:1 AND FINSRL_TYP='CPARTY  ') MNEM_LOCAL,
(select fld_val from ft_t_fab1 where stat_def_id='NUMFOLIO' and inst_mnem=(SELECT PRNT_INST_MNEM FROM FT_T_FIRL WHERE INST_MNEM =:2 AND FINSRL_TYP='CPARTY  ') and org_id=:3 and ft_t_fab1.data_stat_typ='ACTIVE') CODFOLIO, 
(select prnt_org_id from ft_t_eerl where TRIM(org_id) =:4 and rl_typ = 'BRANCH') CODBAN,
(select subdiv_id from ft_t_sust WHERE stat_def_id='MAINOFFI' AND TRIM(ORG_ID)=:5) CODOFI
from dual</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
