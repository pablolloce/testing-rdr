<parameters id="470" type="java.util.HashSet">
<item id="471" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="472">statements</name>
<stringValue id="473"><![CDATA[import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("SSIs_Fx_Alta");
logger.error("Numero de SDIs totales en el mensaje: "+VREQ.length);


String SDI="";
for(int i =0;i<VREQ.length;i++){
	SDI=VREQ[i].get("VND_RQST_STAT_TXT");
	//SDI=SDI.replace("<?xml version=""1.0"" encoding=""UTF-8""?>","");
	SDI=SDI.replace("ssiInformations","ssiInformation");
	MAP_SDIs.put(i,SDI);
	SDI="";
}
CountMax = VREQ.length;

]]></stringValue>
<type>CONSTANT</type>
</item>
