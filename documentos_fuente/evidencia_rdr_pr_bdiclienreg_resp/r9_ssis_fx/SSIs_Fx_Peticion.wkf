<item id="116" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="117">statements</name>
<stringValue id="118">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("SSIs_FX_Peticion");

String query= "select inst_mnem as UTD_ID from ft_t_fist where stat_def_id = 'FXRELF' and STAT_CHAR_VAL_TXT = 'Y' and inst_mnem in ( select UTD_ID FROM FT_T_UTD1 where UTD_EXT_ID IN (select VND_RQST_OID FROM FT_T_VREQ WHERE VND_RQST_OID =q'#"+ VREQ_OID.get("VND_RQST_OID")+"#')  AND UTD_ID_PURP_TYP = 'MNEM_OPE  ')";

logger.error(query);
</stringValue>
<type>CONSTANT</type>
</item>
