<item id="28" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="29">statements</name>
<stringValue id="30"><![CDATA[//DeclaraciÃ³n de variables
Map valores = new HashMap();

String [] etiquetas = new String [5];
etiquetas[0] = "MAIN_ENTITY_ID";
etiquetas[1] = "MAIN_ENTITY_ID_CTXT_TYP";
etiquetas[2] = "MAIN_ENTITY_NME";
etiquetas[3] = "MAIN_ENTITY_TYP";
etiquetas[4] = "MAIN_ENTITY_TBL_TYP";

valores.put (etiquetas[0],((etiquetaEMIR != null && etiquetaEMIR.length > 0) ? etiquetaEMIR[0].get("ETIQUETA") : "No Existe") + ";" + ((cntrprtyTypeUnderEMIR != null && cntrprtyTypeUnderEMIR.length > 0) ? cntrprtyTypeUnderEMIR[0].get("VALOR") : "No Existe"));
valores.put (etiquetas[1],"GRI-" + cntrprtyGlobalOid);
valores.put (etiquetas[2],"Extraccion de Etiqueta EMIR y Extraccion Counterparty Type under EMIR (BBDD)");
valores.put (etiquetas[3],"FINENTEM");
valores.put (etiquetas[4],"FRA1");]]></stringValue>
<type>CONSTANT</type>
</item>
