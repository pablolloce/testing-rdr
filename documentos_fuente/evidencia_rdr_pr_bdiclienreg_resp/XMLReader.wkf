<name id="55">statements</name>
<stringValue id="56">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("XMLReader");

if (errors>0) {
	logger.error("Y: " + errors);
	return "Y";
} else {
	logger.error("N");
	return "N";
}</stringValue>
<type>CONSTANT</type>
