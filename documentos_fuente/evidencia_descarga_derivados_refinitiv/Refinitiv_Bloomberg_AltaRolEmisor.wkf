</item>
<item id="233" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="234">querySQL</name>
<objectValue id="235" type="java.lang.String">SELECT DISTINCT
    op_fiid.fins_id AS fins_id_operativo
FROM 
    ft_t_fiid lei_global
    
    INNER JOIN ft_t_firl rel_local 
        ON rel_local.prnt_inst_mnem = lei_global.inst_mnem 
        AND rel_local.inst_mnem != rel_local.prnt_inst_mnem
        AND rel_local.data_stat_typ = 'ACTIVE'

    INNER JOIN ft_t_firl rel_operativa 
        ON rel_operativa.prnt_inst_mnem = rel_local.inst_mnem 
        AND rel_operativa.inst_mnem != rel_operativa.prnt_inst_mnem
        AND rel_operativa.data_stat_typ = 'ACTIVE'

    INNER JOIN ft_t_fins op_fins
        ON op_fins.inst_mnem = rel_operativa.inst_mnem
        AND op_fins.subsidiary_ind = 'N' -- 'N' significa que NO es subsidiaria, ergo es Matrix
        AND op_fins.data_stat_typ = 'ACTIVE'

    INNER JOIN ft_t_fiid op_fiid 
        ON op_fiid.inst_mnem = rel_operativa.inst_mnem 
        AND op_fiid.fins_id_ctxt_typ = 'FINSID' 
        AND op_fiid.data_stat_typ = 'ACTIVE'
        AND op_fiid.end_tms IS NULL
        
WHERE 
    lei_global.fins_id_ctxt_typ = 'LEIID'
    AND lei_global.fins_id = ?
    AND lei_global.data_stat_typ = 'ACTIVE'
    AND lei_global.end_tms IS NULL</objectValue>
<type>CONSTANT</type>
</item>
</parameters>
<sources id="236" type="java.util.HashSet">
