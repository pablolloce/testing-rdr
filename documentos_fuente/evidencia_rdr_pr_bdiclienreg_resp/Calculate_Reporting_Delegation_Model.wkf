<item id="434" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="435">statements</name>
<stringValue id="436"><![CDATA[import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("Calculate_Reporting_Delegation_Model");

String aux_SFTR_RDM = "";

if (usindem != null && usindem.length > 0 ) {
	logger.error("[Calculate_Reporting_Delegation_Model]  usindem[0].get(USINDEM) : " + usindem[0].get("USINDEM"));
	if(usindem[0].get("USINDEM").equals("Y")){
		aux_SFTR_RDM = "02";
		logger.error("[Calculate_Reporting_Delegation_Model]  aux_SFTR_RDM -1 : " + aux_SFTR_RDM );
	}else	{
		aux_SFTR_RDM = "06";
		logger.error("[Calculate_Reporting_Delegation_Model]  aux_SFTR_RDM -1 : " + aux_SFTR_RDM );
	}
}else{
	aux_SFTR_RDM = "02";
}
logger.error("[Calculate_Reporting_Delegation_Model]  aux_SFTR_RDM -2 : " + aux_SFTR_RDM );]]></stringValue>
<type>CONSTANT</type>
</item>
