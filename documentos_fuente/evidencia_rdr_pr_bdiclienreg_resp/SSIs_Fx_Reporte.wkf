<name id="134">Recu FINS ID FUND</name>
<nodeHandler>com.j2fe.general.activities.database.DBQuery</nodeHandler>
<nodeHandlerClass id="135">com.j2fe.general.activities.database.DBQuery</nodeHandlerClass>
