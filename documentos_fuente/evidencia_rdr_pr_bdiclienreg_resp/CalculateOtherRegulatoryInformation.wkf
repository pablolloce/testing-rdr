<item id="516" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="517">querySQL</name>
<stringValue id="518">Insert into FT_T_FRA1 (FRA1_OID,INST_MNEM,REG1_OID,FINSRL_INST_MNEM,FINSRL_TYP,STAT_DEF_ID,FLD_VAL,ISS_TYP,
CLSF_OID,CL_VALUE,LAST_CHG_TMS,LAST_CHG_USR_ID,DATA_SRC_ID,DATA_STAT_TYP,START_TMS,END_TMS) 
select NEW_OID,:mnem,(SELECT REG1_OID FROM FT_T_REG1 WHERE REG_NME = 'DFA'),null,null,null,null,null,
(SELECT CLSF_OID FROM FT_T_INCL WHERE TRIM(INDUS_CL_SET_ID) = :indus AND CL_VALUE = :valor),:valor,
SYSDATE,'BBVA:CUSTOMER','RDR','ACTIVE',SYSDATE,null from dual where not exists (SELECT * FROM FT_T_FRA1
WHERE CLSF_OID in (SELECT CLSF_OID FROM FT_T_INCL WHERE TRIM(INDUS_CL_SET_ID) = :indus)
AND INST_MNEM = :mnem)</stringValue>
<type>CONSTANT</type>
</item>
