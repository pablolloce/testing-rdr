<name id="13">statements</name>
<stringValue id="14"><![CDATA[import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("IndexSSIS");

if(ALT_ID_aux!=null && ALT_ID_aux.length>0 && ALT_ID_aux[0].get("ALT_ID")!=null){
	RES.put("CanVal_A", ALT_ID_aux[0].get("ALT_ID"));
}else{
	RES.put("CanVal_A", " ");
}

if(FINR_INST_MNEM_aux!=null && FINR_INST_MNEM_aux.length>0 && FINR_INST_MNEM_aux[0].get("FINR_INST_MNEM")!=null){
	RES.put("MNEM",FINR_INST_MNEM_aux[0].get("FINR_INST_MNEM"));
}else{
	RES.put("MNEM"," ");
}

//RES.put("ReqID",ReqID);
//RES.put("CanVal_A", ALT_ID);
RES.put("RDRDataCtxtIdTyp","SISETUP");
RES.put("Source","ALERT");
// RES.put("SysVal", SysVal);
RES.put("DestSysDataCtxtIdTyp","ALERTID");
//RES.put("MNEM",FINR_INST_MNEM);]]></stringValue>
<type>CONSTANT</type>
</item>
