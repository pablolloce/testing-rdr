<item id="167" type="com.j2fe.workflow.definition.Transition">
<name id="168">ERROR</name>
<source id="169">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="170">Load</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="171">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="172" type="java.util.HashSet">
<item id="173" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="174">statements</name>
<objectValue id="175" type="java.lang.String">String fileOrigin=inputMap.get("INFORMATION").split("\\?")[2];
String[] fileOriginArray=fileOrigin.split(";");
String files=inputMap.get("INFORMATION").split("\\?")[0];
String[] filesArray = files.split(";");
String script="./RDR_CargaBasketSponsor.sh "+inputMap.get("INFORMATION").split("\\?")[1].replaceAll("\\$env", env)+" "+maxExec;
String sponsor=inputMap.get("SPONSOR_INDEX").split(";")[0];
String index=inputMap.get("SPONSOR_INDEX").split(";")[1];
String filePath="/fichtemcomp/"+env+"/descargas/kytl/issues/Baskets/Sponsors/"+sponsor+"/";
String oid=inputMap.get("PAR1_OID");
String transition = "OK";
String idType = "";
String idType2 = "";
int counter = 0;

for (String fileName : filesArray){
	File file = new File(filePath+fileName);
	if (!file.exists()){
		transition = "ERROR";
		String[] arrayMensaje = new String[4]; 
		if (fileOriginArray[counter].equals("DESCARGA")){
			arrayMensaje[0] = "ERROR PLATAFORMA";
			arrayMensaje[1] = "No ha sido recibido el fichero "+fileName+" para cargar el índice "+index;
		}else if (fileOriginArray[counter].equals("SPLIT")){
			arrayMensaje[0] = "ERROR TÉCNICO RDR";
			arrayMensaje[1] = "No se encuentra el fichero "+fileName+" para cargar el índice "+index+" al no haber sido generado correctamente durante el proceso de transformación";
		}else {
			arrayMensaje[0] = "ERROR TÉCNICO RDR";
			arrayMensaje[1] = "No se encuentra el fichero "+fileName+" para cargar el índice "+index+" al no haber sido encontrada parametrización correcta para su tranformación";		
		}
		arrayMensaje[2] = index;
		arrayMensaje[3] = sponsor;
		listaErrores.add(arrayMensaje);
	}
	counter++;
}

if (sponsor.equals("BME") || sponsor.equals("Solactive")) {
	idType="ISIN";
	idType2="";
}else if (sponsor.equals("STOXX") || sponsor.equals("STOXX_DAX")){
	idType="TICKER";
	idType2="";
}else if (sponsor.equals("Euronext") || sponsor.equals("MSCI") || sponsor.equals("SP_DJ") || sponsor.equals("FTSE")) {
	idType="INHOUSE";
	idType2="";
}else if (sponsor.equals("MANUAL")) {
	idType="ISIN";
	idType2="RIC";
}

Transition=transition;</objectValue>
<type>CONSTANT</type>
</item>
