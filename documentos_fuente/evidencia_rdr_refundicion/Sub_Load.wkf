					--UPDATE FT_T_FLAR SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_FLG1 SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID IN ('BAJA_CPARTY','REFUNDICION');
					UPDATE FT_T_FPRO SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_FRA1 SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_FRAP SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_FRCA SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_FRCL SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_FRGP SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_FRGR SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_FRIA SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_FRID SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_FRMK SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_IAPR SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_INCS SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_ISSR SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					--UPDATE FT_T_LAAN SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					--UPDATE FT_T_LAIP SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_MRKT SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_RSME SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_RTNG SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_SCIS SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_SLOC SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_SSIA SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_SSIR SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_SSIS SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_SUFR SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
				END IF;
	  END IF;
      
	  --SI EL GLOBAL ES EL MISMO, SET CUENTA GLOBAL A 1 PARA NO CAMBIAR LA MATRIZ
	  IF PRNT_INST_MNEM_CLP = PRNT_INST_MNEM_CLD THEN
		CUENTA_GLOBAL:=1;
	  END IF;
	  -- Get FINSID de los Clientes a nivel local
      SELECT FIID.FINS_ID INTO FINSID_LOCAL_CERRADA FROM FT_T_FIID FIID WHERE FIID.INST_MNEM = INST_MNEM_CLD AND FIID.FINS_ID_CTXT_TYP = 'FINSID' AND FIID.DATA_STAT_TYP = 'ACTIVE';
      -- Get INST_MNEM de los Clientes a nivel global
      SELECT FIRLL2.PRNT_INST_MNEM INTO INST_MNEM_GLOBAL FROM FT_T_FIRL FIRLL2 WHERE FIRLL2.INST_MNEM = INST_MNEM_CLD AND FIRLL2.FINSRL_TYP = 'CUSTOMER';
      -- 1. MOVIMIENTO DE LAS OPERATIVAS AL NUEVO LOCAL
      VCH_SQL_HIJOSGLOBAL := 'SELECT FT_T_FINS.INST_MNEM FROM FT_T_FIRL, FT_T_FINS WHERE FT_T_FINS.INST_MNEM = FT_T_FIRL.INST_MNEM AND FT_T_FINS.DATA_STAT_TYP != '''||'INACTIVE'||''' AND FT_T_FIRL.PRNT_INST_MNEM = '''|| INST_MNEM_CLD ||''' AND FT_T_FIRL.REL_TYP = '''||'OPERATIVE'||''' AND FT_T_FIRL.FINSRL_TYP = '''||'CPARTY' ||'''';
      CONTADOR:=1;
      OPEN CUR_HIJOSGLOBAL FOR VCH_SQL_HIJOSGLOBAL;
      LOOP      
        FETCH CUR_HIJOSGLOBAL INTO INST_MNEM_HIJO;
        EXIT WHEN CUR_HIJOSGLOBAL%NOTFOUND;      
        DBMS_OUTPUT.PUT_LINE('INST_MNEM_HIJO ' || INST_MNEM_HIJO);            
        SELECT FIRL_OID INTO FIRL_OID_HIJO FROM FT_T_FIRL WHERE INST_MNEM = INST_MNEM_HIJO  AND REL_TYP = 'OPERATIVE' AND FINSRL_TYP= 'CPARTY';
        DBMS_OUTPUT.PUT_LINE('FIRL_OID_HIJO ' || FIRL_OID_HIJO);  
        SELECT INST_NME INTO INST_NME_CHLD FROM FT_T_FINS WHERE INST_MNEM = INST_MNEM_HIJO ;
        DBMS_OUTPUT.PUT_LINE('Modificando la FIRL ');
        -- Inserccion en la FIRL
        UPDATE FT_T_FIRL SET PRNT_INST_MNEM = INST_MNEM_CLP, LAST_CHG_TMS = SYSDATE, LAST_CHG_USR_ID = 'REFUNDICION' WHERE FIRL_OID = FIRL_OID_HIJO;
        --LOGICA PARA MANTENER LA MATRIZ DEL CLIENTE QUE DESAPARECE SI REFUNDE SOBRE UN CLIENTE INACTIVO (SI EL GLOBAL ESTA INACTIVO NO TIENE MATRIZ) O SOBRE UN MISMO GLOBAL
		IF CUENTA_GLOBAL = 0 THEN
			UPDATE FT_T_FINS SET FT_T_FINS.SUBSIDIARY_IND = 'S', FT_T_FINS.LAST_CHG_TMS = SYSDATE, FT_T_FINS.LAST_CHG_USR_ID = 'REFUNDICION' WHERE FT_T_FINS.INST_MNEM = INST_MNEM_HIJO AND FT_T_FINS.SUBSIDIARY_IND = 'N';
			UPDATE FT_T_FINS SET FT_T_FINS.LAST_CHG_TMS = SYSDATE, FT_T_FINS.LAST_CHG_USR_ID = 'REFUNDICION' WHERE FT_T_FINS.INST_MNEM = INST_MNEM_HIJO AND FT_T_FINS.SUBSIDIARY_IND = 'S';
        ELSE
			UPDATE FT_T_FINS SET FT_T_FINS.LAST_CHG_TMS = SYSDATE, FT_T_FINS.LAST_CHG_USR_ID = 'REFUNDICION' WHERE FT_T_FINS.INST_MNEM = INST_MNEM_HIJO;
		END IF;
		INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,TRN,contador,1,'Refundicion realizada de forma correcta',INST_MNEM_HIJO,'REPORTES','REFUNDICION','Cliente Cerrado',CLIENTED,'Cliente Destino',CLIENTEP,'INST_MNEM_CPTY_AFECTADAS',FINSID_LOCAL_CERRADA,sysdate,null,sysdate,'BBVA:CUSTOMER','PENDING','M');
        CONTADOR:= CONTADOR+1;  
      END LOOP;
      
      -- 2. LOGICA PARA CERRAR EL LOCAL  
      SELECT count (FT_T_FINS.INST_MNEM) INTO COUNT_HIJOS_LOCALES FROM FT_T_FIRL, FT_T_FINS WHERE FT_T_FINS.INST_MNEM = FT_T_FIRL.INST_MNEM AND FT_T_FINS.DATA_STAT_TYP != 'INACTIVE' AND FT_T_FIRL.PRNT_INST_MNEM = INST_MNEM_CLD AND FT_T_FIRL.REL_TYP = 'OPERATIVE' AND FT_T_FIRL.FINSRL_TYP = 'CPARTY';
      DBMS_OUTPUT.PUT_LINE('COUNT_HIJOS_LOCALES ' || COUNT_HIJOS_LOCALES);
      IF COUNT_HIJOS_LOCALES = 0 THEN   
        -- CIERRE DE UN LOCAL
        DBMS_OUTPUT.PUT_LINE('CIERRE DE UN LOCAL');
        DBMS_OUTPUT.PUT_LINE('INST_MNEM_CLD ' || INST_MNEM_CLD);
        -- CHECK SI ES COMPARTIDA
        select count (ft_T_enfr.org_id) INTO COUNT_ALTAMIRA_D from ft_T_enfr where ft_T_enfr.org_id = '1145' and ft_T_enfr.data_StaT_typ = 'ACTIVE' and ft_t_enfr.enfr_rl_typ = 'LOCAL_ENT' and ft_t_enfr.finr_inst_mnem = INST_MNEM_CLD;
        select count (ft_T_enfr.org_id) INTO COUNT_ALTAMIRA_P from ft_T_enfr where ft_T_enfr.org_id = '1145' and ft_T_enfr.data_StaT_typ = 'ACTIVE' and ft_t_enfr.enfr_rl_typ = 'LOCAL_ENT' and ft_t_enfr.finr_inst_mnem = INST_MNEM_CLP;
        --SI ES MEXICANA
        IF ((COUNT_ALTAMIRA_D > 0) AND (COUNT_ALTAMIRA_P = 0)) THEN
          -- MOVER FIID
          update ft_t_fiid FIID set FIID.inst_mnem = INST_MNEM_CLP, LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate where FIID.data_Stat_typ = 'ACTIVE' and FIID.fins_id_ctxt_typ in ('ALID','SHORTNAME_MEX','HOMOCLAV','CURP','RFC') and FIID.inst_mnem = INST_MNEM_CLD;  
          -- MOVER ENFR
          update ft_t_enfr set ft_t_enfr.inst_mnem = INST_MNEM_CLP, ft_t_enfr.finr_inst_mnem = INST_MNEM_CLP, ft_t_enfr.LAST_CHG_USR_ID = 'REFUNDICION', ft_t_enfr.LAST_CHG_TMS = sysdate where ft_T_enfr.org_id = '1145' and ft_T_enfr.data_StaT_typ = 'ACTIVE' and ft_t_enfr.enfr_rl_typ = 'LOCAL_ENT' and ft_t_enfr.finr_inst_mnem = INST_MNEM_CLD;
          -- MOVER MADR
          update ft_t_madr set ft_t_madr.cnty_nme = (select CNTY.cnty_nme from fT_t_madr CNTY where CNTY.data_StaT_typ = 'ACTIVE' and CNTY.mail_addr_id = (select fT_t_adtp.mail_addr_id from fT_t_adtp where fT_t_adtp.data_stat_typ = 'ACTIVE' and fT_t_adtp.addr_typ = 'FISCAL' and fT_t_adtp.inst_mnem = INST_MNEM_CLD)), ft_t_madr.addr_ln2_txt = (select AD2.addr_ln2_txt from fT_t_madr AD2 where AD2.data_StaT_typ = 'ACTIVE' and AD2.mail_addr_id = (select fT_t_adtp.mail_addr_id from fT_t_adtp where fT_t_adtp.data_stat_typ = 'ACTIVE' and fT_t_adtp.addr_typ = 'FISCAL' and fT_t_adtp.inst_mnem = INST_MNEM_CLD)), ft_t_madr.addr_ln3_txt = (select AD3.addr_ln3_txt from fT_t_madr AD3 where AD3.data_StaT_typ = 'ACTIVE' and AD3.mail_addr_id = (select fT_t_adtp.mail_addr_id from fT_t_adtp where fT_t_adtp.data_stat_typ = 'ACTIVE' and fT_t_adtp.addr_typ = 'FISCAL' and fT_t_adtp.inst_mnem = INST_MNEM_CLD)), ft_t_madr.neighborhood_nme = (select NEIG.neighborhood_nme from fT_t_madr NEIG where NEIG.data_StaT_typ = 'ACTIVE' and NEIG.mail_addr_id = (select fT_t_adtp.mail_addr_id from fT_t_adtp where fT_t_adtp.data_stat_typ = 'ACTIVE' and fT_t_adtp.addr_typ = 'FISCAL' and fT_t_adtp.inst_mnem = INST_MNEM_CLD)), ft_t_madr.township_nme = (select TOWN.township_nme from fT_t_madr TOWN where TOWN.data_StaT_typ = 'ACTIVE' and TOWN.mail_addr_id = (select fT_t_adtp.mail_addr_id from fT_t_adtp where fT_t_adtp.data_stat_typ = 'ACTIVE' and fT_t_adtp.addr_typ = 'FISCAL' and fT_t_adtp.inst_mnem = INST_MNEM_CLD)), ft_t_madr.LAST_CHG_USR_ID = 'REFUNDICION', ft_t_madr.LAST_CHG_TMS = sysdate where ft_t_madr.data_stat_typ = 'ACTIVE' and ft_t_madr.mail_addr_id = (select fT_t_adtp.mail_addr_id from fT_t_adtp where fT_t_adtp.data_stat_typ = 'ACTIVE' and fT_t_adtp.addr_typ = 'FISCAL' and fT_t_adtp.inst_mnem = INST_MNEM_CLP);
        END IF;
        UPDATE FT_T_FIID SET DATA_STAT_TYP = 'INACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLD AND DATA_STAT_TYP <> 'INACTIVE'  AND FINS_ID_CTXT_TYP <>  'FINSID';
        UPDATE FT_T_FINR SET DATA_STAT_TYP = 'INACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLD AND DATA_STAT_TYP <> 'INACTIVE';
        UPDATE FT_T_FINS SET DATA_STAT_TYP = 'INACTIVE', END_TMS = NULL, LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLD AND DATA_STAT_TYP <> 'INACTIVE';
		--INSERT PARA LA BAJA DEL 460
		INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,TRN,'1','1','Contrato 460 pendiente de dar de baja',INST_MNEM_CLD,'PROCESO','REFUNDICION','Cliente Cerrado',CLIENTED,'Cliente Destino',CLIENTEP,'INST_MNEM_CPTY_AFECTADAS',INST_MNEM_CLD,sysdate,null,sysdate,'BBVA:CUSTOMER','PENDING','B460');      
      END IF;
      -- LOGICA PARA CERRAR EL GLOBAL SI PROCEDE
      SELECT count (FT_T_FINS.INST_MNEM) INTO COUNT_HIJOS_GLOBALES FROM FT_T_FIRL FIRLL, FT_T_FINS WHERE FT_T_FINS.INST_MNEM = FIRLL.INST_MNEM AND FT_T_FINS.DATA_STAT_TYP != 'INACTIVE' AND FIRLL.REL_TYP = 'LOCAL' AND FIRLL.FINSRL_TYP = 'CUSTOMER' AND FIRLL.PRNT_INST_MNEM = INST_MNEM_GLOBAL;
      DBMS_OUTPUT.PUT_LINE('COUNT_HIJOS_GLOBALES ' || COUNT_HIJOS_GLOBALES);
      IF COUNT_HIJOS_GLOBALES = 0 THEN   
        -- CIERRE DE UN GLOBAL
        DBMS_OUTPUT.PUT_LINE('CIERRE DE UN GLOBAL');
        UPDATE FT_T_FIID SET DATA_STAT_TYP = 'INACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_GLOBAL AND DATA_STAT_TYP <> 'INACTIVE' AND FINS_ID_CTXT_TYP <>  'FINSID';
        UPDATE FT_T_FINR SET DATA_STAT_TYP = 'INACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_GLOBAL AND DATA_STAT_TYP <> 'INACTIVE';
        UPDATE FT_T_FINS SET DATA_STAT_TYP = 'INACTIVE', END_TMS = NULL, LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_GLOBAL AND DATA_STAT_TYP <> 'INACTIVE';
        UPDATE FT_T_FLG1 SET DATA_STAT_TYP = 'INACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_GLOBAL AND DATA_STAT_TYP <> 'INACTIVE';
      END IF;
      DBMS_OUTPUT.PUT_LINE('REFUNDICION REALIZADA DE MANERA SATISFACTORIA');
    END IF;
    
    -- CASO C: EL QUE EL CLIENTELA DESTINO ESTA DUPLICADO
    IF COUNT_INST_MNEM_CLP > 1 THEN
      RAISE CLIENTEP_DUPLICATE;
    END IF;

    
    -- CONTROL DE EXCEPCIONES
    EXCEPTION
    -- 1. Clientela cierre no encontrado
    WHEN CLIENTED_NOT_FOUND THEN          
      DBMS_OUTPUT.PUT_LINE('Clientela cierre no encontrado');
      INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,TRN,contador,1,'No existe el Clientela a Refundir','NOT_FOUND','REPORTES','REFUNDICION','Cliente Cerrado',CLIENTED,'Cliente Destino',CLIENTEP,'CLIENTED;CLIENTEP',CLIENTED||';'||CLIENTEP,sysdate,null,sysdate,'BBVA:CUSTOMER','NO','null');
    -- 2. Clientela cierre duplicado
    WHEN CLIENTED_DUPLICATE THEN      
      DBMS_OUTPUT.PUT_LINE('Clientela cierre duplicado');
      INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,TRN,contador,1,'El Clientela a Refundir esta duplicado','NOT_FOUND','REPORTES','REFUNDICION','Cliente Cerrado',CLIENTED,'Cliente Destino',CLIENTEP,'CLIENTED;CLIENTEP',CLIENTED||';'||CLIENTEP,sysdate,null,sysdate,'BBVA:CUSTOMER','NO','null');
	  INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,TRN,contador,1,'El Clientela a Refundir esta duplicado','NOT_FOUND','ERRORES','REFUNDICION','Cliente Cerrado',CLIENTED,'Cliente Destino',CLIENTEP,'CLIENTED;CLIENTEP',CLIENTED||';'||CLIENTEP,sysdate,null,sysdate,'BBVA:CUSTOMER','NO','null');
    -- 3. Clientela destino no encontrado
    WHEN CLIENTEP_NOT_FOUND THEN  
      DBMS_OUTPUT.PUT_LINE('Clientela destino no encontrado');
      INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,TRN,contador,1,'No existe el Clientela destino','NOT_FOUND','REPORTES','REFUNDICION','Cliente Cerrado',CLIENTED,'Cliente Destino',CLIENTEP,'CLIENTED;CLIENTEP',CLIENTED||';'||CLIENTEP,sysdate,null,sysdate,'BBVA:CUSTOMER','NO','null');
	  INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,TRN,contador,1,'No existe el Clientela destino','NOT_FOUND','ERRORES','REFUNDICION','Cliente Cerrado',CLIENTED,'Cliente Destino',CLIENTEP,'CLIENTED;CLIENTEP',CLIENTED||';'||CLIENTEP,sysdate,null,sysdate,'BBVA:CUSTOMER','NO','null');
    -- 4. Clientela destino no encontrado
    WHEN CLIENTEP_DUPLICATE THEN  
      DBMS_OUTPUT.PUT_LINE('Clientela destino duplicada');
      INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,TRN,contador,1,'El Clientela destino esta duplicado','NOT_FOUND','REPORTES','REFUNDICION','Cliente Cerrado',CLIENTED,'Cliente Destino',CLIENTEP,'CLIENTED;CLIENTEP',CLIENTED||';'||CLIENTEP,sysdate,null,sysdate,'BBVA:CUSTOMER','NO','null');
	  INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,TRN,contador,1,'El Clientela destino esta duplicado','NOT_FOUND','ERRORES','REFUNDICION','Cliente Cerrado',CLIENTED,'Cliente Destino',CLIENTEP,'CLIENTED;CLIENTEP',CLIENTED||';'||CLIENTEP,sysdate,null,sysdate,'BBVA:CUSTOMER','NO','null');
    -- 5. ERRORES INESPERADOS
    WHEN OTHERS THEN    
      DBMS_OUTPUT.PUT_LINE('Error Inesperado');
      INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,TRN,contador,1,'Error inesperado','NOT_FOUND','REPORTES','REFUNDICION','Cliente Cerrado',CLIENTED,'Cliente Destino',CLIENTEP,'CLIENTED;CLIENTEP',CLIENTED||';'||CLIENTEP,sysdate,null,sysdate,'BBVA:CUSTOMER','NO','null');
	  INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,TRN,contador,1,'Error inesperado','NOT_FOUND','ERRORES','REFUNDICION','Cliente Cerrado',CLIENTED,'Cliente Destino',CLIENTEP,'CLIENTED;CLIENTEP',CLIENTED||';'||CLIENTEP,sysdate,null,sysdate,'BBVA:CUSTOMER','NO','null');

	  
END REFUNDICION]]></objectValue>
<type>CONSTANT</type>
</item>
