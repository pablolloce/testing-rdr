<item id="991" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="992">querySQL</name>
<stringValue id="993">UPDATE FT_T_ALR1
   SET LAST_SEND_TMS = SYSDATE
 WHERE DATA_STAT_TYP = 'ACTIVE'
   AND PROCESO = ?
   AND TIPO_ENVIO = ?
   AND ALM1_OID IN (SELECT ALM1_OID
                      FROM FT_T_ALM1
                     WHERE MEDIO_ENVIO = 'EMAIL'
                       AND DIRECCION = ?
                       AND DATA_STAT_TYP = 'ACTIVE')
   AND ALU1_OID IN (SELECT ALU1_OID
                      FROM FT_T_ALU1
                     WHERE DATA_STAT_TYP = 'ACTIVE')</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
