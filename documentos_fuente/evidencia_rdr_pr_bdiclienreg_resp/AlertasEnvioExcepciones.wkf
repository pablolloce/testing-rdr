<item id="89" type="com.j2fe.workflow.definition.Transition">
<name id="90">goto-next</name>
<source idref="74"/>
<target id="91">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="92">Generar Mail BASKETS SPONSORS</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="93">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="94" type="java.util.HashSet">
<item id="95" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="96">statements</name>
<objectValue id="97" type="java.lang.String"><![CDATA[import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("AlertasEnvio - Mail variables");

String body ="";
String subject = "";
String listaErroresCarga = "";
String listaErroresPublicacion = "";
String listaSinInformacion= "";
String textoErroresCarga = "";
String textoSinInformacion = "";
String textoErroresPublicacion = "";

int total = reportMap[0].get("TOTAL");
int errores = reportMap[0].get("ERRORES");
int cargados = reportMap[0].get("CARGADOS");
int missing = reportMap[0].get("MISSING");
int ack = reportMap[0].get("ACK");
int nack = reportMap[0].get("NACK");
int koPublicacion = cargados-ack;


subject = "Reporte Carga Índices Cotizados - Total: " +total+ " / OK: " +cargados+ " / KO Carga: " +errores+ " / Sin Info Carga: "+missing+" / KO Publicación: " + koPublicacion;

if (cargados>0 || missing>0 || koPublicacion>0){
	
		for (Map resultado : reportMap){
			if(resultado.get("MENSAJE_INDEX") != null){
				if (resultado.get("PUBLISHED") != null && resultado.get("PUBLISHED").equals("0")){
					if (!listaErroresCarga.equals("")){
							listaErroresCarga=listaErroresCarga+",";
					}
					listaErroresCarga=listaErroresCarga+resultado.get("TOTAL_INDEX");
				}else if (resultado.get("PUBLISHED") != null && resultado.get("PUBLISHED").equals("1")){
					if(!(resultado.get("ACKNACK") != null && resultado.get("ACKNACK").equals("ACK"))){
						if (!listaErroresPublicacion.equals("")){
							listaErroresPublicacion=listaErroresPublicacion+",";
						}
						listaErroresPublicacion=listaErroresPublicacion+resultado.get("TOTAL_INDEX");
					}
				}
			}else{
				if (!listaSinInformacion.equals("")){
					listaSinInformacion=listaSinInformacion+",";
				}
				listaSinInformacion=listaSinInformacion+resultado.get("TOTAL_INDEX");
			}
		}
	
	if (cargados > 0 ) {
		textoErroresCarga = "Cestas con error de carga en RDR: " + listaErroresCarga + "\r\n\r\n";
	}
	if (missing > 0 ) {
		textoSinInformacion = "Cestas sin información de carga en RDR (probablemente con error): " + listaSinInformacion + "\r\n\r\n";
	}
	if (koPublicacion > 0 ) {
		textoErroresPublicacion = "Cestas con error de publicación a MX3: " + listaErroresPublicacion + "\r\n\r\n";
	}
}

body = "Estimado usuario,\r\n\r\n"+
"Se adjunta el informe de la carga de índices cotizados.\r\n\r\n" +
"Total de cestas procesadas: " + total + "\r\n\r\n" +
"Total de cestas cargadas en RDR: " + cargados + "\r\n\r\n" + 
"Total de cestas con error de carga en RDR: " + errores + "\r\n\r\n" +
"Total de cestas sin información de carga (probablemente con error): " + missing + "\r\n\r\n" +
"Total de cestas publicadas a MX3: " + ack + "\r\n\r\n" + 
"Total de cestas con error de publicación a MX3: " + koPublicacion + "\r\n\r\n" +
textoErroresCarga +
textoSinInformacion +
textoErroresPublicacion +
"Un saludo.";

logger.error("destination : " + destination );
logger.error("subject: " + subject);
logger.error("body: " + body);
]]></objectValue>
<type>CONSTANT</type>
</item>
