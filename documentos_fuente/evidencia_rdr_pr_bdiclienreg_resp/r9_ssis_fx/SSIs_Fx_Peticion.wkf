<stringValue id="88">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("SSIs_Fx_Peticion");

logger.error("Inicio del proceso de Investor Plan - Alta SSIs");
logger.error(" Punto 2 -Recuperacion Nemonicos Fondos.");

Integer counterUTD1 =0;</stringValue>
