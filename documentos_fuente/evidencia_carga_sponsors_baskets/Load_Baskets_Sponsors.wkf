<item id="192" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="193">statements</name>
<stringValue id="194">String mensaje = "";
String tipoMensaje = "";
String[] arrayMensaje = new String[2]; 

mensaje = "Fin de carga de la cesta: " + indexMap.get("indexId") + " del sponsor: " + sponsor + " de tipo: " + fileType;
tipoMensaje = "INFO";

arrayMensaje[0] = tipoMensaje;
arrayMensaje[1] = mensaje;

listaErrores.add(arrayMensaje);</stringValue>
<type>CONSTANT</type>
</item>
