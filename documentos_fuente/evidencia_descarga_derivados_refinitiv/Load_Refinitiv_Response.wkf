<item id="379" type="com.j2fe.workflow.definition.Transition">
<name id="380">goto-next</name>
<source id="381">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="382">Read Issue line to map</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="383">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="384" type="java.util.HashSet">
<item id="385" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="386">statements</name>
<stringValue id="387"><![CDATA[import java.util.HashMap;
import java.util.LinkedHashMap;
import java.util.Map;

Map fieldsMap = new LinkedHashMap();

String[] fieldsArray = fieldList.split(",");
String[] lineArray = fileLine.split("\\|");
int fieldCounter = 0;
//declaramos mapa vacio
for (String field : fieldsArray) {
	fieldsMap.put(field,"");
}

for (String field : fieldsArray) {
	if (fieldCounter < lineArray.length){
		fieldsMap.put(field,lineArray[fieldCounter]);
	}
	fieldCounter++;
}

idAndMicMap.put(fieldsMap.get("Requested Identifier").trim(),fieldsMap.get("MIC List"));]]></stringValue>
<type>CONSTANT</type>
</item>
<item id="388" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="389">["fieldList"]@java/lang/String@</UITypeHint>
<input>true</input>
<name id="390">variables["fieldList"]</name>
<stringValue id="391">outputLayout</stringValue>
<type>VARIABLE</type>
</item>
<item id="392" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="393">["fileLine"]@java/lang/Object@</UITypeHint>
<input>true</input>
<name id="394">variables["fileLine"]</name>
<stringValue id="395">IncrementedObjects</stringValue>
<type>VARIABLE</type>
</item>
<item id="396" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="397">variables["idAndMicMap"]</name>
<stringValue id="398">idAndMicMap</stringValue>
<type>VARIABLE</type>
</item>
<item id="399" type="com.j2fe.workflow.definition.Parameter">
<input>false</input>
<name id="400">variables["idAndMicMap"]</name>
<stringValue id="401">idAndMicMap</stringValue>
<type>VARIABLE</type>
</item>
</parameters>
