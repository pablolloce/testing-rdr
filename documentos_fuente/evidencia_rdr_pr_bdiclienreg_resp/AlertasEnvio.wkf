<item id="869" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="870">statements</name>
<objectValue id="871" type="java.lang.String"><![CDATA[import java.util.regex.Matcher;
import java.util.regex.Pattern;
import org.apache.log4j.Logger;
import java.io.File;

Logger logger = Logger.getLogger("AlertasEnvio - Get attachment");

String nameFile ="";
String FileBody="";
	   FileMail="";
String directory = RUTA[0].get("RUTA");
Pattern pattern = Pattern.compile("\\$ENV");
Matcher matcher = pattern.matcher(directory);

directory  = matcher.replaceAll(env);
logger.error("[AlertasEnvio - Get attac WORD] directory: "+directory);

resultado = "KO";
enviar = "N";

String short_proc = SH_PROC[0].get("SHORT_PROCESS");
String auxAdjunto="";
String auxCuerpo="";

boolean existeAdjunto=false;
boolean existeCuerpo=false;

if(short_proc != null && short_proc.length() > 0){
	auxAdjunto=SH_PROC[0].get("SHORT_PROCESS")+".docx";
	auxCuerpo = "BODY_" + SH_PROC[0].get("SHORT_PROCESS") + ".txt";
	try{
		File carpeta = new File(directory);
		if(carpeta.exists()){
			for (File fich : carpeta.listFiles()) {
				if (fich.isDirectory()==false) {
					if (fich.getName().equals(auxAdjunto)) {	
						if (fich.exists()){
							nameFile = fich.getName();
							FileMail = fich.toString();
							logger.error("[AlertasEnvio - Get attachment] nameFile: "+ nameFile);
							existeAdjunto=true;
						}
					}else if(fich.getName().equals(auxCuerpo)){
						if (fich.exists()){
							FileBody = fich.toString();
							existeCuerpo=true;
						}
					}
				}
			}
		}else{
			resultado = "KO";
		}
	}catch(Exception e){
		resultado = "KO";
	}
} else {
	resultado = "KO";
}

if(existeCuerpo){
	File archivo = null;
	FileReader fr = null;
	BufferedReader br = null;
	txtBody ="";
	try {
		archivo = new File (FileBody);
		fr = new FileReader (archivo);
		br = new BufferedReader(fr);
		// Lectura del fichero
		String linea="";
		while((linea=br.readLine())!=null){
			txtBody += linea+"\r\n";
		}
		resultado = "OK";
		enviar = "S";
	}catch(Exception e){
		    logger.error("[AlertasEnvio - Reading Body] error:"+ e.toString());
			enviar="N";
	}finally{
		try{                    
			if( null != fr ){   
		       	fr.close();     
		       }                  
		}catch (Exception e2){ 
		       e2.printStackTrace();
		}
	}
}
]]></objectValue>
<type>CONSTANT</type>
