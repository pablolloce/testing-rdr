					UPDATE FT_T_DLER SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_DSRC SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_ENFR SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_EXAC SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_FEO1 SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_FFRL SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_FICL SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_FIDE SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_FIGP SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_FIGR SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_FIGU SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
					UPDATE FT_T_FIID SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID IN ('BAJA_CPARTY','REFUNDICION');
					UPDATE FT_T_FINR SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID IN ('BAJA_CPARTY','REFUNDICION');
					UPDATE FT_T_FINS SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', DATA_SRC_ID = 'RDR',LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID IN ('BAJA_CPARTY','REFUNDICION');
					UPDATE FT_T_FIRL SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = MNEMONICO_GLOBAL AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
