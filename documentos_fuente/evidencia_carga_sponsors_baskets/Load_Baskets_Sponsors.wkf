<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="1187">Componentes en BBDD a Mapa</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="1188">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="1189" type="java.util.HashSet">
<item id="1190" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="1191">statements</name>
<objectValue id="1192" type="java.lang.String"><![CDATA[if (inputMap.get(mainIdType)==null || (!secondaryIdType.equals("") && inputMap.get(secondaryIdType)==null) || inputMap.get("SECLABEL")==null || inputMap.get("ISSU_MKT_CNT") > 1){
	componentsBajaMap.put(inputMap.get("ISGPOID"),inputMap.get("CANONICO"));
}else{
	if (!mainIdType.equals("ISIN")){
		if (inputMap.get(mainIdType+"_MKT")==null || inputMap.get("MKTOID")==null){
			componentsBajaMap.put(inputMap.get("ISGPOID"),inputMap.get("CANONICO"));
		}else if (!inputMap.get(mainIdType+"_MKT").equals(inputMap.get("MKTOID"))){
			if (inputMap.get(mainIdType+"_MKT_GRP")==null || inputMap.get("SECLABEL_MKT_GRP")==null || (!inputMap.get("SECLABEL_MKT_GRP").equals(inputMap.get(mainIdType+"_MKT_GRP")))){
				componentsBajaMap.put(inputMap.get("ISGPOID"),inputMap.get("CANONICO"));
			} else {
				componentsMap.put(inputMap.get(mainIdType), inputMap);
			}
		}else{
			componentsMap.put(inputMap.get(mainIdType), inputMap);
		}
	}else {
		componentsMap.put(inputMap.get(mainIdType), inputMap);
	}
}]]></objectValue>
<type>CONSTANT</type>
</item>
