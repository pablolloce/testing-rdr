<name id="129">querySQL</name>
<stringValue id="130">SELECT FRA1.inst_mnem FROM   
FT_T_FRA1 FRA1,  
FT_T_INCL INCL1 
WHERE inst_mnem = ? 
AND FRA1.clsf_oid = INCL1.clsf_oid   
AND INCL1.CL_VALUE = '04' 
AND INCL1.INDUS_CL_SET_ID = 'MANUALSFTR' 
AND INCL1.DATA_STAT_TYP  = 'ACTIVE' 
AND INCL1.END_TMS IS NULL 
</stringValue>
<type>CONSTANT</type>
</item>
