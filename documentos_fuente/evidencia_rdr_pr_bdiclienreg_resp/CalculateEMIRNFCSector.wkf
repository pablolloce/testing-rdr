<item id="501" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="502">statements</name>
<stringValue id="503"><![CDATA[//Declaracion de variables
Map valores = new HashMap();

String [] etiquetas = new String [5];
etiquetas[0] = "MAIN_ENTITY_ID";
etiquetas[1] = "MAIN_ENTITY_ID_CTXT_TYP";
etiquetas[2] = "MAIN_ENTITY_NME";
etiquetas[3] = "MAIN_ENTITY_TYP";
etiquetas[4] = "MAIN_ENTITY_TBL_TYP";

valores.put (etiquetas[0],((trndMessage!= null && trndMessage.length() > 0) ? trndMessage : (modifiable > 0 ? "Sectorization no modificable" : "CNAE: " + cnae + ";" + "Sector: " + cnaeSect)));
valores.put (etiquetas[1],"GRI-" + cntrprtyGlobalOid);
valores.put (etiquetas[2],"CÃ¡lculo EMIR Sectorization NFC");
valores.put (etiquetas[3],"EMISECNF");
valores.put (etiquetas[4],"FRA1");]]></stringValue>
<type>CONSTANT</type>
</item>
