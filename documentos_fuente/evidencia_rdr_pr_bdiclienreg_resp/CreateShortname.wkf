<item id="338" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="339">statements</name>
<stringValue id="340"><![CDATA[//DeclaraciÃ³n de variables
Map valores = new HashMap();

String [] etiquetas = new String [5];

etiquetas[0] = "MAIN_ENTITY_ID";
etiquetas[1] = "MAIN_ENTITY_ID_CTXT_TYP";
etiquetas[2] = "MAIN_ENTITY_NME";
etiquetas[3] = "MAIN_ENTITY_TYP";
etiquetas[4] = "MAIN_ENTITY_TBL_TYP";


valores.put (etiquetas[0], (compcoun != null && compcoun.length > 0) ? compcoun[0].get("COMPCOUN"): "No Existe Legal Name");
valores.put (etiquetas[1],"SHT-" + cntrprtyOperativeOid);
valores.put (etiquetas[2],"Shortname RDR Identifier -- No se realiza ninguna accion");
valores.put (etiquetas[3],"SHTNMEID");
valores.put (etiquetas[4],"FRID");]]></stringValue>
<type>CONSTANT</type>
</item>
