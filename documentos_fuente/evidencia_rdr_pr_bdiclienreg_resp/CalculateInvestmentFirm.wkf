<stringValue id="603">//Declaracion de variables
import java.util.HashMap;

Map valores = new HashMap();

String [] etiquetas = new String [5];
String GlobalOid2 =null;
GlobalOid2 =cntrprtyGlobalOid;

etiquetas[0] = "MAIN_ENTITY_ID";
etiquetas[1] = "MAIN_ENTITY_ID_CTXT_TYP";
etiquetas[2] = "MAIN_ENTITY_NME";
etiquetas[3] = "MAIN_ENTITY_TYP";
etiquetas[4] = "MAIN_ENTITY_TBL_TYP";


valores.put (etiquetas[0],statchar[0].get("VALTXT"));
valores.put (etiquetas[1],"IF-" + GlobalOid2);
valores.put (etiquetas[2],"InvestmentFirm -- Insert: " + row);
valores.put (etiquetas[3],"VALTXT");
valores.put (etiquetas[4],"FIST");</stringValue>
<type>CONSTANT</type>
</item>
