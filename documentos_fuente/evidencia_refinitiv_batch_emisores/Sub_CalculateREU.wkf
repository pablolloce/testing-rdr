<name id="4128">querySQL</name>
<stringValue id="4129">INSERT INTO FT_T_FRRL (FRRL_OID, PRNT_FINSRL_TYP, 
INST_MNEM, 
FINSRL_TYP, 
REL_TYP, 
START_TMS, LAST_CHG_TMS, 
LAST_CHG_USR_ID, 
DATA_STAT_TYP, DATA_SRC_ID, 
PARTICIPANT_ID, PRNT_FINR_OID, FINR_OID)
values (new_oid,'REUINHER',
 ? ,
'CPARTY',
(SELECT CLSF_OID FROM FT_T_INCL WHERE INDUS_CL_SET_ID = 'REUORG' and CL_NME = 'Automatic'), 
sysdate, sysdate,
 ? ,
'ACTIVE', 'RDR',
?, 
(SELECT FINR_OID FROM FT_T_FINR  where FINSRL_TYP='CPARTY' and INST_MNEM= ?) ,
 (  SELECT FINR_OID FROM FT_T_FINR  where FINSRL_TYP='CPARTY' and INST_MNEM= ? ) )
</stringValue>
<type>CONSTANT</type>
</item>
