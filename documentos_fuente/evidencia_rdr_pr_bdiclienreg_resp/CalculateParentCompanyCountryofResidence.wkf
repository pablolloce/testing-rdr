<item id="93" type="com.j2fe.workflow.definition.Transition">
<name id="94">goto-next</name>
<source id="95">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="96">Parent Company Country of Residence Calculation</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="97">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="98" type="java.util.HashSet">
<item id="99" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="100">statements</name>
<objectValue id="101" type="java.lang.String"><![CDATA[//Declaración de variables
Map calculoCompcoun = new HashMap();
String corprelText = "";

if (!calculoCorprel.isEmpty())
{
	corprelText = calculoCorprel.get("CORPREL");
}else
{
	corprelText = "NE";
}

//Control de nulos para País de Garantía
if (residenceCountry != null && residenceCountry.length > 0)
{
	residenceText = residenceCountry[0].get("RESIDCO");
}else
{
	residenceText = "KO";
}

//Se aplica la lógica a partir de los valores recuperados de la extracción auxiliar y se recalcula el parent company country of residence

if ("CON".equals(corprelText) || "AFL".equals(corprelText))
{
	//Si la contrapartida contiene en el Corporate Relationship datos distintos de Conduit y Affiliate
	if (compcoun != null && compcoun.length > 0) 
	{
		//Se da por válido el dato introducido por el usuario
		calculoCompcoun.put("COMPCOUN", compcoun[0].get("COMPCOUN"));

	}else
	{
		calculoCompcoun.put("COMPCOUN", "US");
	}
}else
{
	if (compcoun != null && compcoun.length > 0) 
	{
		//Se da por válido el dato introducido por el usuario
		calculoCompcoun.put("COMPCOUN", compcoun[0].get("COMPCOUN"));

	}else
	{
		if(!"KO".equals(residenceText))
		{
			calculoCompcoun.put("COMPCOUN", residenceText);
		}
	}

}
]]></objectValue>
<type>CONSTANT</type>
</item>
