<input>true</input>
<name id="2150">statements</name>
<stringValue id="2151">String mensaje = "";
String tipoMensaje = "";
String[] arrayMensaje = new String[2]; 

mensaje = "El "+indexTypeText+" con id "+indexId+" ha generado un error en su carga, revisar con ANS RDR la ejecución con Job Id: "+ jobId;

tipoMensaje = "ERROR TÉCNICO RDR";

arrayMensaje[0] = tipoMensaje;
arrayMensaje[1] = mensaje;

listaErrores.add(arrayMensaje);</stringValue>
<type>CONSTANT</type>
</item>
