<name id="291">statements</name>
<stringValue id="292">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("SSIsExec");
logger.error("MDXSSIsSetup Module - Result: FAILED");

RES.put("Result","NACK");
RES.put("ErrorID","XSITEC002");
RES.put("Message","Data Base Setup Error");
RES.put("MessageG","RDR Technical Error");
RES.put("Module","MDXSSIsSetup");
RES.put("Reg","Online SSIs Setup");
RES.put("TransID",TransID);
RES.put("AccUsu","0000");

Resultado="KO";</stringValue>
<type>CONSTANT</type>
