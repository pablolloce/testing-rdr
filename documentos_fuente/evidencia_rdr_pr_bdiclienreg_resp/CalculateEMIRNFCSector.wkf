<nodeHandler>com.j2fe.general.activities.database.DBQuery</nodeHandler>
<nodeHandlerClass id="89">com.j2fe.general.activities.database.DBQuery</nodeHandlerClass>
<parameters id="90" type="java.util.HashSet">
<item id="91" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="92">database</name>
<stringValue id="93">jdbc/GSDM-1</stringValue>
<type>REFERENCE</type>
</item>
<item id="94" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="95">["01"]@java/lang/String@</UITypeHint>
<input>true</input>
<name id="96">mappedParameters["01"]</name>
<stringValue id="97">cntrprtyGlobalOid</stringValue>
<type>VARIABLE</type>
</item>
<item id="98" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="99">querySQL</name>
<objectValue id="100" type="java.lang.String">SELECT DISTINCT FIGU.inst_mnem
FROM ft_t_FIGU FIGU,
  ft_T_fins fins,
  FT_T_GUNT GUNT,
  FT_T_GUGR GUGR,
  FT_T_GUGP GUGP
WHERE FIGU.fins_gu_purp_typ = 'RESID_CO'
AND FIGU.DATA_STAT_TYP      = 'ACTIVE'
AND FIGU.GU_ID              = GUNT.PRNT_GU_ID
AND FIGU.GU_ID = GUGP.GU_ID
AND GUNT.prnt_gu_typ        = 'COUNTRY'
AND GUNT.DATA_STAT_TYP      = 'ACTIVE'
AND GUGP.PRNT_GU_GRP_OID    = GUGR.GU_GRP_OID
AND GUGP.DATA_STAT_TYP      = 'ACTIVE'
AND GUGR.GRP_PURP_TYP       = 'EMIRREGU'
AND GUGR.DATA_STAT_TYP      = 'ACTIVE'
AND FIGU.inst_mnem          = fins.inst_mnem
AND FINS.DATA_STAT_TYP     != 'INACTIVE'
AND FIGU.inst_mnem         IN
    (select firlout.inst_mnem from ft_t_firl firllo, ft_t_firl firlop, ft_t_fins fins, ft_t_firl firlout
    where firllo.prnt_inst_mnem=:cntrprtyGlobalOid and firllo.rel_typ='LOCAL'
    and firlop.prnt_inst_mnem=firllo.inst_mnem and firlop.rel_typ='OPERATIVE'
    and fins.inst_mnem=firlop.inst_mnem and fins.subsidiary_ind='N'
    and firlout.inst_mnem=firlop.prnt_inst_mnem
    and firllo.data_Stat_Typ='ACTIVE' and firlop.data_Stat_Typ='ACTIVE'
    and fins.data_Stat_Typ='ACTIVE' and firlout.data_Stat_Typ='ACTIVE')</objectValue>
<type>CONSTANT</type>
</item>
</parameters>
