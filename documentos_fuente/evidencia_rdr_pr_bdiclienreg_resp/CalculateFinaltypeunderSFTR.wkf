<name id="29">statements</name>
<stringValue id="30"><![CDATA[import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("Calculate Final type under SFTR");

if (hacerCalculoDR != null && hacerCalculoDR.length() > 0 && hacerCalculoDR.equalsIgnoreCase("false")) {
	logger.error("[CheckDatosRegulatorios] Calculate Final type under SFTR NO SE HACE CALCULO AQUI");

	return false;
}else{
	if (finalSftr  != null){ //&& finalSftr.length()>0) {
		logger.error("Calculate Final type under SFTR - TRUE");
		return true;
	}else{
		logger.error("Calculate Final type under SFTR - FALSE");
		return false;
	 }
}]]></stringValue>
<type>CONSTANT</type>
</item>
