<item id="206" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="207">querySQL</name>
<stringValue id="208">Insert into FT_T_FIGU (FIGU_OID,INST_MNEM,GU_ID,GU_TYP,GU_CNT,FINS_GU_PURP_TYP,START_TMS,END_TMS,LAST_CHG_TMS,
LAST_CHG_USR_ID,PART_CURR_CDE,FINS_GU_DESC,DATA_STAT_TYP,DATA_SRC_ID,PART_CAMT,PART_CPCT,TAX_ID_TYP,TAX_ID,
TAX_REPORT_ID_IND,GLOBAL_CSTDN_WTHHLD_IND) 
select NEW_OID,:mnem,:value,'COUNTRY',1,'COUNCOMP',SYSDATE,null,SYSDATE,'BBVA:CUSTOMER',null,null,'ACTIVE',
'RDR',null,null,null,null,null,null FROM DUAL WHERE NOT EXISTS
(SELECT * FROM FT_T_FIGU WHERE FINS_GU_PURP_TYP = 'COUNCOMP' AND TRIM(GU_ID) = :value AND INST_MNEM = :mnem)</stringValue>
<type>CONSTANT</type>
</item>
