<name id="1209">issuerRequestBE</name>
<source idref="29"/>
<target id="1210">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="1211">query VREQ</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="1212">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="1213" type="java.util.HashSet">
<item id="1214" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="1215">statements</name>
<stringValue id="1216"><![CDATA[String queryVreq="";
String status="";
String[] fileLineAux= fileLine.split("\\|");
String vreqTxt="";


if ( fileLine.contains("ERROR") ){
 	status="FAILED";

	for (int i = 0; i < fileLineAux.length; i++){
		if (fileLineAux[i].equals("ERROR") && i + 1 < fileLineAux.length){
			vreqTxt= fileLineAux[i + 1];
			break;
		}
	}

}else {
	status="PROCESSED";
	vreqTxt="Refinitiv request processed successfully";
}


queryVreq = "UPDATE FT_T_VREQ SET VND_RQST_STAT_TYP='"+status +"', VND_RQST_STAT_TXT='"+vreqTxt +"', LAST_CHG_TMS=SYSDATE, LAST_CHG_USR_ID='ALTA:ROL:EMISOR:RF' WHERE VND_RQST_OID='"+vreqOid +"' and VND_RQST_STAT_TYP='PENDING'";]]></stringValue>
<type>CONSTANT</type>
</item>
