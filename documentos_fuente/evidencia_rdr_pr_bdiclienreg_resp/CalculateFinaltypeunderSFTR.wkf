<parameters id="44" type="java.util.HashSet">
<item id="45" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="46">statements</name>
<objectValue id="47" type="java.lang.String"><![CDATA[import org.apache.commons.lang.StringUtils;
import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("Calculate Final type under SFTR");

//Declaracion de variables
String manSftr = "";
String sftr = "";
String finalSftr = "";

// Manual Counterparty type under SFTR
if (manualSftr != null && manualSftr.length > 0) {
	manSftr = manualSftr[0].get("VALOR");
}else{
	manSftr = "NE";
}

//Counterparty type under SFTR

if (cntrprtyTypeUnderSFTR != null && cntrprtyTypeUnderSFTR.length > 0) {
	if (cntrprtyTypeUnderSFTR[0].get("ETIQUETA") != null && !cntrprtyTypeUnderSFTR[0].get("ETIQUETA").equals("04")) {
		//sftr = cntrprtyTypeUnderSFTR[0].get("ETIQUETA");
		if (cntrprtyTypeUnderSFTR[0].get("ETIQUETA").equals("01") || cntrprtyTypeUnderSFTR[0].get("ETIQUETA").equals("02") ) {
			sftr = "01";
		}else if (cntrprtyTypeUnderSFTR[0].get("ETIQUETA").equals("03") || cntrprtyTypeUnderSFTR[0].get("ETIQUETA").equals("09") ) {
			sftr = "02";
		}else	{
			sftr = "";
		}
	}else	{
		sftr = "";
	}
}else{
	sftr = "NE";
}

if(!manSftr.equals("NE")){
	finalSftr = manSftr;
}else if (!sftr.equals("NE")){
	finalSftr = sftr;
}else{
	finalSftr = "NE";
}


logger.error("Calculate Final type under manSftr: "+manSftr );
logger.error("Calculate Final type under finalSftr: "+finalSftr);]]></objectValue>
<type>CONSTANT</type>
</item>
