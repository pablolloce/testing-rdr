<parameters id="115" type="java.util.HashSet">
<item id="116" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="117">statements</name>
<stringValue id="118"><![CDATA[IS_EXTF_BUCLE = "N";

boolean cumpleTipoInstrumento = 
    ("EXTF".equals(INSTRUMENT_TYPE) || "ETF".equals(INSTRUMENT_TYPE)) 
    || 
    ("ETFA".equals(ClassificationScheme) || "ETFC".equals(ClassificationScheme) 
  || "ETFE".equals(ClassificationScheme) || "ETF".equals(ClassificationScheme) 
  || "ETFB".equals(ClassificationScheme) || "ETFX".equals(ClassificationScheme) 
  || "ETFO".equals(ClassificationScheme) || "EXTF".equals(ClassificationScheme));

if (!"Y".equals(IS_EXTF)) {
    if (FUND_MANAGER != null && !FUND_MANAGER.trim().isEmpty() 
        && cumpleTipoInstrumento) {

        IS_EXTF = "Y";
    }
}

if (FUND_MANAGER != null && !FUND_MANAGER.trim().isEmpty() 
    && cumpleTipoInstrumento) {

    IS_EXTF_BUCLE = "Y";
}

FUND_MANAGER = "";

if ("N".equals(IS_EXTF_BUCLE)) {
    return true;
} else {
    return false;
}]]></stringValue>
<type>CONSTANT</type>
</item>
