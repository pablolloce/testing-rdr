<name id="155">statements</name>
<stringValue id="156"><![CDATA[if (!calculoCorprel.isEmpty() && corprel != null && corprel.length > 0) 
{
	//Control de estado de la extracciÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â³n del Corporate Relationship
	if(corprel[0].get("ESTADO").equals("ACTIVE"))
	{
		if(calculoCorprel.get("CORPREL").equals(corprel[0].get("CORPREL")))
		{
			update = true;
			return "out";
		}else
		{
			update = true;
			return true;
		}
	}else
	{
		//El dato se encuentra inactivo y se tiene que actualizar con el dato calculado y el status reactivado
		return "reactivar";
	}

}else
{
	update = false;
	return false;
	
}]]></stringValue>
<type>CONSTANT</type>
</item>
