<name id="56">querySQL</name>
<stringValue id="57"><![CDATA[select fins.inst_nme cparty2
from ft_t_fiid fiid, ft_t_firl firl, ft_t_fins fins 
where fiid.inst_mnem = firl.inst_mnem 
and fins.inst_mnem = firl.inst_mnem 
and firl.rel_typ='LOCAL' 
and fiid.fins_id_ctxt_typ='CLIENTELAID'
and fiid.fins_id= :finsid
and fins.data_stat_typ = 'ACTIVE'
and fiid.data_stat_typ = 'ACTIVE'
and rownum < 2]]></stringValue>
<type>CONSTANT</type>
</item>
</parameters>
