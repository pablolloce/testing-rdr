<item id="12" type="com.j2fe.workflow.definition.Transition">
<name id="13">KO</name>
<source id="14">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="15">Validate Xpath</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="16">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="17" type="java.util.HashSet">
<item id="18" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="19">statements</name>
<objectValue id="20" type="java.lang.String"><![CDATA[import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("SSIs_Valida_FX");
logger.error("Inicio validacion del mensaje XML.");

String errorText = "";

//Method
if(method==null||"".equals(method)||method.length()==0||(!"CASH".equals(method) &&!"FEDWIRE".equals(method))){
	logger.error("SSIs_Valida_FX Module - Result: FAILED");
	logger.error("Method no valido.");
errorText = "NoCodOid::El Method "+method+" no es valido para el alta de SDIs de F/X.";

	Resultado="KO";
	return "KO";
}
//Acronym
if(Acronym==null||"".equals(Acronym)||Acronym.length()==0){
	logger.error("SSIs_Valida_FX Module - Result: FAILED");
	logger.error("Acronym no informado.");
errorText = "El acronimo de la gestora no viene informado en la SDI recibida de Alert Mirror.";

	Resultado="KO";
	return "KO";
}
//AccessCode
if(AccessCode==null||"".equals(AccessCode)||AccessCode.length()==0){
	logger.error("SSIs_Valida_FX Module - Result: FAILED");
	logger.error("Access Code no informado.");
       errorText = "El Access Code del fondo no viene informado en la SDI recibida de Alert Mirror.";

	Resultado="KO";
	return "KO";
}
//Security
if(Security==null||"".equals(Security)||Security.length()==0||(!Security.equals("F/X")&&!Security.equals("CSH"))){
	logger.error("SSIs_Valida_FX Module - Result: FAILED");
	logger.error("Security no valido.");
	errorText = "NoCodOid::Security "+Security+" no valido para SDIs de F/X.";

	Resultado="KO";
	return "KO";
}
//BIC Corresponsal
if(BICCorresponsal==null||"".equals(BICCorresponsal)||BICCorresponsal.length()==0){
	logger.error("SSIs_Valida_FX Module - Result: FAILED");
	logger.error("BIC Corresponsal erroneo");
       errorText = "NoCodOid::El BIC del Corresponsal no viene informado en la instruccion de liquidacion recibida desde Alert Mirror.";

	Resultado="KO";
	return "KO";
}
//Currency
if(Currency==null||"".equals(Currency)||Currency.length()==0){
	logger.error("SSIs_Valida_FX Module - Result: FAILED");
	logger.error("Currency no valido.");
	errorText = "NoCodOid::La divisa no viene informada en la instruccion de liquidacion recibida desde Alert Mirror.";

	Resultado="KO";
	return "KO";
}
if(CountCurrency==null||"".equals(CountCurrency)||CountCurrency.length()==0||"0".equals(CountCurrency)){
	logger.error("SSIs_Valida_FX Module - Result: FAILED");
	logger.error("Currency no valido.");
	errorText = "NoCodOid::La  divisa "+Currency+" no esta dada de alta en RDR.";

	Resultado="KO";
	return "KO";
}
//CodOid
if(CodOid==null||"".equals(CodOid)||CodOid.length()==0){
	logger.error("SSIs_Valida_FX Module - Result: FAILED");
	logger.error("CodOid no valido.");
	errorText = "Alert ID de la SDI no viene informado en la instruccion de liquidacion recibida desde Alert Mirror.";

	Resultado="KO";
	return "KO";
}
	logger.error("SSIs_Valida_FX Module - Result: ACK");
	logger.error("XML de Alert Mirror Validado");
	Resultado="OK";
	return "OK";]]></objectValue>
<type>CONSTANT</type>
</item>
