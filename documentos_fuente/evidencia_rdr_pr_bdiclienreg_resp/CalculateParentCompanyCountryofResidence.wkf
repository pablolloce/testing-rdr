<parameters id="72" type="java.util.HashSet">
<item id="73" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="74">statements</name>
<stringValue id="75"><![CDATA[if (!calculoCompcoun.isEmpty() && compcoun != null && compcoun.length > 0 && residenceCountry != null && residenceCountry.length > 0) 
{
	if(calculoCompcoun.get("COMPCOUN").equals(compcoun[0].get("COMPCOUN")))
	{
		update = true;
		return "out";
	}else
	{
		update = true;
		return true;
	}

}else
{
	update = false;
	return false;
	
}]]></stringValue>
<type>CONSTANT</type>
</item>
