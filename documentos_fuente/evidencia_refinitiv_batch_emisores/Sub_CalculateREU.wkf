<parameters id="345" type="java.util.HashSet">
<item id="346" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="347">statements</name>
<objectValue id="348" type="java.lang.String"><![CDATA[import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("Sub_CalculateREU");


String SPOid = "";
String FitchOid = "";
String MoodysOid = "";
String REUOid = "";
String REUSPOid = "";
String REUFitchOid = "";
String REUMoodysOid = "";
String REUOidL = "";
String SPOidL = "";
String FitchOidL = "";
String MoodysOidL = "";

String literalSP = "S&P Long Term Foreign";
String literalMoodys = "Moody's Long Term Foreign";
String literalFitch = "Fitch Long Term Foreign";
String literalREU = "External Unified Rating Foreign";
String literalREUSP = "REU S&P Long Term";
String literalREUMoodys = "REU Moody's Long Term";
String literalREUFitch = "REU Fitch Long Term";
String literalREUL = "External Unified Rating Local";
String literalSPL = "S&P Long Term Local";
String literalMoodysL = "Moody's Long Term Local";
String literalFitchL = "Fitch Long Term Local";

if (rtngSetOidArray[0][0]  != null && !"".equals(rtngSetOidArray[0][0]) && literalREU.equals(rtngSetOidArray[0][0]) ){
	logger.error("Sub_CalculateREU FOR INCI 2003 ----------1----------------------------REUOid ------"+rtngSetOidArray[0][1]);
	REUOid = rtngSetOidArray[0][1];
} else {
	logger.error("Sub_CalculateREU FOR INCI 2003 ----------2----------------------------REUOid ------");
	REUOid = "";
}

if (rtngSetOidArray[1][0]  != null && !"".equals(rtngSetOidArray[1][0]) && literalREUL.equals(rtngSetOidArray[1][0]) ){
	logger.error("Sub_CalculateREU LOC INCI 2003 ----------1----------------------------REUOid -----"+rtngSetOidArray[1][1]);
	REUOidL = rtngSetOidArray[1][1];
} else {
	logger.error("Sub_CalculateREU LOC INCI 2003 ----------2----------------------------REUOid ------");
	REUOidL = "";
}

if ( rtngSetOidArray[2][0]  != null && !"".equals(rtngSetOidArray[2][0]) && literalFitch.equals(rtngSetOidArray[2][0]) ){
	FitchOid = rtngSetOidArray[2][1];
} else {
	FitchOid = "";
}

if ( rtngSetOidArray[3][0]  != null && !"".equals(rtngSetOidArray[3][0]) && literalFitchL.equals(rtngSetOidArray[3][0]) ){
	FitchOidL = rtngSetOidArray[3][1];
} else {
	FitchOidL = "";
}

if ( rtngSetOidArray[4][0]  != null && !"".equals(rtngSetOidArray[4][0]) && literalMoodys.equals(rtngSetOidArray[4][0]) ){
	MoodysOid = rtngSetOidArray[4][1];
} else {
	MoodysOid = "";
}

if ( rtngSetOidArray[5][0]  != null && !"".equals(rtngSetOidArray[5][0]) && literalMoodysL.equals(rtngSetOidArray[5][0]) ){
	MoodysOidL = rtngSetOidArray[5][1];
} else {
	MoodysOidL = "";
}

if ( rtngSetOidArray[6][0]  != null && !"".equals(rtngSetOidArray[6][0]) && literalREUFitch.equals(rtngSetOidArray[6][0]) ){
	REUFitchOid = rtngSetOidArray[6][1];
} else {
	REUFitchOid = "";
}

if ( rtngSetOidArray[7][0]  != null && !"".equals(rtngSetOidArray[7][0]) && literalREUMoodys.equals(rtngSetOidArray[7][0]) ){
	REUMoodysOid = rtngSetOidArray[7][1];
} else {
	REUMoodysOid = "";
}

if ( rtngSetOidArray[8][0]  != null && !"".equals(rtngSetOidArray[8][0]) && literalREUSP.equals(rtngSetOidArray[8][0]) ){
	REUSPOid = rtngSetOidArray[8][1];
} else {
	REUSPOid = "";
}

if ( rtngSetOidArray[9][0]  != null && !"".equals(rtngSetOidArray[9][0]) && literalSP.equals(rtngSetOidArray[9][0]) ){
	SPOid = rtngSetOidArray[9][1];
} else {
	SPOid = "";
}

if ( rtngSetOidArray[10][0]  != null && !"".equals(rtngSetOidArray[10][0]) && literalSPL.equals(rtngSetOidArray[10][0]) ){
	SPOidL = rtngSetOidArray[10][1];
} else {
	SPOidL = "";
}
]]></objectValue>
<type>CONSTANT</type>
</item>
