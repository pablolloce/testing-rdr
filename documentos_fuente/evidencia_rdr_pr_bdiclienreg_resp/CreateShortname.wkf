<item id="186" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="187">querySQL</name>
<stringValue id="188">SELECT INST_LEGAL_NME
  	FROM FT_T_FINS FINS
    WHERE FINS.INST_MNEM IN (SELECT PRNT_INST_MNEM 
                              FROM FT_T_FIRL 
                              WHERE INST_MNEM IN (SELECT PRNT_INST_MNEM 
                                                    FROM FT_T_FIRL 
                                                    WHERE INST_MNEM = :mnem 
                                                    AND REL_TYP = 'OPERATIVE'
                                                    AND FINSRL_TYP IN (SELECT RPAD(STAT_CHAR_VAL_TXT,8)
                                                                        FROM FT_T_FIST 
                                                                        WHERE STAT_DEF_ID = 'MAINROL'
                                                                        AND INST_MNEM = :mnem)))
    AND FINS.DATA_STAT_TYP = 'ACTIVE'</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
