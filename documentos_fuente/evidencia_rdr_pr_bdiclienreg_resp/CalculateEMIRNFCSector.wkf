<item id="156" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="157">querySQL</name>
<stringValue id="158">select frcl.cl_value from ft_t_frcl frcl, ft_T_fins fins 
where frcl.INDUS_CL_SET_ID='CNAE'
and frcl.FINSRL_TYP='CUSTOMER' 
and frcl.DATA_STAT_TYP='ACTIVE'
and frcl.inst_mnem = fins.inst_mnem
and fins.DATA_STAT_TYP='ACTIVE'
and frcl.inst_mnem in 
    (select firlout.inst_mnem from ft_t_firl firllo, ft_t_firl firlop, ft_t_fins fins, ft_t_firl firlout
    where firllo.prnt_inst_mnem=:cntrprtyGlobalOid and firllo.rel_typ='LOCAL'
    and firlop.prnt_inst_mnem=firllo.inst_mnem and firlop.rel_typ='OPERATIVE'
    and fins.inst_mnem=firlop.inst_mnem and fins.subsidiary_ind='N'
    and firlout.inst_mnem=firlop.prnt_inst_mnem
    and firllo.data_Stat_Typ='ACTIVE' and firlop.data_Stat_Typ='ACTIVE'
    and fins.data_Stat_Typ='ACTIVE' and firlout.data_Stat_Typ='ACTIVE')</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
