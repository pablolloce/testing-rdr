<item id="178" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="179">statements</name>
<objectValue id="180" type="java.lang.String"><![CDATA[import java.util.Date;
import java.util.Calendar;
import java.text.SimpleDateFormat;
import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("Refinitiv_Load_Ratings");

Date date = Calendar.getInstance().getTime();
SimpleDateFormat sdf = new SimpleDateFormat("MM_dd_yyyy");
String fileNameANS =  "Refinitiv_loadRating_failures_toANS_".concat(sdf.format(date)).concat(".csv");
int counter=0;

String env = "no";
File f1 = new File("/fichtemcomp/de/descargas/kytl/riesgoemisorBatch");	
	if ( f1.canWrite() ) {
		if (f1.exists() && f1.isDirectory()) {
			env = "de";
		}		
	}
File f2 = new File("/fichtemcomp/ei/descargas/kytl/riesgoemisorBatch");	
	if ( f2.canWrite() ) {
		if (f2.exists() && f2.isDirectory()) {
			env = "ei";
		}		
	}
File f3 = new File("/fichtemcomp/pp/descargas/kytl/riesgoemisorBatch");	
	if ( f3.canWrite() ) {
		if (f3.exists() && f3.isDirectory()) {
			env = "pp";
		}		
	}
File f4 = new File("/fichtemcomp/pr/descargas/kytl/riesgoemisorBatch");	
	if ( f4.canWrite() ) {
		if (f4.exists() && f4.isDirectory()) {
			env = "pr";
		}		
	}

String pathBatch = "/fichtemcomp/" + env + "/descargas/kytl/riesgoemisorBatch/Backup/";
String bodyMsg="Please, find attached a report with the errors found in Refinitiv Batch proccess.";
String subject="Refinitiv load ratings failures ".concat(sdf.format(date));]]></objectValue>
<type>CONSTANT</type>
</item>
