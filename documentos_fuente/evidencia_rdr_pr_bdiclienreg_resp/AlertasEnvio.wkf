<item id="662" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="663">querySQL</name>
<stringValue id="664">SELECT ALR1.PERIODICIDAD
  FROM FT_T_ALU1 ALU1  
  JOIN FT_T_ALR1 ALR1 
    ON ALU1.ALU1_OID = ALR1.ALU1_OID 
  JOIN FT_T_ALM1 ALM1 
    ON ALM1.ALM1_OID = ALR1.ALM1_OID 
 WHERE ALU1.DATA_STAT_TYP = 'ACTIVE' 
   AND ALR1.DATA_STAT_TYP = 'ACTIVE' 
   AND ALM1.DATA_STAT_TYP = 'ACTIVE' 
   AND ALM1.MEDIO_ENVIO = 'EMAIL'
   AND ALR1.PROCESO=? 
   AND ALM1.DIRECCION = ? 
   AND ALR1.TIPO_ENVIO = ?
 GROUP BY ALR1.PERIODICIDAD</stringValue>
<type>CONSTANT</type>
</item>
