<input>true</input>
<name id="1888">querySQL</name>
<stringValue id="1889">select distinct FIID.INST_MNEM 
from ft_t_fins fins, ft_t_fiid fiid, ft_t_enfr enfr, ft_t_finr finr, ft_t_frid frid
where fins.inst_mnem = fiid.inst_mnem 
and fins.inst_mnem = enfr.inst_mnem 
and fins.inst_mnem = finr.inst_mnem 
and finr.inst_mnem = frid.inst_mnem 
and fiid.fins_id_ctxt_typ='FINSID' 
and enfr.enfr_rl_typ='OPE_BRANCH' 
and enfr.finsrl_typ='CPARTY' 
and finr.finsrl_typ='ISSUER' 
and frid.finsrl_id_ctxt_typ='ORG_ID' 
and frid.finsrl_typ='ISSUER' 
and fins.data_stat_typ = 'ACTIVE' 
and fiid.data_stat_typ = 'ACTIVE' 
and enfr.data_stat_typ = 'ACTIVE' 
and (finr.data_stat_typ = 'INACTIVE' or frid.data_stat_typ = 'INACTIVE') 
and fins.inst_mnem=?</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
