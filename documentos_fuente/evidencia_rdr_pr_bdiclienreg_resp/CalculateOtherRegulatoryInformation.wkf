<parameters id="301" type="java.util.HashSet">
<item id="302" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="303">statements</name>
<objectValue id="304" type="java.lang.String">//Declaracion de variables
Map valores = new HashMap();
//Declaracion de variables
Map dataMap = new HashMap();
String rolin = cftcMap.get("WE-COD-ROLIN");
String rolcrsec = secMap.get("WE-COD-ROLCRSEC");
ArrayList tags = new ArrayList();

if(!cftcMap.containsKey("WE-COD-ROLCR"))
{
	tags.add("RR_CRD");
	dataMap.put("RR_CRD",cftcMap.get("WE-COD-ROLIN"));
	cftcMap.put("WE-COD-ROLCR",cftcMap.get("WE-COD-ROLIN"));	
}
if(!cftcMap.containsKey("WE-COD-ROLCO"))
{
	tags.add("RR_COM");	
	dataMap.put("RR_COM",cftcMap.get("WE-COD-ROLIN"));
	cftcMap.put("WE-COD-ROLCO",cftcMap.get("WE-COD-ROLIN"));
}
if(!cftcMap.containsKey("WE-COD-ROLEQ"))
{
	tags.add("RR_EQD");	
	dataMap.put("RR_EQD",cftcMap.get("WE-COD-ROLIN"));
	cftcMap.put("WE-COD-ROLEQ",cftcMap.get("WE-COD-ROLIN"));
}
if(!cftcMap.containsKey("WE-COD-ROLFX"))
{
	tags.add("RR_FX");
	dataMap.put("RR_FX",cftcMap.get("WE-COD-ROLIN"));
	cftcMap.put("WE-COD-ROLFX",cftcMap.get("WE-COD-ROLIN"));
}

if(!secMap.containsKey("WE-COD-ROLEQSEC"))
{
	tags.add("SEC_EQD");
	dataMap.put("SEC_EQD",secMap.get("WE-COD-ROLCRSEC"));	
	secMap.put("WE-COD-ROLEQSEC",secMap.get("WE-COD-ROLCRSEC"));
}

String [] etiquetas = new String [5];
etiquetas[0] = "MAIN_ENTITY_ID";
etiquetas[1] = "MAIN_ENTITY_ID_CTXT_TYP";
etiquetas[2] = "MAIN_ENTITY_NME";
etiquetas[3] = "MAIN_ENTITY_TYP";
etiquetas[4] = "MAIN_ENTITY_TBL_TYP";

valores.put (etiquetas[0],"N/A");
valores.put (etiquetas[1],"GRI-" + cntrprtyGlobalOid);
valores.put (etiquetas[2],"No se ha logrado extraer correctamente la información de datos regulatorios (CFTC and SEC) de la contrapartida");
valores.put (etiquetas[3],"RR_;SEC_");
valores.put (etiquetas[4],"FRA1");</objectValue>
<type>CONSTANT</type>
</item>
