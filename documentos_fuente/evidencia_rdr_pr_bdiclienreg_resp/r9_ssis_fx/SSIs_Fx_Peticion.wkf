<input>true</input>
<name id="199">statements</name>
<stringValue id="200"><![CDATA[if(RespuestaUTD1.length==1 && RespuestaUTD1[0].get("VND_RQST_STAT_TYP").equals("ACK")){
	return "OK";
}else if(RespuestaUTD1.length==1 && RespuestaUTD1[0].get("VND_RQST_STAT_TYP").equals("NACK")){
	return "KO_Error";
}else{
	return "KO_Tiempo";
}





]]></stringValue>
<type>CONSTANT</type>
</item>
