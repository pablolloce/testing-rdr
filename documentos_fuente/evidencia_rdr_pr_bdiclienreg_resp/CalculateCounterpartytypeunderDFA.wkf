<item id="175" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="176">statements</name>
<stringValue id="177">//DeclaraciÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â³n de variables
Map valores = new HashMap();
String inup = "Insercion:" + cuenta;

if(update)
{
	if(cuenta != null)
	{
		inup = "Actualizacion:" + cuenta;
	}else
	{
		inup = "El dato calculado y el existente coinciden - No se Actualiza";
	}
}

String [] etiquetas = new String [5];
etiquetas[0] = "MAIN_ENTITY_ID";
etiquetas[1] = "MAIN_ENTITY_ID_CTXT_TYP";
etiquetas[2] = "MAIN_ENTITY_NME";
etiquetas[3] = "MAIN_ENTITY_TYP";
etiquetas[4] = "MAIN_ENTITY_TBL_TYP";

valores.put (etiquetas[0],calculoFinentdf.get("FINENTDF"));
valores.put (etiquetas[1],"ORI-" + cntrprtyOperativeOid);
valores.put (etiquetas[2],"Calculo de Counterparty type under DFA - " + inup);
valores.put (etiquetas[3],"FINENTDF");
valores.put (etiquetas[4],"FRA1");</stringValue>
<type>CONSTANT</type>
</item>
