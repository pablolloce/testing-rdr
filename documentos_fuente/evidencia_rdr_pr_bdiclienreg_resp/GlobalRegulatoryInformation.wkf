<item id="411" type="com.j2fe.workflow.definition.Transition">
<name id="412">goto-next</name>
<source id="413">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="414">Calculo DR</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="415">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="416" type="java.util.HashSet">
<item id="417" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="418">statements</name>
<stringValue id="419"><![CDATA[import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("CheckDatosRegulatorios");

boolean hacerCalculoDR = true;

logger.error("[CheckDatosRegulatorios] Global Regulatory Information predecesor: " + predecesor);
logger.error("[CheckDatosRegulatorios] Global Regulatory Information CALCULODR.length " + CALCULODR.length);

if (predecesor != null && predecesor.equalsIgnoreCase("Ventana") && CALCULODR != null && CALCULODR.length > 0) {
	logger.error("[CheckDatosRegulatorios] Global Regulatory Information CALCULODR[0]" + CALCULODR[0].get("SRC_VALUE"));
	if(CALCULODR[0].get("SRC_VALUE").equals("false"))	{
		logger.error("CheckDatosRegulatorios NOS SALTAMOS EL CALCULO");
		hacerCalculoDR =  false;
	}else	{
		logger.error("CheckDatosRegulatorios VAMOS A POR EL CALCULO");
		hacerCalculoDR =  true;
	}
}else{
	logger.error("CheckDatosRegulatorios VAMOS A POR EL CALCULO");
	hacerCalculoDR =  true;
}
]]></stringValue>
<type>CONSTANT</type>
</item>
