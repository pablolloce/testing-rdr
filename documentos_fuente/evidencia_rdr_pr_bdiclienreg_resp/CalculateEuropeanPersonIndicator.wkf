<item id="91" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="92">statements</name>
<stringValue id="93"><![CDATA[//Tratamos estados y valores del European Person Indicator
if (usindem != null && usindem.length > 0 && usindem2 != null && usindem2.length > 0) 
{
	//Control de estado de la extracciÃƒÂ³n del European Person Indicator
	if(usindem[0].get("ESTADO").equals("ACTIVE"))
	{
		if(usindem[0].get("USINDEM").equals(usindem2[0].get("USINDEM")))
		{
			update = true;
			return "out";
		}else
		{
			update = true;
			return true;
		}
	}else
	{
		//El dato se encuentra inactivo y se tiene que actualizar con el dato calculado y el status reactivado
		return "reactivar";
	}

}else
{
	update = false;
	return false;
	
}]]></stringValue>
<type>CONSTANT</type>
</item>
