						FDL_DOMESTIC_DATE  = fieldsMap.get("FBD_Domestic_Issuer Rating Effective Date").toString() ;
				}else{
						FDL_DOMESTIC_CODE = fieldsMap.get("FBD_Domestic_Issuer Rating Code").toString() ;
						FDL_DOMESTIC_DATE  = fieldsMap.get("FBD_Domestic_Issuer Rating Effective Date").toString() ;
				}
			}
		}

		if(FDL_DOMESTIC_CODE.length()==0 || FDL_DOMESTIC_CODE.equals("NR") ){
			if(fieldsMap.get("FJB_Domestic_Issuer Rating Code")!=null && fieldsMap.get("FJB_Domestic_Issuer Rating Code").toString().length()>0 
					&& !fieldsMap.get("FJB_Domestic_Issuer Rating Code").equals(" ")){
				if(fieldsMap.get("FJB_Domestic_Issuer Rating Code").equals("N.A.") || fieldsMap.get("FJB_Domestic_Issuer Rating Code").equals("N.S.") ||  
					 fieldsMap.get("FJB_Domestic_Issuer Rating Code").equals("NR") || fieldsMap.get("FJB_Domestic_Issuer Rating Code").equals("WD")){
						FDL_DOMESTIC_CODE ="NR";
						FDL_DOMESTIC_DATE  = fieldsMap.get("FJB_Domestic_Issuer Rating Effective Date").toString() ;
