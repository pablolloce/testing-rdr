						FDL_FOREIGN_DATE  = fieldsMap.get("FBD_Foreign_Issuer Rating Effective Date").toString() ;
				}
			}
		}

		if(FDL_FOREIGN_CODE.length()==0 || FDL_FOREIGN_CODE.equals("NR") ){
			if(fieldsMap.get("FJB_Foreign_Issuer Rating Code")!=null && fieldsMap.get("FJB_Foreign_Issuer Rating Code").toString().length()>0 
					&& !fieldsMap.get("FJB_Foreign_Issuer Rating Code").equals(" ")){
				if(fieldsMap.get("FJB_Foreign_Issuer Rating Code").equals("N.A.") || fieldsMap.get("FJB_Foreign_Issuer Rating Code").equals("N.S.") ||  
					 fieldsMap.get("FJB_Foreign_Issuer Rating Code").equals("NR") || fieldsMap.get("FJB_Foreign_Issuer Rating Code").equals("WD")){
