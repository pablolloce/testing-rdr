<item id="32" type="com.j2fe.workflow.definition.Transition">
<name id="33">goto-next</name>
<source id="34">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="35">Componer mapa de Datos Regulatorios</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="36">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="37" type="java.util.HashSet">
<item id="38" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="39">statements</name>
<stringValue id="40">import org.apache.commons.lang.StringUtils;

//DeclaraciÃ³n de variables
Map regulatoryOperativeData = new HashMap();

// Data from Corporate Relationship
if (!calculoCorprel.isEmpty()) 
{
	//Se asocia el dato Corporate Relationship al mapa regulatoryOperativeData
	regulatoryOperativeData.put("WE-COD-CORPREL", calculoCorprel.get("CORPREL"));
}

// Data from Parent Company Country of Residence
if (!calculoCompcoun.isEmpty()) 
{
	//Se asocia el dato Corporate Relationship al mapa regulatoryOperativeData
	regulatoryOperativeData.put("WE-COD-COMPCOUN", calculoCompcoun.get("COMPCOUN"));
}

// Data from Counterparty type under DFA
if (!calculoFinentdf.isEmpty())
{
	//Se asocia el dato Counterparty type under DFA al mapa regulatoryOperativeData
	regulatoryOperativeData.put("WE-COD-FINENTDF", calculoFinentdf.get("FINENTDF"));
}</stringValue>
<type>CONSTANT</type>
</item>
