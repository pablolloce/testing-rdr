<item id="548" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="549">querySQL</name>
<stringValue id="550">SELECT NVL(UPPER(FIID.FINS_ID),' ') CANONICO
FROM FT_T_FIID FIID
WHERE FIID.INST_MNEM = :cntrprtyGlobalOid
AND FIID.FINS_ID_CTXT_TYP = 'FINSID'
AND FIID.DATA_STAT_TYP = 'ACTIVE'</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
