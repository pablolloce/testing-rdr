<item id="567" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="568">statements</name>
<stringValue id="569">//import org.apache.log4j.Logger;
//Logger logger = Logger.getLogger("Enriquecimiento");


String query = "INSERT INTO FT_T_FRCL (FINR_CLSF_OID, INST_MNEM, FINSRL_TYP, INDUS_CL_SET_ID, CLSF_OID, CL_VALUE, START_TMS, LAST_CHG_TMS, LAST_CHG_USR_ID, DATA_STAT_TYP, DATA_SRC_ID, FINR_OID) VALUES ((SELECT NEW_OID FROM DUAL), '"+mnemLocal+"', 'CUSTOMER', 'CPTYONB', (SELECT CLSF_OID FROM FT_t_incl where cl_value = 'ONS' and trim(indus_cl_set_id) ='CPTYONB'), 'ONS', SYSDATE, SYSDATE, 'RDR', 'ACTIVE', 'RDR', (SELECT FINR_OID FROM FT_T_FINR WHERE INST_MNEM = '"+mnemLocal+"' AND FINSRL_TYP = 'CUSTOMER') )\r\n";
</stringValue>
<type>CONSTANT</type>
</item>
