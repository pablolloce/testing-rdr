<input>true</input>
<name id="29">statements</name>
<stringValue id="30"><![CDATA[import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("Calculate European Person Indicator");

if (hacerCalculoDR != null && hacerCalculoDR.length() > 0 && hacerCalculoDR.equalsIgnoreCase("false")) {
	logger.error("[CheckDatosRegulatorios] Calculate European Person Indicator NO SE HACE CALCULO AQUI");
	return false;
}else{
	logger.error("[CheckDatosRegulatorios] Calculate European Person Indicator SE HACE CALCULO AQUI");
	return true;
}]]></stringValue>
<type>CONSTANT</type>
</item>
