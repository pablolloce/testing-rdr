<item id="2374" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="2375">statements</name>
<objectValue id="2376" type="java.lang.String"><![CDATA[import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("Sub_CalculateREU");
logger.error("Sub_CalculateREU: ------------------------LOCAL---------------------------------------");
if(CL_VALUE !=null && CL_VALUE.length>0&&CL_VALUE[0].get("CL_VALUE")!=null){
	logger.error("CL_VALUE[0].get(CL_VALUE): "+CL_VALUE[0].get("CL_VALUE"));
	if(CL_VALUE[0].get("CL_VALUE").trim().equalsIgnoreCase("A")){
		logger.error("Sub_CalculateREU: ------------------------LOCAL-----------OK----A------------------------");
		return "OKA";
	}else	 if(CL_VALUE[0].get("CL_VALUE").trim().equalsIgnoreCase("M")){
		logger.error("Sub_CalculateREU: ------------------------LOCAL-----------OK-----M-----------------------");
		return "OKM";
	}else{
		logger.error("Sub_CalculateREU: ------------------------LOCAL--------KO--NO ES M NI A------------------------");
		return "KO";
	}
}else{
	logger.error("Sub_CalculateREU: ------------------------LOCAL----------------------------KO-----------");
	return "KO";
}


]]></objectValue>
<type>CONSTANT</type>
</item>
