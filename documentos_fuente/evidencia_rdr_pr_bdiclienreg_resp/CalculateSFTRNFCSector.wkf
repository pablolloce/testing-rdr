<parameters id="27" type="java.util.HashSet">
<item id="28" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="29">statements</name>
<stringValue id="30"><![CDATA[import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("Calculate SFTR NFC Sector");

if (hacerCalculoDR != null && hacerCalculoDR.length() > 0 && hacerCalculoDR.equalsIgnoreCase("false")) {
	logger.error("[CheckDatosRegulatorios] Calculate SFTR NFC Sector NO SE HACE CALCULO AQUI");
	return false;
}else{
	logger.error("[CheckDatosRegulatorios] Calculate SFTR NFC Sector SE HACE CALCULO AQUI");
	return true;
}]]></stringValue>
<type>CONSTANT</type>
</item>
