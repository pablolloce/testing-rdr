<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="731">GET FUND DATA</name>
<nodeHandler>com.j2fe.general.activities.database.DBQuery</nodeHandler>
<nodeHandlerClass id="732">com.j2fe.general.activities.database.DBQuery</nodeHandlerClass>
<parameters id="733" type="java.util.HashSet">
<item id="734" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="735">database</name>
<stringValue id="736">jdbc/GSDM-1</stringValue>
<type>REFERENCE</type>
</item>
<item id="737" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="738">[0]@java/lang/String@</UITypeHint>
<input>true</input>
<name id="739">indexedParameters[0]</name>
<stringValue id="740">mnemGlobal</stringValue>
<type>VARIABLE</type>
</item>
<item id="741" type="com.j2fe.workflow.definition.Parameter">
<input>false</input>
