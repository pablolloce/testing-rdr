<item id="3677" type="com.j2fe.workflow.definition.Transition">
<name id="3678">nothing-found</name>
<source idref="22"/>
<target id="3679">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="3680">Calculo REU</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="3681">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="3682" type="java.util.HashSet">
<item id="3683" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="3684">statements</name>
<objectValue id="3685" type="java.lang.String"><![CDATA[java.util.Arrays;

String hayTresRtngIguales = "N";
String losTresSonDistintos= "N";
String hayDosMejoresRtngIguales = "N";
String hayDosPeoresRtngIguales = "N";

String mejorRtng = "";
String peorRtng = "";

int intNumRtngInformados = 0;
String numRtngInformados = ""; //Si hay 1, 2 o 3 rating informados por BBG distintos a N.A.
String mejorREU = "";
String segundoMejorREU = "";
String segundoMejorREUGrado = "";
String segundoMejorREUrating = "";

String value = "";
int conteoMejorRtng = 0;
int conteoPeorRtng = 0;
int sumaTresRating = 0;
double media = 0;

int[] grados;

//Revisamos cuantos ratings han sido informados por BBG
if ( SPRtngCode != null && !"".equals(SPRtngCode) && !"No disp.".equals(SPRtngCode) ){ 
	intNumRtngInformados = intNumRtngInformados + 1;

	if (MoodysRtngCode != null && !"".equals(MoodysRtngCode) && !"No disp.".equals(MoodysRtngCode) ){
		intNumRtngInformados = intNumRtngInformados + 1;
	
		if (FitchRtngCode != null && !"".equals(FitchRtngCode) && !"No disp.".equals(FitchRtngCode)){
			intNumRtngInformados = intNumRtngInformados + 1;
		}
	} else if (FitchRtngCode != null && !"".equals(FitchRtngCode) && !"No disp.".equals(FitchRtngCode)){ 
		intNumRtngInformados = intNumRtngInformados + 1;
	}
	
} else if (MoodysRtngCode != null && !"".equals(MoodysRtngCode) && !"No disp.".equals(MoodysRtngCode) ){
		intNumRtngInformados = intNumRtngInformados + 1;
	
		if (FitchRtngCode != null && !"".equals(FitchRtngCode) && !"No disp.".equals(FitchRtngCode)){
			intNumRtngInformados = intNumRtngInformados + 1;
		}

} else if (FitchRtngCode != null && !"".equals(FitchRtngCode) && !"No disp.".equals(FitchRtngCode)){
	intNumRtngInformados = intNumRtngInformados + 1;
}

//Revisamos si los 3 Grados son iguales, salvo si son 99 ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¿Se tendran en cuenta?
if ( SPGradoRtngCode.equals(MoodysGradoRtngCode) && MoodysGradoRtngCode.equals(FitchGradoRtngCode) ){
	if (!"".equals(SPGradoRtngCode) && !"".equals(MoodysGradoRtngCode) && !"".equals(FitchGradoRtngCode) ){
		hayTresRtngIguales = "S";

	} else {
		hayTresRtngIguales = "N";
	}
} else  if (!SPGradoRtngCode.equals(MoodysGradoRtngCode) && !MoodysGradoRtngCode.equals(FitchGradoRtngCode) && !SPGradoRtngCode.equals(FitchGradoRtngCode)) {
	losTresSonDistintos = "S";
}

//Sacamos el mejor grado de rating, que es el mas bajo, siendo 1 el mas bajo y 25 el mas alto
/*if (!"".equals(SPGradoRtngCode) && !"".equals(MoodysGradoRtngCode) && !"".equals(FitchGradoRtngCode) ){
	grados = new int[intNumRtngInformados];
	grados[0] = Integer.parseInt(SPGradoRtngCode);
	grados[1] = Integer.parseInt(MoodysGradoRtngCode);
	grados[2] = Integer.parseInt(FitchGradoRtngCode);
} else {
	grados = new int[intNumRtngInformados];
	if (!"".equals(SPGradoRtngCode)){
		grados[0] = Integer.parseInt(SPGradoRtngCode);
	}
	if (!"".equals(MoodysGradoRtngCode)){
		grados[1] = Integer.parseInt(SPGradoRtngCode);
	}
	if (!"".equals(FitchGradoRtngCode)){
		grados[2] = Integer.parseInt(SPGradoRtngCode);
	}
}*/
int[] grados = {Integer.parseInt(SPGradoRtngCode), Integer.parseInt(MoodysGradoRtngCode), Integer.parseInt(FitchGradoRtngCode)};
Arrays.sort(grados);
if (intNumRtngInformados > 0){
mejorRtng = String.valueOf(grados[0]);

//Sacamos el peor grado de rating, que es el mas alto, siendo 1 el mas bajo y 25 el mas alto
peorRtng = String.valueOf(grados[intNumRtngInformados-1]);
}

//revisamos si hay 2 mejores grados de rating iguales
for(int i=0;i<intNumRtngInformados;i++){
	value = String.valueOf(grados[i]);
	if (mejorRtng.equals(value) ){
		conteoMejorRtng = conteoMejorRtng + 1;
	}
}

if ( conteoMejorRtng > 1){
	hayDosMejoresRtngIguales = "S";
} else {
	hayDosMejoresRtngIguales = "N";
}

//revisamos si hay 2 peores grados de rating iguales
value = "";
for(int i=0;i<intNumRtngInformados;i++){
	value = String.valueOf(grados[i]);
	if (peorRtng.equals(value) ){
		conteoPeorRtng = conteoPeorRtng + 1;
	}
}

if ( conteoPeorRtng > 1){
	hayDosPeoresRtngIguales = "S";
} else {
	hayDosPeoresRtngIguales = "N";
}



numRtngInformados = String.valueOf(intNumRtngInformados);

//Calculamos el Rating Externo Unificado
if ( intNumRtngInformados == 0 ) {
	//no se realiza ningun calculo dado que ninguno de los valores devueltos por BBG es vÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡lido.
	mejorGradoREU = rankNumREUNR; //Grado NR para la clasificacion del REU
	segundoMejorGradoREU = "N.A.";
} else if ( intNumRtngInformados == 1 ) {
	mejorGradoREU = mejorRtng;
	segundoMejorGradoREU = "N.A.";
} else  if ( intNumRtngInformados == 2 ) {
	mejorGradoREU = mejorRtng;

	if ( "S".equals(hayDosMejoresRtngIguales) ){
		segundoMejorGradoREU = mejorRtng;
	} else if ( "S".equals(hayDosPeoresRtngIguales) ){
		segundoMejorGradoREU = peorRtng;
	} else {
		segundoMejorGradoREU = String.valueOf(grados[intNumRtngInformados-1]);
	}
	
} else if ( intNumRtngInformados == 3 ) {
	if ("S".equals(losTresSonDistintos)){
		
		// Antescambios SDATOOL-48154 Cambio lÃ³gica REU
		for(int i=0;i<3;i++){
			sumaTresRating = sumaTresRating + grados[i];
		}
		media = (double)sumaTresRating/grados.length;
		/*mejorGradoREU = (int)Math.round(media);
		segundoMejorGradoREU = mejorGradoREU;*/

		// Despues cambios SDATOOL-48154 Cambio lÃ³gica REU
		for(int i=0; i < grados.length-1; i++){
                   for(int j=0; j < (grados.length-1-i); j++){  
                        if(grados[j] > grados[j+1]){  
                                int aux=grados[j];                 
                                grados[j]=grados[j+1];           
                                grados[j+1]=aux;
                         }    
                   }
              }
		mejorGradoREU = (int)Math.round(grados[1]);
		segundoMejorGradoREU = mejorGradoREU;

	} else {
	
		mejorGradoREU = mejorRtng;
		if ( "S".equals(hayDosMejoresRtngIguales) ){
			segundoMejorGradoREU = mejorRtng;
		} else if ( "S".equals(hayDosPeoresRtngIguales) ){
			segundoMejorGradoREU = peorRtng;
		} else {
			segundoMejorGradoREU = String.valueOf(grados[intNumRtngInformados-1]);
		}
	}
}
]]></objectValue>
<type>CONSTANT</type>
</item>
