<name id="1132">Main Issue ID</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="1133">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="1134" type="java.util.HashSet">
<item id="1135" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="1136">statements</name>
<stringValue id="1137">String mainIdType = "";
String secondaryIdType = "";
String instrumentName= "INSTRUMENT_NAME";

if (sponsor.equals("BME") || sponsor.equals("EURONEXT") || sponsor.equals("MSCI") || sponsor.equals("SP_DJ") || sponsor.equals("STOXX_DAX")|| sponsor.equals("MANUAL")){
	mainIdType = "ISIN";
	secondaryIdType = "";
}

if (sponsor.equals("FTSE")){
	mainIdType = "SEDOL";
	secondaryIdType = "";
}

if (sponsor.equals("SOLACTIVE") || sponsor.equals("STOXX")){
	mainIdType = "RIC";
	secondaryIdType = "";
}</stringValue>
<type>CONSTANT</type>
</item>
<item id="1138" type="com.j2fe.workflow.definition.Parameter">
<input>false</input>
