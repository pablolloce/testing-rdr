<name id="1357">querySQL</name>
<stringValue id="1358">update FT_T_FRRL set PRNT_INST_MNEM= null, LAST_CHG_USR_ID =? where PRNT_INST_MNEM is not null  and  REL_TYP=(select FRRL.REL_TYP from ft_t_firt FIRT, FT_T_FRRL FRRL, ft_t_incl INCL where  FRRL.rel_typ = INCL.CLSF_OID and FIRT.DATA_STAT_TYP='ACTIVE' and FRRL.DATA_STAT_TYP='ACTIVE' and INCL.DATA_STAT_TYP='ACTIVE' and FRRL.PARTICIPANT_ID = FIRT.fins_RTNG_OID and FIRT.FINS_RTNG_OID = ? and FIRT.INST_MNEM = ? and FIRT.RTNG_SET_OID = ? and PRNT_INST_MNEM is not null) and INST_MNEM =? and PARTICIPANT_ID=?  and PRNT_FINSRL_TYP ='REUINHER' and DATA_STAT_TYP= 'ACTIVE' 
</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
