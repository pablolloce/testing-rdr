<stringValue id="85">import org.apache.commons.lang.StringUtils;

if(Action.equals("C")) {
	return "COPY";
} else if (Action.equals("R") || Action.equals("P")) {
	return "DENE";
} else if (Action.equals("S")) {
	return "DERE";
} else {
	return "Other";
}
</stringValue>
<type>CONSTANT</type>
