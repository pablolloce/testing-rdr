<parameters id="432" type="java.util.HashSet">
<item id="433" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="434">statements</name>
<stringValue id="435">String mensaje = "";
String tipoMensaje = "";
String[] arrayMensaje = new String[2]; 
String subException = "";
if (exception.length() > 300){
	subException =  exception.substring(0, 299);
}else{
	subException =  exception;
}
mensaje = "Error encontrado al intentar leer el fichero: " + file + ", Error: " + subException;
tipoMensaje = "ERROR TÉCNICO RDR";

arrayMensaje[0] = tipoMensaje;
arrayMensaje[1] = mensaje;

listaErrores.add(arrayMensaje);





</stringValue>
<type>CONSTANT</type>
</item>
