<stringValue id="318">//import org.apache.log4j.Logger;
//Logger logger = Logger.getLogger("Enriquecimiento");

String query = "Insert into ft_t_fab1 (FAB1_OID,INST_MNEM,ORG_ID,STAT_DEF_ID,FLD_VAL,CLSF_OID,CL_VALUE,LAST_CHG_TMS,LAST_CHG_USR_ID,DATA_SRC_ID,DATA_STAT_TYP,START_TMS,END_TMS) \r\n" + 
				"values (new_oid,'"+mnemLocal+"',(select ORG_ID from ft_t_enfr where inst_mnem = '"+mnemGlobal+"' and enfr_rl_typ = 'BRANCH_OWN' and data_stat_typ = 'ACTIVE'),'NUMFOLIO','"+FOLIO_NUM+"',null,null,sysdate,'BBVA:CUSTOMER','MGC','ACTIVE',sysdate,null)\r\n";
	
		
		

//logger.error("FOLIO_NUM query: "+ query);
</stringValue>
<type>CONSTANT</type>
</item>
