<name id="1073">statements</name>
<stringValue id="1074"><![CDATA[import java.util.HashMap;
import java.util.LinkedHashMap;
import java.util.Map;

Map fieldsMap = new LinkedHashMap();

String[] fieldsArray = fieldsList.split(",");
String[] lineArray = fileLine.split("\\|");
int fieldCounter = 0;
//declaramos mapa vacio
for (String field : fieldsArray) {
	fieldsMap.put(field,"");
}

for (String field : fieldsArray) {
	if (fieldCounter < lineArray.length){
		fieldsMap.put(field,lineArray[fieldCounter]);
	}
	fieldCounter++;
}


String ActivityCode = fieldsMap.get("TRBC Activity Code").toString();
String EntitySubtype = fieldsMap.get("Legal Entity SubType").toString();]]></stringValue>
<type>CONSTANT</type>
</item>
