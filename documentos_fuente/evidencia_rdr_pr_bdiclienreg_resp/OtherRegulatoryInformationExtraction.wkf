<item id="76" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="77">querySQL</name>
<stringValue id="78">SELECT NVL(UPPER(INCL.INDUS_CL_SET_ID),'  ') ETIQUETA,
      DECODE(UPPER(FRA1.CL_VALUE),'Y','S',NVL(UPPER(FRA1.CL_VALUE),' ')) VALOR
FROM FT_T_FRA1 FRA1, FT_T_INCL INCL
WHERE FRA1.CLSF_OID = INCL.CLSF_OID
AND FRA1.DATA_STAT_TYP = 'ACTIVE'
AND INCL.INDUS_CL_SET_ID in ('RR_CRD    ','RR_FX     ','RR_EQD    ','RR_COM    ','RR_IRS    ')
AND FRA1.INST_MNEM = :cntrprtyOperativeOid</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
