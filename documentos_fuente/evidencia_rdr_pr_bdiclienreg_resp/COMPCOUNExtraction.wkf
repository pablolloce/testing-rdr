<type>VARIABLE</type>
</item>
<item id="58" type="com.j2fe.workflow.definition.Parameter">
<input>false</input>
<name id="59">mappedResult</name>
<stringValue id="60">compcoun</stringValue>
<type>VARIABLE</type>
</item>
<item id="61" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="62">querySQL</name>
<stringValue id="63">SELECT GU_ID COMPCOUN
  	FROM FT_T_FIGU FIGU
    WHERE FIGU.INST_MNEM = :cntrprtyOperativeOid
    AND FINS_GU_PURP_TYP = 'COUNCOMP'
    AND FIGU.DATA_STAT_TYP = 'ACTIVE'</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
