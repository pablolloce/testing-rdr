<stringValue id="664">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("RecepcionAlertApiRest");

String query= "UPDATE  FT_T_VREQ SET VND_RQST_STAT_TYP= '"+Estado+"' WHERE VND_RQST_OID='"+vnd_rqst_oid+"' and DATA_SRC_ID='ALERT_IP_SSI'";

