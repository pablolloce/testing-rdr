<item id="70" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="71">querySQL</name>
<stringValue id="72">SELECT CL_VALUE  VALOR, DATA_STAT_TYP ESTADO
FROM FT_T_FRA1
WHERE FRA1_OID = (SELECT FRA1_OID FROM (SELECT ROW_NUMBER() over (PARTITION BY INST_MNEM ORDER BY DATA_STAT_TYP asc) AS RNK, FRA1.* FROM FT_T_FRA1 FRA1
	WHERE CLSF_OID in (SELECT CLSF_OID FROM FT_T_INCL WHERE TRIM(INDUS_CL_SET_ID) = 'EMIRCAT')
	AND INST_MNEM = :mnem
	AND END_TMS is null)
	WHERE RNK=1)</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
