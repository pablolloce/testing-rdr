<input>true</input>
<name id="138">database</name>
<stringValue id="139">jdbc/GSDM-1</stringValue>
<type>REFERENCE</type>
</item>
<item id="140" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="141">["01"]@java/lang/String@</UITypeHint>
<input>true</input>
<name id="142">mappedParameters["01"]</name>
<stringValue id="143">AccessCode</stringValue>
<type>VARIABLE</type>
</item>
<item id="144" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="145">["02"]@java/lang/String@</UITypeHint>
<input>true</input>
<name id="146">mappedParameters["02"]</name>
