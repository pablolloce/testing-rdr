<parameters id="1706" type="java.util.HashSet">
<item id="1707" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="1708">statements</name>
<stringValue id="1709"><![CDATA[String mensaje = "";
String tipoMensaje = "";
String[] arrayMensaje = new String[2]; 

if (componentsBajaMap.get(isgp) != null && !componentsBajaMap.get(isgp).equals("BAJA")) {
	mensaje = "Se ha dado de baja el componente con CANONICO: "+ componentsBajaMap.get(isgp);
	tipoMensaje = "INFO";

	arrayMensaje[0] = tipoMensaje;
	arrayMensaje[1] = mensaje;

	listaErrores.add(arrayMensaje);
}]]></stringValue>
<type>CONSTANT</type>
</item>
