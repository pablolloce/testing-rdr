<item id="267" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="268">statements</name>
<stringValue id="269">//import org.apache.log4j.Logger;
//Logger logger = Logger.getLogger("Enriquecimiento");

String query = "UPDATE FT_T_VREQ SET VND_RQST_STAT_TYP = 'PROCESSING_AUTOCALC', VND_RQST_STAT_TXT = 'RDR_AltaFondos_Autocalc_PARTY.wkf::Realizando autocaclulos y enriquecimientos' WHERE VND_RQST_OID = '"+vreqOid+"'";
		
</stringValue>
<type>CONSTANT</type>
</item>
