<item id="187" type="com.j2fe.workflow.definition.Transition">
<name id="188">true</name>
<source id="189">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="190">Type FinancialInstitution</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="191">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="192" type="java.util.HashSet">
<item id="193" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="194">statements</name>
<objectValue id="195" type="java.lang.String"><![CDATA[import java.io.StringReader;
import javax.xml.parsers.DocumentBuilder;
import javax.xml.parsers.DocumentBuilderFactory;
import org.w3c.dom.Document;
import org.w3c.dom.Element;
import org.w3c.dom.Node;
import org.w3c.dom.NodeList;
import org.xml.sax.InputSource;

import org.apache.log4j.Logger; 
Logger logger = Logger.getLogger("ValidacionOficinas");
logger.error("Empieza workflow ValidacionOficinas");

try{
DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance(); 		
DocumentBuilder builder;  
Document document;

    builder = factory.newDocumentBuilder();  
	String message2 = String.copyValueOf(message.toCharArray());
	 message2 =message2.trim().replaceFirst("^([\\W]+)<","<");	  
	message2 = message2.replace("<!DOCTYPE STREET_REF SYSTEM \"fti://repository/dtd/STREET_REF\">", "");   
	document =  builder.parse(new InputSource(new StringReader(message2)));      
	document.getDocumentElement().normalize();		
	
	NodeList nList = document.getElementsByTagName("OFFICE");
	int numeroIdentifiers = nList.getLength();
	String [] lista  = new String[numeroIdentifiers] ;

	for (int j = 0; j < nList.getLength(); j++) {		
		Node nodeSegment = nList.item(j);
		if(nodeSegment.getNodeType() == Node.ELEMENT_NODE){
			Element segmento = (Element) nodeSegment;
			String identifier= segmento.getElementsByTagName("IDENTIFIER").item(0).getTextContent();
			
			String identiBranch = "";

			if(identifier != null && identifier.length() != 0){
				identiBranch = identiBranch +identifier;
			}
			String branch= segmento.getElementsByTagName("BRANCH").item(0).getTextContent();
			if(branch != null && branch.length() != 0){
				identiBranch = identiBranch +"|"+branch;
			}
			lista[j] =identiBranch;
			
		}
	}

idOficinas = lista;
return true;

}catch(Exception e){
logger.error("Catch ValidacionOficinas");
return false;
}
]]></objectValue>
<type>CONSTANT</type>
</item>
