<item id="87" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="88">statements</name>
<stringValue id="89">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("ValidacionOficinas");

String insercion="";
String cad_mostrar="Esta oficina está INACTIVA";



 insercion = "insert into FT_T_RLT1 (RLT_OID, JOB_ID, TRN_ID, RECORD_SEQ_NUM, RLT_STATUS, RLT_DIF_STAT, RLT_DIF_ACC, MESSAGE_RLT, RLT_FIELD, RLT_PURP_TYP, DATA_SRC_APP, SRC_FIELD, SRC_VALUE, GS_FIELD, GS_VALUE, MAIN_ENTITY_NME, MAIN_ENTITY_ID, START_TMS, END_TMS, LAST_CHG_TMS, LAST_CHG_USR_ID) select new_oid, '"+JobId+"', null, null , 0, null, null , '"+cad_mostrar +"', null, 'NACK', 'CARGA_CPARTY', null, null, null, null, 'Id Oficina',q'$"+ Identificador +"$', systimestamp, null, systimestamp, '" + User + "' from dual";
 

logger.error("*** INSERT RLT1 OTHER CPTY Existe oficina: "+insercion );

</stringValue>
<type>CONSTANT</type>
</item>
