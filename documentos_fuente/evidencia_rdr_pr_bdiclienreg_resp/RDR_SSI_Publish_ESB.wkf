<parameters id="11" type="java.util.HashSet">
<item id="12" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="13">statements</name>
<stringValue id="14">import org.apache.commons.lang.StringUtils;
import org.apache.log4j.Logger;

String accionArray = SSI_ELEM.get("accionXML");

if ( accionArray.equals("") ) {
	return "FIN_FOR";
} else  {
	Logger logger = Logger.getLogger("RDR_SSI_Publish_ESB_continuar");
	logger.error("Contador de SSI a publicar: " + counterSSI + ", ID Publicado: " + SSI_ELEM.get("Id_SSI"));
	return "CONTINUE";
}


</stringValue>
<type>CONSTANT</type>
</item>
