<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="288"><![CDATA[Replace >,< and &]]></name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="289">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="290" type="java.util.HashSet">
<item id="291" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="292">statements</name>
<stringValue id="293"><![CDATA[String newValue = oldValue.replace("%ampersand%","&");
newValue = newValue.replace("%menorque%","<");
newValue = newValue.replace("%mayorque%",">");

newValue = newValue.replace("&#62;",">");
newValue = newValue.replace("&gt;",">");
newValue = newValue.replace("&lt;","<");
newValue = newValue.replace("&#60;","<");
newValue = newValue.replace("&amp;","&");
newValue = newValue.replace("&#38;","&");


]]></stringValue>
<type>CONSTANT</type>
</item>
<item id="294" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="295">["newValue"]@java/lang/String@</UITypeHint>
