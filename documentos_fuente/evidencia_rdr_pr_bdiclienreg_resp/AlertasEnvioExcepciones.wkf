<parameters id="135" type="java.util.HashSet">
<item id="136" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="137">statements</name>
<stringValue id="138">import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("AlertasEnvio - Mail variables");

String body ="";
String subject = "";

subject = "Reporte LEIs pendientes de regularizar - Total: " + total;

body = "Estimado usuario,\r\n\r\n"+
"Se adjunta el informe de los LEIs pendientes de regularizar de la carga de emisiones\r\n\r\n" +
"Total por regularizar: " + total + "\r\n\r\n" +
"Un saludo.";



logger.error("destination : " + destination );
logger.error("subject: " + subject);
logger.error("body: " + body);
</stringValue>
<type>CONSTANT</type>
</item>
