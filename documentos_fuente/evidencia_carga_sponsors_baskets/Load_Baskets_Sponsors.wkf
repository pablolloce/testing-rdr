<item id="644" type="com.j2fe.workflow.definition.Transition">
<name id="645">INHOUSE</name>
<source idref="216"/>
<target id="646">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="647">Check INHOUSE</name>
<nodeHandler>com.j2fe.general.activities.database.DBQuery</nodeHandler>
<nodeHandlerClass id="648">com.j2fe.general.activities.database.DBQuery</nodeHandlerClass>
<parameters id="649" type="java.util.HashSet">
<item id="650" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="651">database</name>
<stringValue id="652">jdbc/GSDM-1</stringValue>
<type>REFERENCE</type>
</item>
<item id="653" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="654">["1"]@java/lang/String@</UITypeHint>
<input>true</input>
<name id="655">mappedParameters["1"]</name>
<stringValue id="656">indexMap</stringValue>
<type>VARIABLE</type>
<variablePart id="657">["indexIdentifier"]</variablePart>
</item>
<item id="658" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="659">["2"]@java/lang/String@</UITypeHint>
<input>true</input>
<name id="660">mappedParameters["2"]</name>
<stringValue id="661">indexType</stringValue>
<type>VARIABLE</type>
</item>
<item id="662" type="com.j2fe.workflow.definition.Parameter">
<input>false</input>
<name id="663">mappedResult</name>
<stringValue id="664">MappedResult</stringValue>
<type>VARIABLE</type>
</item>
<item id="665" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="666">[0]["INDEXTYPE"]@java/lang/String@</UITypeHint>
<input>false</input>
<name id="667">mappedResult[0]["INDEXTYPE"]</name>
<stringValue id="668">indexType</stringValue>
<type>VARIABLE</type>
</item>
<item id="669" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="670">querySQL</name>
<stringValue id="671">select INSTRID, INDEXTYPE from (select COUNT(distinct issu.instr_id) over() cnt ,issu.instr_id instrid, issu.iss_typ INDEXTYPE from ft_t_isid inhouse, ft_t_isid seclabel, ft_t_issu issu
where inhouse.id_ctxt_typ = 'INHOUSE'
and seclabel.id_ctxt_typ = 'MUREXID'
and issu.instr_id=inhouse.instr_id
and inhouse.instr_id=seclabel.instr_id
and (inhouse.end_tms is null or inhouse.end_tms > sysdate)
and (seclabel.end_tms is null or seclabel.end_tms > sysdate)
and (issu.end_tms is null or issu.end_tms > sysdate)
and (issu.data_stat_typ='ACTIVE' or issu.data_stat_typ='INCOMPLETO')
and (inhouse.data_stat_typ='ACTIVE' or inhouse.data_stat_typ='INCOMPLETO')
and (seclabel.data_stat_typ='ACTIVE' or seclabel.data_stat_typ='INCOMPLETO')
and inhouse.iss_id=:1
and (issu.iss_typ = :2 or (issu.iss_typ in ('ETF', 'FUND') and issu.Alt_asset_class_txt in ('ETP', 'Exchange Traded Funds', 'Equity ETFs'))))
where cnt=1 and rownum=1</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
<sources id="672" type="java.util.HashSet">
<item idref="644"/>
</sources>
<targets id="673" type="java.util.HashSet">
<item id="674" type="com.j2fe.workflow.definition.Transition">
<name id="675">nothing-found</name>
<source idref="646"/>
<target id="676">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="677">Error - Index not found</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="678">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="679" type="java.util.HashSet">
<item id="680" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="681">statements</name>
<stringValue id="682">String mensaje = "";
String tipoMensaje = "";
String[] arrayMensaje = new String[2]; 
String indexTypeText = "Index";
		
mensaje = "El "+indexTypeText+indexMap.get("indexIdText")+" no existe en RDR o no cumple las condiciones para continuar: revisar si posee Security Label, el mismo identificador, si el tipo de la emisión es "+indexTypeText+" o si el identificador está duplicado";

tipoMensaje = "ERROR DE DATOS";

arrayMensaje[0] = tipoMensaje;
arrayMensaje[1] = mensaje;

listaErrores.add(arrayMensaje);</stringValue>
<type>CONSTANT</type>
</item>
<item id="683" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="684">["indexMap"]@java/lang/Object@</UITypeHint>
