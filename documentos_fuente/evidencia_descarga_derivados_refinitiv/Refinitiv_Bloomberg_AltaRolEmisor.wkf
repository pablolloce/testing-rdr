<item id="288" type="com.j2fe.workflow.definition.Transition">
<name id="289">goto-next</name>
<source id="290">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="291">Get LEI and ORGID</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="292">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="293" type="java.util.HashSet">
<item id="294" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="295">statements</name>
<objectValue id="296" type="java.lang.String"><![CDATA[boolean esLineaValida = true;
String TIPO_PROVEEDOR = ""; 

String lineaActual = Result[Contador];
String[] campos = lineaActual.split("\\|", -1);

if (campos.length == 64) {
    TIPO_PROVEEDOR = "REFINITIV";

    if (esLineaValida) {
        LEI = campos[22];
        if (!LEI.isEmpty() && LEI.length() != 20) {
            esLineaValida = false;
        }
    }

    if (esLineaValida) {
        ORG_ID = campos[21];
        INSTRUMENT_TYPE = campos[6];
	ClassificationScheme = campos[8];
    }

} else if (campos.length == 47) {
    TIPO_PROVEEDOR = "BLOOMBERG";
    
    IDENTIFIER_TYPE = "";
    INSTRUMENT_TYPE = "";

    LEI    = campos[21];
    ORG_ID = campos[22]; 

    if (LEI != null && !LEI.trim().isEmpty() && LEI.trim().length() != 20) {
        esLineaValida = false;
    }

} else {
    TIPO_PROVEEDOR = "DESCONOCIDO";
    esLineaValida = false;
}

if (!esLineaValida) {
    ORG_ID = "";
    LEI = "";
    IDENTIFIER_TYPE = "";
    INSTRUMENT_TYPE = "";
}















]]></objectValue>
<type>CONSTANT</type>
</item>
