<parameters id="143" type="java.util.HashSet">
<item id="144" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="145">statements</name>
<stringValue id="146"><![CDATA[if (User != null && User.length()>0) {
	if (User.indexOf("RFN") == 0) {
		EntityName = "RFN";
	} else if (User.indexOf("COMPASS") == 0) {
		EntityName = "COMPASS";
	} else {
		EntityName = "empty";
	}		
} else {
	EntityName = "empty";
}

return EntityName;]]></stringValue>
<type>CONSTANT</type>
</item>
