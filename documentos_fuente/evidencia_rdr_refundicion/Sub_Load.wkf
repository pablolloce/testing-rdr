<name id="35">Carga PL</name>
<nodeHandler>com.j2fe.general.activities.database.PLSQLprocedure</nodeHandler>
<nodeHandlerClass id="36">com.j2fe.general.activities.database.PLSQLprocedure</nodeHandlerClass>
