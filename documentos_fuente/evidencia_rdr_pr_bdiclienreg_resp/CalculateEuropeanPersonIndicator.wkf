<name id="112">Insercion JAVA</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="113">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="114" type="java.util.HashSet">
<item id="115" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="116">statements</name>
<objectValue id="117" type="java.lang.String">import org.apache.log4j.Logger;
import java.io.*;
import java.sql.*;
import java.util.regex.*;

Logger logger = Logger.getLogger("Calculate Final type under EMIR");
Connection dbConnection = null;
Statement statement = null;
String RowCount = "0";

String DB_DRIVER = "oracle.jdbc.driver.OracleDriver";
String DB_CONNECTION = urldb;
String DB_USER = userdb;
String DB_PASSWORD = passdb;

try {
    String insertSQL =
 "Insert into FT_T_FRA1 (FRA1_OID,INST_MNEM,REG1_OID,FINSRL_INST_MNEM,FINSRL_TYP,STAT_DEF_ID,FLD_VAL,ISS_TYP, " +
 "CLSF_OID,CL_VALUE,LAST_CHG_TMS,LAST_CHG_USR_ID,DATA_SRC_ID,DATA_STAT_TYP,START_TMS,END_TMS)  " +
 "select NEW_OID,'" + var1 + "',(SELECT REG1_OID FROM FT_T_REG1 WHERE REG_NME = 'EMIR'),null,null,null,null,null, " +
 "(SELECT CLSF_OID FROM FT_T_INCL WHERE INDUS_CL_SET_ID = 'INDICYN' AND CL_VALUE = '" + var2 + "'),'" + var2 + "', " +
 "SYSDATE,'BBVA:CUSTOMER','RDR','ACTIVE',SYSDATE,null " +
 "FROM DUAL WHERE NOT EXISTS " +
 "(SELECT * FROM FT_T_FRA1 WHERE CLSF_OID = (SELECT CLSF_OID FROM FT_T_INCL WHERE INDUS_CL_SET_ID = 'INDICYN'  " +
 "AND CL_VALUE = '" + var2 + "') AND INST_MNEM = '" + var1 + "')";

    Class.forName(DB_DRIVER);
    dbConnection = DriverManager.getConnection(DB_CONNECTION, DB_USER, DB_PASSWORD);
    statement = dbConnection.createStatement();

    int rows = statement.executeUpdate(insertSQL);
    RowCount = String.valueOf(rows);

} catch (SQLException e) {
    logger.error("*** Insercion JAVA SQL errorCode=" + e.getErrorCode() + " msg=" + e.getMessage());
    RowCount = "0";
} finally {
    if (statement != null) statement.close();
    if (dbConnection != null) dbConnection.close();
}</objectValue>
<type>CONSTANT</type>
</item>
