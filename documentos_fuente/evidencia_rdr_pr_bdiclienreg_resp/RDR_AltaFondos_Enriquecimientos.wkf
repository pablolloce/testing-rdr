<item id="66" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="67">statements</name>
<stringValue id="68">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("ResponseManagement");

logger.error("INDEX-:  "+ mnemMapa.size());

for(String key : mnemMapa.keySet()){
	logger.error("INDEX-:  "+ key);
}

logger.error("INDEX-:  "+ mnemMapa.get("INST_MNEM"));

mnemOperativo = mnemMapa.get("INST_MNEM");
vreqOid = mnemMapa.get("VND_RQST_OID");</stringValue>
<type>CONSTANT</type>
</item>
