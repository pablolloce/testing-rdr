<type>REFERENCE</type>
</item>
<item id="54" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="55">["01"]@java/lang/String@</UITypeHint>
<input>true</input>
<name id="56">mappedParameters["01"]</name>
