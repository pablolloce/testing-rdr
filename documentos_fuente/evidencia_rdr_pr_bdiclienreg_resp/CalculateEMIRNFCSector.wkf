<name id="549">querySQL</name>
<stringValue id="550">UPDATE FT_T_FRA1 SET DATA_STAT_TYP='INACTIVE', LAST_CHG_TMS=SYSDATE, LAST_CHG_USR_ID='BBVA:CUSTOMER', END_TMS=SYSDATE 
WHERE INST_MNEM=:cntrprtyGlobalOid AND CLSF_OID IN (select CLSF_OID from FT_T_INCL WHERE INDUS_CL_SET_ID='EMISECNF') AND END_TMS IS NULL AND FRA1_OID!=:fra1SectOid</stringValue>
<type>CONSTANT</type>
