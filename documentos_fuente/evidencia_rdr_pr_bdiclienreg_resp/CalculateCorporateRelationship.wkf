<parameters id="217" type="java.util.HashSet">
<item id="218" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="219">statements</name>
<objectValue id="220" type="java.lang.String"><![CDATA[//DeclaraciÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â³n de variables
Map valores = new HashMap();
String inup = "Insercion:" + cuenta;

if(update)
{
	if(cuenta != null)
	{
		inup = "Actualizacion:" + cuenta;
	}else
	{
		inup = "El dato calculado y el existente coinciden - No se Actualiza";
	}
}

StringBuilder datos = new StringBuilder();

if(head != null && head.length > 0)
{
	datos.append(head[0].get("HEAD"));
	datos.append(";");
}else
{
	datos.append("NoExiste;");
}

if(fund != null && fund.length > 0)
{
	datos.append(fund[0].get("FUND"));
	datos.append(";");
}else
{
	datos.append("NoExiste;");
}

if(!calculoCorprel.isEmpty())
{
	datos.append(calculoCorprel.get("CORPREL"));
}else
{
	datos.append("NoExiste");
}

String [] etiquetas = new String [5];
etiquetas[0] = "MAIN_ENTITY_ID";
etiquetas[1] = "MAIN_ENTITY_ID_CTXT_TYP";
etiquetas[2] = "MAIN_ENTITY_NME";
etiquetas[3] = "MAIN_ENTITY_TYP";
etiquetas[4] = "MAIN_ENTITY_TBL_TYP";

valores.put (etiquetas[0],datos.toString());
valores.put (etiquetas[1],"ORI-" + cntrprtyOperativeOid);
valores.put (etiquetas[2],"Calculo(Se muestran datos: Head Office Relationship, Fund Indicator, Corporate Relationship - " + inup);
valores.put (etiquetas[3],"CORPREL");
valores.put (etiquetas[4],"FRA1");]]></objectValue>
<type>CONSTANT</type>
</item>
