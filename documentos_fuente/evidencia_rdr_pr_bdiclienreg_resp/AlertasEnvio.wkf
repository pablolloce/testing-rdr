<item id="552" type="com.j2fe.workflow.definition.Transition">
<name id="553">CUERPO</name>
<source id="554">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="555">Validate TIPO_ENVIO</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="556">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="557" type="java.util.HashSet">
<item id="558" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="559">statements</name>
<stringValue id="560">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("GestionAlertas - Validate env");

String tipoenvio = TIPO_ENVIO.get("TIPO_ENVIO");
tipoenv = TIPO_ENVIO.get("TIPO_ENVIO");

if (tipoenvio == null || tipoenvio.length() == 0){
	resultado = "KO";
	return "KO";
} else if (tipoenvio.equals("EXCEL")){
	resultado = "EXCEL";
	return "EXCEL";
}else if (tipoenvio.equals("WORD")){
	resultado = "WORD";
	return "WORD";
}else if (tipoenvio.equals("TXT")){
	resultado = "TXT";
	return "TXT";
}else if (tipoenvio.equals("DAT")){
	resultado = "DAT";
	return "DAT";
}else if (tipoenvio.equals("CUERPO")){
	resultado = "CUERPO";
	return "CUERPO";
} else {
	resultado = "KO";
	return "KO";
}
</stringValue>
<type>CONSTANT</type>
</item>
