<item id="125" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="126">querySQL</name>
<stringValue id="127"><![CDATA[Select count(*)
from ft_t_alg1 WHERE PROCESO = 'PETICION_REFINITIV_EMISIONES' AND PROCESADO <> 'N' AND last_chg_tms>trunc(sysdate)-30
AND SUBSTR(mensaje,0,3)='LEI'
and not exists (select * from ft_t_fiid lei, ft_t_fins finso, ft_t_fins finsl, ft_t_firl firll, ft_t_firl firlo, ft_t_fins finsg, ft_t_finr finro 
where finsg.inst_mnem = lei.inst_mnem and firll.prnt_inst_mnem = finsg.inst_mnem and finsl.inst_mnem = firll.inst_mnem and firlo.prnt_inst_mnem = finsl.inst_mnem and finso.inst_mnem = firlo.inst_mnem 
and finro.inst_mnem = finso.inst_mnem and firll.rel_typ='LOCAL' and firlo.rel_typ='OPERATIVE' and lei.FINS_ID_CTXT_TYP='LEIID' and lei.data_stat_typ='ACTIVE' and finsg.data_stat_typ='ACTIVE' and finsl.data_stat_typ='ACTIVE' 
and finro.finsrl_typ='ISSUER' and finso.data_stat_typ='ACTIVE' and finso.subsidiary_ind='N' and lei.fins_id=SUBSTR(mensaje,5,INSTR(mensaje,'|', 1, 1)-5))]]></stringValue>
<type>CONSTANT</type>
</item>
</parameters>
