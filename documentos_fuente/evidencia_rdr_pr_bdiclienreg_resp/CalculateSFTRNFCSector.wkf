<stringValue id="581">INSERT INTO FT_T_FRA1 (FRA1_OID, INST_MNEM, REG1_OID, CLSF_OID, CL_VALUE, LAST_CHG_TMS, LAST_CHG_USR_ID, DATA_SRC_ID, DATA_STAT_TYP, START_TMS)
VALUES (new_oid, :cntrprtyGlobalOid, (select REG1_OID from FT_T_REG1 where REG_NME='SFTR'), (select CLSF_OID from FT_T_INCL WHERE INDUS_CL_SET_ID='SFTRSECNFC' AND CL_VALUE=:cnaeSect), :cnaeSect, SYSDATE, 'BBVA:CUSTOMER', 'RDR', 'ACTIVE', SYSDATE)</stringValue>
<type>CONSTANT</type>
