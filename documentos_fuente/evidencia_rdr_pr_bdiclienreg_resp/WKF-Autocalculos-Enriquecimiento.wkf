<item id="744" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="745">querySQL</name>
<objectValue id="746" type="java.lang.String">WITH vreq AS (
    SELECT
        vnd_rqst_oid
    FROM
        ft_t_vreq
    WHERE
        vnd_rqst_xref_id_ctxt_typ = 'FundLEI'
        AND vnd_rqst_xref_id IN (
            SELECT
                fins_id
            FROM
                ft_t_fiid
            WHERE
                fins_id_ctxt_typ = 'LEIID'
                AND inst_mnem = ?
                AND data_stat_typ = 'ACTIVE'
        )
)
SELECT
    a.*,
    b.utd_id   AS cnae,
    c.utd_id   AS inst_typ,
    d.utd_id   AS vip_cl_ind,
    e.utd_id   AS folio_num,
    f.utd_id   AS address,
    g.utd_id   AS inst_code,
    h.utd_id   AS act_1940,
    i.utd_id   AS plaza_fisc,
    j.utd_id   AS provi,
    k.utd_id   AS country,
    l.utd_id   AS fxrelfund,
    m.utd_id   AS ctm_fund
FROM
    vreq        a
    LEFT JOIN ft_t_utd1   b ON a.vnd_rqst_oid = b.utd_ext_id
                             AND b.utd_id_purp_typ = 'CNAE'
    LEFT JOIN ft_t_utd1   c ON a.vnd_rqst_oid = c.utd_ext_id
                             AND c.utd_id_purp_typ = 'INST_TYP'
    LEFT JOIN ft_t_utd1   d ON a.vnd_rqst_oid = d.utd_ext_id
                             AND d.utd_id_purp_typ = 'VIP_CL_IND'
    LEFT JOIN ft_t_utd1   e ON a.vnd_rqst_oid = e.utd_ext_id
                             AND e.utd_id_purp_typ = 'FOLIO_NUM'
    LEFT JOIN ft_t_utd1   f ON a.vnd_rqst_oid = f.utd_ext_id
                             AND f.utd_id_purp_typ = 'ADDRESS'
    LEFT JOIN ft_t_utd1   g ON a.vnd_rqst_oid = g.utd_ext_id
                             AND g.utd_id_purp_typ = 'INST_CODE'
    LEFT JOIN ft_t_utd1   h ON a.vnd_rqst_oid = h.utd_ext_id
                             AND h.utd_id_purp_typ = '1940_ACT'
    LEFT JOIN ft_t_utd1   i ON a.vnd_rqst_oid = i.utd_ext_id
                             AND i.utd_id_purp_typ = 'CITY_DISTR'
    LEFT JOIN ft_t_utd1   j ON a.vnd_rqst_oid = j.utd_ext_id
                             AND j.utd_id_purp_typ = 'PROVINCE'
    LEFT JOIN ft_t_utd1   k ON a.vnd_rqst_oid = k.utd_ext_id
                             AND k.utd_id_purp_typ = 'COUNTRY'
    LEFT JOIN ft_t_utd1   l ON a.vnd_rqst_oid =l.utd_ext_id
                             AND l.utd_id_purp_typ = 'FXRELFUND'
    LEFT JOIN ft_t_utd1   m ON a.vnd_rqst_oid =m.utd_ext_id
                             AND m.utd_id_purp_typ = 'CTM_FUND'   </objectValue>
<type>CONSTANT</type>
</item>
</parameters>
