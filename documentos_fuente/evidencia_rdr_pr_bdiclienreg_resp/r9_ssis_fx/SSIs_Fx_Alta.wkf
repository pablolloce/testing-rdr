<item id="515" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="516">statements</name>
<stringValue id="517">// Selección de modo de extraer los xml para dar de alta las SDIs
if(Modo.equals("Online")){return "ONLINE";}
else if(Modo.equals("Conciliacion")) {return "CONCILIACION";}
else {return "ERROR";}</stringValue>
<type>CONSTANT</type>
</item>
