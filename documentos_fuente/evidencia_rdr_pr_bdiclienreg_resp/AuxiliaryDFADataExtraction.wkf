<item id="233" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="234">querySQL</name>
<stringValue id="235">SELECT	NVL(FRA1.CL_VALUE,' ') USPERSON
FROM FT_T_FRA1 FRA1, FT_T_FIRL FIRLL, FT_T_FIRL FIRLO
WHERE FRA1.INST_MNEM = FIRLL.PRNT_INST_MNEM
AND FRA1.CLSF_OID IN (SELECT CLSF_OID FROM FT_T_INCL WHERE INDUS_CL_SET_ID ='USPERSON  ')
AND FRA1.DATA_STAT_TYP = 'ACTIVE'
AND FIRLL.INST_MNEM = FIRLO.PRNT_INST_MNEM
AND FIRLO.INST_MNEM = :cntrprtyOperativeOid</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
