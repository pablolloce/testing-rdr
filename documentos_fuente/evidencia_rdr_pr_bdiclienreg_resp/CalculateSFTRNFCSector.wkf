</item>
<item id="133" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="134">querySQL</name>
<stringValue id="135">select fra1.fra1_oid from ft_t_fra1 fra1, ft_t_reg1 reg1, ft_t_incl incl 
where fra1.reg1_oid=reg1.reg1_oid 
and reg1.reg_nme='SFTR' 
and fra1.clsf_oid=incl.clsf_oid 
and incl.indus_cl_set_id='FINALSFTR' 
and (incl.cl_nme='Non FC+' OR incl.cl_nme = 'Non FC-')
and fra1.inst_mnem=:cntrprtyGlobalOid 
and fra1.data_stat_typ='ACTIVE'</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
