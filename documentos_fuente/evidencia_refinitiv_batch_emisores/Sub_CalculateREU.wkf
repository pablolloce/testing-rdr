<input>true</input>
<name id="14">statements</name>
<stringValue id="15"><![CDATA[import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("Sub_CalculateREU");
logger.error("Sub_CalculateREU: ---------------------------------------------------------------2");

if(CL_VALUE !=null && CL_VALUE.length>0&&CL_VALUE[0].get("CL_VALUE")!=null){
	logger.error("CL_VALUE[0].get(CL_VALUE): "+CL_VALUE[0].get("CL_VALUE"));
	if(CL_VALUE[0].get("CL_VALUE").trim().equalsIgnoreCase("A")){
		return "OK";
	}else{
		return "KO";
	}
}else{
	return "KO";
}


]]></stringValue>
<type>CONSTANT</type>
</item>
