<stringValue id="241">INSERT INTO TABLEALERTGENER (ALG1_OID,PROCESO,ALD1_OID,MENSAJE,TIPO,PROCESADO,DATA_STAT_TYP,LAST_CHG_TMS,START_TMS,LAST_CHG_USR_ID) VALUES (new_oid, 'CALCULO_EMIR_SECT', (select ALD1_OID from ft_t_ald1 where ID_DEF_ALERT = 'EXCELROW' and data_stat_typ='ACTIVE'),:message,'CELDAEXCEL','N','ACTIVE',sysdate,sysdate,'AlertasBarrido.jar')</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
