<item id="384" type="com.j2fe.workflow.definition.Transition">
<name id="385">goto-next</name>
<source id="386">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="387">get SPONSOR FILE TICKER</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="388">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="389" type="java.util.HashSet">
<item id="390" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="391">statements</name>
<stringValue id="392">String ruta = "";
String sponsor = "";
String fileName = "";
String file ="";
String basketIdentifier = "";
String indexId = "";
ArrayList listaErrores = new ArrayList();
ruta=Ruta.getPath();

String[] splitted = ruta.split("/");
//Separamos el sponsor y el nombre de fichero de la ruta
sponsor = splitted [splitted.length-2].toUpperCase();
fileName = splitted [splitted.length-1];
//al nombre de fichero le quitamos la extension
fileName= fileName.replaceFirst("[.][^.]+$", "");

String[] splittedName = fileName.split("_");
fileType = splittedName[0].toUpperCase();

if(sponsor.equals("SP_DJ")){
indexId = splittedName[1].toUpperCase();
basketIdentifier = indexId;
}else{
indexId = splittedName[splittedName.length-1].toUpperCase();
basketIdentifier = indexId;
}
		</stringValue>
<type>CONSTANT</type>
</item>
