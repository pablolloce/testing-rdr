						FDL_FOREIGN_DATE  = fieldsMap.get("FIS_Foreign_Issuer Rating Effective Date").toString() ;
				}else{
						FDL_FOREIGN_CODE = fieldsMap.get("FIS_Foreign_Issuer Rating Code").toString() ;
						FDL_FOREIGN_DATE  = fieldsMap.get("FIS_Foreign_Issuer Rating Effective Date").toString() ;
				}
			}
		}

		if(FDL_FOREIGN_CODE.length()==0 || FDL_FOREIGN_CODE.equals("NR") ){
			if(fieldsMap.get("FBD_Foreign_Issuer Rating Code")!=null && fieldsMap.get("FBD_Foreign_Issuer Rating Code").toString().length()>0 
					&& !fieldsMap.get("FBD_Foreign_Issuer Rating Code").equals(" ")){
				if(fieldsMap.get("FBD_Foreign_Issuer Rating Code").equals("N.A.") || fieldsMap.get("FBD_Foreign_Issuer Rating Code").equals("N.S.") ||  
