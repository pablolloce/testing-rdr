<item id="104" type="com.j2fe.workflow.definition.Transition">
<name id="105">KO</name>
<source id="106">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="107">calculoSFTR por defecto</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="108">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="109" type="java.util.HashSet">
<item id="110" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="111">statements</name>
<stringValue id="112"><![CDATA[import org.apache.commons.lang.StringUtils;
import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("Global Regulatory Information / Calculate Final type under SFTR");
//Declaracion de variables
Map calculoSFTR;
String manSftr = "";

// Manual Counterparty type under SFTR
if (manualSftrStatus!=null && manualSftrStatus.length > 0){
	if (manualSftrStatus[0].get("STATUS") != null && manualSftrStatus[0].get("STATUS").equals("Activar")){
		return "ACTIVANDO";
	}
	else if (manualSftrStatus[0].get("STATUS") != null && manualSftrStatus[0].get("STATUS").equals("Inactivar")){
		return "INACTIVANDO";
	}
	else{
		return "KO";
	}
}
else{
	if (manualSftr != null && manualSftr.length > 0) {
		calculoSFTR = new HashMap();
		manSftr = manualSftr[0].get("VALOR");
		calculoSFTR.put("ETIQUETA", manSftr);
		return "OK";

	}else{
		manSftr = "NE";
		return "KO";
	}
}]]></stringValue>
<type>CONSTANT</type>
</item>
