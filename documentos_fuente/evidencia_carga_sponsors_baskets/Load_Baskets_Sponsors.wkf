<item id="780" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="781">querySQL</name>
<objectValue id="782" type="java.lang.String">select INSTRID, INDEXTYPE from (select COUNT(distinct issu.instr_id) over() cnt ,issu.instr_id instrid, issu.iss_typ INDEXTYPE from ft_t_isid isin, ft_t_isid ticker, ft_t_isid seclabel, ft_t_issu issu
where isin.id_ctxt_typ = 'ISIN'
and ticker.id_ctxt_typ = 'TICKER'
and seclabel.id_ctxt_typ = 'MUREXID'
and issu.instr_id=ticker.instr_id
and ticker.instr_id=isin.instr_id
and isin.instr_id=seclabel.instr_id
and (issu.end_tms is null or issu.end_tms > sysdate)
and (ticker.end_tms is null or ticker.end_tms > sysdate)
and (isin.end_tms is null or isin.end_tms > sysdate)
and (seclabel.end_tms is null or seclabel.end_tms > sysdate)
and (issu.data_stat_typ='ACTIVE' or issu.data_stat_typ='INCOMPLETO')
and (ticker.data_stat_typ='ACTIVE' or ticker.data_stat_typ='INCOMPLETO')
and (isin.data_stat_typ='ACTIVE' or isin.data_stat_typ='INCOMPLETO')
and (seclabel.data_stat_typ='ACTIVE' or seclabel.data_stat_typ='INCOMPLETO')
and ticker.iss_id=:1
and isin.iss_id=:2
and (issu.iss_typ = :3 or (issu.iss_typ in ('ETF', 'FUND') and issu.Alt_asset_class_txt in ('ETP', 'Exchange Traded Funds', 'Equity ETFs'))))
where cnt=1 and rownum=1</objectValue>
<type>CONSTANT</type>
</item>
</parameters>
