				}
			}
		}
			
		if(FDL_DOMESTIC_CODE.equals("")){
			FDL_DOMESTIC_CODE ="NR";
		}
			
		fieldsCateg.put("FITCH_DOMESTIC_CODE", FDL_DOMESTIC_CODE );
		fieldsCateg.put("FITCH_DOMESTIC_DATE", FDL_DOMESTIC_DATE );
			
		String FDL_FOREIGN_CODE ="";
		String FDL_FOREIGN_DATE ="";

		if(fieldsMap.get("FDL_Foreign_Issuer Rating Code")!=null && fieldsMap.get("FDL_Foreign_Issuer Rating Code").toString().length()>0 
				&& !fieldsMap.get("FDL_Foreign_Issuer Rating Code").equals(" ")){
			if(fieldsMap.get("FDL_Foreign_Issuer Rating Code").equals("N.A.") || fieldsMap.get("FDL_Foreign_Issuer Rating Code").equals("N.S.") ||  
