<item id="238" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="239">querySQL</name>
<stringValue id="240">UPDATE FT_T_FRA1 SET DATA_STAT_TYP = 'ACTIVE', CLSF_OID = (SELECT CLSF_OID FROM FT_T_INCL WHERE TRIM(INDUS_CL_SET_ID) = :indus AND CL_VALUE = :valor), CL_VALUE = :valor
WHERE FRA1_OID = (SELECT FRA1_OID FROM (SELECT ROW_NUMBER() over (PARTITION BY INST_MNEM ORDER BY DATA_STAT_TYP asc) AS RNK, FRA1.* FROM FT_T_FRA1 FRA1
	WHERE CLSF_OID in (SELECT CLSF_OID FROM FT_T_INCL WHERE TRIM(INDUS_CL_SET_ID) = :indus)
	AND INST_MNEM = :mnem
	AND END_TMS is null)
	WHERE RNK=1)</stringValue>
<type>CONSTANT</type>
</item>
<item id="241" type="com.j2fe.workflow.definition.Parameter">
<input>false</input>
<name id="242">rowCount</name>
<stringValue id="243">RowCount</stringValue>
<type>VARIABLE</type>
</item>
</parameters>
