<name id="1149">statements</name>
<objectValue id="1150" type="java.lang.String"><![CDATA[import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.Calendar;
import java.util.HashMap;
import java.util.LinkedHashMap;
import java.util.Map;

Date date = Calendar.getInstance().getTime();
SimpleDateFormat date2 = new SimpleDateFormat("dd-MM-yyyy  HH.mm.ss");

if (fieldsMap.get("Request Status").equals("OK"))
{
OUTPUT="<?xml version='1.0' encoding='utf-8'?><REFINITIV_REQ><REF_ID>" + VREQ_OID + 
"</REF_ID><REF_STATUS>PROCESSED</REF_STATUS><REF_DATE>"+ date2.format(date) +"</REF_DATE><REF_MSG>The request has been correctly processed.</REF_MSG>" +
"<REF_RLEI>" + fieldsMap.get("Entity LEI").	toString() + "</REF_RLEI>" +
"<REF_RCRISK>" + fieldsMap.get("Country of Risk - Ultimate Parent - Primary").toString() + "</REF_RCRISK>" +
"<REF_RAC>" + fieldsMap.get("TRBC Activity Code").toString() + "</REF_RAC>" +
"<REF_RESCD>" +fieldsMap.get("TRBC Economic Sector Code Description").toString() +"</REF_RESCD>" +
"<REF_RBSCD>" + fieldsMap.get("TRBC Business Sector Code Description").toString() + "</REF_RBSCD>" +
"<REF_RIGCD>" + fieldsMap.get("TRBC Industry Group Code Description").toString() + "</REF_RIGCD>" + 
"<REF_TRICD>" + fieldsMap.get("TRBC Industry Code Description").toString() + "</REF_TRICD>" +
"<REF_TRACD>" + fieldsMap.get("TRBC Activity Code Description").toString() + "</REF_TRACD>" +
"<REF_TRLET>" + fieldsMap.get("Legal Entity Type").toString() + "</REF_TRLET>" +
"<REF_TRLETD>" + fieldsMap.get("Legal Entity Type Description").toString() + "</REF_TRLETD>" +
"<REF_TRLEST>" + fieldsMap.get("Legal Entity SubType").toString() + "</REF_TRLEST>" +
"<REF_TRLESTD>" + fieldsMap.get("Legal Entity SubType Description").toString() + "</REF_TRLESTD>" +
OUTPUT_SAA + 
"</REFINITIV_REQ>";
} 
else
{
OUTPUT="<?xml version='1.0' encoding='utf-8'?><REFINITIV_REQ><REF_ID>" + VREQ_OID + 
"</REF_ID><REF_STATUS>FAILED</REF_STATUS><REF_DATE>"+ date2.format(date) +"</REF_DATE><REF_MSG>Refinitiv refuses the request with error message: "+ fieldsMap.get("Error Message") +"</REF_MSG>" +
"<REF_RLEI/>" +
"<REF_RCRISK/>" + 
"<REF_RAC/>" + 
"<REF_RESCD/>" +
"<REF_RBSCD/>" + 
"<REF_RIGCD/>" + 
"<REF_TRICD/>" + 
"<REF_TRACD/>" + 
"<REF_TRLET/>" + 
"<REF_TRLETD/>" + 
"<REF_TRLEST/>" + 
"<REF_TRLESTD/>" + 
"<REF_ACTIVITY_ASSET/>" + 
"<REF_ACTIVITY_ASSET_CLVALUE/>"+ 
"<REF_ACTIVITY_ASSET_INDCLSETID/>" +
"<REF_ACTIVITY_ASSET_CLSFOID/>" +
"<REF_ACTIVITY_ASSET_DATASRCID/>"+
"<REF_SECTOR_ASSET/>"+
"<REF_SECTOR_ASSET_CLVALUE/>"+
