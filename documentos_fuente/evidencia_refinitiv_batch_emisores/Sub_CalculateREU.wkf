<name id="2686">statements</name>
<stringValue id="2687">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("Sub_CalculateREU");

CLSF_OID = CLSF_OID_Array[0].get("CLSF_OID");

logger.error("Sub_CalculateREU1111111: --------------------------------------CLSF_OID--"+CLSF_OID);</stringValue>
<type>CONSTANT</type>
</item>
