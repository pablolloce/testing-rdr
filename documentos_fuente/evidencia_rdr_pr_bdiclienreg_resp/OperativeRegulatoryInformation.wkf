<item id="363" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="364">querySQL</name>
<stringValue id="365">SELECT NVL(UPPER(FIID.FINS_ID),' ') CANONICO
FROM FT_T_FIID FIID
WHERE FIID.INST_MNEM = :cntrprtyOperativeOid
AND FIID.FINS_ID_CTXT_TYP = 'FINSID'
AND FIID.DATA_STAT_TYP = 'ACTIVE'</stringValue>
<type>CONSTANT</type>
</item>
