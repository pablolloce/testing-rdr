<stringValue id="420">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("GestionAlertas - Validate env");

String periodicidad = PERIODICIDAD[0].get("PERIODICIDAD");

if(periodicidad.contains("PARCIAL")){
	if(body.contains("No existen datos a enviar")){
		return "KO";
	}
	return "OK";
}else{
	return "OK";
}</stringValue>
