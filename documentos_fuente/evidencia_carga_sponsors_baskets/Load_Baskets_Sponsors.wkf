<input>true</input>
<name id="914">statements</name>
<stringValue id="915">String mensaje = "";
String tipoMensaje = "";
String[] arrayMensaje = new String[2]; 

mensaje = "El "+indexTypeText+indexMap.get("indexIdText")+" no está asociado a ninguna cesta en RDR";

tipoMensaje = "ERROR DE DATOS";

arrayMensaje[0] = tipoMensaje;
arrayMensaje[1] = mensaje;

listaErrores.add(arrayMensaje);</stringValue>
<type>CONSTANT</type>
</item>
