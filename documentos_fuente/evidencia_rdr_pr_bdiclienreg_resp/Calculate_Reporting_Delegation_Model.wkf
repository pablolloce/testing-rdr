<name id="716">statements</name>
<stringValue id="717"><![CDATA[import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("Calculate_Reporting_Delegation_Model");

String aux_EMIR_RDM = "";

if (usindem != null && usindem.length > 0 ) {
	logger.error("[Calculate_Reporting_Delegation_Model]  usindem[0].get(USINDEM) : " + usindem[0].get("USINDEM"));
	if(usindem[0].get("USINDEM").equals("Y")){
		aux_EMIR_RDM = "02";
		logger.error("[Calculate_Reporting_Delegation_Model]  aux_EMIR_RDM -1 : " + aux_EMIR_RDM );
	}else	{
		aux_EMIR_RDM = "06";
		logger.error("[Calculate_Reporting_Delegation_Model]  aux_EMIR_RDM -1 : " + aux_EMIR_RDM );
	}
}else{
	aux_EMIR_RDM = "02";
}
logger.error("[Calculate_Reporting_Delegation_Model]  aux_EMIR_RDM -2 : " + aux_EMIR_RDM );]]></stringValue>
<type>CONSTANT</type>
</item>
