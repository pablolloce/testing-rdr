<directJoin>false</directJoin>
<name id="50">Crea Msg ALTA 460</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="51">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="52" type="java.util.HashSet">
<item id="53" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="54">statements</name>
<stringValue id="55"><![CDATA[// Mensaje de ALTA 460
import org.apache.commons.lang.StringUtils;
import java.text.SimpleDateFormat;
import java.util.Date;

Date ahora = new Date();
SimpleDateFormat formateador = new SimpleDateFormat("yyMMddHHmmssSSS");
String fecha = formateador.format(ahora);
String msgeId = "";
if (newOid!=null && newOid.length>0){
	msgeId = "C" + newOid[0].get("NEWOID") + fecha.substring(4,8) + "ACLIA460";
} else {
	msgeId = "C" + fecha.substring(0,14) + "ACLIA460";
}
String MSG_ID= msgeId.substring(5,15);
StringBuilder messageCLI = new StringBuilder(msgeId);
if (!(CODPAIS!=null && CODPAIS.length()>0)) {
	CODPAIS="0011";
} 
String [] values = {CCLIEN,CODBAN,CODOFI,CODPAIS};
int [] longs = {9,4,4,4};
int i = 0;



for ( i = 0 ; i < values.length ; i++)
{
	if (values[i] != null)
	{
		messageCLI.append(StringUtils.rightPad(values[i],longs[i]));
	}
	else
	{
		messageCLI.append(StringUtils.rightPad(" ",longs[i]));
	}
}

String message = messageCLI.toString();
]]></stringValue>
<type>CONSTANT</type>
</item>
