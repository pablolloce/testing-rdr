<parameters id="92" type="java.util.HashSet">
<item id="93" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="94">statements</name>
<stringValue id="95"><![CDATA[if (cftcMap != null) 
{
	if(!cftcMap.containsKey("WE-COD-ROLIN"))
	{
		cftcMap.put("WE-COD-ROLIN"," ");
		if(!secMap.containsKey("WE-COD-ROLCRSEC"))
		{
			secMap.put("WE-COD-ROLCRSEC"," ");
			return false;
		}else
		{
			return "out";
		}
	}else
	{
		if(!secMap.containsKey("WE-COD-ROLCRSEC"))
		{
			secMap.put("WE-COD-ROLCRSEC"," ");
			return "out2";
		}else
		{
			//Los datos prioritarios si que se encuentran rellenos
			if(cftcMap.size() == 5 && secMap.size() == 2)
			{
				return "ok";
			}else
			{
				return "calculate";
			}
		}
	}

}else
{
	return false;
	
}]]></stringValue>
<type>CONSTANT</type>
</item>
