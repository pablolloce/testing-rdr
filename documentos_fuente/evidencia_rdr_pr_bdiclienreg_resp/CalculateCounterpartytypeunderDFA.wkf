<name id="112">statements</name>
<stringValue id="113"><![CDATA[if (!calculoFinentdf.isEmpty() && finentdf != null && finentdf.length > 0) 
{
	//Control de estado de la extracciÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â³n del European Person Indicator
	if(finentdf[0].get("ESTADO").equals("ACTIVE"))
	{
		if(calculoFinentdf.get("FINENTDF").equals(finentdf[0].get("FINENTDF")))
		{
			update = true;
			return "out";
		}else
		{
			update = true;
			return true;
		}
	}else
	{
		//El dato se encuentra inactivo y se tiene que actualizar con el dato calculado y el status reactivado
		return "reactivar";
	}

}else
{
	update = false;
	return false;
	
}]]></stringValue>
<type>CONSTANT</type>
</item>
