String query = "Insert into ft_t_atb1 (ATB1_OID,INST_MNEM,DEST_SYST,OBL_APP,BROAD_CHECK,LAST_CHG_TMS,LAST_CHG_USR_ID,DATA_SRC_ID,DATA_STAT_TYP,START_TMS,END_TMS,ESB_CHECK) values ((SELECT NEW_OID FROM DUAL),'"+mnemOperativo+"','SCFFID','N','N',SYSDATE,'SCF_LOADER','RDR','ACTIVE',SYSDATE,null,'Y   ')\r\n";
</stringValue>
<type>CONSTANT</type>
