<item id="1278" type="com.j2fe.workflow.definition.Transition">
<name id="1279">CORRECTO</name>
<source id="1280">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="1281">Loop verificacion xml entrada</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="1282">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="1283" type="java.util.HashSet">
<item id="1284" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="1285">statements</name>
<objectValue id="1286" type="java.lang.String"><![CDATA[import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("Load_Baskets_Sponsors");
//logger.error("text");

String currency ="";
String accion ="";
String mensaje = "";
String tipoMensaje = "";
String mainId = "";
String secondaryId = "";
String market = "";
String instrName = "";
String[] arrayMensaje = new String[2]; 
Map mapAlta = new HashMap();
accion="CORRECTO";
//cada inputComponentNode es un elemento del XML de entrada sobre el cual se hace el loop
//componentsMap tiene todos los componentes de la ISGP activos y que no han sido descartados cuando se pasa de BBDD a Mapa
//componentsMap se agrega la acción sobre cada uno, ALTA, CORRECTO, ERROR

mainId = inputComponentNode.getElementsByTagName(mainIdType).item(0).getTextContent();
if (!secondaryIdType.equals("")) {
		secondaryId = inputComponentNode.getElementsByTagName(secondaryIdType).item(0).getTextContent();
}
currency = inputComponentNode.getElementsByTagName("CURRENCY").item(0).getTextContent();
instrName = inputComponentNode.getElementsByTagName(instrumentName).item(0).getTextContent();

//Asignamos valor al market solo cuando el maindIdType es ISIN
if (mainIdType.equals("ISIN")){
	if(inputComponentNode.getElementsByTagName("COMPONENT_MIC").item(0).getTextContent().equals("")){
		market=mic;
	} else {
		market=inputComponentNode.getElementsByTagName("COMPONENT_MIC").item(0).getTextContent();
	}
}

if (componentsMap.containsKey(mainId)) {
	if (!secondaryId.isEmpty() && componentsMap.get(mainId).get(secondaryIdType) != null && componentsMap.get(mainId).get(secondaryIdType).equals(secondaryId)) {
	}else if (secondaryId.isEmpty()){
		}else {
			accion="ERROR";
			mensaje="El componente ya existente en la cesta con " + mainIdType + ": " + mainId + " y " + secondaryIdType + ": " + secondaryId + " no pertenecen a la misma emisión en RDR";
			tipoMensaje = "ERROR DE DATOS";
			arrayMensaje[0] = tipoMensaje;
			arrayMensaje[1] = mensaje;
			listaErrores.add(arrayMensaje);
		}
		
	if (!accion.equals("ERROR")) {
		if (componentsMap.get(mainId).get("CURRENCY") != null && componentsMap.get(mainId).get("CURRENCY").equalsIgnoreCase(currency)) {
		}else{
			componentsBajaMap.put(componentsMap.get(mainId).get("ISGPOID"),componentsMap.get(mainId).get("CANONICO"));
			componentsMap.remove(mainId);
			accion="ALTA";
			mapAlta.put(mainIdType,inputComponentNode.getElementsByTagName(mainIdType).item(0).getTextContent());
			if (!secondaryIdType.equals("")) {
				mapAlta.put(secondaryIdType,inputComponentNode.getElementsByTagName(secondaryIdType).item(0).getTextContent());
			}
			mapAlta.put("CURRENCY",currency);
			mapAlta.put("MARKET",market);		
            mapAlta.put("INSTRUMENT_NAME",instrName);
        	componentsMap.put(mainId,mapAlta);
		}

		if (mainIdType.equals("ISIN")){
			if(componentsMap.get(mainId).get("MKTID") != null && componentsMap.get(mainId).get("MKTID").equals(market)) {
			}else if (componentsMap.get(mainId).get("SECLABEL_MKT_GRP") != null && componentsMap.get(mainId).get("SECLABEL_MKT_GRP").equals(prt_grp_mic)){
			}else{
				componentsBajaMap.put(componentsMap.get(mainId).get("ISGPOID"),componentsMap.get(mainId).get("CANONICO"));
				componentsMap.remove(mainId);
				accion="ALTA";
				mapAlta.put(mainIdType,inputComponentNode.getElementsByTagName(mainIdType).item(0).getTextContent());
				if (!secondaryIdType.equals("")) {
					mapAlta.put(secondaryIdType,inputComponentNode.getElementsByTagName(secondaryIdType).item(0).getTextContent());
				}
				mapAlta.put("CURRENCY",currency);
				mapAlta.put("MARKET",market);
				mapAlta.put("INSTRUMENT_NAME",instrName);
				componentsMap.put(mainId,mapAlta);
			}
		}
	}
}else{
	accion="ALTA";
	mapAlta.put(mainIdType,inputComponentNode.getElementsByTagName(mainIdType).item(0).getTextContent());
	if (!secondaryIdType.equals("")) {
		mapAlta.put(secondaryIdType,inputComponentNode.getElementsByTagName(secondaryIdType).item(0).getTextContent());
	}
	mapAlta.put("CURRENCY",currency);
	mapAlta.put("MARKET",market);
	mapAlta.put("INSTRUMENT_NAME",instrName);
	componentsMap.put(mainId,mapAlta);
}
componentsMap.get(mainId).put("accion",accion);
Transition=accion;]]></objectValue>
<type>CONSTANT</type>
</item>
