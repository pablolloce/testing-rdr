<name id="222">Calculo DR</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="223">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="224" type="java.util.HashSet">
<item id="225" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="226">statements</name>
<stringValue id="227"><![CDATA[import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("CheckDatosRegulatorios");

boolean hacerCalculoDR = true;

logger.error("[CheckDatosRegulatorios] OperativeRegulatoryInformation predecesor: " + predecesor);
logger.error("[CheckDatosRegulatorios] OperativeRegulatoryInformation CALCULODR.length " + CALCULODR.length);

if (predecesor != null && predecesor.equalsIgnoreCase("Ventana") && CALCULODR != null && CALCULODR.length > 0) {
	logger.error("[CheckDatosRegulatorios] OperativeRegulatoryInformation CALCULODR[0]" + CALCULODR[0].get("SRC_VALUE"));
	if(CALCULODR[0].get("SRC_VALUE").equals("false"))	{
		logger.error("CheckDatosRegulatorios NOS SALTAMOS EL CALCULO");
		hacerCalculoDR =  false;
	}else	{
		logger.error("CheckDatosRegulatorios VAMOS A POR EL CALCULO");
		hacerCalculoDR =  true;
	}
}else{
	logger.error("CheckDatosRegulatorios VAMOS A POR EL CALCULO");
	hacerCalculoDR =  true;
}
]]></stringValue>
<type>CONSTANT</type>
</item>
