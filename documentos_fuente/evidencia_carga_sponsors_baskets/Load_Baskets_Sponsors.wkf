<item id="214" type="com.j2fe.workflow.definition.Transition">
<name id="215">ERROR</name>
<source id="216">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="217">Alert Started - Index Ids Check</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="218">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="219" type="java.util.HashSet">
<item id="220" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="221">statements</name>
<objectValue id="222" type="java.lang.String"><![CDATA[import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("Load_Baskets_Sponsors");

String mensaje = "";
String[] arrayMensaje = new String[2]; 
String indexType = "EQINDEX";
String indexIdType = "ERROR";
String indexIdText = "";
String indexId = "";



//Detectamos el tipo de id a usar y generamos el texto para mensajes alerta

if(!indexMap.get("indexIdentifier").equals("")){
	//Si el campo indexIdentifier viene informado usaremos solo el INHOUSE identifier para encontrar el indice
	indexIdType="INHOUSE";
	indexIdText=" con INHOUSE ID: "+indexMap.get("indexIdentifier");
	indexId = indexMap.get("indexIdentifier");
}else if (!indexMap.get("indexSymbol").equals("") && !indexMap.get("indexIsin").equals("")){
	//Si los campos indexSymbol e indexIsin vienen informados usaremos TICKER+ISIN para encontrar el indice
	indexIdType="TICKER+ISIN";
	indexIdText=" con Ticker: "+indexMap.get("indexSymbol")+" e ISIN: "+indexMap.get("indexIsin");
	indexId = indexMap.get("indexSymbol");
}else if (!indexMap.get("indexSymbol").equals("")){
		//Si solo viene informado campo indexSymbol y no el ISIN, usaremos solo TICKER para encontrar el indice
	indexIdType="TICKER";
	indexIdText=" con Ticker: "+indexMap.get("indexSymbol");
	indexId = indexMap.get("indexSymbol");
}else if (!indexMap.get("indexIsin").equals("")){
		//Si solo viene informado campo indexIsin y no el TICKER, usaremos solo ISIN para encontrar el indice
	indexIdType="ISIN";
	indexIdText=" con ISIN: "+indexMap.get("indexIsin");
	indexId = indexMap.get("indexIsin");
}else if (!indexMap.get("indexRic").equals("")){
		//Si solo viene informado campo indexRic y no el TICKER ni ISIN, usaremos solo RIC para encontrar el indice
	indexIdType="RIC";
	indexIdText=" con RIC: "+indexMap.get("indexRic");
	indexId = indexMap.get("indexRic");
}

indexMap.put("indexId",indexId);
indexMap.put("indexIdText",indexIdText);

logger.error("Inicio de carga de cesta, indice "+ indexMap.get("indexId"));
mensaje = "Inicio de carga de la cesta: " + indexMap.get("indexId") + " del sponsor: " + sponsor + " de tipo: " + fileType;
arrayMensaje[0] = "INFO";
arrayMensaje[1] = mensaje;
listaErrores.add(arrayMensaje);



//Se define el index type ADINDEX para SP_DJ, todos los sponsor permiten ETF y FUNDS
if (sponsor.equals("SP_DJ")) {
indexType = "ADINDEX";
}


Transition=indexIdType;]]></objectValue>
<type>CONSTANT</type>
</item>
