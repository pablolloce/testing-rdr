<item id="181" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="182">querySQL</name>
<stringValue id="183">select 
RECORD_SEQ_NUM,
'Tecnico' ERROR_TYPE,
MAIN_ENTITY_NME,
''MESSAGE_RLT,
CRRNT_SEVERITY_CDE,
MAIN_ENTITY_TBL_TYP,
''RLT_OID,
TRN_ID,
JOB_ID,
'' NOTFCN_ID,
'' NOTFCN_SHORT_TXT

from ft_t_trid
where
JOB_ID=? and crrnt_severity_cde > 39
</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
