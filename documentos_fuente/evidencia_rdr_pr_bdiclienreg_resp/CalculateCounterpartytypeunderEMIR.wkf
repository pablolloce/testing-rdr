<item id="362" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="363">querySQL</name>
<stringValue id="364">UPDATE FT_T_FRA1
SET CLSF_OID = (SELECT CLSF_OID FROM FT_T_INCL WHERE INDUS_CL_SET_ID = 'EMIRCAT' AND CL_VALUE = :value), CL_VALUE = :value, LAST_CHG_TMS = sysdate
WHERE FRA1_OID = (SELECT FRA1_OID FROM (SELECT ROW_NUMBER() over (PARTITION BY INST_MNEM ORDER BY DATA_STAT_TYP asc) as RNK, FRA1.* FROM FT_T_FRA1 FRA1
	WHERE CLSF_OID in (SELECT CLSF_OID FROM FT_T_INCL WHERE TRIM(INDUS_CL_SET_ID) = 'EMIRCAT')
	AND INST_MNEM = :contrprtyGlobalOid
	AND END_TMS is null)
	WHERE RNK=1)
AND CL_VALUE != :value</stringValue>
<type>CONSTANT</type>
</item>
