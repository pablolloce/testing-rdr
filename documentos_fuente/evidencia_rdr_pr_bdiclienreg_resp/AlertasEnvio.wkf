<sources id="1029" type="java.util.HashSet">
<item id="1030" type="com.j2fe.workflow.definition.Transition">
<name id="1031">goto-next</name>
<source id="1032">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="1033">Variables</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="1034">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="1035" type="java.util.HashSet">
<item id="1036" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="1037">statements</name>
<stringValue id="1038">import java.io.File;
import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("ComposeEmail - Get environment");
logger.error(" -Entorno enviado por el GSProcess: " + Entorno);
if (Entorno==null){
	Entorno = "no";

	String pathpro = "/pr/kytl/online/multipais/multicanal/cfg/entorno/";
	String pathpre = "/pp/kytl/online/multipais/multicanal/cfg/entorno/";
	String pathint = "/ei/kytl/online/multipais/multicanal/cfg/entorno/";
	String pathdev = "/de/kytl/online/multipais/multicanal/cfg/entorno/";
	File folderpro = new File(pathpro);
	File folderpre = new File(pathpre);
	File folderint = new File(pathint);
	File folderdev = new File(pathdev);

	if (folderpro.exists())
		Entorno = "pr";
	else if (folderpre.exists())
		Entorno = "pp";
	else if (folderint.exists())
		Entorno = "ei";
	else if (folderdev.exists())
		Entorno = "de";
}

int counterProcesos=0;
int counterDestinatarios = 0;
int counterTipoEnvio = 0;

</stringValue>
<type>CONSTANT</type>
</item>
