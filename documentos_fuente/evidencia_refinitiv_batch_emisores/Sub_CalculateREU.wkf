<name id="1852">querySQL</name>
<stringValue id="1853">select FIST.INST_MNEM
from ft_t_fist fist
where fist.stat_def_id='KEEPREUL'
and fist.stat_char_val_txt='Y'
and fist.data_stat_typ='ACTIVE'
and fist.end_tms is null
and fist.inst_mnem=?</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
