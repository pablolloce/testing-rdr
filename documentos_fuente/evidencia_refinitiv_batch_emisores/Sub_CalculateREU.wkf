<name id="1145">statements</name>
<stringValue id="1146">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("Sub_CalculateREU");
logger.error("Sub_CalculateREU FOR: -------------------11-------------------finsRtngOid--------------------"+finsRtngOid);
logger.error("Sub_CalculateREU FOR: -------------------11---------------------inst_mnem-------------------"+inst_mnem);
logger.error("Sub_CalculateREU FOR: -------------------11---------------------REUOid-----------------------"+REUOid);
</stringValue>
<type>CONSTANT</type>
</item>
