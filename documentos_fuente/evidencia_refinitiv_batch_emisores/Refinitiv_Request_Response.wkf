<input>true</input>
<name id="13">statements</name>
<stringValue id="14">import java.io.*;
import java.net.URI;

try{

if ("UNDLY".equals(idType)) {
	String file = "file:"+ pathOut + fileOut;
	String old = (file+"").replace("OpcionesFutures/Enrichment/issues/RFNT_BBVA", "OpcionesFutures/Enrichment/issues/old/RFNT_BBVA");
	File source = new File(new URI(file+""));
	File dest = new File(new URI(old+""));
      	boolean bool = source.renameTo(dest);
}

else {
	String file = "file:"+ pathOut + fileOut;
	String old = (file+"").replace("Refinitiv/RFNT_BBVA", "Refinitiv/old/RFNT_BBVA");
      	File source = new File(new URI(file+""));
      	File dest = new File(new URI(old+""));
      	boolean bool = source.renameTo(dest);
}

} catch (Exception ex){	} 	
</stringValue>
<type>CONSTANT</type>
</item>
