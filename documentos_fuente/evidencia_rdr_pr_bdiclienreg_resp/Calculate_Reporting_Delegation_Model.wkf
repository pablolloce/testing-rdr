<stringValue id="844">INSERT INTO FT_T_FRA1 (FRA1_OID, INST_MNEM,REG1_OID,CLSF_OID,CL_VALUE,LAST_CHG_TMS,LAST_CHG_USR_ID,DATA_SRC_ID,DATA_STAT_TYP,START_TMS,ORG_ID)  
