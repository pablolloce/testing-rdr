<stringValue id="58">import org.apache.log4j.Logger; 
Logger logger = Logger.getLogger("ValidacionOficinas");
logger.error("Empieza workflow ValidacionOficinas");

try{
errors = errors + 1;
return "goto-next";
}catch(Exception e){
logger.error("Catch ValidacionOficinas");
return "goto-next";
}
</stringValue>
<type>CONSTANT</type>
