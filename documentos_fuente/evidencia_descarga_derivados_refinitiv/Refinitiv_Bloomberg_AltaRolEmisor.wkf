<item id="69" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="70">querySQL</name>
<stringValue id="71">SELECT 
    fiid.fins_id
FROM ft_t_fiid fiid
INNER JOIN ft_t_finr finr 
    ON finr.inst_mnem = fiid.inst_mnem
WHERE 
    fiid.fins_id_ctxt_typ = 'FINSID'
    AND fiid.fins_id = ?
    AND fiid.data_stat_typ = 'ACTIVE'
    AND fiid.end_tms IS NULL

    AND finr.finsrl_typ = 'ISSUER'
    AND finr.data_stat_typ = 'ACTIVE'
    AND finr.end_tms IS NULL</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
