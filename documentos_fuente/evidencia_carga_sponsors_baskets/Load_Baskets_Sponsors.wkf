<input>true</input>
<name id="1606">statements</name>
<stringValue id="1607">String alert ="";
String instrId = "";
String isidOid = "";
String mktIssOid = "";
String accion ="";

if (componentsMap.get(issue).containsKey("accion")) {
	accion = componentsMap.get(issue).get("accion");
}else{
	if (componentsIsgpMap.containsValue(componentsMap.get(issue).get("ISGPOID"))) {
		accion = "DUPLICADO";
	} else {
		componentsBajaMap.put(componentsMap.get(issue).get("ISGPOID"), "BAJA");
		componentsMap.remove(issue);
		accion = "BAJA";
	}
}
if (accion.equals("ALTA")){
	instrId = componentsMap.get(issue).get("INSTRID");
	isidOid = componentsMap.get(issue).get("ISIDOID");
	mktIssOid = componentsMap.get(issue).get("MKTISSOID");
}

Transition=accion;</stringValue>
<type>CONSTANT</type>
</item>
