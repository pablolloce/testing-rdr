<name id="3516">Moodys Rating value</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="3517">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="3518" type="java.util.HashSet">
<item id="3519" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="3520">statements</name>
<stringValue id="3521"><![CDATA[import org.apache.commons.lang.StringUtils;

String MoodysRtngCode = "";
String MoodysGradoRtngCode = "";

if ( intMoodysRatingArray > 0 && MoodysRatingArray[0][0]  != null && !"".equals(MoodysRatingArray[0][0]) ){
	MoodysRtngCode = MoodysRatingArray[0][0];
} else {
	MoodysRtngCode = "No disp.";
}

if ( intMoodysRatingArray > 0 && MoodysRatingArray[0][1]  != null && !"".equals(MoodysRatingArray[0][1]) ){
	MoodysGradoRtngCode = String.valueOf(MoodysRatingArray[0][1]);
} else {
	MoodysGradoRtngCode = "99";
}]]></stringValue>
<type>CONSTANT</type>
</item>
