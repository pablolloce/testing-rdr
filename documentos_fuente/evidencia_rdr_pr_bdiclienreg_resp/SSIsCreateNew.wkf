<name id="67">querySQL</name>
<stringValue id="68"><![CDATA[select ALT_ID from (select sai1.alt_id from ft_t_sai1 sai1, ft_t_sai1 sai11 where sai1.ssi_oid=sai11.ssi_oid and sai1.data_src_id='RDR' and sai11.alt_id=? and sai11.data_src_id='ALERT'  and sai1.DATA_STAT_TYP='ACTIVE'  and sai11.DATA_STAT_TYP='ACTIVE' order by sai1.last_Chg_tms desc) where rownum <=1]]></stringValue>
<type>CONSTANT</type>
</item>
