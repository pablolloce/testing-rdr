<name id="2918">statements</name>
<stringValue id="2919">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("Sub_CalculateREU");
logger.error("Sub_CalculateREU2222222: --------------------------------------finsRtngOidL-------------------------2502025"+finsRtngOidL);
logger.error("Sub_CalculateREU2222222: ----------------------------------------inst_mnem-----------------------2502025"+inst_mnem);
logger.error("Sub_CalculateREU2222222: ----------------------------------------REUOidL-----------------------2502025"+REUOidL);
</stringValue>
<type>CONSTANT</type>
</item>
