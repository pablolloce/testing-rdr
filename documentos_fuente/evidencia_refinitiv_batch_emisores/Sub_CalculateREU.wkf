<item id="335" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="336">querySQL</name>
<stringValue id="337">select decode(trim(rtng_set_mnem),'SPRLOTRT',rtng_set_nme||' Foreign', 'FTCHLTRT',rtng_set_nme||' Foreign', 'MODLOTRT',rtng_set_nme||' Foreign', 'EXT_RTN', rtng_set_nme||' Foreign', 'EXT_RTNL', 'External Unified Rating Local', rtng_set_nme), rtng_set_oid
from ft_t_rtng 
where rtng_set_mnem in (
'FTCHLTRT',
'SPRLOTRT',
'MODLOTRT',
'EXT_RTN',
'REUMOD',
'REUSP',
'REUFTCH',
'SPRLTRTL',
'MODLTRTL',
'FTCLTRTL',
'EXT_RTNL') 
and data_stat_typ = 'ACTIVE' 
and end_tms is null 
order by 1 asc</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
