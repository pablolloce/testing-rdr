<stringValue id="247"><![CDATA[//import org.apache.log4j.Logger;
//Logger logger = Logger.getLogger("Enriquecimiento");

String query = "Insert into FT_T_FRCL (FINR_CLSF_OID,INST_MNEM,FINSRL_TYP,INDUS_CL_SET_ID,CLSF_OID,CL_VALUE,CLSF_PURP_TYP,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,DATA_STAT_TYP,DATA_SRC_ID,EINC_OID, FINR_OID) \r\n" + 
		"values (new_oid,'"+mnemOperativo+"','CPARTY','CODINSTI',(select CLSF_OID from ft_t_incl where cl_value = '"+INST_CODE+"' and indus_cl_set_id = 'CODINSTI' and data_stat_typ = 'ACTIVE'),'"+INST_CODE+"',null,sysdate,null,sysdate,'RDR','ACTIVE','BDI',null, (SELECT FINR_OID FROM FT_T_FINR WHERE DATA_STAT_TYP = 'ACTIVE' AND FINSRL_TYP = 'CPARTY' AND INST_MNEM = '"+mnemOperativo+"' AND ROWNUM < 2))\r\n";

//logger.error("INST_CODE query: "+ query);
]]></stringValue>
<type>CONSTANT</type>
</item>
