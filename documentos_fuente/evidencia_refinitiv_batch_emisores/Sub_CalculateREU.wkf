<name id="1452">statements</name>
<stringValue id="1453">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("Sub_CalculateREU");
logger.error("Sub_CalculateREU FOR 2222222222222222: --------------------------------------finsRtngOid-------------------------2502025"+finsRtngOid);
logger.error("Sub_CalculateREU FOR 2222222222222222: ----------------------------------------inst_mnem-----------------------2502025"+inst_mnem);
logger.error("Sub_CalculateREU FOR 2222222222222222: ----------------------------------------REUOid-----------------------2502025"+REUOid);
</stringValue>
<type>CONSTANT</type>
</item>
