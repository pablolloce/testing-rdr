<item id="497" type="com.j2fe.workflow.definition.Transition">
<name id="498">goto-next</name>
<source id="499">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="500">Get attach CUERPO</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="501">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="502" type="java.util.HashSet">
<item id="503" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="504">statements</name>
<objectValue id="505" type="java.lang.String"><![CDATA[import java.util.regex.Matcher;
import java.util.regex.Pattern;
import org.apache.log4j.Logger;
import java.io.File;
import java.io.FileReader;
import java.io.BufferedReader;

Logger logger = Logger.getLogger("AlertasEnvio - Get attachment");

String nameFile ="";
String directory = RUTA[0].get("RUTA");
Pattern pattern = Pattern.compile("\\$ENV");
Matcher matcher = pattern.matcher(directory);

directory  = matcher.replaceAll(env);
logger.error("[AlertasEnvio - Get attachment] directory: "+directory);

resultado = "KO";
enviar = "N";

String short_proc = SH_PROC[0].get("SHORT_PROCESS");
String aux="";

if(short_proc != null && short_proc.length() > 0){
	aux="CUERPO_" + SH_PROC[0].get("SHORT_PROCESS")+".txt";
	try{
		File carpeta = new File(directory);
		if(carpeta.exists()){
			for (File fich : carpeta.listFiles()) {
				if (fich.isDirectory()==false) {
					if (fich.getName().equals(aux)) {	
						if (fich.exists()){
							nameFile = fich.getName();
							FileMail = fich.toString();
							logger.error("[AlertasEnvio - Get attachment] nameFile: "+ nameFile);
							resultado = "OK";
							enviar = "S";
						}
						break;
					}
				}
			}
		}else{
			resultado = "KO";
		}
	}catch(Exception e){
		resultado = "KO";
	}
} else {
	resultado = "KO";
}

if("S".equals(enviar)){
	File archivo = null;
	FileReader fr = null;
	BufferedReader br = null;
	txtBody ="";
	try {
		archivo = new File (FileMail);
		fr = new FileReader (archivo);
		br = new BufferedReader(fr);
		// Lectura del fichero
		String linea;
		while((linea=br.readLine())!=null){
			txtBody += linea+"\r\n";
		}
		//Quitamos el contenido de FileMail para que no se envie el archivo.
		nameFile = "";
		FileMail = "";
	}catch(Exception e){
		       logger.error("[AlertasEnvio - Get attach CUERPO] error:"+ e.toString());
			enviar="N";
	}finally{
		try{                    
			if( null != fr ){   
		       	fr.close();     
		       }                  
		}catch (Exception e2){ 
		       e2.printStackTrace();
		}
	}
}

]]></objectValue>
<type>CONSTANT</type>
</item>
