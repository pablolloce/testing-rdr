<item id="484" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="485">statements</name>
<objectValue id="486" type="java.lang.String"><![CDATA[import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("Sub_CalculateREU");
logger.error("Sub_CalculateREU: -------- FOR-------------------------------------------------------3");
if(CL_VALUE !=null && CL_VALUE.length>0&&CL_VALUE[0].get("CL_VALUE")!=null){
	logger.error("CL_VALUE[0].get(CL_VALUE): "+CL_VALUE[0].get("CL_VALUE"));
	if(CL_VALUE[0].get("CL_VALUE").trim().equalsIgnoreCase("A")){
		logger.error("Sub_CalculateREU: ------- FOR---------------------OKA---------------A--------------------3");
		return "OKA";
	}else if(CL_VALUE[0].get("CL_VALUE").trim().equalsIgnoreCase("M")){
		logger.error("Sub_CalculateREU: ----- FOR-----------------------OKM---------------M--------------------3");
		return "OKM";
	}else{
logger.error("Sub_CalculateREU: ------------- FOR---------------KO-----------------------------------3");
		return "KO";
	}
}else{
logger.error("Sub_CalculateREU: -------- FOR--------------------KO-----------------------------------3");
	return "KO";
}


]]></objectValue>
<type>CONSTANT</type>
</item>
