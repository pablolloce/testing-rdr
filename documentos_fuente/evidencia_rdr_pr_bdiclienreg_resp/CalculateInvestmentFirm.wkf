<name id="102">database</name>
<stringValue id="103">jdbc/GSDM-1</stringValue>
<type>REFERENCE</type>
</item>
<item id="104" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="105">["01"]@java/lang/String@</UITypeHint>
<input>true</input>
<name id="106">mappedParameters["01"]</name>
<stringValue id="107">cntrprtyGlobalOid</stringValue>
<type>VARIABLE</type>
</item>
<item id="108" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="109">querySQL</name>
<stringValue id="110">SELECT DISTINCT FIGU.inst_mnem
FROM ft_t_FIGU FIGU,
  ft_T_fins fins,
  FT_T_GUNT GUNT,
  FT_T_GUGR GUGR,
  FT_T_GUGP GUGP,
  FT_T_FIRL FIRLL,
  FT_T_FIRL FIRLO
WHERE FIGU.fins_gu_purp_typ = 'RESID_CO'
AND FIGU.DATA_STAT_TYP = 'ACTIVE'
AND FIGU.GUNT_OID = GUNT.GUNT_OID
AND GUNT.GUNT_OID = GUGP.GUNT_OID
AND GUNT.prnt_gu_typ = 'COUNTRY'
AND GUNT.DATA_STAT_TYP  = 'ACTIVE'
AND GUGP.PRNT_GU_GRP_OID = GUGR.GU_GRP_OID
AND GUGP.DATA_STAT_TYP  = 'ACTIVE'
AND GUGR.GRP_PURP_TYP = 'UKREGU'
AND GUGR.DATA_STAT_TYP = 'ACTIVE'
AND FIGU.inst_mnem = fins.inst_mnem
AND FINS.DATA_STAT_TYP != 'INACTIVE'
AND FINS.subsidiary_ind='N'
AND FIGU.inst_mnem = FIRLO.INST_MNEM
AND FIRLL.PRNT_INST_MNEM = :cntrprtyGlobalOid
AND FIRLL.DATA_STAT_TYP = 'ACTIVE'
AND FIRLL.DATA_STAT_TYP = 'ACTIVE'
and FIRLO.PRNT_INST_MNEM = FIRLL.INST_MNEM
and FIRLO.DATA_STAT_TYP != 'INACTIVE'
and FIRLO.rel_typ='OPERATIVE'</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
<sources id="111" type="java.util.HashSet">
