<type>VARIABLE</type>
</item>
<item id="125" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="126">querySQL</name>
<stringValue id="127">select frcl.inst_mnem from ft_t_frcl frcl, ft_T_fins fins 
where frcl.INDUS_CL_SET_ID='CNAE' 
and frcl.cl_value in('6400','6410','6419','6490','6492','6499','6420','6422','6492') 
and frcl.FINSRL_TYP='CUSTOMER  ' 
and frcl.DATA_STAT_TYP='ACTIVE'
and frcl.inst_mnem = fins.inst_mnem
and fins.DATA_STAT_TYP='ACTIVE'
and frcl.inst_mnem in 
	(SELECT firl.INST_MNEM FROM FT_T_FIRL firl
         WHERE firl.PRNT_INST_MNEM = :cntrprtyGlobalOid
         and firl.DATA_STAT_TYP='ACTIVE')</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
