<item id="496" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="497">statements</name>
<stringValue id="498"><![CDATA[//import org.apache.log4j.Logger;
//Logger logger = Logger.getLogger("Enriquecimiento");

String reg = "";

if ("N".equals(ACT_1940)){
	reg = "No";
}else if ("Y".equals(ACT_1940)){
	reg = "Yes";
}

String query = "Insert into FT_T_FRCL (FINR_CLSF_OID,INST_MNEM,FINSRL_TYP,INDUS_CL_SET_ID,CLSF_OID,CL_VALUE,CLSF_PURP_TYP,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,DATA_STAT_TYP,DATA_SRC_ID,EINC_OID, FINR_OID) \r\n" + 
				"values (new_oid,'"+mnemOperativo+"','CPARTY','REG1940',(select CLSF_OID from ft_t_incl where indus_cl_set_id = 'REG1940' and CL_VALUE = '"+reg+"' and data_stat_typ = 'ACTIVE'),'"+reg+"',null,sysdate,null,sysdate,'admin','ACTIVE','RDR',null, (SELECT FINR_OID FROM FT_T_FINR WHERE DATA_STAT_TYP = 'ACTIVE' AND FINSRL_TYP = 'CPARTY' AND INST_MNEM = '"+mnemOperativo+"' AND ROWNUM < 2))\r\n";
		

//logger.error("ACT_1940 query: "+ query);
]]></stringValue>
<type>CONSTANT</type>
</item>
