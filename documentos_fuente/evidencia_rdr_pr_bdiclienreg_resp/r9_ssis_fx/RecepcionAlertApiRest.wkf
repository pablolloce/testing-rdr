<name id="508">statements</name>
<stringValue id="509"><![CDATA[import org.apache.log4j.Logger;




String ssisConcat="<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"no\"?><ssis>";
for(int i =0;i<VREQ.length;i++){

	ssisConcat=ssisConcat + VREQ[i].get("VND_RQST_STAT_TXT");

}
ssisConcat=ssisConcat +"</ssis>";

]]></stringValue>
<type>CONSTANT</type>
</item>
