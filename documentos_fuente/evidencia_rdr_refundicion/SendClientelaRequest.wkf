<stringValue id="255">INSERT INTO ft_t_utd1 (UTD_OID, UTD_EXT_ID, UTD_USAGE_TYP, REG_NUM, UTD_ID_PURP_TYP, UTD_ID, LAST_CHG_TMS, LAST_CHG_USR_ID, DATA_SRC_ID, DATA_STAT_TYP, START_TMS) 
VALUES (new_oid, ?, 'Clientela ', '1', 'Error','Waiting for Clientela response.', sysdate, 'GIMPORT', 'CLIENTELA', 'ACTIVE', sysdate)</stringValue>
<type>CONSTANT</type>
