<item id="2005" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="2006">statements</name>
<objectValue id="2007" type="java.lang.String"><![CDATA[//rutas
String ruta = "";
ruta=Ruta.getPath();
String[] splitted = ruta.split("/");
String environment = splitted[2];
String jars=" /"+environment+"/kytl/online/multipais/multicanal/jar/";
String properties=" /"+environment+"/kytl/online/multipais/multicanal/dat/properties/";

fileDupliPath=ruta.replaceFirst("[.][^.]+$", "_dupli.xml");
fileSplittedPath=ruta.replaceFirst("[.][^.]+$", "_splitted.xml");

String cmdXslt1 = "java -cp "+jars+"Transformar_XML.jar ppal.Transformar "+ruta+" "+properties+"baskets_sponsor_split_1.xsl "+fileDupliPath+" 3 "+properties+"log4jBaskets_Split.properties";
String cmdXslt2 = "java -cp "+jars+"Transformar_XML.jar ppal.Transformar "+fileDupliPath+" "+properties+"baskets_sponsor_split_2.xsl "+fileSplittedPath+" 3 "+properties+"log4jBaskets_Split.properties";
String cmdSed= "sed -i 's/<\\/Baskets>/&\\n/g;s/<Baskets_Split>//g;s/<\\/Baskets_Split>//g' "+fileSplittedPath;

String removeSplittedFile  ="rm "+fileSplittedPath;
String removeDupliFile  ="rm "+fileDupliPath;]]></objectValue>
<type>CONSTANT</type>
</item>
