</item>
<item id="3508" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="3509">querySQL</name>
<stringValue id="3510">select distinct rtvlREU.rtng_nme, rtvlREU.rank_num from ft_t_firt firt, ft_t_rtvl rtvl, ft_t_rtvl rtvlREU where firt.rtng_set_oid = :0 and firt.inst_mnem = :1 
and firt.data_stat_typ = 'ACTIVE' and rtvl.rtng_set_oid = firt.rtng_set_oid and firt.rtng_cde = rtvl.rtng_cde and rtvl.data_stat_typ = 'ACTIVE'
and rtvlREU.rtng_set_oid = :2 and rtvlREU.rtng_cde = rtvl.rtng_cde and rtvlREU.data_stat_typ = 'ACTIVE' and rtvlREU.end_tms is null</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
