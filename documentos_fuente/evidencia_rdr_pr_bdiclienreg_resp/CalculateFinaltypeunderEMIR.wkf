values (new_oid,null,null,'1',null,null,null,'Control del calculo de datos regulatorios',null,'CONTROLDR','CALCULODR','CALCULO',?,'REL_TYP' , 'GLOBAL', 'FT_T_FIID.INST_MNEM', ?,sysdate,null,sysdate,'CONTROLDR')</stringValue>
