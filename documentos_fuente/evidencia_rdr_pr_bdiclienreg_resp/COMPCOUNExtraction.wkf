<name id="25">Transaction Information</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="26">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="27" type="java.util.HashSet">
<item id="28" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="29">statements</name>
<stringValue id="30"><![CDATA[//Declaración de variables
Map valores = new HashMap();

String [] etiquetas = new String [5];

etiquetas[0] = "MAIN_ENTITY_ID";
etiquetas[1] = "MAIN_ENTITY_ID_CTXT_TYP";
etiquetas[2] = "MAIN_ENTITY_NME";
etiquetas[3] = "MAIN_ENTITY_TYP";
etiquetas[4] = "MAIN_ENTITY_TBL_TYP";


valores.put (etiquetas[0], (compcoun != null && compcoun.length > 0) ? compcoun[0].get("COMPCOUN"): "No Existe");
valores.put (etiquetas[1],"ORI-" + cntrprtyOperativeOid);
valores.put (etiquetas[2],"Extraccion de Parent Company Country of Residence");
valores.put (etiquetas[3],"COMPCOUN");
valores.put (etiquetas[4],"FIGU");]]></stringValue>
<type>CONSTANT</type>
</item>
