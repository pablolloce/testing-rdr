<stringValue id="1210"><![CDATA[Map calculoEMIR = new HashMap();


if (calculoEMIR2 != null && calculoEMIR2.length > 0 && calculoEMIR2[0].get("ETIQUETA") != null) {
	calculoEMIR.put("ETIQUETA",calculoEMIR2[0].get("ETIQUETA"));
}]]></stringValue>
<type>CONSTANT</type>
