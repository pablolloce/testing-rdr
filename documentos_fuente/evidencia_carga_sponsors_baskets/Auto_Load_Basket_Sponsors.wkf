<item id="608" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="609">querySQL</name>
<stringValue id="610"><![CDATA[select distinct * from (select PREPROCESS.PAR1_OID PAR1_OID,
PREPROCESS.PAR1_NME SPONSOR_INDEX,
PREPROCESS.PAR1_VALUE INFORMATION,
LISTAGG(SUBSTR(LOAD.PAR1_NME,INSTR(LOAD.PAR1_NME,';',1,1)+1,15), ';') WITHIN GROUP (ORDER BY LOAD.PAR1_OID) OVER (PARTITION BY PREPROCESS.PAR1_NME ) AFFECTED_INDEX
from FT_T_PAR1 PREPROCESS, FT_T_PAR1 LOAD WHERE PREPROCESS.PARAMETER_CTXT_TYP=:1
AND LOAD.PARAMETER_CTXT_TYP='BSKT_LOAD' AND SUBSTR(PREPROCESS.PAR1_NME,INSTR(PREPROCESS.PAR1_NME,';',1,1)+1,6)=SUBSTR(LOAD.PAR1_NME,INSTR(LOAD.PAR1_NME,';',1,1)+1,6)
and PREPROCESS.DATA_STAT_TYP='ACTIVE' AND PREPROCESS.LAST_CHG_TMS < TRUNC(SYSDATE))]]></stringValue>
<type>CONSTANT</type>
</item>
</parameters>
