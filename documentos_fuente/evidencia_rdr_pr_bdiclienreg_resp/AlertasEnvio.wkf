<item id="141" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="142">statements</name>
<stringValue id="143">import java.text.SimpleDateFormat;
import java.util.Date;

String nameFile = SH_PROC[0].get("SHORT_PROCESS");

if(nameFile .contains("YYYYMMDD")){
	Date myDate = new Date();
	String fec=new SimpleDateFormat("yyyyMMdd").format(myDate);
	String res = nameFile.replace("YYYYMMDD", fec);
	SH_PROC[0].put("SHORT_PROCESS", res);
}
resultado = "OK";
</stringValue>
<type>CONSTANT</type>
</item>
