<item id="389" type="com.j2fe.workflow.definition.Transition">
<name id="390">ERROR</name>
<source id="391">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="392">Split</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="393">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="394" type="java.util.HashSet">
<item id="395" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="396">statements</name>
<objectValue id="397" type="java.lang.String">String files=inputMap.get("INFORMATION").split("\\?")[0];
String[] filesArray = files.split(";");
String script="./RDR_SponsorSplit.sh "+inputMap.get("INFORMATION").split("\\?")[1].replaceAll("\\$env", env);
String sponsor=inputMap.get("SPONSOR_INDEX").split(";")[0];
String index=inputMap.get("SPONSOR_INDEX").split(";")[1];
String filePath="/fichtemcomp/"+env+"/descargas/kytl/issues/Baskets/Sponsors/"+sponsor+"/";
String oid=inputMap.get("PAR1_OID");
String transition = "OK";

for (String fileName : filesArray){
	File file = new File(filePath+fileName);
	if (!file.exists()){
		transition = "ERROR";
		String[] arrayMensaje = new String[4]; 
		if (sponsor.equals("MSCI")){
			arrayMensaje[0] = "ERROR TÉCNICO RDR";
			arrayMensaje[1] = "No se encuentra el fichero "+fileName+" para cargar el índice "+index+" al no haber sido generado correctamente durante el proceso de transformación";
		}else {
			arrayMensaje[0] = "ERROR PLATAFORMA";
			arrayMensaje[1] = "No ha sido recibido el fichero "+fileName+" para cargar el índice "+index;
		}
		arrayMensaje[2] = index;
		arrayMensaje[3] = sponsor;
		listaErrores.add(arrayMensaje);
	}
}

Transition=transition;</objectValue>
<type>CONSTANT</type>
</item>
