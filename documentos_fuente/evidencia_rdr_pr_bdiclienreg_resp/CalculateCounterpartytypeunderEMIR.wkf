<name id="25">Calculo DR</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="26">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="27" type="java.util.HashSet">
<item id="28" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="29">statements</name>
<stringValue id="30"><![CDATA[import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("Calculate Counterparty type under EMIR");

if (hacerCalculoDR != null && hacerCalculoDR.length() > 0 && hacerCalculoDR.equalsIgnoreCase("false")) {
	logger.error("[CheckDatosRegulatorios] Calculate Counterparty type under EMIR NO SE HACE CALCULO AQUI");
	return false;
}else{
	logger.error("[CheckDatosRegulatorios] Calculate Counterparty type under EMIR SE HACE CALCULO AQUI");
	return true;
}]]></stringValue>
<type>CONSTANT</type>
</item>
<item id="31" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="32">["hacerCalculoDR"]@java/lang/Object@</UITypeHint>
<input>true</input>
<name id="33">variables["hacerCalculoDR"]</name>
<stringValue id="34">hacerCalculoDR</stringValue>
<type>VARIABLE</type>
</item>
</parameters>
<sources id="35" type="java.util.HashSet">
<item id="36" type="com.j2fe.workflow.definition.Transition">
<name id="37">goto-next</name>
<source id="38">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="39">EMIR Calculation</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="40">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="41" type="java.util.HashSet">
<item id="42" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="43">statements</name>
<objectValue id="44" type="java.lang.String"><![CDATA[//DeclaraciÃ³n de variables
Map calculoEMIR = new HashMap();
String bdi = "";
String ent = "";
String pers = "";
String rolcr = "";
String etiqueta = "";
String european = "";
String codinstiText = "";


if (bdiCode != null && bdiCode.length > 0)
{
	bdi = bdiCode[0].get("BDI");
}else
{
	bdi = "NE";
}

if (codinsti != null && codinsti.length > 0)
{
	codinstiText = codinsti[0].get("CODINSTI");
}else
{
	codinstiText = "NE";
}

if (entOwn != null && entOwn.length > 0)
{
	ent = entOwn[0].get("ENTOWN");
}else
{
	ent = "NE";
}

if (personality != null && personality.length > 0)
{
	pers = personality[0].get("ROLE");
}else
{
	pers = "NE";
}

if (rolcrsem != null && rolcrsem.length > 0)
{
	rolcr = rolcrsem[0].get("ROLCRSEM");
}else
{
	rolcr = "NE";
}

if (etiquetaEmir != null && etiquetaEmir.length > 0)
{
	etiqueta = etiquetaEmir[0].get("ETIQUETA");
}else
{
	etiqueta = "NE";
}

if (europeanPersonData != null && europeanPersonData.length > 0)
{
	european = europeanPersonData[0].get("USINDEM");
}else
{
	european = "NE";
}

//Una vez inicializados los valores por si alguno de ellos no existiera en la contrapartida, se realiza el calculo del dato

switch (etiqueta) 
{
	case "PENDING":  
		calculoEMIR.put("ETIQUETA","05");
		break;
		
	case "NFC / EXENT":

		//Se valida el campo CCP (se valida si la contrapartida es cÃ¡mara o no)
		if(rolcr.equals("Y"))
		{
			calculoEMIR.put("ETIQUETA","02");
		}else
		{
			calculoEMIR.put("ETIQUETA","04");
		}  
		break;

	case "EXENT / FINAN.":

		//Se valida el European Person Indicator
		if(european.equals("Y"))
		{
			calculoEMIR.put("ETIQUETA","02");
		}else
		{
			calculoEMIR.put("ETIQUETA","03");
		}  
		
		break;
		
	case "PEND. / NFC":

		//Se valida si la contrapartida tiene cÃ³digo de BDI
		if(!bdi.equals("NE"))
		{
			calculoEMIR.put("ETIQUETA","05");
		}else
		{
			calculoEMIR.put("ETIQUETA","04");
		}
		break;

	case "EXENT EXC. REP.":  
		calculoEMIR.put("ETIQUETA","01");
		break;
		
	case "EX. EXC. / NFC":

		//Se valida el European Person Indicator
		if(european.equals("Y"))
		{
			calculoEMIR.put("ETIQUETA","01");
		}else
		{
			calculoEMIR.put("ETIQUETA","04");
		}  
		break;

	case "FINANCIAL":
		calculoEMIR.put("ETIQUETA","03");
		break;
		
	case "EXENT":
		calculoEMIR.put("ETIQUETA","02");
		break;

	case "EXENT / NFC":  

		//Se valida el European Person Indicator
		if(european.equals("Y"))
		{
			calculoEMIR.put("ETIQUETA","02");
		}else
		{
			calculoEMIR.put("ETIQUETA","04");
		}  
		break;
		
	case "NON FINAN.":
		calculoEMIR.put("ETIQUETA","04");
		break;
		
    default:
	
		if(!pers.equals("NE"))
		{
			calculoEMIR.put("ETIQUETA","04");
		}else
		{
			if(!codinstiText.equals("NE"))
			{
				calculoEMIR.put("ETIQUETA","05");
			}else
			{
				calculoEMIR.put("ETIQUETA","02");
			}
		}
		break;
}]]></objectValue>
<type>CONSTANT</type>
</item>
