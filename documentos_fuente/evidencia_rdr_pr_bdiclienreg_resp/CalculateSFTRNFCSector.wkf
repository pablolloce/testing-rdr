VALUES 
(new_oid, :cntrprtyGlobalOid, 
(select REG1_OID from FT_T_REG1 where REG_NME='SFTR'),
(select CLSF_OID from FT_T_INCL WHERE INDUS_CL_SET_ID='SFTRASCNFC' AND CL_VALUE= 'OTHR'),
(select CLSF_OID from FT_T_INCL WHERE INDUS_CL_SET_ID='SFTRSECNFC' AND CL_VALUE=:cnaeSect), :cnaeSect, SYSDATE, 'BBVA:CUSTOMER', 'RDR', 'ACTIVE', SYSDATE)</stringValue>
