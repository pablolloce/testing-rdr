<stringValue id="311">String query= "insert into ft_t_vreq(VND_RQST_OID,VND_RQSTR_ID,VND_RQST_ACTION_TYP,VND_RQST_TMS,VND_RQST_TYP,DATA_SRC_ID,VND_RQST_XREF_TBL_TYP,VND_RQST_XREF_ID_CTXT_TYP,VND_RQST_XREF_ID,VND_RQST_STAT_TYP,VND_RQST_STAT_TXT,VND_RQST_CORR_ID,LAST_CHG_TMS,LAST_CHG_USR_ID,TRN_ID,USR_RQST_ID,PHYSICAL_RQST_IND,VENDOR_ID,VND_RQST_DATA_TYP,BASIC_VND_RQST_OID,VND_RESP_FILE_NME,MSG_CNT,VND_SRVC_NME,VND_CHAIN_RQST_IND) values ('"+new_oid +"',' ',null,sysdate,null,'ALERT_IP_SSI',null,null,null,'START',' ',null,sysdate,'ALERT',null,null,'1' ,null,'ONLINE',null,null,null,null,null)";</stringValue>
<type>CONSTANT</type>
</item>
