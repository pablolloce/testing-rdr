<input>true</input>
<name id="1198">querySQL</name>
<stringValue id="1199">SELECT CL_VALUE as ETIQUETA 
FROM FT_T_FRA1
WHERE INST_MNEM = ?
AND CLSF_OID IN (SELECT CLSF_OID FROM FT_T_INCL WHERE INDUS_CL_SET_ID = 'MANPARTY')</stringValue>
<type>CONSTANT</type>
</item>
