<stringValue id="143"><![CDATA[import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("Calculate_EMIR_Category");

String mnemGlobal = mnemGlobal;
logger.error("INST_MNEM GLOBAL -  "+mnemGlobal);

String aux_EMIR_CAT = "02";
logger.error("[EMIR Category]  aux_EMIR_CAT : " + aux_EMIR_CAT );


if (manualEmir != null && manualEmir.length > 0) {
	logger.error("calculoEMIR NO se modifica el calculo por parte de Calculate_EMIR_Category");
}else{
	logger.error("calculoEMIR SI se modifica el calculo por parte de Calculate_EMIR_Category");
	calculoEMIR.put("ETIQUETA","02");
}]]></stringValue>
<type>CONSTANT</type>
</item>
