<directJoin>false</directJoin>
<name id="55">Genera difusion</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="56">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="57" type="java.util.HashSet">
<item id="58" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="59">statements</name>
<objectValue id="60" type="java.lang.String">import org.apache.commons.lang.StringUtils;
import org.apache.log4j.Logger;
import java.util.ArrayList;

Map [] Array_SSI = new HashMap[2];

Map SSI1 = new HashMap();
Map SSI2 = new HashMap();

SSI1.put("accionXML", "");
SSI1.put("Id_SSI", "");
SSI2.put("accionXML", "");
SSI2.put("Id_SSI", "");

String accion_publicada = "";

if (Action.equals("A")) {
	SSI1.put("accionXML", "INSERT");
	SSI1.put("Id_SSI", ID_SSI1);
	accion_publicada = "Alta";
} else if (Action.equals("M")) {
	SSI1.put("accionXML", "UPDATE");
	SSI1.put("Id_SSI", ID_SSI1);
	accion_publicada = "Modificacion";
} else if (Action.equals("R")) {
	SSI1.put("accionXML", "DELETE");
	SSI1.put("Id_SSI", ID_SSI1);
	SSI2.put("accionXML", "INSERT");
	SSI2.put("Id_SSI", ID_SSI2);
	accion_publicada = "Baja + Alta";
} else if (Action.equals("P")) {
	SSI1.put("accionXML", "DELETE");
	SSI1.put("Id_SSI", ID_SSI1);
	SSI2.put("accionXML", "INSERT");
	SSI2.put("Id_SSI", ID_SSI2);
	accion_publicada = "Baja + Alta (ILP)";
}else if (Action.equals("C")) {
	SSI1.put("accionXML", "INSERT");
	SSI1.put("Id_SSI", ID_SSI2);	
	accion_publicada = "Alta de crear copiando";
} else if (Action.equals("S")) {
	SSI1.put("accionXML", "DELETE");
	SSI1.put("Id_SSI", ID_SSI1);
	accion_publicada = "Baja + Reasignacion";
} else if (Action.equals("E")) {
	SSI1.put("accionXML", "UPDATE");
	SSI1.put("Id_SSI", ID_SSI1);
	accion_publicada = "Activacion";
} else if (Action.equals("D")) {
	SSI1.put("accionXML", "DELETE");
	SSI1.put("Id_SSI", ID_SSI1);
	accion_publicada = "Desactivacion";
}


Array_SSI[0] = SSI1;
Array_SSI[1] = SSI2;

Logger logger = Logger.getLogger("RDR_SSI_Publish_ESB_GeneroDifusion");
logger.error("Publicacion SSI, Accion: " + accion_publicada  + ", IDs: " + Array_SSI[0].get("Id_SSI") + " " + Array_SSI[1].get("Id_SSI"));
</objectValue>
<type>CONSTANT</type>
</item>
