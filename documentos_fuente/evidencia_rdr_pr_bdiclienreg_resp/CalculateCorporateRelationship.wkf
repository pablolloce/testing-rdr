<item id="83" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="84">querySQL</name>
<stringValue id="85">SELECT DECODE (COUNT(*),'0','N','Y') FUND
FROM FT_T_FIGP FIGP
WHERE FIGP.INST_MNEM = :cntrprtyOperativeOid
AND FIGP.PRT_PURP_TYP = 'FUND    '
AND FIGP.DATA_STAT_TYP = 'ACTIVE'</stringValue>
<type>CONSTANT</type>
</item>
