<item id="362" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="363">querySQL</name>
<stringValue id="364">select DISTINCT ORG_ID FROM FT_T_ENFR where INST_MNEM IN (
        SELECT DISTINCT ACRONIMO.INST_MNEM FROM  
         FT_T_FRID ACRONIMO, FT_T_FRID ACCESSCODE ,FT_T_FIST FIST
         WHERE ACRONIMO.FINR_ID = ?
         AND ACRONIMO.FINSRL_ID_CTXT_TYP ='ALERTID' 
         AND ACCESSCODE.FINR_ID = ?
         AND ACCESSCODE.FINSRL_ID_CTXT_TYP ='ACCDE'
         AND ACRONIMO.DATA_STAT_TYP = 'ACTIVE' 
         AND ACCESSCODE.DATA_STAT_TYP = 'ACTIVE' 
         AND ACRONIMO.INST_MNEM = ACCESSCODE.INST_MNEM 
         AND ACRONIMO.INST_MNEM = FIST.INST_MNEM
	  AND ACRONIMO.END_TMS IS NULL
         AND ACCESSCODE.END_TMS IS NULL
         AND FIST.STAT_DEF_ID = 'FXRELF' and FIST.LAST_CHG_USR_ID = 'FXFUNDS' and FIST.STAT_CHAR_VAL_TXT = 'Y'
         AND FIST.DATA_STAT_TYP = 'ACTIVE' AND FIST.END_TMS IS NULL ) AND FINSRL_TYP = 'CPARTY' AND DATA_STAT_TYP = 'ACTIVE'</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
