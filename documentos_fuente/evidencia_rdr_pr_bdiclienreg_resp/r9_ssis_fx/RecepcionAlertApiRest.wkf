String query= "select count(*) as countExiste from ft_t_sai1 where trim(alt_id)=q'#"+ codOid+"#' and DATA_STAT_TYP='ACTIVE' and ID_CTXT_TYP='ALERTID' ";

logger.error(query);
</stringValue>
