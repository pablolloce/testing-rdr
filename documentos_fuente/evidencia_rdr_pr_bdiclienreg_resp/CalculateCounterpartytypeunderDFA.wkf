<item id="36" type="com.j2fe.workflow.definition.Transition">
<name id="37">goto-next</name>
<source id="38">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="39">Counterparty type under DFA Calculation</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="40">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="41" type="java.util.HashSet">
<item id="42" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="43">statements</name>
<objectValue id="44" type="java.lang.String"><![CDATA[//Declaracion de variables
Map calculoFinentdf = new HashMap();
String rolinText = "";
String uspersonText = "";
String residenceText = "";
String guaranteText = "";
String headText = "";
String continenteText = "";

//Logica de control de nulos para mapas correspondientes a extraccion global
if (globalData != null && globalData.length > 0)
{
	if (globalData[0].containsKey("ROLIN") && globalData[0].get("ROLIN") != null)
	{
		if (!globalData[0].get("ROLIN").equals(" "))
		{
			rolinText = globalData[0].get("ROLIN");
		}else
		{
			rolinText = "NEX";
		}
	}else
	{
		rolinText = "NEX";
	}
	if (globalData[0].containsKey("USPERSON")&& globalData[0].get("USPERSON") != null)
	{
		uspersonText = globalData[0].get("USPERSON");
	}else
	{
		uspersonText = "NE";
	}
}else
{
	rolinText = "NE";
	uspersonText = "NE";
}

//Control de nulos para Pais de Residencia
if (guaranteCountry != null && guaranteCountry.length > 0)
{
	guaranteText = guaranteCountry[0].get("COUNGUAR");
}else
{
	guaranteText = "NE";
}

//Control de nulos para Pais de Garantia
if (residenceCountry != null && residenceCountry.length > 0)
{
	residenceText = residenceCountry[0].get("RESIDCO");
}else
{
	residenceText = "NE";
}

//Control de nulos para Head Office Relationship
if (head != null && head.length > 0)
{
	headText = head[0].get("HEAD");
}else
{
	headText = "NE";
}

if (!calculoCorprel.isEmpty())
{
	corprelText = calculoCorprel.get("CORPREL");
}else
{
	corprelText = "NE";
}

//Control de nulos para el continente
if (continente != null && continente.length > 0)
{
	continenteText = continente[0].get("CONTINENTE");
}else
{
	continenteText = "NE";
}

//Se aplica la logica a partir de los valores recuperados de la extraccion auxiliar y se recalcula el counterparty type under DFA.

//Booleano para indicar si el pais de residencia es Estados Unidos o Puerto Rico
Boolean residencia = false;
Boolean garantia = false;

if(residenceText.equals("US") || residenceText.equals("PR"))
{
	//La contrapartida tiene de pais de residencia o Estados Unidos o Puerto Rico
	residencia = true;	
}

if(guaranteText.equals("US") || guaranteText.equals("PR"))
{
	//La contrapartida tiene de pais de garantia o Estados Unidos o Puerto Rico
	garantia = true;	
}

//Lo primero a identificar es el US Person Indicator (S/N)
if(uspersonText.equals("Y"))
{
	//La contrapartida es estadounidense

	//Se valida el Corporate Relationship
	if(corprelText.equals("CVR"))
	{
		//La contrapartida es Covered Prime Brokerage
		
		//Se valida la geografia
		if(continenteText.equals("EUR"))
		{
			//Contrapartida Europea
			calculoFinentdf.put("FINENTDF","16");	
			//La contrapartida es mexicana o compartida
			if(headText.equals("S"))
			{
				//La contrapartida es sucursal
				if(!residenceText.equals("US") &&  !residenceText.equals("PR"))
				{
					//El pais de residencia de la contrapartida es distinto de Puerto Rico
					calculoFinentdf.put("FINENTDF","18");
				}
			}
		}
	}
	
}else if (uspersonText.equals("N") && corprelText.equals("CVR"))
{
	//El US Person Indicator no se encuentra informado
	calculoFinentdf.put("FINENTDF","17");
	
}else if (continenteText.equals("MEX"))
{
	//El US Person Indicator no se encuentra informado
	calculoFinentdf.put("FINENTDF","01");
	
}

//Control de nulos para Pais de Garantia
if (residenceCountry != null && residenceCountry.length > 0)
{
	if (!calculoCompcoun.isEmpty())
	{
		residenceText = calculoCompcoun.get("COMPCOUN");
	}else
	{
		residenceText = residenceCountry[0].get("RESIDCO");
	}
}else
{
	residenceText = "NE";
}
if(residenceText.equals("US") || residenceText.equals("PR"))
{
	//La contrapartida tiene de pais de residencia o Estados Unidos o Puerto Rico
	residencia = true;	
}

if(!corprelText.equals("CVR") || calculoFinentdf.isEmpty())
{
	if(uspersonText.equals("Y"))
	{
		//Si es residente en Estados Unidos o Puerto Rico

		switch(rolinText)
		{
			case "SD":
				if(residencia)
				{
					if(corprelText.equals("SUC"))
					{
						calculoFinentdf.put("FINENTDF","05");
					}else
					{
						calculoFinentdf.put("FINENTDF","02");
					}
				}
				break;
			case "MS":
				if(residencia)
				{
					if(corprelText.equals("SUC"))
					{
						calculoFinentdf.put("FINENTDF","06");
					}else
					{
						calculoFinentdf.put("FINENTDF","03");
					}
				}
				break;
			case "OT":
				if(residencia)
				{
					if(corprelText.equals("SUC"))
					{
						calculoFinentdf.put("FINENTDF","07");
					}else
					{
						calculoFinentdf.put("FINENTDF","04");
					}
				}
				break;
			case "NE":
				calculoFinentdf.put("FINENTDF","08");
				break;
			default:
				break;
		}

	}else if(uspersonText.equals("N"))
	{
		if((residencia && corprelText.equals("CON")) || (garantia))
		{
			switch(rolinText)
			{
				case "SD":
					calculoFinentdf.put("FINENTDF","13");
					break;
				case "MS":
					calculoFinentdf.put("FINENTDF","14");
					break;
				case "OT":
					calculoFinentdf.put("FINENTDF","12");
					break;
				case "NE":
					calculoFinentdf.put("FINENTDF","11");
					break;
				default:
					break;
			}
		}else
		{
			switch(rolinText)
			{
				case "SD":
					calculoFinentdf.put("FINENTDF","09");
					break;
				case "MS":
					calculoFinentdf.put("FINENTDF","10");
					break;
				case "OT":
					calculoFinentdf.put("FINENTDF","15");
					break;
				case "NE":
					calculoFinentdf.put("FINENTDF","15");
					break;
				default:
					break;
			}
		}
	}
	if (rolinText.equals("NEX") && !continenteText.equals("MEX"))
	{
		if(uspersonText.equals("Y"))
		{
			calculoFinentdf.put("FINENTDF","01");
		}else
		{
			calculoFinentdf.put("FINENTDF","15");
		}
	}
}

//Asignar un valor al calculo si tras toda la logica no se ha asignado ninguno
if (calculoFinentdf.isEmpty())
{
	calculoFinentdf.put("FINENTDF","01");
}

if(corprelText.equals("SNU"))
{
	//Norma Footnote 513 / CFTC Guidance 13-69 (15072016)
	calculoFinentdf.put("FINENTDF","19");	
}
]]></objectValue>
<type>CONSTANT</type>
</item>
