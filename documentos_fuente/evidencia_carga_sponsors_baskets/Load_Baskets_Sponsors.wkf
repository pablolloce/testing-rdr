<name id="1158">get Component from DDBB</name>
<nodeHandler>com.j2fe.general.activities.database.DBQuery</nodeHandler>
<nodeHandlerClass id="1159">com.j2fe.general.activities.database.DBQuery</nodeHandlerClass>
<parameters id="1160" type="java.util.HashSet">
<item id="1161" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="1162">database</name>
<stringValue id="1163">jdbc/GSDM-1</stringValue>
<type>REFERENCE</type>
</item>
<item id="1164" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="1165">["1"]@java/lang/String@</UITypeHint>
<input>true</input>
<name id="1166">mappedParameters["1"]</name>
<stringValue id="1167">indexMap</stringValue>
<type>VARIABLE</type>
<variablePart id="1168">["basketInstrId"]</variablePart>
</item>
<item id="1169" type="com.j2fe.workflow.definition.Parameter">
<input>false</input>
<name id="1170">mappedResult</name>
<stringValue id="1171">allComponentsDDBB</stringValue>
<type>VARIABLE</type>
</item>
<item id="1172" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="1173">querySQL</name>
<objectValue id="1174" type="java.lang.String"><![CDATA[select * from (select isgp.instr_id INSTRID, isgp.isid_oid ISIDOID, isgp.mkt_iss_oid MKTISSOID, isgp.isgp_oid ISGPOID,count (distinct isgp_oid) over (partition by isgp.instr_id, mkis.mkt_oid) ISSU_MKT_CNT,
        mkis.mkt_oid MKTOID,mkid.mkt_id MKTID, mkis.prc_curr_cde CURRENCY, sedol.iss_id SEDOL,sedol.mkt_oid SEDOL_MKT, isin.iss_id ISIN, seclabel.iss_id SECLABEL, ric.iss_id RIC,
        RIC.mkt_oid RIC_MKT, canonico.iss_id CANONICO, MKIS_MTGP.PRNT_MKT_GRP_OID SECLABEL_MKT_GRP, sedol_mtgp.PRNT_MKT_GRP_OID SEDOL_MKT_GRP, ric_mtgp.PRNT_MKT_GRP_OID RIC_MKT_GRP,
        CASE WHEN (sedol_mtgp.PRNT_MKT_GRP_OID=MKIS_MTGP.PRNT_MKT_GRP_OID AND ric_mtgp.PRNT_MKT_GRP_OID=MKIS_MTGP.PRNT_MKT_GRP_OID) THEN 1 WHEN (sedol_mtgp.PRNT_MKT_GRP_OID=MKIS_MTGP.PRNT_MKT_GRP_OID AND ric_mtgp.PRNT_MKT_GRP_OID<>MKIS_MTGP.PRNT_MKT_GRP_OID) THEN 2 WHEN (sedol_mtgp.PRNT_MKT_GRP_OID<>MKIS_MTGP.PRNT_MKT_GRP_OID AND ric_mtgp.PRNT_MKT_GRP_OID=MKIS_MTGP.PRNT_MKT_GRP_OID) THEN 2 ELSE 999 END TEMP_RANK,
        dense_rank() over (partition by isgp.isgp_oid order by 
            CASE WHEN (sedol_mtgp.PRNT_MKT_GRP_OID=MKIS_MTGP.PRNT_MKT_GRP_OID AND ric_mtgp.PRNT_MKT_GRP_OID=MKIS_MTGP.PRNT_MKT_GRP_OID) THEN 1 
                WHEN (sedol_mtgp.PRNT_MKT_GRP_OID=MKIS_MTGP.PRNT_MKT_GRP_OID AND ric_mtgp.PRNT_MKT_GRP_OID<>MKIS_MTGP.PRNT_MKT_GRP_OID) THEN 2 
                WHEN (sedol_mtgp.PRNT_MKT_GRP_OID<>MKIS_MTGP.PRNT_MKT_GRP_OID AND ric_mtgp.PRNT_MKT_GRP_OID=MKIS_MTGP.PRNT_MKT_GRP_OID) THEN 2 ELSE 999 
            END ASC, MKIS_MTGP.PRNT_MKT_GRP_OID , sedol_mtgp.PRNT_MKT_GRP_OID , ric_mtgp.PRNT_MKT_GRP_OID)rank
from ft_t_isgr isgr, ft_t_isgp isgp, ft_t_mkis mkis, ft_t_isid sedol, ft_t_isid ric, ft_t_isid isin, ft_t_isid seclabel, ft_t_isid canonico, ft_t_mkid mkid,ft_t_mtgp mkis_mtgp,ft_t_mtgp sedol_mtgp,ft_t_mtgp ric_mtgp
where isgr.ISS_GRP_OID=isgp.PRNT_ISS_GRP_OID
and isgp.prt_purp_typ='COMPNENT'
and isgp.data_stat_typ='ACTIVE'
and isgp.end_tms is null
and isgp.mkt_iss_oid=mkis.mkt_iss_oid (+)
and mkis.data_stat_typ (+) ='ACTIVE'
and mkis.end_tms (+) is null
and mkis.mkt_oid=mkis_mtgp.mkt_oid (+)
and mkis_mtgp.data_stat_typ (+) ='ACTIVE'
and mkis_mtgp.end_tms (+) is null
and mkis.mkt_oid=mkid.mkt_oid (+)
and mkid.mkt_id_ctxt_typ (+) ='MIC'
and mkid.data_stat_typ (+) ='ACTIVE'
and mkid.end_tms (+) is null
and mkis_mtgp.PRNT_MKT_GRP_OID = sedol_mtgp.PRNT_MKT_GRP_OID (+)
and sedol_mtgp.data_stat_typ (+) ='ACTIVE'
and sedol_mtgp.end_tms (+) is null
and isgp.instr_id=sedol.instr_id (+)
and sedol.id_ctxt_typ (+) ='SEDOL'
and sedol.data_stat_typ (+) ='ACTIVE'
and sedol.mkt_oid  =sedol_mtgp.mkt_oid (+)
and sedol.end_tms (+) is null
and mkis_mtgp.PRNT_MKT_GRP_OID = ric_mtgp.PRNT_MKT_GRP_OID (+)
and ric_mtgp.data_stat_typ (+) ='ACTIVE'
and ric_mtgp.end_tms (+) is null
and isgp.instr_id=ric.instr_id (+)
and ric.id_ctxt_typ (+) ='RIC'
and ric.data_stat_typ (+) ='ACTIVE'
and ric.mkt_oid =ric_mtgp.mkt_oid (+)
and ric.end_tms (+) is null
and isgp.instr_id=isin.instr_id (+)
and isin.id_ctxt_typ (+) ='ISIN'
and isin.data_stat_typ (+) ='ACTIVE'
and isin.end_tms (+) is null
and isgp.instr_id=canonico.instr_id (+)
and canonico.id_ctxt_typ (+) ='RDR_ID'
and canonico.data_stat_typ (+) ='ACTIVE'
and canonico.end_tms (+) is null
and isgp.instr_id=seclabel.instr_id (+)
and isgp.isid_oid=seclabel.isid_oid (+)
and seclabel.id_ctxt_typ (+) ='MUREXID'
and seclabel.data_stat_typ (+) ='ACTIVE'
and mkis.mkt_oid=seclabel.mkt_oid (+)
and seclabel.end_tms (+) is null
and isgr.instr_id=:1
and isgr.data_stat_typ='ACTIVE'
and isgr.grp_purp_typ='BASKET')
where rank=1]]></objectValue>
<type>CONSTANT</type>
</item>
</parameters>
<sources id="1175" type="java.util.HashSet">
