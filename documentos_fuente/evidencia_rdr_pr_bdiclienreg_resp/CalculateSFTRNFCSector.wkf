<input>true</input>
<name id="250">statements</name>
<stringValue id="251">String message = "";
String trndMessage = "";


message = sequence+ "\";\"1\";\"" + "El CNAE:" + cnae+ ", asociado a la Cparty con FINSID:" + finsId + ", no tiene parametrizacion en RDR";

trndMessage = "El CNAE:" + cnae+ ", no tiene parametrizacion en RDR";



</stringValue>
<type>CONSTANT</type>
</item>
