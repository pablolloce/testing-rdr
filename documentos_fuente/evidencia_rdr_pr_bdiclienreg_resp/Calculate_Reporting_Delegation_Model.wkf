<item id="816" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="817">querySQL</name>
<stringValue id="818">UPDATE FT_T_FRA1 
SET CL_VALUE = ?,
CLSF_OID = (
SELECT CLSF_OID
FROM FT_T_INCL
WHERE INDUS_CL_SET_ID = 'EMIRREPDEL'
AND CL_VALUE= ?
AND DATA_STAT_TYP='ACTIVE'),
LAST_CHG_TMS=SYSDATE,
LAST_CHG_USR_ID='BBVA:CUSTOMER'
WHERE INST_MNEM  = ? 
AND FRA1_OID = ?
AND LAST_CHG_USR_ID='BBVA:CUSTOMER'
</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
