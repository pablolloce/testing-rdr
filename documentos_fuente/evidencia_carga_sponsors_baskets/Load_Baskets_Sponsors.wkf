<item id="1454" type="com.j2fe.workflow.definition.Transition">
<name id="1455">EXCHANGE</name>
<source id="1456">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="1457">XML Check by sponsor</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="1458">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="1459" type="java.util.HashSet">
<item id="1460" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="1461">statements</name>
<objectValue id="1462" type="java.lang.String">String accion ="OK";
String mensaje = "";
String market = "";
String tipoMensaje = "";
String mainId = "";
String secondaryId = "";
String mic ="";
String[] arrayMensaje = new String[2]; 
//cada inputComponentNode es un elemento del XML de entrada sobre el cual se hace el loop
//Verificamos que el main id type venga con valor

mainId = inputComponentNode.getElementsByTagName(mainIdType).item(0).getTextContent();
if (!secondaryIdType.equals("")) {
		secondaryId = inputComponentNode.getElementsByTagName(secondaryIdType).item(0).getTextContent();
}

if (!mainId.equals("")) {
	if (mainIdType.equals("ISIN")) {
		if (sponsor.equals("STOXX_DAX")){
			//Verificamos que tenga Exchange informado
			market=inputComponentNode.getElementsByTagName("EXCHANGE").item(0).getTextContent();
			accion="EXCHANGE";
		} else {
			//Verificamos que tenga MIC informado
			market=inputComponentNode.getElementsByTagName("COMPONENT_MIC").item(0).getTextContent();
			mic=inputComponentNode.getElementsByTagName("COMPONENT_MIC").item(0).getTextContent();
		}
		if (market.equals("")){
			accion="ERROR";
			mensaje="El fichero de entrada no tiene mercado informado para el ISIN: "+mainId;
			tipoMensaje = "ERROR TÉCNICO RDR";
			arrayMensaje[0] = tipoMensaje;
			arrayMensaje[1] = mensaje;
			listaErrores.add(arrayMensaje);	
		}
	}
}else{
	accion="ERROR";
	mensaje="El fichero de entrada tiene un componente sin "+mainIdType;
	tipoMensaje = "ERROR TÉCNICO RDR";
	arrayMensaje[0] = tipoMensaje;
	arrayMensaje[1] = mensaje;
	listaErrores.add(arrayMensaje);
}
Transition=accion;</objectValue>
<type>CONSTANT</type>
</item>
