<name id="55">statements</name>
<stringValue id="56">import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("AlertasEnvio - Mail variables");

String body ="";
String subject = "";

subject = "Reporte descarga datos emisores Refinitiv";

body = "Estimado usuario,\r\n\r\n"+
"Se adjunta el informe del proceso de descarga de datos de emisores de Refinitiv.\r\n\r\n" +
"Número de líneas: " + total + "\r\n\r\n" +
"Un saludo.";



logger.error("destination : " + destination );
logger.error("subject: " + subject);
logger.error("body: " + body);
</stringValue>
<type>CONSTANT</type>
</item>
