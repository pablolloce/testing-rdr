<item id="22" type="com.j2fe.workflow.definition.Transition">
<name id="23">goto-next</name>
<source id="24">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="25">Transaction Information</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="26">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="27" type="java.util.HashSet">
<item id="28" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="29">statements</name>
<objectValue id="30" type="java.lang.String">//Declaración de variables
Map valores = new HashMap();
Map cftcMap = new HashMap();
Map secMap = new HashMap();

String [] etiquetas = new String [5];
etiquetas[0] = "MAIN_ENTITY_ID";
etiquetas[1] = "MAIN_ENTITY_ID_CTXT_TYP";
etiquetas[2] = "MAIN_ENTITY_NME";
etiquetas[3] = "MAIN_ENTITY_TYP";
etiquetas[4] = "MAIN_ENTITY_TBL_TYP";


//Data from CFTC
for (Map cftc : cftcData)
{	
	if (cftc.get("ETIQUETA").equals("RR_CRD"))  
	{
		//Indicador del rol de la contrapartida a nivel de créditos en el mercado en el ambito del CFTC.
		cftcMap.put("WE-COD-ROLCR", cftc.get("VALOR"));
	}else if (cftc.get("ETIQUETA").equals("RR_IRS"))  
	{
		//Indicador del rol de la contrapartida a nivel de interés en el mercado en el ámbito del CFTC.
		cftcMap.put("WE-COD-ROLIN", cftc.get("VALOR"));
	}else if (cftc.get("ETIQUETA").equals("RR_FX"))  
	{
		//Indicador del rol de la contrapartida a nivel de FX en el mercado en el ámbito del CFTC.
		cftcMap.put("WE-COD-ROLFX", cftc.get("VALOR"));
	}else if (cftc.get("ETIQUETA").equals("RR_COM"))  
	{
		//Indicador del rol de la contrapartida a nivel de commodities en el mercado en el ámbito del CFTC.
		cftcMap.put("WE-COD-ROLCO", cftc.get("VALOR"));
	}else if (cftc.get("ETIQUETA").equals("RR_EQD"))  
	{
		//Indicador del rol de la contrapartida a nivel de equity en el mercado en el ámbito del CFTC.
		cftcMap.put("WE-COD-ROLEQ", cftc.get("VALOR"));
	}
}

//Data from SEC
for (Map sec : secData)
{	
	if (sec.get("ETIQUETA").equals("SEC_CRD"))  
	{
		//Indicador del rol de la contrapartida a nivel de créditos en el mercado en el ambito SEC.
		secMap.put("WE-COD-ROLCRSEC", sec.get("VALOR"));
	}else if (sec.get("ETIQUETA").equals("SEC_EQD"))  
	{
		//Indicador del rol de la contrapartida a nivel de equity en el mercado en el ámbito SEC.
		secMap.put("WE-COD-ROLEQSEC", sec.get("VALOR"));
	}
}

valores.put (etiquetas[0],((cftcMap.containsKey("WE-COD-ROLCR")) ? cftcMap.get("WE-COD-ROLCR") : "No Existe") + ";" + 
((cftcMap.containsKey("WE-COD-ROLIN")) ? cftcMap.get("WE-COD-ROLIN") : "No Existe") + ";" + 
((cftcMap.containsKey("WE-COD-ROLFX")) ? cftcMap.get("WE-COD-ROLFX") : "No Existe") + ";" +
((cftcMap.containsKey("WE-COD-ROLCO")) ? cftcMap.get("WE-COD-ROLCO") : "No Existe") + ";" +
((cftcMap.containsKey("WE-COD-ROLEQ")) ? cftcMap.get("WE-COD-ROLEQ") : "No Existe") + ";" + 
((secMap.containsKey("WE-COD-ROLCRSEC")) ? secMap.get("WE-COD-ROLCRSEC") : "No Existe") + ";" + 
((secMap.containsKey("WE-COD-ROLEQSEC")) ? secMap.get("WE-COD-ROLEQSEC") : "No Existe"));
valores.put (etiquetas[1],"GRI-" + cntrprtyGlobalOid);
valores.put (etiquetas[2],"Extraccion de indicadores según CFTC (Credito, Interes, Forex, Commodities, Renta Fija) e indicadores según SEC (Credito, Renta Fija)");
valores.put (etiquetas[3],"RR_;SEC_");
valores.put (etiquetas[4],"FRA1");</objectValue>
<type>CONSTANT</type>
</item>
