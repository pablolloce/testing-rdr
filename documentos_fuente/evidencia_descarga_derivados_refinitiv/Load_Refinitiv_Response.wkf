<name id="563">Listed MIC</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="564">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="565" type="java.util.HashSet">
<item id="566" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="567">statements</name>
<objectValue id="568" type="java.lang.String"><![CDATA[import java.util.HashMap;
import java.util.LinkedHashMap;
import java.util.Map;
import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.Calendar;

String mensaje = "";
String mics = "";
String error = "";
for (Map mapMic : listedMic) {
	if (idAndMicMap.get(mapMic.get("ID"))!=null){
			String[] micList = idAndMicMap.get(mapMic.get("ID")).split(",");
	mics = "";
	for(String mic : micList){
		mics = mics +  "<MIC>" + mic + "</MIC>";
	}
	mensaje = mensaje+"<listed_MIC><data_src>REFINITIV</data_src><emision>" + mapMic.get("ID") + "</emision><mktoid_primexch>" + mapMic.get("MARKET") + 
	"</mktoid_primexch><numero_mercados>" + micList.length + "</numero_mercados><MICs>" + mics + "</MICs></listed_MIC>";
}else{
	error = mapMic.get("ID");
}
}

Date date = Calendar.getInstance().getTime();
SimpleDateFormat sdf = new SimpleDateFormat("MMdd_kkmmss_SSSSS");
String fileName = "CargaListedMIC".concat("_").concat(sdf.format(date)).concat(".xml");
fileName = fileName.replace(" ","");

String pathMic = path + fileName;]]></objectValue>
<type>CONSTANT</type>
</item>
