<stringValue id="466">import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("AlertasEnvio - Mail variables");

String body ="";
String subject = "";
String destination = "";

destination = MAIL.get("DIRECCION");
subject = "[RDR Reportes] - " +PROCESO.get("PROCESO");
body = txtBody;



logger.error("destination : " + destination );
logger.error("subject: " + subject);
logger.error("body: " + body);
</stringValue>
<type>CONSTANT</type>
</item>
