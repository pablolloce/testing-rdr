<input>true</input>
<name id="60">statements</name>
<stringValue id="61"><![CDATA[import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("Calculate Reporting Delegation Model");

if (hacerCalculoDR != null && hacerCalculoDR.length() > 0 && hacerCalculoDR.equalsIgnoreCase("false")) {
	logger.error("[CheckDatosRegulatorios] Calculate Reporting Delegation Model: NO SE HACE CALCULO AQUI");
	return false;
}else{
	logger.error("[CheckDatosRegulatorios] Calculate Reporting Delegation Model: SE HACE CALCULO AQUI");
	return true;
}]]></stringValue>
<type>CONSTANT</type>
</item>
