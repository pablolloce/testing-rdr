<item id="131" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="132">statements</name>
<stringValue id="133"><![CDATA[if (roleqsem != null && roleqsem.length > 0) 
{
	//Control de estado de la extracción del European Person Indicator
	if(roleqsem[0].get("ESTADO").equals("ACTIVE"))
	{
		if(finalEmir.equals(roleqsem[0].get("VALOR")))
		{
			update = true;
			return "out";
		}else
		{
			update = true;
			return true;
		}
	}else
	{
		//El dato se encuentra inactivo y se tiene que actualizar con el dato calculado y el status reactivado
		return "reactivar";
	}
}else
{
	update = false;
	return false;
	
}]]></stringValue>
<type>CONSTANT</type>
</item>
