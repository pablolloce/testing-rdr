<item id="72" type="com.j2fe.workflow.definition.Transition">
<name id="73">CARGA_BASKETS_SPONSORS</name>
<source idref="9"/>
<target id="74">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="75">Get Datos</name>
<nodeHandler>com.j2fe.general.activities.database.DBQuery</nodeHandler>
<nodeHandlerClass id="76">com.j2fe.general.activities.database.DBQuery</nodeHandlerClass>
<parameters id="77" type="java.util.HashSet">
<item id="78" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="79">database</name>
<stringValue id="80">jdbc/GSDM-1</stringValue>
<type>REFERENCE</type>
</item>
<item id="81" type="com.j2fe.workflow.definition.Parameter">
<input>false</input>
<name id="82">mappedResult</name>
<stringValue id="83">reportMap</stringValue>
<type>VARIABLE</type>
</item>
<item id="84" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="85">querySQL</name>
<objectValue id="86" type="java.lang.String"><![CDATA[SELECT TOTAL,
SUM(CASE WHEN PUBLISHED='0' THEN 1 ELSE 0 END)  OVER() ERRORES,
SUM(CASE WHEN PUBLISHED='1' THEN 1 ELSE 0 END)  OVER() CARGADOS,
SUM(CASE WHEN MENSAJE_INDEX IS NULL THEN 1 ELSE 0 END)  OVER() MISSING,
SUM(CASE WHEN (ACK>NACK or (NACK is null and ACK is not null)) THEN 1 ELSE 0 END) OVER() ACK,
SUM(CASE WHEN (NACK>ACK or (ACK is null and NACK is not null)) THEN 1 ELSE 0 END) OVER() NACK,
TOTAL_INDEX,
MENSAJE_INDEX,
PUBLISHED,
CANONICO,
CASE WHEN (ACK>NACK or (NACK is null and ACK is not null)) THEN 'ACK' WHEN (NACK>ACK or (ACK is null and NACK is not null)) THEN 'NACK' END ACKNACK
FROM (
SELECT TOTAL_PAR1.*,
MENSAJE.*,
EMM1.MSG_DESCRIPTION MSG_NACK,
EMM1.BROADCAST_DATE NACK,
dense_rank() over(partition by TOTAL_INDEX order by EMM1.BROADCAST_DATE desc) NACK_RANK,
MUREXID.LAST_CHG_TMS ACK
FROM 
(SELECT COUNT(PAR1_OID) OVER () TOTAL, SUBSTR(PAR1_NME,INSTR(PAR1_NME,';',1,1)+1) TOTAL_INDEX 
FROM FT_T_PAR1 WHERE  PARAMETER_CTXT_TYP = 'BSKT_LOAD' and data_stat_typ='ACTIVE') TOTAL_PAR1,
(SELECT DISTINCT SUBSTR(MENSAJE,INSTR(MENSAJE,'|', 1, 3)+1,INSTR(MENSAJE,'|', 1, 4)-INSTR(MENSAJE,'|', 1, 3)-1) MENSAJE_INDEX,
SUBSTR(mensaje,INSTR(mensaje,'|', 1, 7)+1) PUBLISHED,
SUBSTR(mensaje,INSTR(mensaje,'|', 1, 6)+1,INSTR(mensaje,'|', 1, 7)-INSTR(mensaje,'|', 1, 6)-1) CANONICO,
MIN(START_TMS) OVER(PARTITION BY SUBSTR(MENSAJE,INSTR(MENSAJE,'|', 1, 3)+1,INSTR(MENSAJE,'|', 1, 4)-INSTR(MENSAJE,'|', 1, 3)-1)) PUBLISHED_TMS
FROM FT_T_ALG1 WHERE PROCESO = 'CARGA_BASKETS_SPONSORS' and PROCESADO ='S' and last_chg_tms > trunc(sysdate)) MENSAJE, 
FT_T_EMM1 EMM1, FT_T_ISID RDRID, FT_T_ISID MUREXID
WHERE TOTAL_INDEX=MENSAJE_INDEX(+)
AND CANONICO=EMM1.DATA_CDE (+)
AND PUBLISHED_TMS<=EMM1.BROADCAST_DATE (+)
AND EMM1.BROADCAST_SYSTEM (+) IN ('MUREX','ESB')
AND EMM1.DATA_TYP (+) = 'Basket'
AND CANONICO = RDRID.ISS_ID (+)
AND RDRID.ID_CTXT_TYP (+) = 'RDR_ID'
AND RDRID.DATA_STAT_TYP (+) ='ACTIVE'
AND RDRID.INSTR_ID = MUREXID.INSTR_ID (+)
AND MUREXID.ID_CTXT_TYP (+)='MUREXID'
AND MUREXID.DATA_STAT_TYP (+) ='ACTIVE'
AND MUREXID.LAST_CHG_USR_ID (+)= 'ACK'
AND PUBLISHED_TMS<=MUREXID.LAST_CHG_TMS (+)
)
WHERE NACK_RANK=1]]></objectValue>
<type>CONSTANT</type>
</item>
</parameters>
