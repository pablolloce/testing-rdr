<item id="28" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="29">querySQL</name>
<stringValue id="30">UPDATE ft_t_rlt1 
 SET RLT_DIF_STAT = 'FIN' 
 FROM FT_T_INCL 
 where ft_t_rlt1.main_entity_id =? 
 and RLT_PURP_TYP='CONTROLDR' 
 and GS_VALUE='OPERATIVE'
 and LAST_CHG_TMS >sysdate - 7 /86400</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
