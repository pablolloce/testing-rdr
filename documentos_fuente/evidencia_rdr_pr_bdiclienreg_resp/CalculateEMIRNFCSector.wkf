<name id="206">statements</name>
<stringValue id="207">String message = "";
String trndMessage = "";


message = sequence+ "\";\"1\";\"" + "La Cparty con FINSID:" + finsId + ", no tiene CNAE en RDR";


trndMessage = "La Cparty no tiene CNAE en RDR";

</stringValue>
