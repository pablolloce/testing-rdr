<item id="246" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="247">querySQL</name>
<stringValue id="248">select ridf.instr_id instridbasket from ft_t_riss riss, ft_t_ridf ridf
where riss.instr_id in (select instr_id from ft_t_isid where iss_id=:index_ID and (id_ctxt_typ=:idType or id_ctxt_typ=:idType2) and data_stat_typ='ACTIVE' and end_tms is null)
and riss.iss_part_rl_typ='INDEX'
and ridf.rel_typ='BASKET'
and riss.rld_iss_feat_id=ridf.rld_iss_feat_id
and riss.data_stat_typ='ACTIVE'
and ridf.data_stat_typ='ACTIVE'
and (riss.end_tms is null or riss.end_tms > sysdate)
and (ridf.end_tms is null or ridf.end_tms > sysdate)</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
