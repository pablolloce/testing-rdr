<name id="156">querySQL</name>
<stringValue id="157">UPDATE FT_T_FRA1 
SET CL_VALUE = '02',
CLSF_OID = (
SELECT CLSF_OID
FROM FT_T_INCL
WHERE INDUS_CL_SET_ID = 'SFTRREPDEL'
AND CL_VALUE='02'
AND DATA_STAT_TYP='ACTIVE'),
LAST_CHG_TMS=SYSDATE,
LAST_CHG_USR_ID='BBVA:CUSTOMER'
WHERE INST_MNEM  = ? 
AND FRA1_OID = ?</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
