<item id="1999" type="com.j2fe.workflow.definition.Transition">
<name id="2000">goto-next</name>
<source id="2001">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="2002">Generar comandos XSLT</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="2003">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
