<name id="264">statements</name>
<objectValue id="265" type="java.lang.String"><![CDATA[//DeclaraciÃ³n de variables
Map valores = new HashMap();
String inup = "Insercion:" + cuenta;

if(update)
{
	if(cuenta != null)
	{
		inup = "Actualizacion:" + cuenta;
	}else
	{
		inup = "El dato calculado y el existente coinciden - No se Actualiza";
	}
}

StringBuilder datos = new StringBuilder();

if(bdiCode != null && bdiCode.length > 0)
{
	datos.append(bdiCode[0].get("BDI"));
	datos.append(";");
}else
{
	datos.append("NoExiste;");
}

if(entOwn != null && entOwn.length > 0)
{
	datos.append(entOwn[0].get("ENTOWN"));
	datos.append(";");
}else
{
	datos.append("NoExiste;");
}

if(personality != null && personality.length > 0)
{
	datos.append(personality[0].get("ROLE"));
	datos.append(";");
}else
{
	datos.append("NoExiste;");
}

if(rolcrsem != null && rolcrsem.length > 0)
{
	datos.append(rolcrsem[0].get("ROLCRSEM"));
	datos.append(";");
}else
{
	datos.append("NoExiste;");
}

if (europeanPersonData != null && europeanPersonData.length > 0)
{
	datos.append(europeanPersonData[0].get("USINDEM"));
	datos.append(";");
}else
{
	datos.append("NoExiste;");
}

if(calculoEMIR != null )
{
	datos.append(calculoEMIR.get("ETIQUETA"));
}else
{
	datos.append("NoExiste");
}

String [] etiquetas = new String [5];
etiquetas[0] = "MAIN_ENTITY_ID";
etiquetas[1] = "MAIN_ENTITY_ID_CTXT_TYP";
etiquetas[2] = "MAIN_ENTITY_NME";
etiquetas[3] = "MAIN_ENTITY_TYP";
etiquetas[4] = "MAIN_ENTITY_TBL_TYP";

valores.put (etiquetas[0],datos.toString());
valores.put (etiquetas[1],"GRI-" + cntrprtyGlobalOid);
valores.put (etiquetas[2],"Calculo(Se muestran datos: BDI Code, Entity Owner, Personality, campo CCP, European Person Indicator, Counterparty type under EMIR - " + inup);
valores.put (etiquetas[3],"FINENTEM");
valores.put (etiquetas[4],"FRA1");]]></objectValue>
<type>CONSTANT</type>
</item>
