<item id="57" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="58">statements</name>
<stringValue id="59"><![CDATA[import org.apache.commons.lang.StringUtils;

String FitchRtngCode = "";
String FitchGradoRtngCode = "";

if ( intFitchRatingArray > 0 && FitchRatingArray[0][0]  != null && !"".equals(FitchRatingArray[0][0]) ){
	FitchRtngCode = FitchRatingArray[0][0];
} else {
	FitchRtngCode = "No disp.";
}

if ( intFitchRatingArray > 0 && FitchRatingArray[0][1]  != null && !"".equals(FitchRatingArray[0][1]) ){
	FitchGradoRtngCode = String.valueOf(FitchRatingArray[0][1]);
} else {
	FitchGradoRtngCode = "99";
}]]></stringValue>
<type>CONSTANT</type>
</item>
