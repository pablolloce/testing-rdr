<item id="52" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="53">querySQL</name>
<stringValue id="54">SELECT	DECODE(COUNT(*),'1','Y','N') USINDEM
  	FROM FT_T_FIGU FIGU, FT_T_GUGP GUGP, FT_T_GUNT GUNT
    WHERE FIGU.INST_MNEM = :cntrprtyGlobalOid 
    AND FIGU.GUNT_OID = GUNT.GUNT_OID 
    AND GUNT.GUNT_OID = GUGP.GUNT_OID 
    AND UPPER(FIGU.GU_TYP) IN ('COUNTRY', 'EURCMMTY', 'ALLIANCE')
    AND UPPER(FIGU.FINS_GU_PURP_TYP) = 'STSMNTCT'
    AND GUGP.DATA_STAT_TYP = 'ACTIVE'
    AND GUGP.PRT_PURP_TYP = 'EMIRREGU'</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
