<item id="93" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="94">statements</name>
<objectValue id="95" type="java.lang.String"><![CDATA[import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("---Calculate Final type under SFTR");
	
if (roleqsem != null && roleqsem.length > 0) {
	logger.error("1---Calculate Final type under SFTR " + roleqsem[0].get("ESTADO"));
	//Control de estado de la extraccion del European Person Indicator
	if(roleqsem[0].get("ESTADO").equals("ACTIVE"))	{
		logger.error("2---Calculate Final type under SFTR");
		if(finalSftr.equals(roleqsem[0].get("VALOR")))	{
			logger.error("3---Calculate Final type under SFTR");
			update = true;
			return "out";
		}else	{
			logger.error("4---Calculate Final type under SFTR");
			if(finalSftr.trim().equals("05")||finalSftr.trim().equals("")){
				logger.error("7.1---Calculate Final type under SFTR");
				update = true;
				return "inactivar";
			}else	{
				update = true;
				return true;
			}
		}
	}else	{
		if(finalSftr.trim().equals("05")){
			logger.error("7.2---Calculate Final type under SFTR");
			update = true;
			return "out";
		} else if(finalSftr.trim().equals("")){
			logger.error("9---Calculate Final type under SFTR");
			update = true;
			return "inactivar";
		}else	{
			logger.error("5---Calculate Final type under SFTR");
			//El dato se encuentra inactivo y se tiene que actualizar con el dato calculado y el status reactivado
			return "reactivar";
		}
	}
}else{
	logger.error("6---Calculate Final type under SFTR");
	if(finalSftr.trim().equals("05")||finalSftr.trim().equals("")){
		logger.error("7.3---Calculate Final type under SFTR");
		update = true;
		return "inactivar";
	}else	{
		logger.error("8---Calculate Final type under SFTR");
		update = false;
		return false;
	}
}]]></objectValue>
<type>CONSTANT</type>
</item>
