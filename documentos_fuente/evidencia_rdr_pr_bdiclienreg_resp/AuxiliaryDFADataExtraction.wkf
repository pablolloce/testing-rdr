<item id="89" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="90">querySQL</name>
<stringValue id="91">SELECT DECODE(COUNT(*),'0','MEX', 'EUR') CONTINENTE
FROM FT_T_EERL EERL, FT_T_ENFR ENFR,FT_T_FIRL FIRLL, FT_T_FIRL FIRLO,
FT_T_FIRL FIRLOMATRIZ,FT_T_FIRL FIRLLMATRIZ, FT_T_FINS FINS
WHERE ENFR.FINR_INST_MNEM = FIRLOMATRIZ.INST_MNEM
AND FIRLO.INST_MNEM = :cntrprtyOperativeOid
AND FIRLO.PRNT_INST_MNEM = FIRLL.INST_MNEM
AND FIRLL.PRNT_INST_MNEM = FIRLLMATRIZ.PRNT_INST_MNEM
AND FIRLLMATRIZ.INST_MNEM = FIRLOMATRIZ.PRNT_INST_MNEM
AND FIRLL.REL_TYP = 'LOCAL'
AND FIRLO.REL_TYP = 'OPERATIVE'
AND FIRLOMATRIZ.REL_TYP = 'OPERATIVE'
AND FIRLOMATRIZ.INST_MNEM = FINS.INST_MNEM
AND TRIM(FIRLO.FINSRL_TYP) = 'CPARTY'
AND TRIM(FIRLOMATRIZ.FINSRL_TYP) = 'CPARTY'
AND ENFR.ORG_ID = EERL.ORG_ID
AND EERL.RL_TYP = 'BRANCH'
AND ENFR.FINSRL_TYP = 'CPARTY  '
AND EERL.PRNT_ORG_ID = '0182'</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
