<name id="106">statements</name>
<stringValue id="107">if(TRIP.length==0){
	return "KO";
}else{
	if(TRIP[0].get("SEVERITY")==null || TRIP[0].get("SEVERITY").equals("KO")){
		return "KO";
	}else{
		return "OK";
	}
}
</stringValue>
<type>CONSTANT</type>
