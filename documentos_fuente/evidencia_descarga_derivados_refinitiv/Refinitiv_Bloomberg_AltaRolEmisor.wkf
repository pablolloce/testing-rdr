<name id="460">XML_ALTA_ROL</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="461">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="462" type="java.util.HashSet">
<item id="463" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="464">statements</name>
<objectValue id="465" type="java.lang.String"><![CDATA[String bbg = BBGID;
if (bbg == null) bbg = "";
bbg = bbg.trim();
if (bbg.equalsIgnoreCase("n.a") || bbg.equalsIgnoreCase("na") || bbg.equalsIgnoreCase("n/a")
 || bbg.equalsIgnoreCase("null") || bbg.equalsIgnoreCase("void") || bbg.equals("-")) bbg = "";

String lei = LEI;
if (lei == null) lei = "";
lei = lei.trim();

String fins = FINS_ID;
if (fins == null) fins = "";
fins = fins.trim();

String req = String.valueOf(System.currentTimeMillis());

String XML_ALTA_ROL =
    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" +
    "<PtyDetlListUpd ReqID=\"" + req + "\" SvcID=\"ISSUER\">" +
        "<PtyDetlUpd ListUpdActn=\"A\">" +
            "<PtyDetl ID=\"" + fins + "\" R=\"CHILD\" src=\"ASSET\">" +
                "<RolDetl R=\"CPARTY\"><AltPty><ID></ID><Typ>ORG_ID</Typ></AltPty></RolDetl>" +
                "<RolDetl R=\"CPARTY\"><AltPty><ID>" + bbg + "</ID><Typ>BBGCID</Typ></AltPty></RolDetl>" +
                "<RolDetl R=\"CPARTY\"><AltPty><ID>" + lei + "</ID><Typ>LEIID</Typ></AltPty></RolDetl>" +
            "</PtyDetl>" +
        "</PtyDetlUpd>" +
    "</PtyDetlListUpd>";]]></objectValue>
<type>CONSTANT</type>
</item>
