<item id="288" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="289">querySQL</name>
<stringValue id="290">MERGE INTO FT_T_ISST USING dual ON ( INSTR_ID=:instrIdBasket AND STAT_DEF_ID='B_OPNRES')
WHEN MATCHED THEN UPDATE SET last_CHG_USR_ID=:sponsor, LAST_CHG_TMS=SYSDATE, STAT_CHAR_VAL_TXT=:statusCarga
WHEN NOT MATCHED THEN INSERT (STAT_ID, STAT_DEF_ID, INSTR_ID, START_TMS, LAST_CHG_TMS, LAST_CHG_USR_ID, STAT_CHAR_VAL_TXT, DATA_SRC_ID, DATA_STAT_TYP)
    VALUES (new_oid, 'B_OPNRES', :instrIdBasket, sysdate, sysdate, :sponsor,:statusCarga, 'RDR','ACTIVE')</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
