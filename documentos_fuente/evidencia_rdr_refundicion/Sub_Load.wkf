<item id="173" type="com.j2fe.workflow.definition.Transition">
<name id="174">goto-next</name>
<source idref="151"/>
<target id="175">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="176">Carga PL</name>
<nodeHandler>com.j2fe.general.activities.database.PLSQLprocedure</nodeHandler>
<nodeHandlerClass id="177">com.j2fe.general.activities.database.PLSQLprocedure</nodeHandlerClass>
<parameters id="178" type="java.util.HashSet">
<item id="179" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="180">PLSQLQuery</name>
<objectValue id="181" type="java.lang.String"><![CDATA[DECLARE

-- EXCEPCIONES CONTROLADAS
CLIENTED_DUPLICATE EXCEPTION;
CLIENTED_NOT_FOUND EXCEPTION;
CLIENTEP_DUPLICATE EXCEPTION;
CLIENTEP_NOT_FOUND EXCEPTION;

-- DECLARACION DE VARIABLES
REGISTRO VARCHAR2(100);
-- Clientela que se Cierra
CLIENTED VARCHAR2(9) := ?;
-- Clientela Destino
CLIENTEP VARCHAR2(9) := ?;
--JOB_ID
JOB varchar2(40) := ?;
--TRN_ID
TRN varchar2(40) := ?;
--SEVERITY
SEVERITY NUMBER(4,0) := 10;
INST_MNEM_CLD VARCHAR (10);
INST_MNEM_CLP VARCHAR (10);
FIRL_OID_CLD VARCHAR (10);
FIRL_OID_CLP VARCHAR (10);
FIID_OID_CLD VARCHAR (10);
PRNT_INST_MNEM_CLD VARCHAR (10);
PRNT_INST_MNEM_CLP VARCHAR (10);
PRNT_FIID_OID_CLD VARCHAR (10);
INST_NME_PRNT VARCHAR (100);
INST_NME_CLD VARCHAR (100);
INST_NME_CLP VARCHAR (100);
INST_NME_CHLD VARCHAR (100);
INST_MNEM_GLOBAL VARCHAR (100);
INST_MNEM_HIJO VARCHAR (10);
MNEMONICO_GLOBAL VARCHAR (10);
FINSID_LOCAL_CERRADA VARCHAR (100);
FIRL_OID_HIJO VARCHAR (10);
GLOBAL_FINSRL_TYP VARCHAR (12);
GLOBAL_FIRL_OID VARCHAR (10);
HIJOS_GLOBAL NUMERIC;
CONTADOR NUMERIC;
COUNT_INST_MNEM_CLD NUMERIC;
COUNT_INST_MNEM_CLP NUMERIC;
COUNT_HIJOS_LOCALES NUMERIC;
COUNT_HIJOS_GLOBALES NUMERIC;
LOCAL_ACTIVO NUMERIC;
CUENTA_GLOBAL NUMERIC;
COUNT_ALTAMIRA_D NUMERIC;
COUNT_ALTAMIRA_P NUMERIC;

VFILE UTL_FILE.FILE_TYPE;

TYPE HIJOSGLOBAL IS REF CURSOR;
CUR_HIJOSGLOBAL HIJOSGLOBAL;
VCH_SQL_HIJOSGLOBAL VARCHAR2(2000);

BEGIN
    -- Carga de Clientelas en variables y control de errores    
    DBMS_OUTPUT.PUT_LINE('CLIENTED: ' || CLIENTED);
    DBMS_OUTPUT.PUT_LINE('CLIENTEP: ' || CLIENTEP);  
    
    -- Control de errores    
    SELECT count (FIID.INST_MNEM) INTO COUNT_INST_MNEM_CLD FROM FT_T_FIID FIID, FT_T_FIRL FIRL WHERE FIID.FINS_ID = CLIENTED AND FIID.FINS_ID_CTXT_TYP = 'CLIENTELAID' AND FIID.INST_MNEM = FIRL.INST_MNEM AND FIRL.REL_TYP='LOCAL' AND FIID.DATA_STAT_TYP = 'ACTIVE';
		DBMS_OUTPUT.PUT_LINE('COUNT_INST_MNEM_CLD ' || COUNT_INST_MNEM_CLD);
		SELECT count (FIID.INST_MNEM) INTO COUNT_INST_MNEM_CLP FROM FT_T_FIID FIID, FT_T_FIRL FIRL WHERE FIID.FINS_ID = CLIENTEP AND FIID.FINS_ID_CTXT_TYP = 'CLIENTELAID' AND FIID.INST_MNEM = FIRL.INST_MNEM AND FIRL.REL_TYP='LOCAL' AND (FIID.DATA_STAT_TYP = 'ACTIVE' OR (FIID.DATA_STAT_TYP = 'INACTIVE' AND FIID.LAST_CHG_USR_ID IN ('BAJA_CPARTY','REFUNDICION')));
		DBMS_OUTPUT.PUT_LINE('COUNT_INST_MNEM_CLP ' || COUNT_INST_MNEM_CLP);
    
    -- Control del Clientela que se cierra
    IF COUNT_INST_MNEM_CLD = 0 THEN   
      RAISE CLIENTED_NOT_FOUND;
    END IF;
    IF COUNT_INST_MNEM_CLD > 1 THEN    
      RAISE CLIENTED_DUPLICATE;
    END IF;    
    
    -- Control del Clientela que permanece
    -- CASO A: EL QUE EL CLIENTELA DESTINO NO EXISTE
    IF COUNT_INST_MNEM_CLP = 0 THEN   
      DBMS_OUTPUT.PUT_LINE('NO EXISTE CLIENTELA DESTINO, SE PROCEDE A ACTUALIZAR EL DE CIERRE');
      -- Get INST_MNEM de los Clientes a nivel local
      SELECT FIID.INST_MNEM INTO INST_MNEM_CLD FROM FT_T_FIID FIID, FT_T_FIRL FIRL WHERE FIID.FINS_ID = CLIENTED AND FIID.FINS_ID_CTXT_TYP = 'CLIENTELAID' AND FIID.INST_MNEM = FIRL.INST_MNEM AND FIRL.REL_TYP='LOCAL' AND FIID.DATA_STAT_TYP = 'ACTIVE';
      DBMS_OUTPUT.PUT_LINE('INST_MNEM_CLD ' || INST_MNEM_CLD);
      -- Get FINSID de los Clientes a nivel local
      SELECT FIID.FINS_ID INTO FINSID_LOCAL_CERRADA FROM FT_T_FIID FIID WHERE FIID.INST_MNEM = INST_MNEM_CLD AND FIID.FINS_ID_CTXT_TYP = 'FINSID' AND FIID.DATA_STAT_TYP = 'ACTIVE';
      -- Actualizacion del Clientela que se cierra por el nuevo por no existir el Clientela Destino
      -- Cambio en Marzo del 2023, dejando inactivo el anterior INICIO
	-- ANTES: UPDATE FT_T_FIID SET FINS_ID = CLIENTEP, LAST_CHG_TMS = SYSDATE, LAST_CHG_USR_ID = 'REFUNDICION' WHERE FINS_ID = CLIENTED AND FINS_ID_CTXT_TYP = 'CLIENTELAID' AND DATA_STAT_TYP = 'ACTIVE';

	INSERT INTO FT_T_FIID 
		(FIID_OID,INST_MNEM,FINS_ID_CTXT_TYP,FINS_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,INST_SYMBOL_STAT_TYP,
		DATA_STAT_TYP,DATA_SRC_ID,GU_ID,GU_TYP,GU_CNT,MERGE_UNIQ_OID, INST_USAGE_TYP,INST_SYMBOL_STAT_TMS,SRCE_INST_MNEM,
		GLOBAL_UNIQ_IND,INST_SYMBOL_RENEW_TMS,GUNT_OID)
			SELECT new_oid, FIID.INST_MNEM,FIID.FINS_ID_CTXT_TYP,CLIENTEP,FIID.START_TMS,FIID.END_TMS,sysdate,'REFUNDICION',FIID.INST_SYMBOL_STAT_TYP,FIID.DATA_STAT_TYP,FIID.DATA_SRC_ID,FIID.GU_ID,
				FIID.GU_TYP,FIID.GU_CNT,FIID.MERGE_UNIQ_OID, FIID.INST_USAGE_TYP,FIID.INST_SYMBOL_STAT_TMS,	FIID.SRCE_INST_MNEM,FIID.GLOBAL_UNIQ_IND,FIID.INST_SYMBOL_RENEW_TMS,FIID.GUNT_OID
			FROM FT_T_FIID FIID WHERE FIID.FINS_ID = CLIENTED AND FIID.FINS_ID_CTXT_TYP = 'CLIENTELAID' AND FIID.DATA_STAT_TYP = 'ACTIVE';

	UPDATE FT_T_FIID SET DATA_STAT_TYP = 'INACTIVE', LAST_CHG_TMS = SYSDATE, LAST_CHG_USR_ID = 'REFUNDICION' WHERE FINS_ID = CLIENTED AND FINS_ID_CTXT_TYP = 'CLIENTELAID' AND DATA_STAT_TYP = 'ACTIVE';
 	-- Cambio en Marzo del 2023, dejando inactivo el anterior FIN
      -- Reporte
      INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,TRN,'1','1','El Clientela se ha actualizado de forma correcta',INST_MNEM_CLD,'REPORTES','REFUNDICION','Cliente Cerrado',CLIENTED,'Cliente Destino',CLIENTEP,'CLIENTED;CLIENTEP',CLIENTED||';'||CLIENTEP,sysdate,null,sysdate,'BBVA:CUSTOMER','PENDING','M');      
      DBMS_OUTPUT.PUT_LINE('ACTUALIZACION REALIZADA DE MANERA SATISFACTORIA');
	  --INSERT PARA LA BAJA DEL 460
	  INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,TRN,'1','1','Contrato 460 pendiente de dar de baja',INST_MNEM_CLD,'PROCESO','REFUNDICION','Cliente Cerrado',CLIENTED,'Cliente Destino',CLIENTEP,'INST_MNEM_CPTY_AFECTADAS',INST_MNEM_CLD,sysdate,null,sysdate,'BBVA:CUSTOMER','PENDING','B460');
      --INSERT PARA EL ALTA DEL 460
	  INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,TRN,'1','1','Pendiente Nuevo alta de contrato 460',INST_MNEM_CLD,'PROCESO','REFUNDICION','Cliente Cerrado',CLIENTED,'Cliente Destino',CLIENTEP,'INST_MNEM_CPTY_AFECTADAS',INST_MNEM_CLD,sysdate,null,sysdate,'BBVA:CUSTOMER','PENDING','A460');      
    END IF;
    
    -- CASO B: EL QUE EL CLIENTELA DESTINO EXISTE  
    IF COUNT_INST_MNEM_CLP = 1 THEN   
      -- Get INST_MNEM de los Clientes a nivel local
      SELECT FIID.INST_MNEM, FIRL.PRNT_INST_MNEM INTO INST_MNEM_CLD, PRNT_INST_MNEM_CLD FROM FT_T_FIID FIID, FT_T_FIRL FIRL WHERE FIID.FINS_ID = CLIENTED AND FIID.FINS_ID_CTXT_TYP = 'CLIENTELAID' AND FIID.INST_MNEM = FIRL.INST_MNEM AND FIRL.REL_TYP='LOCAL' AND FIID.DATA_STAT_TYP = 'ACTIVE';
      DBMS_OUTPUT.PUT_LINE('INST_MNEM_CLD ' || INST_MNEM_CLD);
      SELECT FIID.INST_MNEM, FIRL.PRNT_INST_MNEM INTO INST_MNEM_CLP, PRNT_INST_MNEM_CLP FROM FT_T_FIID FIID, FT_T_FIRL FIRL WHERE FIID.FINS_ID = CLIENTEP AND FIID.FINS_ID_CTXT_TYP = 'CLIENTELAID' AND FIID.INST_MNEM = FIRL.INST_MNEM AND FIRL.REL_TYP='LOCAL' AND (FIID.DATA_STAT_TYP = 'ACTIVE' OR (FIID.DATA_STAT_TYP = 'INACTIVE' AND FIID.LAST_CHG_USR_ID = 'BAJA_CPARTY'));
      DBMS_OUTPUT.PUT_LINE('INST_MNEM_CLP ' || INST_MNEM_CLP);    
      
	  --HAY QUE CONTROLAR SI ESTA ACTIVO EL CLIENTELA DESTINO
	  SELECT COUNT(*) INTO LOCAL_ACTIVO FROM FT_T_FINS WHERE DATA_STAT_TYP = 'ACTIVE' AND INST_MNEM = INST_MNEM_CLP;
	  IF LOCAL_ACTIVO = 0 THEN
			--HAY QUE SOLICITAR ALTA DEL FOLIO -> INSERT PARA EL ALTA DEL 460
			INSERT INTO FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,RLT_DIF_STAT,RLT_DIF_ACC) VALUES (new_oid,JOB,TRN,'1','1','Pendiente Nuevo alta de contrato 460',INST_MNEM_CLD,'PROCESO','REFUNDICION','Cliente Cerrado',CLIENTED,'Cliente Destino',CLIENTEP,'INST_MNEM_CPTY_AFECTADAS',INST_MNEM_CLD,sysdate,null,sysdate,'BBVA:CUSTOMER','PENDING','A460');      
			--HAY QUE REACTIVAR LOS NIVELES LOCAL Y GLOBAL SI PROCEDE
			UPDATE FT_T_ADTP SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_ATB1 SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_CLMN SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_CNTA SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_CUST SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_DEOP SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_DLBR SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_DLER SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_DSRC SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_ENFR SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_EXAC SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_FEO1 SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_FFRL SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_FICL SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_FIDE SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_FIGP SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_FIGR SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_FIGU SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_FIID SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID IN ('BAJA_CPARTY','REFUNDICION');
			UPDATE FT_T_FINR SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID IN ('BAJA_CPARTY','REFUNDICION');
			UPDATE FT_T_FINS SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID IN ('BAJA_CPARTY','REFUNDICION');
			UPDATE FT_T_FIRL SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_FIRT SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_FIST SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate, end_tms = null WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			--UPDATE FT_T_FLAR SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_FLG1 SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_FPRO SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_FRA1 SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_FRAP SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_FRCA SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_FRCL SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_FRGP SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
			UPDATE FT_T_FRGR SET DATA_STAT_TYP = 'ACTIVE', LAST_CHG_USR_ID = 'REFUNDICION', LAST_CHG_TMS = sysdate WHERE INST_MNEM = INST_MNEM_CLP AND DATA_STAT_TYP = 'INACTIVE' AND LAST_CHG_USR_ID = 'BAJA_CPARTY';
