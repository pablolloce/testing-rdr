<input>true</input>
<name id="146">querySQL</name>
<stringValue id="147">SELECT * FROM ft_t_utd1 UTD1 
WHERE UTD1.DATA_STAT_TYP IN ('ACTIVE') 
AND UTD1.LAST_CHG_USR_ID='SCF'
and UTD1.UTD_ID_PURP_TYP ='MNEM_OPE  '
AND UTD1.UTD_ID = :mnem 
</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
