<stringValue id="604">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("IndexSSIS_Online");

RES.put("Result","NACK");
RES.put("ReqID",ReqID);
Resultado="KO";

	RES.put("ErrorID","OSITEC002");
	RES.put("Message","Input Message Not Found");
	RES.put("MessageG","Input Message Not Found");
	RES.put("ErrorID","OSITEC001");
	RES.put("Message","Message Correlation Id Not Found");
	RES.put("MessageG","Message Correlation Id Not Found");
	JMSMessageID="000000";

//logger.error("**** Validation InCorrect. Error: "+RES.get("Message"));
//logger.error("**** Validation InCorrect. Module: "+RES.get("Module"));

logger.error("IndexSSIS_Online Module - Result: FAILED");</stringValue>
<type>CONSTANT</type>
