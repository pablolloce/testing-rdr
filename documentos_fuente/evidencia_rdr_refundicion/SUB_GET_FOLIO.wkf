<item id="61" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="62">querySQL</name>
<stringValue id="63">SELECT 
(SELECT ORG_ID FROM FT_T_FAB1 WHERE FAB1_OID =:1 and data_stat_typ='ACTIVE') BRANCH,
(select prnt_org_id from ft_t_eerl where org_id =(SELECT ORG_ID FROM FT_T_FAB1 WHERE FAB1_OID =:2 and data_stat_typ='ACTIVE') and rl_typ = 'BRANCH') CODBAN,
(select subdiv_id from ft_t_sust WHERE stat_def_id='MAINOFFI' AND ORG_ID= (SELECT ORG_ID FROM FT_T_FAB1 WHERE FAB1_OID =:3 and data_stat_typ='ACTIVE')) CODOFI,
(SELECT FLD_VAL FROM FT_T_FAB1 WHERE FAB1_OID =:4 and data_stat_typ='ACTIVE') FOLIO
FROM DUAL</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
