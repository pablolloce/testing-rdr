<item id="298" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="299">querySQL</name>
<stringValue id="300">select COUNT (*) FROM 
         FT_T_FRID ACRONIMO, FT_T_FRID ACCESSCODE ,FT_T_FIST FIST
         WHERE ACRONIMO.FINR_ID = ? 
         AND ACRONIMO.FINSRL_ID_CTXT_TYP ='ALERTID' 
         AND ACCESSCODE.FINR_ID = ?
         AND ACCESSCODE.FINSRL_ID_CTXT_TYP ='ACCDE'
         AND ACRONIMO.DATA_STAT_TYP = 'ACTIVE' 
         AND ACCESSCODE.DATA_STAT_TYP = 'ACTIVE' 
         AND ACRONIMO.INST_MNEM = ACCESSCODE.INST_MNEM 
         AND ACRONIMO.INST_MNEM = FIST.INST_MNEM
         AND ACRONIMO.END_TMS IS NULL
         AND ACCESSCODE.END_TMS IS NULL
         AND FIST.STAT_DEF_ID = 'FXRELF' and FIST.LAST_CHG_USR_ID = 'FXFUNDS' and FIST.STAT_CHAR_VAL_TXT = 'Y'</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
