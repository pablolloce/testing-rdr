<name id="554">querySQL</name>
<stringValue id="555">select SRC_VALUE as ID, GS_VALUE as MARKET from FT_T_RLT1 where JOB_ID=:0 and RLT_PURP_TYP='LISTED_MIC' and MAIN_ENTITY_NME='INSERT' and DATA_SRC_APP='RFNT_ISSUE_REQUEST'</stringValue>
