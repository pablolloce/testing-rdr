<item id="142" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="143">querySQL</name>
<stringValue id="144">SELECT tipo,
mensaje,
PUBLISHED,
min(listado.FECHA) over() FECHA 
FROM (SELECT 
SUBSTR(mensaje,INSTR(mensaje,'|', 1, 4)+1,INSTR(mensaje,'|', 1, 5)-INSTR(mensaje,'|', 1, 4)-1) TIPO,
SUBSTR(mensaje,INSTR(mensaje,'|', 1, 5)+1,INSTR(mensaje,'|', 1, 6)-INSTR(mensaje,'|', 1, 5)-1) MENSAJE,
SUBSTR(mensaje,INSTR(mensaje,'|', 1, 7)+1) AS PUBLISHED,
start_tms FECHA
FROM FT_T_ALG1
WHERE PROCESO = 'RELOAD_BASKETS_SPONSORS'
AND PROCESADO = 'N'
and last_chg_tms > trunc(sysdate)
AND SUBSTR(mensaje,INSTR(mensaje,'|', 1, 3)+1,INSTR(mensaje,'|', 1, 4)-INSTR(mensaje,'|', 1, 3)-1) = :indexId
) listado
where listado.MENSAJE not like 'Inicio de carga%'
and listado.MENSAJE not like 'Fin de carga%'</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
