<name id="182">statements</name>
<stringValue id="183"><![CDATA[import org.apache.commons.lang.StringUtils;

//Declaracion de variables
Map calculoEMIR;
String manEmir = "";
String emir = "";
String finalEmir = "";

// Manual Counterparty type under EMIR
if (manualEmirStatus!=null && manualEmirStatus.length > 0){
	if (manualEmirStatus[0].get("STATUS") != null && manualEmirStatus[0].get("STATUS").equals("Activar")){
		return "ACTIVANDO";
	}
	else if (manualEmirStatus[0].get("STATUS") != null && manualEmirStatus[0].get("STATUS").equals("Inactivar")){
		return "INACTIVANDO";
	}
	else{
		return "KO";
	}
}
else{
	if (manualEmir != null && manualEmir.length > 0) 
	{
		calculoEMIR = new HashMap();
		manEmir = manualEmir[0].get("VALOR");
		calculoEMIR.put("ETIQUETA", manEmir);
		return "OK";

	}else
	{
		manEmir = "NE";
		return "KO";
	}
}]]></stringValue>
<type>CONSTANT</type>
