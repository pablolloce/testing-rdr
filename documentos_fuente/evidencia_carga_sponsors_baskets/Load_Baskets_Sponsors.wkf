<parameters id="155" type="java.util.HashSet">
<item id="156" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="157">statements</name>
<stringValue id="158">String mensaje = "";
String tipoMensaje = "";
String[] arrayMensaje = new String[2]; 
String statusCarga = "ERROR";
String transition = "NOISST";

if (published)  {
mensaje = "ACKNACK";
tipoMensaje = "ACKINFO";

arrayMensaje[0] = tipoMensaje;
arrayMensaje[1] = mensaje;

listaErrores.add(arrayMensaje);
statusCarga = "OK";

}

if (indexMap.get("basketInstrId") != null) {
	transition= "ISST";
}

Transition=transition;</stringValue>
<type>CONSTANT</type>
</item>
