<item id="268" type="com.j2fe.workflow.definition.Transition">
<name id="269">goto-next</name>
<source id="270">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="271">Prepare Query</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="272">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="273" type="java.util.HashSet">
<item id="274" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="275">statements</name>
<objectValue id="276" type="java.lang.String">import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("SSIs_Fx_Reporte");

String ID = SSI_ID[0].get("SSI_ID");
String Message = "La SDI con ID: "+ID+" se ha dado de baja correctamente.";
Query = "Insert into FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,RLT_DIF_STAT,RLT_DIF_ACC,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID) values (new_oid,null,null,'1',null,null,'SUCCESSFUL','"+Message+"','CONCILIACION','"+FinsIdFund+"','ALERT_CON_SSI','"+Branch+"','ALTA','"+FinsIdGest+"','"+CodOid+"','"+Acronym+"','"+Access+"',sysdate,null,sysdate,'CARGA_FX_ALERTMIRR')";
QueryVREQ="Insert into FT_T_VREQ (VND_RQST_OID,VND_RQSTR_ID,VND_RQST_ACTION_TYP,VND_RQST_TMS,VND_RQST_TYP,DATA_SRC_ID,VND_RQST_XREF_TBL_TYP,VND_RQST_XREF_ID_CTXT_TYP,VND_RQST_XREF_ID,VND_RQST_STAT_TYP,VND_RQST_STAT_TXT,VND_RQST_CORR_ID,LAST_CHG_TMS,LAST_CHG_USR_ID,TRN_ID,USR_RQST_ID,PHYSICAL_RQST_IND,VENDOR_ID,VND_RQST_DATA_TYP,BASIC_VND_RQST_OID,VND_RESP_FILE_NME,MSG_CNT,VND_SRVC_NME,VND_CHAIN_RQST_IND,VND_RQST_FILE_NME,PRNT_VND_RQST_OID,VND_RESP_FILE_CORR_TXT,MSTP_OID,VRSC_OID,VENDOR_DATA_OID) values (new_oid,'"+Acronym+"','"+FinsIdGest+"',sysdate,'"+FinsIdFund+"','ALERT_CON_SSI',null,'"+Access+"','"+CodOid+"','SUCCESSFUL','"+Message+"',null,sysdate,'CARGA_FX_ALERTMIRR',null,null,'1',null,'CONCILIACION',null,'"+Branch+"',null,null,null,null,null,null,null,null,null)";



logger.error(Message );





</objectValue>
<type>CONSTANT</type>
</item>
