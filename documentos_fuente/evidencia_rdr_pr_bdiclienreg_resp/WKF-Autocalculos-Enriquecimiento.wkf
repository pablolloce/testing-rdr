<item id="624" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="625">statements</name>
<objectValue id="626" type="java.lang.String">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("Enriquecimiento ");

//logger.error("AUTOCALCULOS-ENRIQUECIMIENTO-:  "+ res[0].size());

CNAE = res[0].get("CNAE");
INST_TYP = res[0].get("INST_TYP");
VIP_CL_IND = res[0].get("VIP_CL_IND");
FOLIO_NUM = res[0].get("FOLIO_NUM");
ADDRESS = res[0].get("ADDRESS");
INST_CODE = res[0].get("INST_CODE");
ACT_1940  = res[0].get("ACT_1940");
PLAZA_FISC = res[0].get("PLAZA_FISC");
PROVI = res[0].get("PROVI");
COUNTRY = res[0].get("COUNTRY");
FXRELFUND = res[0].get("FXRELFUND");
CTM_FUND =res[0].get("CTM_FUND");

if("NO".equals(VIP_CL_IND)){
VIP_CL_IND = "N";
}else if("YES".equals(VIP_CL_IND)){
VIP_CL_IND = "Y";
}

if (INST_CODE.length() == 2) {
	INST_CODE ="00"+INST_CODE; 
}
if (INST_TYP.length() == 2) {
	INST_TYP ="00"+INST_TYP; 
}

//for(String key : res[0].keySet()){
	//int valor = res[0].size();
	//logger.error("AUTOCALCULOS-ENRIQUECIMIENTO-: CNAE  "+ CNAE);
//logger.error("AUTOCALCULOS-ENRIQUECIMIENTO-: INST_TYP "+ INST_TYP );
//logger.error("AUTOCALCULOS-ENRIQUECIMIENTO-: VIP_CL_IND "+ VIP_CL_IND );
//logger.error("AUTOCALCULOS-ENRIQUECIMIENTO-: FOLIO_NUM "+ FOLIO_NUM );
logger.error("AUTOCALCULOS-ENRIQUECIMIENTO-: ADDRESS "+ ADDRESS );
//logger.error("AUTOCALCULOS-ENRIQUECIMIENTO-: INST_CODE   "+ INST_CODE );
//logger.error("AUTOCALCULOS-ENRIQUECIMIENTO-: ACT_1940  "+ ACT_1940  );
logger.error("AUTOCALCULOS-ENRIQUECIMIENTO-: PLAZA_FISC "+ PLAZA_FISC );
logger.error("AUTOCALCULOS-ENRIQUECIMIENTO-: PROVI "+ PROVI );
logger.error("AUTOCALCULOS-ENRIQUECIMIENTO-: CTM_FUND "+ CTM_FUND );
//}</objectValue>
<type>CONSTANT</type>
</item>
