<stringValue id="34">hacerCalculoDR</stringValue>
<type>VARIABLE</type>
</item>
</parameters>
<sources id="35" type="java.util.HashSet">
<item id="36" type="com.j2fe.workflow.definition.Transition">
<name id="37">goto-next</name>
<source id="38">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="39">Corporate Relationship Calculation</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="40">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="41" type="java.util.HashSet">
<item id="42" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="43">statements</name>
<objectValue id="44" type="java.lang.String"><![CDATA[//Declaracion de variables
Map calculoCorprel = new HashMap();
String fundText = "";
String headText = "";
String corprelText = "";

if (fund != null && fund.length > 0)
{
	fundText = fund[0].get("FUND");
}else
{
	fundText = "NE";
}

if (head != null && head.length > 0)
{
	headText = head[0].get("HEAD");
}else
{
	headText = "NE";
}

if (corprel != null && corprel.length > 0)
{
	corprelText = corprel[0].get("CORPREL");
}else
{
	corprelText = "NE";
}


//Una vez inicializados los valores por si alguno de ellos no existiera en la contrapartida, se realiza el calculo del dato

switch (corprelText) 
{
	case "CMA":  
		
		//Se valida el campo Head Office Relationship
		if(headText.equals("S")) // Es Sucursal
		{	
			//Se valida el campo Fund Indicator
			if(fundText.equals("Y")) //Si es Fondo, el dato viene como SUC, viene mal informado y se actualiza
			{
				calculoCorprel.put("CORPREL","FIL");
			}else
			{
				calculoCorprel.put("CORPREL","SUC");
			}
		}

		//Si por el contrario la contrapartida es casa matriz, es correcto que se informe como CMA
		
		break;
		
	case "SUC":
	
		//Se valida el campo Head Office Relationship
		if(headText.equals("N")) // Es casa Matriz, el dato viene mal informado y se actualiza
		{
			calculoCorprel.put("CORPREL","CMA");
		}else
		{
			//Se valida el campo Fund Indicator
			if(fundText.equals("Y")) //Si es Fondo, el dato viene como SUC, viene mal informado y se actualiza
			{
				calculoCorprel.put("CORPREL","FIL");
			}
		}

		//Si la contrapartida es sucursal y no es fondo es correcto que lleve SUC
		
		break;

	case "FIL":

		//Se valida el campo Head Office Relationship
		if(headText.equals("Y")) // Es casa Matriz, el dato viene mal informado y se actualiza
		{
			//Se valida el campo Fund Indicator
			if(fundText.equals("N")) //Si no es Fondo, el dato viene mal informado y se actualiza
			{
				calculoCorprel.put("CORPREL","SUC");
			}
		}else
		{
			//Se valida el campo Fund Indicator
			if(fundText.equals("N")) //Si no es Fondo, el dato viene mal informado y se actualiza
			{
				calculoCorprel.put("CORPREL","CMA");
			}
		}
		
		break;
		
	case "CVR":
		
		//Para cualquier casuistica, el campo CVR informado por el usuario prevalece
		calculoCorprel.put("CORPREL","CVR");
		break;

	case "CON":
	
		//Se valida el campo Head Office Relationship
		if(headText.equals("S")) // Es Sucursal, el dato viene mal informado y se actualiza
		{
			//Se valida el campo Fund Indicator
			if(fundText.equals("N")) //Si no es Fondo, el dato viene mal informado y se actualiza
			{
				calculoCorprel.put("CORPREL","SUC");
			}
		}
		
		break;
		
	case "AFL":

		//Se valida el campo Head Office Relationship
		if(headText.equals("S")) // Es Sucursal, el dato viene mal informado y se actualiza
		{
			//Se valida el campo Fund Indicator
			if(fundText.equals("N")) //Si no es Fondo, el dato viene mal informado y se actualiza
			{
				calculoCorprel.put("CORPREL","SUC");
			}
		}
		
		break;

	case "SNU":
			//Siempre que el usuario informe el atributo SNU en el campo Corporate Relationship
			calculoCorprel.put("CORPREL","SNU");
		break;

	case "NE":

		//Se valida el Head Office Relationship
		if(headText.equals("S")) //Es Sucursal
		{
			//Se valida el indicador de Fondo
			if(fundText.equals("Y")) // Es Fondo
			{
				calculoCorprel.put("CORPREL","FIL");
			}else
			{
				calculoCorprel.put("CORPREL","SUC");
			}
		}else
		{
			//Se valida el indicador de Fondo
			if(fundText.equals("Y"))
			{
				calculoCorprel.put("CORPREL","FIL");
			}else
			{
				calculoCorprel.put("CORPREL","CMA");
			}
		}  
		break;
		
    default: //No viene informado el dato Corporate Relationship 
		
		//Se valida el Head Office Relationship
		if(headText.equals("S")) //Es Sucursal
		{
			//Se valida el indicador de Fondo
			if(fundText.equals("Y")) // Es Fondo
			{
				calculoCorprel.put("CORPREL","FIL");
			}else
			{
				calculoCorprel.put("CORPREL","SUC");
			}
		}else
		{
			//Se valida el indicador de Fondo
			if(fundText.equals("Y"))
			{
				calculoCorprel.put("CORPREL","FIL");
			}else
			{
				calculoCorprel.put("CORPREL","CMA");
			}
		}
		break;
}

if(calculoCorprel.isEmpty())
{
	calculoCorprel.put("CORPREL",corprelText);
}]]></objectValue>
<type>CONSTANT</type>
</item>
