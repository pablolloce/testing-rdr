<stringValue id="37"><![CDATA[import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("Calculate_EMIR_Category");


// Vemos el tipo de contrapartida que tenemos

String tipoREL_TYP = REL_TYP[0];
String tipoRFINSRL_TYP = FINSRL_TYP[0];

logger.error("tipoREL_TYP -  "+tipoREL_TYP);
logger.error("tipoRFINSRL_TYP -  "+tipoRFINSRL_TYP);

if(tipoREL_TYP .equals("GLOBAL") && tipoRFINSRL_TYP .equals("INDVDUAL")  ){
	return "OK";
}else{
	return "KO";
}


]]></stringValue>
<type>CONSTANT</type>
</item>
