<item id="747" type="com.j2fe.workflow.definition.Transition">
<name id="748">EXCEL</name>
<source idref="554"/>
<target id="749">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="750">Get attach EXCEL</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="751">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="752" type="java.util.HashSet">
<item id="753" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="754">statements</name>
<objectValue id="755" type="java.lang.String"><![CDATA[import java.util.regex.Matcher;
import java.util.regex.Pattern;
import org.apache.log4j.Logger;
import java.io.File;

Logger logger = Logger.getLogger("AlertasEnvio - Get attachment");

String nameFile ="";
String FileBody="";
	   FileMail="";
String directory = RUTA[0].get("RUTA");
Pattern pattern = Pattern.compile("\\$ENV");
Matcher matcher = pattern.matcher(directory);

directory  = matcher.replaceAll(env);
logger.error("[AlertasEnvio - Get attac EXCEL] directory: "+directory);

resultado = "KO";
enviar = "N";

String short_proc = SH_PROC[0].get("SHORT_PROCESS");
String auxAdjunto="";
String auxAdjunto2="";
String auxCuerpo="";

boolean existeAdjunto=false;
boolean existeCuerpo=false;

if(short_proc != null && short_proc.length() > 0){
	auxAdjunto  =SH_PROC[0].get("SHORT_PROCESS")+".xlsx";
	auxAdjunto2=SH_PROC[0].get("SHORT_PROCESS")+".xlsm";

	auxCuerpo = "BODY_" + SH_PROC[0].get("SHORT_PROCESS") + ".txt";
	try{
		File carpeta = new File(directory);
		if(carpeta.exists()){
			for (File fich : carpeta.listFiles()) {
				if (fich.isDirectory()==false) {
					if (fich.getName().equals(auxAdjunto)) {	
						if (fich.exists()){
							nameFile = fich.getName();
							FileMail = fich.toString();
							logger.error("[AlertasEnvio - Get attachment] nameFile: "+ nameFile);
							existeAdjunto=true;
						}
					}else if(fich.getName().equals(auxAdjunto2)) {
						if (fich.exists()){
							nameFile = fich.getName();
							FileMail = fich.toString();
							logger.error("[AlertasEnvio - Get attachment] nameFile: "+ nameFile);
							existeAdjunto=true;
						}
					}else if(fich.getName().equals(auxCuerpo)){
						if (fich.exists()){
							FileBody = fich.toString();
							existeCuerpo=true;
						}
					}
				}
			}
		}else{
			resultado = "KO";
		}
	}catch(Exception e){
		resultado = "KO";
	}
} else {
	resultado = "KO";
}
if(existeCuerpo){
	File archivo = null;
	FileReader fr = null;
	BufferedReader br = null;
	txtBody ="";
	try {
		archivo = new File (FileBody);
		fr = new FileReader (archivo);
		br = new BufferedReader(fr);
		// Lectura del fichero
		String linea="";
		while((linea=br.readLine())!=null){
			txtBody += linea+"\r\n";
		}
		resultado = "OK";
		enviar = "S";
	}catch(Exception e){
		    logger.error("[AlertasEnvio - Reading Body] error:"+ e.toString());
			enviar="N";
	}finally{
		try{                    
			if( null != fr ){   
		       	fr.close();     
		       }                  
		}catch (Exception e2){ 
		       e2.printStackTrace();
		}
	}
}
]]></objectValue>
<type>CONSTANT</type>
</item>
