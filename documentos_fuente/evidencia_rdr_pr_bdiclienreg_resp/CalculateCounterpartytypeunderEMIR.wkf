<name id="217">statements</name>
<stringValue id="218"><![CDATA[if (calculoEMIR != null && finentem != null && finentem.length > 0) 
{
	//Control de estado de la extracciÃ³n del European Person Indicator
	if(finentem[0].get("ESTADO").equals("ACTIVE"))
	{
		if(calculoEMIR.get("ETIQUETA").equals(finentem[0].get("VALOR")))
		{
			update = true;
			return "out";
		}else
		{
			update = true;
			return true;
		}
	}else
	{
		//El dato se encuentra inactivo y se tiene que actualizar con el dato calculado y el status reactivado
		return "reactivar";
	}

}else
{
	update = false;
	return false;
	
}]]></stringValue>
<type>CONSTANT</type>
</item>
