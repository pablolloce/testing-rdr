<item id="391" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="392">statements</name>
<stringValue id="393"><![CDATA[//import org.apache.log4j.Logger;
//Logger logger = Logger.getLogger("Enriquecimiento");

String query = "Insert into FT_T_FRCL (FINR_CLSF_OID,INST_MNEM,FINSRL_TYP,INDUS_CL_SET_ID,CLSF_OID,CL_VALUE,CLSF_PURP_TYP,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID,DATA_STAT_TYP,DATA_SRC_ID,EINC_OID, FINR_OID) \r\n" + 
				"values (new_oid,'"+mnemOperativo+"','CPARTY','CNAE',(select clsf_oid from ft_t_incl where cl_value = '"+CNAE+"' and data_stat_typ = 'ACTIVE'  AND INDUS_CL_SET_ID = 'CNAE'),'"+CNAE+"',null,sysdate,null,sysdate,'RDR','ACTIVE','BDI',null, (SELECT FINR_OID FROM FT_T_FINR WHERE DATA_STAT_TYP = 'ACTIVE' AND FINSRL_TYP = 'CPARTY' AND INST_MNEM = '"+mnemOperativo+"' AND ROWNUM < 2))\r\n";
		
		

//logger.error("CNAE query: "+ query);
]]></stringValue>
<type>CONSTANT</type>
</item>
