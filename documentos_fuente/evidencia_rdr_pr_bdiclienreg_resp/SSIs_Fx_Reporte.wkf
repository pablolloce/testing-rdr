<name id="193">Modo</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="194">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="195" type="java.util.HashSet">
<item id="196" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="197">statements</name>
<stringValue id="198">// SelecciÃ³n de modo para el reporte.
if(Modo.equals("Trans")){return "trans";}
else if(Modo.equals("Valida")) {return "valida";}
else if(Modo.equals("Branch")) {return "branch";}
else if(Modo.equals("Alta")) {return "alta";}
else if(Modo.equals("KO")) {return "KO";}
else if(Modo.equals("Cparty")) {return "Cpty";}
else {return "ERROR";}</stringValue>
<type>CONSTANT</type>
</item>
<item id="199" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="200">["Modo"]@java/lang/String@</UITypeHint>
<input>true</input>
<name id="201">variables["Modo"]</name>
<stringValue id="202">Donde</stringValue>
<type>VARIABLE</type>
</item>
</parameters>
<sources id="203" type="java.util.HashSet">
<item idref="190"/>
</sources>
<targets id="204" type="java.util.HashSet">
<item id="205" type="com.j2fe.workflow.definition.Transition">
<name id="206">Cpty</name>
<source idref="192"/>
<target id="207">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="208">Prepare Query CPTY</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="209">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="210" type="java.util.HashSet">
<item id="211" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="212">statements</name>
<objectValue id="213" type="java.lang.String">import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("SSIs_Fx_Reporte");

String Data = "";
String Data2="";
if(Modo.equals("Conciliacion")){
	Data="ALERT_CON_SSI";
	Data2 = "CONCILIACION";
}else{
	Data="ALERT_IP_SSI";
	Data2="ONLINE";
}


Message = "El Acronimo "+Acronym+" y el Access Code "+Access+" estan dados de alta en mas de una contrapartida que opera con FX en RDR";
Query = "Insert into FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,RLT_DIF_STAT,RLT_DIF_ACC,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID) values (new_oid,null,null,'1',null,null,'FAILED','"+Message+"','"+Data2+"',null,'"+Data+"',null,'ALTA',null,'"+CodOid+"','"+Acronym+"','"+Access+"',sysdate,null,sysdate,'CARGA_FX_ALERTMIRR')";

QueryVREQ="Insert into FT_T_VREQ (VND_RQST_OID,VND_RQSTR_ID,VND_RQST_ACTION_TYP,VND_RQST_TMS,VND_RQST_TYP,DATA_SRC_ID,VND_RQST_XREF_TBL_TYP,VND_RQST_XREF_ID_CTXT_TYP,VND_RQST_XREF_ID,VND_RQST_STAT_TYP,VND_RQST_STAT_TXT,VND_RQST_CORR_ID,LAST_CHG_TMS,LAST_CHG_USR_ID,TRN_ID,USR_RQST_ID,PHYSICAL_RQST_IND,VENDOR_ID,VND_RQST_DATA_TYP,BASIC_VND_RQST_OID,VND_RESP_FILE_NME,MSG_CNT,VND_SRVC_NME,VND_CHAIN_RQST_IND,VND_RQST_FILE_NME,PRNT_VND_RQST_OID,VND_RESP_FILE_CORR_TXT,MSTP_OID,VRSC_OID,VENDOR_DATA_OID) values (new_oid,'"+Acronym+"',null,sysdate,null,'"+Data+"',null,'"+Access+"','"+CodOid+"','FAILED','"+Message+"',null,sysdate,'CARGA_FX_ALERTMIRR',null,null,'1',null,'"+Data2+"',null,null,null,null,null,null,null,null,null,null,null)";

logger.error(Message);
</objectValue>
<type>CONSTANT</type>
</item>
