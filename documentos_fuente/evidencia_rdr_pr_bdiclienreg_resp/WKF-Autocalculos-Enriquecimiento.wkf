<item id="597" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="598">statements</name>
<stringValue id="599">//import org.apache.log4j.Logger;
//Logger logger = Logger.getLogger("Enriquecimiento");

String query = "INSERT INTO FT_T_FIST (STAT_ID, STAT_DEF_ID, INST_MNEM, START_TMS, LAST_CHG_TMS, LAST_CHG_USR_ID, STAT_VAL_TMS, STAT_CHAR_VAL_TXT, DATA_STAT_TYP, DATA_SRC_ID) VALUES ((SELECT NEW_OID FROM DUAL), 'CTMONB', '"+mnemLocal+"', SYSDATE, SYSDATE, 'RDR' ,SYSDATE, 'Y', 'ACTIVE', 'RDR')\r\n";
</stringValue>
<type>CONSTANT</type>
</item>
