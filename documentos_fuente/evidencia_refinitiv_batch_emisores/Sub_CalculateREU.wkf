where issr.instr_issr_id = irst.instr_issr_id 
and irst.stat_def_id = 'SOURCE  ' 
and irst.stat_char_val_txt = 'Bloomberg' 
and irst.data_stat_typ = 'ACTIVE' 
and issr.finsrl_typ = 'ISSUER  ' 
and issr.data_stat_typ = 'ACTIVE'
and issr.inst_mnem = ?</stringValue>
