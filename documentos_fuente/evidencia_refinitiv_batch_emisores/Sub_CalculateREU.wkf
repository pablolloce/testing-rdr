<parameters id="207" type="java.util.HashSet">
<item id="208" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="209">statements</name>
<objectValue id="210" type="java.lang.String"><![CDATA[String SPOid = "";
String FitchOid = "";
String MoodysOid = "";
String REUOid = "";
String REUSPOid = "";
String REUFitchOid = "";
String REUMoodysOid = "";

String literalSP = "S&P Long Term";
String literalMoodys = "Moody's Long Term";
String literalFitch = "Fitch Long Term";
String literalREU = "External Unified Rating";
String literalREUSP = "REU S&P Long Term";
String literalREUMoodys = "REU Moody's Long Term";
String literalREUFitch = "REU Fitch Long Term";

if ( rtngSetOidArray[0][0]  != null && !"".equals(rtngSetOidArray[0][0]) && literalREU.equals(rtngSetOidArray[0][0]) ){
	REUOid = rtngSetOidArray[0][1];
} else {
	REUOid = "";
}

if ( rtngSetOidArray[1][0]  != null && !"".equals(rtngSetOidArray[1][0]) && literalFitch.equals(rtngSetOidArray[1][0]) ){
	FitchOid = rtngSetOidArray[1][1];
} else {
	FitchOid = "";
}

if ( rtngSetOidArray[2][0]  != null && !"".equals(rtngSetOidArray[2][0]) && literalMoodys.equals(rtngSetOidArray[2][0]) ){
	MoodysOid = rtngSetOidArray[2][1];
} else {
	MoodysOid = "";
}

if ( rtngSetOidArray[3][0]  != null && !"".equals(rtngSetOidArray[3][0]) && literalREUFitch.equals(rtngSetOidArray[3][0]) ){
	REUFitchOid = rtngSetOidArray[3][1];
} else {
	REUFitchOid = "";
}

if ( rtngSetOidArray[4][0]  != null && !"".equals(rtngSetOidArray[4][0]) && literalREUMoodys.equals(rtngSetOidArray[4][0]) ){
	REUMoodysOid = rtngSetOidArray[4][1];
} else {
	REUMoodysOid = "";
}

if ( rtngSetOidArray[5][0]  != null && !"".equals(rtngSetOidArray[5][0]) && literalREUSP.equals(rtngSetOidArray[5][0]) ){
	REUSPOid = rtngSetOidArray[5][1];
} else {
	REUSPOid = "";
}

if ( rtngSetOidArray[6][0]  != null && !"".equals(rtngSetOidArray[6][0]) && literalSP.equals(rtngSetOidArray[6][0]) ){
	SPOid = rtngSetOidArray[6][1];
} else {
	SPOid = "";
}
]]></objectValue>
<type>CONSTANT</type>
</item>
