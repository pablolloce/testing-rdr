<item id="245" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="246">statements</name>
<objectValue id="247" type="java.lang.String">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("SSIs_Fx_Peticion");
logger.error(" - Process Started: ONLINE SSIs");

int errors=0;
String Resultado="OK";
Map RES = new HashMap();
boolean MIS=false;

RES.put("Result"," "); 								// Resultado: NACK / ACK 
RES.put("ReqID"," ");							       // ReqID
RES.put("ErrorID"," ");								// Codigo de Error
RES.put("AccUsu","0000");							// Accion Usuario
RES.put("Message"," ");								// Mensaje de Error
RES.put("MessageG"," ");							// Mensaje de Error
RES.put("Reg","Online SSIs Setup");					// Servicio de alta, ej: Online SI Setup
RES.put("SysVal", new_oid_VREQ);					// Codigo AlertID - Se inserta el Mnem de inserciÃƒÂ³n en la VREQ
RES.put("Acronym","Acronym");					// Acronym
RES.put("AccessCode","AccessCode");				// Access Code
RES.put("OrigCountry","0");							// Pais de la instruccion de liquidacion
RES.put("Securities"," ");							// Parametro de la instruccion de liquidacion que viene en el alta
RES.put("Method"," ");								// Metodo de la instruccion de liquidacion
RES.put("PSET"," ");									// Pset del matcheo de la instruccion de liquidacion
RES.put("RDRDataCtxtIdTyp","SISETUP");			// SISETUP
RES.put("DestSysDataCtxtIdTyp","ALERTID");		// ALERT_ID
RES.put("Source","ALERT");							// Alert Mirror
RES.put("MNEM"," ");								// ssi_oid de la tabla FT_T_SSIS de la si insertada
RES.put("TransID"," ");								// Codigo de transaccion realizada (MDX)
RES.put("JobID", JobID);								// Job del proceso entero
RES.put("CanVal_A"," ");							// Canonico de la instruccion de liquidacion realizada
RES.put("Module","SSIs_Fx_Peticion");				// Modulo en el que se ha producido Error


</objectValue>
<type>CONSTANT</type>
</item>
