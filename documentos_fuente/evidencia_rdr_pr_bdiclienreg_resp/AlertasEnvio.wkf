<input>true</input>
<name id="620">mappedParameters["02"]</name>
<stringValue id="621">MAIL</stringValue>
<type>VARIABLE</type>
<variablePart id="622">["DIRECCION"]</variablePart>
</item>
<item id="623" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="624">["03"]@java/lang/String@</UITypeHint>
<input>true</input>
<name id="625">mappedParameters["03"]</name>
<stringValue id="626">TIPO_ENVIO</stringValue>
<type>VARIABLE</type>
<variablePart id="627">["TIPO_ENVIO"]</variablePart>
</item>
<item id="628" type="com.j2fe.workflow.definition.Parameter">
<input>false</input>
<name id="629">mappedResult</name>
<stringValue id="630">DAYSLASTSEND</stringValue>
<type>VARIABLE</type>
</item>
<item id="631" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="632">querySQL</name>
<stringValue id="633">SELECT TO_CHAR(TRUNC(SYSDATE) - TRUNC(NVL(ALR1.LAST_SEND_TMS, TO_DATE('19700101', 'YYYYMMDD')))) AS DAYSLASTSEND
  FROM FT_T_ALU1 ALU1  
  JOIN FT_T_ALR1 ALR1 
    ON ALU1.ALU1_OID = ALR1.ALU1_OID 
  JOIN FT_T_ALM1 ALM1 
    ON ALM1.ALM1_OID = ALR1.ALM1_OID 
 WHERE ALU1.DATA_STAT_TYP = 'ACTIVE' 
   AND ALR1.DATA_STAT_TYP = 'ACTIVE' 
   AND ALM1.DATA_STAT_TYP = 'ACTIVE' 
   AND ALM1.MEDIO_ENVIO = 'EMAIL'
   AND ALR1.PROCESO=? 
   AND ALM1.DIRECCION = ? 
   AND ALR1.TIPO_ENVIO = ?
 GROUP BY (TRUNC(SYSDATE) - TRUNC(NVL(ALR1.LAST_SEND_TMS, TO_DATE('19700101', 'YYYYMMDD'))))
 ORDER BY  (TRUNC(SYSDATE) - TRUNC(NVL(ALR1.LAST_SEND_TMS, TO_DATE('19700101', 'YYYYMMDD')))) DESC</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
