<item id="216" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="217">querySQL</name>
<stringValue id="218">SELECT DISTINCT FIGU.inst_mnem
FROM ft_t_FIGU FIGU,
  FT_T_FINS FINS,
  FT_T_GUNT GUNT,
  FT_T_GUGR GUGR,
  FT_T_GUGP GUGP,
  FT_T_FIRL FIRLL,
  FT_T_FIRL FIRLO
WHERE FIGU.fins_gu_purp_typ = 'RESID_CO'
AND FIGU.DATA_STAT_TYP = 'ACTIVE'
AND FIGU.GUNT_OID = GUNT.GUNT_OID
AND GUNT.GUNT_OID = GUGP.GUNT_OID
AND GUNT.prnt_gu_typ = 'COUNTRY'
AND GUNT.DATA_STAT_TYP  = 'ACTIVE'
AND GUGP.PRNT_GU_GRP_OID = GUGR.GU_GRP_OID
AND GUGP.DATA_STAT_TYP  = 'ACTIVE'
AND GUGR.GRP_PURP_TYP = 'EMIRREGU'
AND GUGR.DATA_STAT_TYP = 'ACTIVE'
AND FIGU.inst_mnem = fins.inst_mnem
AND FINS.DATA_STAT_TYP != 'INACTIVE'
AND FINS.subsidiary_ind='N'
AND FIGU.inst_mnem = FIRLO.INST_MNEM
AND FIRLL.PRNT_INST_MNEM = :cntrprtyGlobalOid
AND FIRLL.DATA_STAT_TYP = 'ACTIVE'
and FIRLO.PRNT_INST_MNEM = FIRLL.INST_MNEM
and FIRLO.DATA_STAT_TYP != 'INACTIVE'
and FIRLO.rel_typ='OPERATIVE'</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
