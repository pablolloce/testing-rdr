<name id="3581">statements</name>
<stringValue id="3582"><![CDATA[import org.apache.commons.lang.StringUtils;

String SPRtngCode = "";
String SPGradoRtngCode = "";



if ( intSPRatingArray > 0 && SPRatingArray[0][0]  != null && !"".equals(SPRatingArray[0][0]) ){
	SPRtngCode = SPRatingArray[0][0];
} else {
	SPRtngCode = "No disp.";
}

if ( intSPRatingArray > 0 && SPRatingArray[0][1]  != null && !"".equals(SPRatingArray[0][1]) ){
	SPGradoRtngCode = String.valueOf(SPRatingArray[0][1]);
} else {
	SPGradoRtngCode = "99";
}]]></stringValue>
<type>CONSTANT</type>
</item>
