<parameters id="239" type="java.util.HashSet">
<item id="240" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="241">statements</name>
<objectValue id="242" type="java.lang.String">import org.apache.log4j.Logger;
import java.io.*;
import java.sql.*;
import java.util.regex.*;

Logger logger = Logger.getLogger("Calculate Final type under EMIR");
Connection dbConnection = null;
Statement statement = null;
String RowCount = "0";

String DB_DRIVER = "oracle.jdbc.driver.OracleDriver";
String DB_CONNECTION = urldb;
String DB_USER = userdb;
String DB_PASSWORD = passdb;

try {
    String insertSQL =
 "INSERT INTO FT_T_FRA1 (FRA1_OID, INST_MNEM,REG1_OID,CLSF_OID,CL_VALUE,LAST_CHG_TMS,LAST_CHG_USR_ID,DATA_SRC_ID,DATA_STAT_TYP,START_TMS,ORG_ID) " +
 "values (new_oid,'" + var1 + "', " +
 "(SELECT REG1_OID FROM REGULATORY_INFO WHERE DATA_STAT_TYP = 'ACTIVE' AND END_TMS IS NULL AND REG_NME = 'SFTR'), " +
 "(SELECT CLSF_OID FROM FT_T_INCL WHERE DATA_STAT_TYP = 'ACTIVE' AND END_TMS IS NULL AND CL_VALUE = '02' AND INDUS_CL_SET_ID = 'SFTRREPDEL'), " +
 "'02',sysdate,'BBVA:CUSTOMER','RDR','ACTIVE',sysdate,'0182')";

    Class.forName(DB_DRIVER);
    dbConnection = DriverManager.getConnection(DB_CONNECTION, DB_USER, DB_PASSWORD);
    statement = dbConnection.createStatement();

    int rows = statement.executeUpdate(insertSQL);
    RowCount = String.valueOf(rows);

} catch (SQLException e) {
    logger.error("*** Insercion JAVA SQL errorCode=" + e.getErrorCode() + " msg=" + e.getMessage());
    RowCount = "0";
} finally {
    if (statement != null) statement.close();
    if (dbConnection != null) dbConnection.close();
}</objectValue>
<type>CONSTANT</type>
</item>
