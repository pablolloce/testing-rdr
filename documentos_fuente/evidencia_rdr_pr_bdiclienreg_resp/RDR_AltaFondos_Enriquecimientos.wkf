<item id="98" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="99">querySQL</name>
<stringValue id="100">SELECT b.VND_RQST_OID,                                                                         
       c.UTD_ID AS INST_MNEM
  FROM FT_T_VREQ a                                                                             
  JOIN FT_T_VREQ b                                                                             
    ON a.VND_RQST_OID = b.BASIC_VND_RQST_OID                                                   
   AND b.VND_RQST_XREF_ID_CTXT_TYP = 'FundLEI'                                                 
   AND b.VND_RQST_STAT_TYP = 'FUND_LOADED' 
  JOIN FT_T_UTD1 c
    ON c.UTD_EXT_ID = b.VND_RQST_OID
   AND c.UTD_USAGE_TYP = 'FIELD'
   AND c.UTD_ID_PURP_TYP = 'MNEM_OPE'
 WHERE a.VND_RQST_XREF_ID_CTXT_TYP = 'FILE_DATE'                                               
   AND a.VND_RQST_STAT_TYP = 'FONDOS_CUADRE_OK'</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
