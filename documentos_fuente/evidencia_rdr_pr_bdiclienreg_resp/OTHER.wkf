<name id="158">Generar INSERT</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="159">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="160" type="java.util.HashSet">
<item id="161" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="162">statements</name>
<stringValue id="163">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("XMLReader");

String insercion="";
String cad_mostrar="Existe otra contrapartida con el mismo Legal Name";

String aux_LegalName="";

if(LegalName.length()>20){
	aux_LegalName=LegalName.substring(0, 20);
}else{
	aux_LegalName=LegalName;
}


 insercion = "insert into FT_T_RLT1 (RLT_OID, JOB_ID, TRN_ID, RECORD_SEQ_NUM, RLT_STATUS, RLT_DIF_STAT, RLT_DIF_ACC, MESSAGE_RLT, RLT_FIELD, RLT_PURP_TYP, DATA_SRC_APP, SRC_FIELD, SRC_VALUE, GS_FIELD, GS_VALUE, MAIN_ENTITY_NME, MAIN_ENTITY_ID, START_TMS, END_TMS, LAST_CHG_TMS, LAST_CHG_USR_ID) select '"+aux_new_oid+"', '"+JobId +"', null, null , 0, null, null ,'"+cad_mostrar +"', null, 'NACK', 'CARGA_CPARTY', null, null, null, null, 'Legal Name',q'$"+ aux_LegalName +"$', systimestamp, null, systimestamp, '" + User + "' from dual";

logger.error("*** INSERT RLT1 OTHER CPTY Existe LegalName: "+insercion );

errors++;</stringValue>
<type>CONSTANT</type>
</item>
