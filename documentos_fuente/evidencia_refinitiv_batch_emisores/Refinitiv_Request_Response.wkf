<name id="478">Read Ratings line to map</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="479">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="480" type="java.util.HashSet">
<item id="481" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="482">statements</name>
<stringValue id="483"><![CDATA[import java.util.HashMap;
import java.util.LinkedHashMap;
import java.util.Map;

Map fieldsMap = new LinkedHashMap();

String[] fieldsArray = fieldsList.split(",");
String[] lineArray = fileLine.split("\\|");
int fieldCounter = 0;
//declaramos mapa vacio
for (String field : fieldsArray) {
	fieldsMap.put(field,"");
}

for (String field : fieldsArray) {
	if (fieldCounter < lineArray.length){
		fieldsMap.put(field,lineArray[fieldCounter]);
	}
	fieldCounter++;
}]]></stringValue>
<type>CONSTANT</type>
