<stringValue id="384">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("SSIs_FX_Peticion");

String query= "select FINR_ID FROM FT_T_FRID where TRIM(FINSRL_ID_CTXT_TYP) = 'ACCDE' AND INST_MNEM = q'#"+ UTD_ID.get("UTD_ID") +"#' AND DATA_STAT_TYP = 'ACTIVE' AND END_TMS IS NULL";

logger.error(query);
</stringValue>
