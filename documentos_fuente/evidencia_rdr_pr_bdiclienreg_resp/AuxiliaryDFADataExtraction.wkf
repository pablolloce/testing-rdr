<name id="25">Transaction Information</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="26">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="27" type="java.util.HashSet">
<item id="28" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="29">statements</name>
<objectValue id="30" type="java.lang.String"><![CDATA[//DeclaraciÃ³n de variables
Map valores = new HashMap();
Map lolo=new HashMap();

String [] etiquetas = new String [5];

etiquetas[0] = "MAIN_ENTITY_ID";
etiquetas[1] = "MAIN_ENTITY_ID_CTXT_TYP";
etiquetas[2] = "MAIN_ENTITY_NME";
etiquetas[3] = "MAIN_ENTITY_TYP";
etiquetas[4] = "MAIN_ENTITY_TBL_TYP";

if(rolin != null && rolin.length > 0)
{
	if(globalData != null && globalData.length > 0)
	{
		globalData[0].put("ROLIN",rolin[0].get("ROLIN"));
	}else
	{
		globalData = new Map[1];
		lolo.put("ROLIN",rolin[0].get("ROLIN"));
		//globalData[0] = new HashMap("ROLIN",rolin[0].get("ROLIN"));
		globalData[0] = lolo;
	}
}else
{
	if(globalData != null && globalData.length > 0)
	{
		globalData[0].put("ROLIN"," ");
	}else
	{
		globalData = new Map[1];
		lolo.put("ROLIN"," ");
		globalData[0] = lolo;
	}
	
}


valores.put (etiquetas[0], ((residenceCountry != null && residenceCountry.length > 0) ? residenceCountry[0].get("RESIDCO"): "No Existe") + ";" + ((guaranteCountry != null && guaranteCountry.length > 0) ? guaranteCountry[0].get("COUNGUAR"): "No Existe") + ";" + ((globalData != null && globalData.length > 0) ? globalData[0].get("ROLIN"): "No Existe") + ";" + ((globalData != null && globalData.length > 0) ? globalData[0].get("USPERSON"): "No Existe") + ";" + ((globalData != null && globalData.length > 0) ? globalData[0].get("USPERSON"): "No Existe")+ ";" + ((head != null && head.length > 0) ? head[0].get("HEAD"): "No Existe")
+ ";" + ((continente != null && continente.length > 0) ? continente[0].get("CONTINENTE"): "No Existe"));
valores.put (etiquetas[1],"ORI-" + cntrprtyOperativeOid);
valores.put (etiquetas[2],"Extraccion de Datos Auxiliares para DFA(PaÃ­ses (Residencia, GarantÃ­a), Ctpda Role en CFTC, US Person Indicator, Head Office Relationship, Geografia)");
valores.put (etiquetas[3],"FINENTDF");
valores.put (etiquetas[4],"FRA1");]]></objectValue>
<type>CONSTANT</type>
</item>
