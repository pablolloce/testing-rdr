<input>true</input>
<name id="510">querySQL</name>
<stringValue id="511">INSERT INTO FT_T_FRA1 (FRA1_OID, INST_MNEM,REG1_OID,CLSF_OID,CL_VALUE,LAST_CHG_TMS,LAST_CHG_USR_ID,DATA_SRC_ID,DATA_STAT_TYP,START_TMS,ORG_ID)  
values (new_oid,?, 
(SELECT REG1_OID FROM REGULATORY_INFO WHERE DATA_STAT_TYP = 'ACTIVE' AND END_TMS IS NULL AND REG_NME = 'SFTR'), 
(SELECT CLSF_OID FROM FT_T_INCL WHERE DATA_STAT_TYP = 'ACTIVE' AND END_TMS IS NULL AND CL_VALUE = ? AND INDUS_CL_SET_ID = 'SFTRREPDEL'), 
?,sysdate,'BBVA:CUSTOMER','RDR','ACTIVE',sysdate,'0182')</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
