<source id="78">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="79">Componer mapa de Datos Regulatorios</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="80">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="81" type="java.util.HashSet">
<item id="82" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="83">statements</name>
<objectValue id="84" type="java.lang.String"><![CDATA[import org.apache.commons.lang.StringUtils;

//Declaracion de variables
Map regulatoryGlobalData = new HashMap();
String manEmir = "";
String emir = "";
String finalEmir = "";

// Data from European Person Indicator
if (europeanPersonData != null && europeanPersonData.length > 0) 
{
	//Se asocia el dato European Person Indicator al mapa regulatoryGlobalData
	regulatoryGlobalData.put("WE-COD-USINDEM", europeanPersonData[0].get("USINDEM"));
}else
{
	regulatoryGlobalData.put("WE-COD-USINDEM", "N");
}

// Manual Counterparty type under EMIR
if (manualEmir != null && manualEmir.length > 0) 
{
	manEmir = manualEmir[0].get("VALOR");
	regulatoryGlobalData.put("WE-COD-SBTIPCTP", manEmir);

}else
{
	manEmir = "NE";
}

if(!manEmir.equals("NE"))
{
	finalEmir = manEmir;

}else if (!emir.equals("NE"))
{
	finalEmir = emir;
}else
{
	finalEmir = "NE";
}

if (!finalEmir.equals("NE")) 
{
	//Se asocia el dato Final Counterparty type under EMIR al mapa regulatoryGlobalData
	regulatoryGlobalData.put("WE-COD-ROLEQSEM", finalEmir);
}else
{
	regulatoryGlobalData.put("WE-COD-ROLEQSEM", " ");
}

//Se rellena la variable regulatoryGlobalData con los atributos contenidos en los mapas cftcMap y secMap que contienen roles de la contrapartida en el mercado segun distintos ambitos

if(!cftcMap.isEmpty())
{
	regulatoryGlobalData.put("WE-COD-ROLCR",cftcMap.get("WE-COD-ROLCR"));
	regulatoryGlobalData.put("WE-COD-ROLIN",cftcMap.get("WE-COD-ROLIN"));
	regulatoryGlobalData.put("WE-COD-ROLFX",cftcMap.get("WE-COD-ROLFX"));
	regulatoryGlobalData.put("WE-COD-ROLCO",cftcMap.get("WE-COD-ROLCO"));
	regulatoryGlobalData.put("WE-COD-ROLEQ",cftcMap.get("WE-COD-ROLEQ"));
}

if(!secMap.isEmpty())
{
	regulatoryGlobalData.put("WE-COD-ROLCRSEC",secMap.get("WE-COD-ROLCRSEC"));
	regulatoryGlobalData.put("WE-COD-ROLEQSEC",secMap.get("WE-COD-ROLEQSEC"));
}

]]></objectValue>
<type>CONSTANT</type>
</item>
