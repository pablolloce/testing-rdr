<item id="376" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="377">statements</name>
<stringValue id="378"><![CDATA[import java.util.ArrayList;
import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("SSIs_Fx_Alta");
logger.error("Numero de Branchs totales en el mensaje: "+BranchAux.length);

Map MAP_Branchs = new HashMap();

String Branch="";
for(int i =0;i<BranchAux.length;i++){
	Branch=BranchAux[i].get("ORG_ID");
	MAP_Branchs.put(i,Branch);
}
CountBranchMax = BranchAux.length;

if(BranchAux.length==0){
	return "KO";
}else{
	return "OK";
}]]></stringValue>
<type>CONSTANT</type>
</item>
