<item id="398" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="399">querySQL</name>
<objectValue id="400" type="java.lang.String">Insert into FT_T_FRID (FRID_OID,INST_MNEM,FINSRL_TYP,FINSRL_ID_CTXT_TYP,MKT_OID,FINR_ID,START_TMS,END_TMS,
LAST_CHG_TMS,LAST_CHG_USR_ID,DATA_STAT_TYP,DATA_SRC_ID,GU_ID,GU_TYP,GU_CNT,MERGE_UNIQ_OID,FINR_CROSS_REF_ID,FINR_OID) 
select NEW_OID,:mnem,(SELECT RPAD(STAT_CHAR_VAL_TXT,8)
                                                                        FROM FT_T_FIST 
                                                                        WHERE STAT_DEF_ID = 'MAINROL'
                                                                        AND INST_MNEM = :mnem),'SHTNMEID',null,:shortname,sysdate,null,
sysdate,'BBVA:CUSTOMER','ACTIVE','RDR',null,null,null,null,NEW_OID,
(SELECT FINR.FINR_OID
FROM FT_T_FINR FINR, FT_T_FIST FIST 
WHERE FINR.FINSRL_TYP = RPAD(STAT_CHAR_VAL_TXT,8) 
AND FINR.INST_MNEM = FIST.INST_MNEM 
AND FINR.INST_MNEM = :mnem 
AND FIST.STAT_DEF_ID = 'MAINROL' )
from dual where not exists (select * from ft_t_frid where finsrl_id_ctxt_typ = 'SHTNMEID'
and data_stat_typ = 'ACTIVE' and inst_mnem = :mnem) 
and exists (select * from ft_t_fins
where inst_mnem = :mnem and data_stat_typ != 'INACTIVE')</objectValue>
<type>CONSTANT</type>
</item>
