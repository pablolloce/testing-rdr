<parameters id="382" type="java.util.HashSet">
<item id="383" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="384">statements</name>
<stringValue id="385"><![CDATA[import org.apache.log4j.Logger;

Logger logger = Logger.getLogger("AlertasEnvio - Validate mail");

boolean destinationOK = false;
boolean subjectOK = false;
boolean bodyOK = false;
boolean enviarOK = false;

// Mirar destinatarios
if (destination != null && !destination.isEmpty())
{
   destinationOK = true;
}

// Mirar asunto
if (subject != null && !subject.isEmpty())
{
 subjectOK = true;
}
else
{
 subjectOK = false;
}

// Mirar cuerpo
if (body != null && !body.isEmpty())
{
 bodyOK = true;
}
else
{
 bodyOK = false;
}

//Mirar envio
if (enviar != null && enviar.equals("S")){
	enviarOK=true;
}else{
	enviarOK=false;
}

logger.error("Destination OK : " + destinationOK); 
logger.error("Subject OK : " + subjectOK);
logger.error("Body OK : " + mailOK);

if (destinationOK && subjectOK && bodyOK && enviarOK)
{
 validaemail = "OK";
 return "OK";
}
else
{
 validaemail = "KO";
 return "KO";
}]]></stringValue>
<type>CONSTANT</type>
</item>
