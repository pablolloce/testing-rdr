<item id="369" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="370">querySQL</name>
<stringValue id="371">SELECT DECODE(COUNT(*),'0','1145', '0182') ENTOWN
FROM FT_T_EERL EERL, FT_T_ENFR ENFR
WHERE ENFR.FINR_INST_MNEM IN (SELECT INST_MNEM FROM FT_T_FIRL
                                WHERE PRNT_INST_MNEM IN (SELECT INST_MNEM FROM
                                                      FT_T_FIRL WHERE PRNT_INST_MNEM = :cntrprtyGlobalOid))
AND ENFR.ORG_ID = EERL.ORG_ID
AND EERL.RL_TYP = 'BRANCH'
AND ENFR.FINSRL_TYP = 'CPARTY  '
AND ENFR.ENFR_RL_TYP = 'OPE_BRANCH'
AND ENFR.DATA_STAT_TYP = 'ACTIVE'
AND EERL.PRNT_ORG_ID = '0182'</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
