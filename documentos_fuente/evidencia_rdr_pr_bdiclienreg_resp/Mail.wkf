<source id="45">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="46">HOST - USER</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="47">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="48" type="java.util.HashSet">
<item id="49" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="50">statements</name>
<objectValue id="51" type="java.lang.String"><![CDATA[import org.apache.log4j.Logger;
import java.io.File;
import java.util.ArrayList;
import java.util.Map;
import javax.xml.parsers.DocumentBuilder;
import javax.xml.parsers.DocumentBuilderFactory;
import javax.xml.xpath.XPath;
import javax.xml.xpath.XPathConstants;
import javax.xml.xpath.XPathExpression;
import javax.xml.xpath.XPathFactory;

import org.w3c.dom.Document;
import org.w3c.dom.Element;
import org.w3c.dom.Node;
import org.w3c.dom.NodeList;

Logger logger = Logger.getLogger("Mail");

String ENV="";

File folderpro = new File("/pr/kytl/online/multipais/multicanal/cfg/entorno/");
File folderpre = new File("/pp/kytl/online/multipais/multicanal/cfg/entorno/");
File folderint = new File("/ei/kytl/online/multipais/multicanal/cfg/entorno/");
File folderdev = new File("/de/kytl/online/multipais/multicanal/cfg/entorno/");

if (folderpro.exists()){		ENV="pr";	}
else if (folderpre.exists()){	ENV="pp";	}
else if (folderint.exists()){	ENV="ei";	}
else if (folderdev.exists()){	ENV="de";	}

logger.error("[Mail] Entorno de ejecucion: "+ ENV);

String HOST="devsmtptc-ipfromlock.igrupobbva";
String USER="rdr.es@dev.bbva.com";
DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
DocumentBuilder builder = factory.newDocumentBuilder();
try {
	    Document doc = builder.parse("/"+ENV+"/kytl/online/multipais/multicanal/dat/properties/ServerMailConfig.xml");

	    XPathFactory xPathfactory = XPathFactory.newInstance();
	    XPath xpath = xPathfactory.newXPath();
	    
	    XPathExpression expr = xpath.compile("/root/server[@id='"+ENV+"']");
	    NodeList nodeList = (NodeList) expr.evaluate(doc, XPathConstants.NODESET);

	    for (int i = 0; i < nodeList.getLength(); i++) {
		Node nNode = nodeList.item(i);

		if (nNode.getNodeType() == Node.ELEMENT_NODE) {
		    Element eElement = (Element) nNode;
		    HOST=eElement.getElementsByTagName("host").item(0).getTextContent();
		    USER=eElement.getElementsByTagName("user").item(0).getTextContent();
		}
	    }
	    logger.error("[Mail] HOST: " +HOST);
	    logger.error("[Mail] USER: " +USER);
} catch (Exception e) {
	   e.printStackTrace();
}
]]></objectValue>
<type>CONSTANT</type>
</item>
