<name id="519">statements</name>
<stringValue id="520">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("SSI_Fx_Peticion");
logger.error(" *** SSIs_Fx_Peticion Module - Result: Not found Web Service *** ");

RES.put("Result","NACK");
RES.put("ReqID",ReqID);
RES.put("ErrorID","OSITEC007");
RES.put("Message","Call WS Alert - Error");
RES.put("MessageG","Call WS Alert - Error");
RES.put("Module","SSI_Fx_Peticion");

Resultado="KO";

String query = "Insert into FT_T_RLT1 (RLT_OID,JOB_ID,TRN_ID,RECORD_SEQ_NUM,RLT_STATUS,RLT_DIF_STAT,RLT_DIF_ACC,MESSAGE_RLT,RLT_FIELD,RLT_PURP_TYP,DATA_SRC_APP,SRC_FIELD,SRC_VALUE,GS_FIELD,GS_VALUE,MAIN_ENTITY_NME,MAIN_ENTITY_ID,START_TMS,END_TMS,LAST_CHG_TMS,LAST_CHG_USR_ID) values (new_oid,null,null,'1',null,null,'FAILED',SUBSTR('"+message+"', 0 , 256),'ONLINE','"+FinsIDFond+"','ALERT_IP_SSI',null,'ALTA','"+FinsIDGest+"',null,'"+Acronym+"','"+AccessCode+"',sysdate,null,sysdate,'CARGA_FX_ALERTMIRR')";</stringValue>
<type>CONSTANT</type>
</item>
