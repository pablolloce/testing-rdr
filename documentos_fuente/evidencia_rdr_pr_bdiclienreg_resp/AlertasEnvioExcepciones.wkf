<item id="31" type="com.j2fe.workflow.definition.Transition">
<name id="32">BATCH_REFINITIV_EMISORES</name>
<source idref="9"/>
<target id="33">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="34">Get Datos Total</name>
<nodeHandler>com.j2fe.general.activities.database.DBQuery</nodeHandler>
<nodeHandlerClass id="35">com.j2fe.general.activities.database.DBQuery</nodeHandlerClass>
<parameters id="36" type="java.util.HashSet">
