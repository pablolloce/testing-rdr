<item id="574" type="com.j2fe.workflow.definition.Transition">
<name id="575">OK</name>
<source id="576">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="577">Validate PERIODICIDAD</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="578">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="579" type="java.util.HashSet">
<item id="580" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="581">statements</name>
<stringValue id="582">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("GestionAlertas - Validate env");

String periodicidad = PERIODICIDAD[0].get("PERIODICIDAD");
int daysago = Integer.parseInt( DAYSLASTSEND[0].get("DAYSLASTSEND") );
int dayscompare = 99999;
int enviototal =0;

if(null == periodicidad){
	resultado = "KO";
	return "KO";
}

if("DIARIA".equals(periodicidad) || "DIARIA_PARCIAL".equals(periodicidad)){
	dayscompare  = 1;
}else if("SEMANAL".equals(periodicidad)|| "SEMANAL_PARCIAL".equals(periodicidad) ){
	dayscompare  = 7;
}else if("MENSUAL".equals(periodicidad) || "MENSUAL_PARCIAL".equals(periodicidad) ){
	dayscompare  = 30;
}else if("ENVIOTOTAL".equals(periodicidad) || "ENVIOTOTAL_PARCIAL".equals(periodicidad) ){
	enviototal = 1;
}else{
	//Periodicidad no definida
	resultado = "KO";
	return "KO";
}


if(daysago >= dayscompare || enviototal ==1){
	resultado = "OK";
	return "OK";
}else{
	resultado = "KO";
	return "KO";
}
</stringValue>
<type>CONSTANT</type>
</item>
