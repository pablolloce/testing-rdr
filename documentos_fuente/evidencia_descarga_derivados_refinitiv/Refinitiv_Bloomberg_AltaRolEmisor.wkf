<item id="389" type="com.j2fe.workflow.definition.Transition">
<name id="390">goto-next</name>
<source id="391">
<activation>INVOKE</activation>
<clusteredCall>false</clusteredCall>
<directJoin>false</directJoin>
<name id="392">Read Response</name>
<nodeHandler>com.j2fe.general.activities.BeanShellScript</nodeHandler>
<nodeHandlerClass id="393">com.j2fe.general.activities.BeanShellScript</nodeHandlerClass>
<parameters id="394" type="java.util.HashSet">
<item id="395" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="396">statements</name>
<objectValue id="397" type="java.lang.String"><![CDATA[import java.io.BufferedReader;
import java.io.File;
import java.io.FileReader;

File archivo = null;
FileReader fr = null;
BufferedReader br = null;
String str;

File archivo2 = null;
FileReader fr2 = null;
BufferedReader br2 = null;
String str2;
int lines = 0;

String[] Result = null;

try {
    archivo = new File(Path);
    fr = new FileReader(archivo);           
    br = new BufferedReader(fr);

    archivo2 = new File(Path);
    fr2 = new FileReader(archivo2);          
    br2 = new BufferedReader(fr2);
    
    str2 = br2.readLine();
    lines++;
    while (str2 != null) {
        str2 = br2.readLine();
        lines++;
    }
    
    String[] a = new String[lines + 10];
    int i = 0;
    str = br.readLine();
    a[i] = str;
    i++;
    while (str != null) {
        str = br.readLine();
        a[i] = str;
        i++;
    }
    
    i--;
    
    Result = new String[i];

    for (int j = 0; j < Result.length; j++) {
        Result[j] = a[j];
    }

} catch (Exception e) {
    throw e; 
} finally {
    try {                    
        if (null != br) { br.close(); }
        if (null != fr) { fr.close(); }
        if (null != br2) { br2.close(); }
        if (null != fr2) { fr2.close(); }
    } catch (Exception e2) { 
        // Cierre silencioso
    }
}]]></objectValue>
<type>CONSTANT</type>
</item>
