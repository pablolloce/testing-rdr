<stringValue id="291">import org.apache.log4j.Logger;
Logger logger = Logger.getLogger("GestionAlertas - Validate env");

String addess = MAIL.get("DIRECCION");

if (addess == null || addess.length() == 0){
	resultado = "KO";
	return "KO";
} else {
	resultado = "OK";
	return "OK";
}
</stringValue>
<type>CONSTANT</type>
