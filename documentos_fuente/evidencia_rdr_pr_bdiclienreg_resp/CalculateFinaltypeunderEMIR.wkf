<stringValue id="223">UPDATE FT_T_FRA1
SET CLSF_OID = (SELECT CLSF_OID FROM FT_T_INCL WHERE INDUS_CL_SET_ID = 'FINALEM' AND CL_VALUE = :value), CL_VALUE = :value, LAST_CHG_TMS = sysdate, DATA_STAT_TYP = 'ACTIVE',
REG1_OID = (SELECT REG1_OID FROM FT_T_REG1 WHERE REG_NME = 'EMIR')
WHERE FRA1_OID = (SELECT FRA1_OID FROM (SELECT ROW_NUMBER() over (PARTITION BY INST_MNEM ORDER BY DATA_STAT_TYP asc) AS RNK, FRA1.* FROM FT_T_FRA1 FRA1
	WHERE CLSF_OID in (SELECT CLSF_OID FROM FT_T_INCL WHERE TRIM(INDUS_CL_SET_ID) = 'FINALEM')
	AND INST_MNEM = :contrprtyGlobalOid
	AND END_TMS is null)
	WHERE RNK=1)</stringValue>
