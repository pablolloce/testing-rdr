<item id="263" type="com.j2fe.workflow.definition.Parameter">
<UITypeHint id="264">["01"]@java/lang/String@</UITypeHint>
<input>true</input>
<name id="265">mappedParameters["01"]</name>
<stringValue id="266">LEI</stringValue>
<type>VARIABLE</type>
</item>
<item id="267" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="268">querySQL</name>
<stringValue id="269">SELECT 
    fins.fins_id AS fins_id_global
FROM ft_t_fiid lei
INNER JOIN ft_t_fiid fins 
    ON fins.inst_mnem = lei.inst_mnem
    AND fins.fins_id_ctxt_typ = 'FINSID'
    AND fins.data_stat_typ = 'ACTIVE'
    AND fins.end_tms IS NULL
WHERE lei.fins_id_ctxt_typ = 'LEIID'
  AND lei.fins_id = ?
  AND lei.data_stat_typ = 'ACTIVE'
  AND lei.end_tms IS NULL</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
