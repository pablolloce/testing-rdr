<name id="230">querySQL</name>
<stringValue id="231">SELECT FRA1.FRA1_OID 
FROM FT_T_FRA1 FRA1, FT_T_INCL INCL, REGULATORY_INFO RINF 
WHERE FRA1.END_TMS is null 
and FRA1.DATA_STAT_TYP = 'INACTIVE' 
AND FRA1.INST_MNEM = ? 
AND FRA1.CLSF_OID = INCL.CLSF_OID 
AND INCL.INDUS_CL_SET_ID = 'SFTRREPDEL' 
AND INCL.DATA_STAT_TYP = 'ACTIVE' 
AND INCL.END_TMS IS NULL 
AND FRA1.REG1_OID = rinf.reg1_oid 
AND RINF.DATA_STAT_TYP = 'ACTIVE' 
AND RINF.END_TMS IS NULL 
AND RINF.REG_NME = 'SFTR'
ORDER BY FRA1.LAST_CHG_TMS DESC
FETCH FIRST 1 ROWS ONLY</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
