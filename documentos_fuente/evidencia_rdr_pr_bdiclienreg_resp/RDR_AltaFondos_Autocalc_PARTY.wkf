<item id="203" type="com.j2fe.workflow.definition.Parameter">
<input>true</input>
<name id="204">querySQL</name>
<stringValue id="205">SELECT firl_loc.INST_MNEM AS VALOR
FROM FT_T_FIRL firl_loc
JOIN FT_T_FIRL firl_ope
ON firl_loc.REL_TYP        = 'LOCAL'
AND firl_loc.DATA_STAT_TYP  = 'ACTIVE'
AND firl_ope.PRNT_INST_MNEM = firl_loc.inst_mnem
AND firl_ope.DATA_STAT_TYP = 'ACTIVE'
AND firl_ope.inst_mnem     = :mnemOperativo</stringValue>
<type>CONSTANT</type>
</item>
</parameters>
